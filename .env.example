# Google Fonts API key — required for automatic woff2 download in type-system extractor.
# Get one at https://console.cloud.google.com/ (enable "Google Fonts Developer API").
# If unset, extraction still succeeds but Google-hosted fonts won't be downloaded.
google_fonts_api_key=

HEADLESS=true
TIMEOUT=30000
EXTRACTOR_RETRIES=2
VISION_RETRIES=2

# Logging
LOG_LEVEL_STDOUT=info
LOG_LEVEL_FILE=debug
LOG_DIR=./logs
LOG_APP_NAME=design-system
LOG_ROTATE_HOURS=24
LOG_ROTATE_KEEP_FILES=7
LOG_SILENT=false
