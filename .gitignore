# LLM call logs
lib/llm/*.db

# Credentials & secrets
.mcp.json
.env
.env.*
!.env.example

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node (if npm tooling is added later)
node_modules/

# Build output
dist/
build/

# Next.js build artifacts (generated per-machine, never commit)
**/.next/

# Python (local dev server cache)
__pycache__/
*.pyc
*.pyo

# Git worktrees
.worktrees/

# Temporary task scratchpad files
project-documentation/scratchpad/

# Generated screenshot artifacts (large binaries, never commit)
design-system/**/screenshots/

# Generated scroll recording artifacts (large binary .webm files, never commit)
extraction-assets/

# Debug/test screenshots in root directory
/*.png
/*.jpg
/*.jpeg

# Playwright MCP artifacts (screenshots, console logs, network logs)
.playwright-mcp/

# Playwright CLI artifacts
.playwright-cli/

# Agent identity and config files
.agent-repo-identity.json
config.yaml
deluluagent/

# Demo site generated assets (video/image binaries — use Kling/Nano Banana prompts instead)
demo/**/assets/

# Design system generated landing page assets (video/image binaries — use prompts/*.md instead)
design-system/**/landing-page/assets/
design-system/**/assets/*.mp4
design-system/**/assets/*.webm
design-system/**/assets/*.jpg
design-system/**/assets/*.jpeg
design-system/**/assets/*.png
design-system/**/assets/*.prompt.txt
design-system/**/assets/bkp/
design-system/**/assets/archive-*/

# Exception: Next.js public/assets are served by the website and must be committed
!design-system/**/public/assets/
!design-system/**/public/assets/*.mp4
!design-system/**/public/assets/*.webm
!design-system/**/public/assets/*.jpg
!design-system/**/public/assets/*.jpeg
!design-system/**/public/assets/*.png

# Task tracker local config (machine-specific, not shared)
project-documentation/task-tracker-config.md

# Agent workspaces (ephemeral copies of design-system sites for code agent editing)
workspaces/
