{
  "geometry": {
    "height": 49.9765625,
    "paddingInline": 0,
    "position": "absolute",
    "itemSpacing": 0,
    "heightScrolled": 0,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": "1px solid rgba(255,255,255,0.5)",
    "borderBottomScrolled": "1px solid rgba(255,255,255,0.5)",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "1s"
  },
  "typography": {
    "fontFamily": "Goyard, sans-serif",
    "fontSize": "0.5625rem",
    "fontWeight": "400",
    "letterSpacing": "0.0819rem",
    "textTransform": "none",
    "lineHeight": "2.22"
  },
  "linkHover": {
    "opacity": 1,
    "backgroundPill": false,
    "transition": "color 0.15s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "4px",
      "offset": "20px",
      "animation": {
        "property": "opacity",
        "from": "0",
        "to": "1",
        "origin": "center",
        "duration": "0s",
        "easing": "none"
      }
    }
  },
  "linkActive": {
    "selector": ".nav-sections .magemenu-menu.horizontal-menu .megamenu-items li.megamenu-item.active > a",
    "fontWeight": "400",
    "indicator": "dot"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "opaque-nav-sections",
    "propertiesChanged": [
      "position",
      "background-color",
      "top",
      "transition-timing-function"
    ],
    "duration": "1s",
    "easing": "ease-in",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0",
    "boxShadow": "none",
    "padding": "0",
    "itemPadding": "14px 0px 14px 129px",
    "animation": "none"
  },
  "characterDescription": "A luxury horizontal megamenu navigation built on a deep forest-green bar with ultra-small spaced-out uppercase letterforms at 50% opacity that snap to full opacity on hover, punctuated by a gold dot indicator beneath the active item — communicating quiet authority and restrained refinement. The three-level dropdown uses a split-panel tab architecture with serif body copy inside, merging editorial hierarchy with boutique e-commerce navigation conventions."
}