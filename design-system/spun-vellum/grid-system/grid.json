{
  "cssVars": {
    "--container-max-width": "1440px",
    "--container-padding-inline": "34px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1372px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto",
    "--grid-formless-sticky-gap": "80px",
    "--grid-formless-2col-baseline-gap": "48px",
    "--grid-formless-4col-flex-gap": "32px",
    "--grid-formless-4col-bar-gap": "60px",
    "--grid-formless-section-large-gap": "164px"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "34px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0"
    },
    "ecosystem-cards": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "two-col-split": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "unknown"
    },
    "testimonials": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    },
    "editorial": {
      "display": "block",
      "marginInline": "244px",
      "maxWidth": "calc(100% - 488px)"
    },
    "formless-two-col-split": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "gap": "48px",
      "alignItems": "flex-end"
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  },
  "responsive": {
    "bp-640px": {
      "query": "(min-width: 640px)",
      "maxWidth": "640px"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "768px"
    },
    "bp-1024px": {
      "query": "(min-width: 1024px)",
      "maxWidth": "1024px",
      "display": "block",
      "gridTemplateColumns": "repeat(3, minmax(0px, 1fr))",
      "flexDirection": "row",
      "rowGap": "0px",
      "columnGap": "0px"
    },
    "bp-1280px": {
      "query": "(min-width: 1280px)",
      "maxWidth": "1280px",
      "rowGap": "106px",
      "columnGap": "106px"
    },
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "maxWidth": "1440px"
    }
  },
  "_twist": {
    "type": "C. Container padding change",
    "intensity": 3,
    "sourceSystem": "griting-formless",
    "description": "Container paddingInline increased from 22px to 34px (+12px, intensity 3). Section-width adjusted from 1420px to 1372px to reflect the wider gutter. The wider container padding opens up the lateral breathing room — content feels more settled within the frame, less crowded at edges."
  }
}
