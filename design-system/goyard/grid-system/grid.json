{
  "cssVars": {},
  "container": {
    "maxWidth": "730px",
    "paddingLeft": "25px",
    "paddingRight": "25px"
  },
  "grids": {
    "the-goyard-gazette": {
      "display": "flex",
      "flexDirection": "row-reverse",
      "gap": "normal 80px",
      "justifyContent": "center",
      "childCount": "2"
    }
  },
  "responsive": {
    "bp-481px": {
      "query": "(max-width: 481px)",
      "display": "none"
    },
    "bp-576px": {
      "query": "(min-width: 576px)",
      "maxWidth": "540px",
      "flexWrap": "nowrap",
      "flexDirection": "row",
      "display": "flex",
      "rowGap": "0px",
      "columnGap": "0px"
    },
    "bp-639px": {
      "query": "only screen and (max-width: 639px)",
      "display": "table"
    },
    "bp-640px": {
      "query": "(min-width: 640px)",
      "display": "table",
      "maxWidth": "500px"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "display": "none",
      "maxWidth": "100%",
      "flexDirection": "row-reverse",
      "columnGap": "80px",
      "flexWrap": "wrap"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "720px",
      "flexWrap": "nowrap",
      "flexDirection": "row",
      "display": "flex",
      "rowGap": "0px",
      "columnGap": "0px",
      "gridTemplateColumns": "auto calc(50% + 233px)"
    },
    "bp-769px": {
      "query": "(min-width: 769px), print",
      "display": "inline-block",
      "maxWidth": "1280px",
      "flexDirection": "row",
      "flexWrap": "wrap"
    },
    "bp-799px": {
      "query": "only screen and (min-width: 799px)",
      "maxWidth": "670px"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "full-width-overlay",
      "description": "Full-width background image with a centered modal overlay containing cookie consent text and two CTA buttons arranged horizontally."
    },
    {
      "section": "product-grid-1",
      "layout": "3-column-equal",
      "description": "Three equal-width product cards displayed side by side with product image, name, and subtitle below each."
    },
    {
      "section": "editorial-split",
      "layout": "2-column-asymmetric",
      "description": "Left column contains a small illustration and text block; right column contains a large editorial image filling the remaining width."
    },
    {
      "section": "full-width-image",
      "layout": "full-width",
      "description": "Single full-width centered product image with no surrounding content columns."
    },
    {
      "section": "product-grid-2",
      "layout": "3-column-equal",
      "description": "Three equal-width product cards with images, product names, and color variant labels below."
    },
    {
      "section": "boutiques-carousel",
      "layout": "full-width-carousel",
      "description": "Horizontally scrolling carousel of boutique interior images spanning the full viewport width with previous/next arrow controls."
    },
    {
      "section": "footer",
      "layout": "4-column-equal",
      "description": "Four equal-width columns for Customer Service, Maison Goyard, Legal Information, and Accessibility links, with a bottom bar for locale selector and copyright."
    }
  ]
}