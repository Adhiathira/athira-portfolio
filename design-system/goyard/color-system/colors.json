  "visual": [
    {
      "hex": "#183f26",
      "role": "nav-background",
      "description": "Deep forest green forming the persistent top utility bar (logo, icons row) in both top-of-page and scrolled states — nav never goes transparent."
    },
    {
      "hex": "#1e4d2e",
      "role": "nav-secondary-background",
      "description": "Slightly lighter forest green used for the secondary nav row holding the catalogue/personalization/boutiques links."
    },
    {
      "hex": "#ffffff",
      "role": "nav-text",
      "description": "White used for all text, logo wordmark, and icon strokes on the dark green navigation backgrounds."
    },
    {
      "hex": "#f0ede8",
      "role": "page-background",
      "description": "Warm off-white cream used as the primary content section background throughout the page."
    },
    {
      "hex": "#f8f8f8",
      "role": "surface-background",
      "description": "Near-white used as a slightly cooler surface for distinct content blocks like the Gazette subscription section."
    },
    {
      "hex": "#333333",
      "role": "body-text",
      "description": "Dark charcoal used for product titles, body copy, and general text on light page backgrounds."
    },
    {
      "hex": "#888888",
      "role": "muted-text",
      "description": "Medium gray used for secondary descriptors such as 'See all the colors' product captions."
    },
    {
      "hex": "#183f26",
      "role": "heading-text",
      "description": "Forest green reused as editorial heading color for large display type on warm off-white content sections."
    },
    {
      "hex": "#e8b14d",
      "role": "accent",
      "description": "Warm gold used for CTA button borders, text link underlines, and decorative rule accents throughout the page."
    },
    {
      "hex": "#2a5c3a",
      "role": "footer-background",
      "description": "Medium forest green forming the boutiques carousel section background and the main footer column area."
    },
    {
      "hex": "#3d7a54",
      "role": "footer-background-bottom",
      "description": "Slightly lighter/brighter green for the very bottom footer strip containing the logo monogram, social icons, and copyright."
    },
    {
      "hex": "#3d4938",
      "role": "hero-background",
      "description": "Dark muted green-gray that forms the dominant ambient tone of the full-bleed hero video background."
    },
    {
      "hex": "#cdcdcd",
      "role": "border",
      "description": "Light gray border used on form inputs and region selector button outlines."
    }
