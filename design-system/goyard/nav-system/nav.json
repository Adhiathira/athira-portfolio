{
  "geometry": {
    "height": 49.9765625,
    "paddingInline": 0,
    "position": "absolute",
    "itemSpacing": 0,
    "heightScrolled": 0,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": "1px solid rgba(255, 255, 255, 0.5)",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "1s"
  },
  "typography": {
    "fontFamily": "Goyard, sans-serif",
    "fontSize": "0.5625rem",
    "fontWeight": "400",
    "letterSpacing": "0.0819rem",
    "textTransform": "none",
    "lineHeight": "2.22"
  },
  "linkHover": {
    "opacity": 1,
    "backgroundPill": false,
    "transition": "color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "4px",
      "offset": "0",
      "animation": {
        "property": "width",
        "from": "0",
        "to": "4px",
        "origin": "center",
        "duration": "0s",
        "easing": "none"
      }
    }
  },
  "linkActive": {
    "selector": ".nav-sections .magemenu-menu.horizontal-menu .megamenu-items li.megamenu-item:not(.close-button).active > a > span > span::after",
    "fontWeight": "400",
    "indicator": "dot"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "opaque-nav-sections",
    "propertiesChanged": [
      "position",
      "background-color",
      "top"
    ],
    "duration": "0s",
    "easing": "ease-in",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0",
    "boxShadow": "none",
    "padding": "0px",
    "itemPadding": "14px 0px 14px 129px",
    "animation": "display toggle"
  },
  "characterDescription": "A luxury e-commerce navigation system built for the Goyard brand — horizontal megamenu with extreme restraint in spacing and typography, using opacity-dimmed inactive links against a deep forest green bar, with a precise dot-indicator hover reveal and a cinematic full-width dropdown panel that layers category thumbnails alongside tabbed sub-navigation. The design language is deliberately understated and haute-couture, prioritizing spatial control and typographic precision over decorative flourish."
}