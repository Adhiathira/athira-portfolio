{
  "geometry": {
    "height": 49.9765625,
    "paddingInline": 0,
    "position": "absolute",
    "itemSpacing": 0,
    "heightScrolled": 0,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": "1px solid rgba(255, 255, 255, 0.5)",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "left 0.3s"
  },
  "typography": {
    "fontFamily": "Goyard, sans-serif",
    "fontSize": "0.5625rem",
    "fontWeight": "400",
    "letterSpacing": "0.0819rem",
    "textTransform": "uppercase",
    "lineHeight": "2.22"
  },
  "linkHover": {
    "opacity": 1,
    "backgroundPill": false,
    "transition": "color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "4px",
      "offset": null,
      "animation": {
        "property": "opacity",
        "from": "0",
        "to": "1",
        "origin": "center",
        "duration": null,
        "easing": null
      }
    }
  },
  "linkActive": {
    "selector": ".nav-sections .magemenu-menu.horizontal-menu .megamenu-items li.megamenu-item.active > a",
    "fontWeight": "400",
    "indicator": "dot"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "opaque-nav-sections",
    "propertiesChanged": [
      "position",
      "background-color",
      "top",
      "transition-timing-function"
    ],
    "duration": "1s",
    "easing": "ease-in",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px",
    "boxShadow": "none",
    "padding": "0px",
    "itemPadding": "14px 0px 14px 129px",
    "animation": "display toggle"
  },
  "characterDescription": "A restrained, luxury mega-menu navigation using the proprietary Goyard typeface at micro scale with aggressive letter-spacing and 50% opacity resting state, communicating exclusivity through deliberate understatement. The dot indicator on hover and active states — a 4px circular accent — reinforces the house identity with a precise, jewel-like detail rather than conventional underlines."
}