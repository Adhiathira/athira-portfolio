{
  "buttons": {
    "primary-cta": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#020b44",
        "color": "#FFFFFF",
        "borderColor": "#020b44",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineColor": "transparent",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "backgroundColor": "#2c2f31",
        "color": "#FFFFFF",
        "borderColor": "#0a2168",
        "borderWidth": "1px",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transform": "translateY(-1px)",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "focus": {
        "outlineColor": "#020b44",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px",
        "_twist": "Focus state enhancement (intensity 3): outlineWidth 2px + outlineOffset 2px for keyboard accessibility"
      },
      "active": {
        "backgroundColor": "#1a1a1a",
        "transform": "translateY(0px)",
        "transition": "0.13s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      }
    },
    "ghost-cta": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#FFFFFF",
        "borderColor": "#FFFFFF",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "backgroundColor": "rgba(255, 255, 255, 0.1)",
        "color": "#FFFFFF",
        "borderColor": "#FFFFFF",
        "opacity": "1",
        "cursor": "pointer",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "focus": {
        "outlineColor": "#FFFFFF",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    },
    "secondary-cta": {
      "selector": ".btn-secondary",
      "default": {
        "backgroundColor": "#2c2f31",
        "color": "#FFFFFF",
        "borderColor": "#0a2168",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "backgroundColor": "#020b44",
        "color": "#FFFFFF",
        "borderColor": "#020b44",
        "opacity": "1",
        "cursor": "pointer",
        "transition": "0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "focus": {
        "outlineColor": "#9a9a9a",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    }
  },
  "inputs": {
    "default-input": {
      "selector": "input, textarea, select",
      "default": {
        "backgroundColor": "rgba(255, 255, 255, 0.05)",
        "borderColor": "#2c2f31",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "color": "#FFFFFF",
        "outlineWidth": "0px",
        "transition": "border-color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "focus": {
        "borderColor": "#020b44",
        "outlineColor": "#020b44",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "0px",
        "boxShadow": "0 0 0 3px rgba(30, 126, 69, 0.2)",
        "transition": "border-color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "placeholder": {
        "color": "#9a9a9a",
        "opacity": "0.6"
      }
    }
  },
  "links": {
    "default-link": {
      "selector": "a:not(.btn)",
      "default": {
        "color": "#9a9a9a",
        "textDecoration": "none",
        "transition": "color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "color": "#FFFFFF",
        "opacity": "0.9",
        "transition": "color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "focus": {
        "outlineColor": "#020b44",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    }
  },
  "cards": {
    "default-card": {
      "selector": ".card",
      "default": {
        "backgroundColor": "#1a1a1a",
        "borderColor": "#2c2f31",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "8px",
        "transform": "translateY(0)",
        "boxShadow": "none",
        "transition": "transform 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "transform": "translateY(-4px)",
        "boxShadow": "0 8px 24px rgba(0, 0, 0, 0.3)",
        "borderColor": "#0a2168",
        "transition": "transform 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.41s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "selector": ".nav-link",
      "default": {
        "color": "#FFFFFF",
        "opacity": "1",
        "transition": "color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "hover": {
        "color": "#9a9a9a",
        "opacity": "0.85",
        "transition": "color 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "active": {
        "color": "#FFFFFF",
        "opacity": "1",
        "fontWeight": "600"
      },
      "focus": {
        "outlineColor": "#020b44",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    }
  },
  "_twist": "Twist A — Hover transition speed (more languid, intensity 3): +0.15s added to all transition durations in inputs, links, cards, and navigation (0.21s->0.36s, 0.26s->0.41s), clamped 0.05s-0.8s. Smoother, understated timing for DARK cinematic premium feel. Prior focus-state enhancement (Twist E, outlineWidth 2px + outlineOffset 2px) preserved. No color values changed. Source: deep-signal."
}