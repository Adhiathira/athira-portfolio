{
  "_source": "sprig-ledger",
  "_twist": "Masthead-style editorial nav — uppercase 0.75rem tracked, scaleX underline hover, 1px borderBottom on scroll only — intensity 2",
  "geometry": {
    "height": 72,
    "position": "fixed",
    "itemSpacing": 32,
    "logoPosition": "left",
    "mobileBreakpoint": 768
  },
  "background": {
    "default": "transparent",
    "scrolled": "var(--color-surface, #fcf7f1)",
    "borderBottom": null,
    "borderBottomScrolled": "1px solid currentColor",
    "boxShadow": null,
    "boxShadowScrolled": null
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase",
    "_note": "Nav uses body font at label scale — uppercase + tracking distinguishes it from body without adding a font"
  },
  "linkHover": {
    "backgroundPill": false,
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "color": "currentColor",
      "animation": {
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left center",
        "duration": "0.3s",
        "easing": "ease-out"
      }
    }
  },
  "scrollTransition": {
    "triggerClass": "nav--scrolled",
    "scrollThreshold": 40,
    "colorInversion": false,
    "_note": "At scroll threshold: background fills, borderBottom appears. Text color unchanged."
  },
  "dropdown": {
    "present": false
  },
  "cta": {
    "style": "text-link",
    "present": true
  }
}
