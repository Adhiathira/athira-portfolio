{
  "_source": "cerulean-draft",
  "_twist": "Maximum weight contrast — 900 display serif paired with 300 grotesque body, h1 at clamp(6rem,12vw,14rem) — intensity 4",
  "cssVars": {
    "--font-display": "'Playfair Display', serif",
    "--font-body": "'DM Sans', sans-serif",
    "--letter-spacing-h1": "-0.05em",
    "--letter-spacing-h2": "-0.02em",
    "--letter-spacing-h3": "-0.01em",
    "--letter-spacing-eyebrow": "0.12em",
    "--letter-spacing-body": "0.01em",
    "--letter-spacing-nav": "0.08em",
    "--letter-spacing-button": "0.06em",
    "--font-size-h1": "clamp(6rem, 12vw, 14rem)",
    "--font-size-h2": "clamp(2.5rem, 5vw, 4rem)",
    "--font-size-h3": "clamp(1.8rem, 3vw, 2.2rem)",
    "--font-size-h4": "0.75rem",
    "--font-size-body": "1rem",
    "--font-size-button": "0.875rem",
    "--font-size-nav": "0.875rem",
    "--font-weight-h1": "900",
    "--font-weight-h2": "700",
    "--font-weight-h3": "600",
    "--font-weight-h4": "500",
    "--font-weight-body": "300",
    "--font-weight-button": "500",
    "--font-weight-nav": "400",
    "--line-height-h1": "0.95",
    "--line-height-h2": "1.1",
    "--line-height-h3": "1.2",
    "--line-height-h4": "1.5",
    "--line-height-body": "1.75"
  },
  "fontFaces": [
    {
      "family": "Playfair Display",
      "weight": "400 900",
      "src": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&display=swap",
      "resolvedName": "Playfair Display",
      "webAccessible": true,
      "role": "display"
    },
    {
      "family": "DM Sans",
      "weight": "300 500",
      "src": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap",
      "resolvedName": "DM Sans",
      "webAccessible": true,
      "role": "body"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Playfair Display, serif",
      "fontSize": "clamp(6rem, 12vw, 14rem)",
      "fontWeight": "900",
      "lineHeight": "0.95",
      "letterSpacing": "-0.05em",
      "_note": "Display mass — negative tracking tightens the typographic block. Occupies above-fold zone as architecture."
    },
    "h2": {
      "fontFamily": "Playfair Display, serif",
      "fontSize": "clamp(2.5rem, 5vw, 4rem)",
      "fontWeight": "700",
      "lineHeight": "1.1",
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "fontFamily": "Playfair Display, serif",
      "fontSize": "clamp(1.8rem, 3vw, 2.2rem)",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "-0.01em"
    },
    "h4": {
      "fontFamily": "DM Sans, sans-serif",
      "fontSize": "0.75rem",
      "fontWeight": "500",
      "lineHeight": "1.5",
      "letterSpacing": "0.12em",
      "textTransform": "uppercase",
      "_note": "Eyebrow / section label register — uppercase tracked label, not headline"
    },
    "body": {
      "fontFamily": "DM Sans, sans-serif",
      "fontSize": "1rem",
      "fontWeight": "300",
      "lineHeight": "1.75",
      "letterSpacing": "0.01em"
    },
    "button": {
      "fontFamily": "DM Sans, sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "500",
      "letterSpacing": "0.06em",
      "textTransform": "uppercase"
    },
    "nav": {
      "fontFamily": "DM Sans, sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  }
}
