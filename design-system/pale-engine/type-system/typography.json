      "resolvedName": "Archivo Narrow",
      "webAccessible": true,
      "_note": "/* font: D-DIN (not available) — using Archivo Narrow [concept-matched fallback: condensed grotesque for cold aerospace body text] */"
    },
    {
      "family": "Bricolage Grotesque",
      "weight": "200 800",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap",
      "resolvedName": "Bricolage Grotesque",
      "webAccessible": true,
      "_note": "/* font: D-DIN-Bold (not available) — using Bricolage Grotesque [concept-matched fallback: sharp mechanical grotesque for cold aerospace display headings] */"
    },
    {
      "family": "Roboto Mono",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400&display=swap",
