{
  "cssVars": {},
  "container": {
    "maxWidth": "1468px"
  },
  "grids": {
    "primary-12col": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "32px",
      "childCount": "12"
    },
    "feature-2col": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "columnCount": "2",
      "gap": "32px",
      "childCount": "2"
    },
    "editorial-4col": {
      "display": "grid",
      "templateColumns": "repeat(4, 1fr)",
      "columnCount": "4",
      "gap": "32px",
      "childCount": "4"
    },
    "editorial-3col": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": "3",
      "gap": "32px",
      "childCount": "3"
    },
    "hero-asymmetric": {
      "display": "grid",
      "templateColumns": "2fr 1fr",
      "columnCount": "2",
      "gap": "32px",
      "childCount": "2",
      "description": "Asymmetric hero split: large media left, editorial content right"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "(max-width: 375px)",
      "maxWidth": "100vw",
      "flexDirection": "column"
    },
    "bp-768px": {
      "query": "only screen and (min-width: 768px)",
      "display": "grid",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "rowGap": "24px",
      "columnGap": "24px",
      "maxWidth": "calc(100vw - 48px)"
    },
    "bp-1024px": {
      "query": "only screen and (min-width: 1024px)",
      "display": "grid",
      "gridTemplateColumns": "repeat(3, 1fr)",
      "rowGap": "32px",
      "columnGap": "32px"
    },
    "bp-1440px": {
      "query": "only screen and (min-width: 1440px)",
      "display": "grid",
      "gridTemplateColumns": "repeat(4, 1fr)",
      "maxWidth": "1468px"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "asymmetric-2-column",
      "description": "Hero split into large left media column (~67% width) and a narrow right content column (~33%) with editorial text and CTA."
    },
    {
      "section": "feature-grid",
      "layout": "4-column-equal",
      "description": "4-column equal-width grid of feature cards with product image and label."
    },
    {
      "section": "editorial-strip",
      "layout": "3-column-equal",
      "description": "Three equal editorial columns for showcase content."
    },
    {
      "section": "footer-main",
      "layout": "5-column-unequal",
      "description": "Footer divided into 5 columns: wide brand blurb left, then Address, Contact, Info, Follow Us."
    }
  ],
  "twist": {
    "type": "A",
    "description": "Container max-width tightened by 15% (intensity 2, editorial). 1728px reduced to 1468px — creates a tighter typographic measure and more deliberate margins on wide viewports, reinforcing the printed-page editorial register."
  }
}
