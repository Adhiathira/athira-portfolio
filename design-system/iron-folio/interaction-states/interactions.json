{
  "buttons": {
    "primary-button": {
      "selector": "button, .btn",
      "default": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "1px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "solid"
      },
      "hover": {
        "color": "#fcf7f1",
        "backgroundColor": "#000000",
        "borderColor": "#000000",
        "borderWidth": "1px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "solid"
      }
    },
    "ghost-button": {
      "selector": "button.ghost, .btn-ghost",
      "default": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "1px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "solid",
        "backgroundColor": "transparent"
      },
      "hover": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "1px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "0.7",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "solid"
      }
    },
    "utility-button": {
      "selector": "button.utility",
      "default": {
        "color": "#696969",
        "borderColor": "#696969",
        "borderWidth": "0px 0px 0px 1px",
        "outlineColor": "#696969",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "none none none solid"
      },
      "hover": {
        "color": "#696969",
        "borderColor": "#696969",
        "borderWidth": "0px 0px 0px 1px",
        "outlineColor": "#696969",
        "outlineWidth": "0px",
        "opacity": "0.7",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out",
        "borderStyle": "none none none solid"
      }
    }
  },
  "inputs": {
    "text-input": {
      "selector": "input[type='text'], input[type='email'], textarea",
      "default": {
        "borderColor": "#000000",
        "borderWidth": "0px 0px 1px 0px",
        "borderStyle": "none none solid none",
        "outlineWidth": "0px",
        "opacity": "1",
        "transition": "all 0.45s ease-in-out"
      },
      "focus": {
        "borderColor": "#000000",
        "borderWidth": "0px 0px 2px 0px",
        "outlineWidth": "0px",
        "opacity": "1",
        "transition": "all 0.45s ease-in-out"
      }
    }
  },
  "links": {
    "body-link": {
      "selector": "a:not(.btn)",
      "default": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "0px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "textDecoration": "underline",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out"
      },
      "hover": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "0px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "0.7",
        "fontWeight": "400",
        "textDecoration": "underline",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out"
      }
    }
  },
  "cards": {
    "product-card": {
      "selector": ".card",
      "default": {
        "opacity": "1",
        "transform": "translateY(0px)",
        "transition": "all 0.45s ease-in-out"
      },
      "hover": {
        "opacity": "0.95",
        "transform": "translateY(-2px)",
        "transition": "all 0.45s ease-in-out"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "selector": "nav a, .nav-link",
      "default": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "0px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out"
      },
      "hover": {
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "0px 0px 1px 0px",
        "outlineColor": "#000000",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "textDecoration": "none",
        "borderStyle": "none none solid none",
        "cursor": "pointer",
        "transition": "all 0.45s ease-in-out"
      }
    }
  },
  "twist": {
    "type": "A",
    "description": "Hover transition speed made more languid: +0.15s added to all hover transitions (intensity 3). Transitions raised to 0.45s throughout — the system does not snap, it settles. Paired with the 1.5× motion duration scaling, hover states now feel considered rather than reactive."
  }
}
