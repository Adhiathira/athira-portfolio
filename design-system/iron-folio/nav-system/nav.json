{
  "geometry": {
    "height": 48,
    "heightScrolled": 40,
    "paddingInline": 24,
    "position": "fixed",
    "itemSpacing": 24,
    "logoWidth": 160,
    "logoHeight": 32,
    "logoPosition": "left"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "behavior": {
    "transparentAtTop": true,
    "solidOnScroll": true,
    "scrollThreshold": 80,
    "backdropBlur": false
  },
  "states": {
    "default": {
      "background": "transparent",
      "textColor": "#000000",
      "borderBottom": "none"
    },
    "scrolled": {
      "background": "#fcf7f1",
      "textColor": "#000000",
      "borderBottom": "1px solid #000000"
    },
    "mobile": {
      "height": 48,
      "logoPosition": "left",
      "menuType": "overlay"
    }
  },
  "links": {
    "hoverStyle": "underline-wipe",
    "underlineOrigin": "left",
    "transitionDuration": "0.45s"
  },
  "twist": {
    "type": "A",
    "description": "Nav height adjustment +16px (intensity 3). 32px→48px default, scrolled 40px. The nav gains measured presence — no longer a whisper at the top of the page but a deliberate horizontal plane that frames the content below."
  }
}
