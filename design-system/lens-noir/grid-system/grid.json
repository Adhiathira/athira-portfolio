{
  "cssVars": {
    "container-max-width": "1440px",
    "container-padding": "80px",
    "container-padding-tablet": "40px",
    "container-padding-mobile": "20px"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "80px",
    "notes": "Widescreen feel — 80px gutters mimic cinema projection margins"
  },
  "grids": {
    "widescreen-hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "aspectRatio": "2.35 / 1",
      "description": "Full-viewport with 2.35:1 cinematic aspect ratio letterbox"
    },
    "three-col-features": {
      "display": "grid",
      "templateColumns": "1fr 1fr 1fr",
      "columnCount": "3",
      "gap": "32px",
      "description": "Equal three-column feature card grid"
    },
    "editorial-split": {
      "display": "grid",
      "templateColumns": "3fr 2fr",
      "columnCount": "2",
      "gap": "64px",
      "description": "Asymmetric editorial layout — dominant left with secondary right"
    },
    "stats-four": {
      "display": "grid",
      "templateColumns": "1fr 1fr 1fr 1fr",
      "columnCount": "4",
      "gap": "0px",
      "description": "Four equal stat columns — borderless"
    },
    "credits-five": {
      "display": "grid",
      "templateColumns": "1fr 1fr 1fr 1fr 1fr",
      "columnCount": "5",
      "gap": "32px",
      "description": "Five-column credits layout — footer attribution"
    },
    "filmstrip": {
      "display": "flex",
      "flexDirection": "row",
      "overflowX": "scroll",
      "gap": "24px",
      "description": "Horizontal scroll filmstrip — equal-width card row"
    },
    "acts-three": {
      "display": "grid",
      "templateColumns": "1fr 1fr 1fr",
      "columnCount": "3",
      "gap": "1px",
      "borderBetween": "1px solid rgba(255,255,255,0.08)",
      "description": "Three-act structure with dividers — Act I / II / III"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "(max-width: 375px)",
      "containerPadding": "20px",
      "defaultGrid": "1fr"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "containerPadding": "20px",
      "defaultGrid": "1fr",
      "twoColGrid": "1fr"
    },
    "bp-1024px": {
      "query": "(max-width: 1024px)",
      "containerPadding": "40px",
      "defaultGrid": "1fr 1fr"
    },
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "containerPadding": "80px"
    }
  },
  "visual": [
    { "section": "hero", "layout": "full-viewport-letterboxed", "description": "Full viewport with black letterbox bars top and bottom, 80px each. 2.35:1 content area. Big title centered." },
    { "section": "features", "layout": "three-col-dark-cards", "description": "Three equal dark cards with film-frame borders. Image placeholder areas as pure-black panels." },
    { "section": "stats", "layout": "four-col-numerals", "description": "Four large Bebas Neue numerals in amber, labels below in Libre Baskerville." },
    { "section": "how-it-works", "layout": "three-acts", "description": "Three equal columns with vertical dividers. ACT I / II / III headings in Bebas Neue." },
    { "section": "testimonials", "layout": "filmstrip-scroll", "description": "Horizontal scroll row of dark quote cards." },
    { "section": "footer", "layout": "credits-five-col", "description": "Five-column credits layout. Film roll divider at top." }
  ]
}
