{
  "philosophy": "Interactions feel like physical film — they respond to touch with tactile weight, not digital snappiness. Transitions are 0.3s ease-out, never instant.",
  "duration": "0.3s",
  "easing": "ease-out",
  "states": {
    "hover": {
      "images": {
        "filter": "brightness(1.15)",
        "transition": "filter 0.3s ease-out",
        "notes": "Brightness increase only — no color change. Mimics a light coming up on a projected image."
      },
      "links": {
        "color": "#e63946",
        "textDecoration": "underline",
        "textUnderlineOffset": "3px",
        "transition": "color 0.3s ease-out",
        "notes": "Film-red underline appears on hover — sharp, decisive"
      },
      "buttons": {
        "backgroundColor": "#e63946",
        "color": "#f0ece4",
        "transition": "background-color 0.3s ease-out, color 0.3s ease-out"
      },
      "cards": {
        "boxShadow": "0 0 0 1px rgba(255,255,255,0.15)",
        "transition": "box-shadow 0.3s ease-out"
      },
      "navLinks": {
        "color": "#e63946",
        "transition": "color 0.3s ease-out"
      }
    },
    "focus": {
      "outline": "2px solid #e63946",
      "outlineOffset": "3px",
      "transition": "outline 0.15s ease-out",
      "notes": "Visible film-red focus ring — accessibility compliant"
    },
    "active": {
      "opacity": "0.75",
      "transition": "opacity 0.1s ease-out",
      "notes": "Active state feels like a shutter click — brief opacity drop"
    },
    "disabled": {
      "opacity": "0.35",
      "cursor": "not-allowed",
      "filter": "grayscale(1)"
    }
  },
  "components": {
    "button-primary": {
      "default": { "background": "#e63946", "color": "#f0ece4", "border": "none" },
      "hover": { "background": "#cc2f3c", "transform": "none" },
      "active": { "opacity": "0.75" },
      "focus": { "outline": "2px solid #e63946", "outlineOffset": "3px" },
      "transition": "background-color 0.3s ease-out, opacity 0.1s ease-out"
    },
    "button-ghost": {
      "default": { "background": "transparent", "color": "#f0ece4", "border": "1px solid rgba(255,255,255,0.15)" },
      "hover": { "background": "rgba(255,255,255,0.05)", "borderColor": "rgba(255,255,255,0.3)" },
      "active": { "opacity": "0.75" },
      "transition": "background-color 0.3s ease-out, border-color 0.3s ease-out"
    },
    "nav-link": {
      "default": { "color": "#f0ece4", "textDecoration": "none" },
      "hover": { "color": "#e63946" },
      "active-page": { "color": "#e63946" },
      "transition": "color 0.3s ease-out"
    },
    "card": {
      "default": { "boxShadow": "0 0 0 1px rgba(255,255,255,0.08)" },
      "hover": { "boxShadow": "0 0 0 1px rgba(255,255,255,0.15)", "filter": "brightness(1.05)" },
      "transition": "box-shadow 0.3s ease-out, filter 0.3s ease-out"
    },
    "image-area": {
      "default": { "filter": "brightness(1)" },
      "hover": { "filter": "brightness(1.15)" },
      "transition": "filter 0.3s ease-out"
    }
  }
}
