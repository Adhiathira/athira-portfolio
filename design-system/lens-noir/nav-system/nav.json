{
  "height": "64px",
  "position": "fixed",
  "zIndex": 100,
  "behavior": {
    "initial": {
      "background": "transparent",
      "backdropFilter": "none",
      "notes": "Transparent on cinematic hero — logo and links float over dark bg"
    },
    "scrolled": {
      "background": "rgba(12, 12, 14, 0.95)",
      "backdropFilter": "blur(8px)",
      "borderBottom": "1px solid rgba(255,255,255,0.06)",
      "transition": "background 0.4s ease-out, backdrop-filter 0.4s ease-out",
      "triggerScrollY": "80px"
    }
  },
  "logo": {
    "fontFamily": "'Bebas Neue', sans-serif",
    "fontSize": "1.75rem",
    "fontWeight": "400",
    "color": "#ffffff",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "links": {
    "fontFamily": "'Libre Baskerville', Georgia, serif",
    "fontSize": "0.875rem",
    "fontWeight": "400",
    "color": "#f0ece4",
    "textTransform": "uppercase",
    "letterSpacing": "0.12em",
    "gap": "40px"
  },
  "activeLink": {
    "color": "#e63946"
  },
  "ctaButton": {
    "background": "#e63946",
    "color": "#f0ece4",
    "paddingInline": "24px",
    "paddingBlock": "10px",
    "fontFamily": "'Libre Baskerville', Georgia, serif",
    "fontSize": "0.75rem",
    "letterSpacing": "0.12em",
    "textTransform": "uppercase",
    "borderRadius": "0px"
  },
  "mobile": {
    "breakpoint": "768px",
    "hamburger": true,
    "menuBackground": "rgba(12,12,14,0.98)"
  }
}
