{
  "cssVars": {
    "font-display": "'Bebas Neue', sans-serif",
    "font-body": "'Libre Baskerville', Georgia, serif",
    "font-letter-spacing-display": "0.08em",
    "font-letter-spacing-heading": "0.05em",
    "font-letter-spacing-label": "0.18em",
    "font-letter-spacing-nav": "0.12em",
    "font-letter-spacing-caption": "0.03em"
  },
  "fontFaces": [
    {
      "family": "Bebas Neue",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap",
      "resolvedName": "Bebas Neue",
      "role": "Display — film poster titles, all-caps numerals"
    },
    {
      "family": "Libre Baskerville",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap",
      "resolvedName": "Libre Baskerville",
      "role": "Body — warm refined body, newspaper/literary feel"
    },
    {
      "family": "Libre Baskerville",
      "weight": "700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap",
      "resolvedName": "Libre Baskerville"
    },
    {
      "family": "Libre Baskerville",
      "weight": "400",
      "style": "italic",
      "src": "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap",
      "resolvedName": "Libre Baskerville"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "'Bebas Neue', sans-serif",
      "fontSize": "clamp(5rem, 10vw, 10rem)",
      "fontWeight": "400",
      "lineHeight": "0.95",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase",
      "primaryFont": "Bebas Neue",
      "notes": "Title card display — film poster scale"
    },
    "h2": {
      "fontFamily": "'Bebas Neue', sans-serif",
      "fontSize": "clamp(2.5rem, 5vw, 5rem)",
      "fontWeight": "400",
      "lineHeight": "1.0",
      "letterSpacing": "0.05em",
      "textTransform": "uppercase",
      "primaryFont": "Bebas Neue",
      "notes": "Section titles — widescreen chapter headings"
    },
    "h3": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "clamp(1.25rem, 2.5vw, 1.75rem)",
      "fontWeight": "700",
      "lineHeight": "1.35",
      "letterSpacing": "0",
      "primaryFont": "Libre Baskerville"
    },
    "body": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.8",
      "letterSpacing": "0",
      "primaryFont": "Libre Baskerville"
    },
    "caption": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "0.75rem",
      "fontWeight": "400",
      "fontStyle": "italic",
      "lineHeight": "1.6",
      "letterSpacing": "0.03em",
      "primaryFont": "Libre Baskerville",
      "notes": "Film captions, lower-thirds"
    },
    "label": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "0.6875rem",
      "fontWeight": "400",
      "lineHeight": "1.4",
      "letterSpacing": "0.18em",
      "textTransform": "uppercase",
      "primaryFont": "Libre Baskerville",
      "notes": "Eyebrow labels, section tags"
    },
    "credits": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "0.75rem",
      "fontWeight": "400",
      "fontStyle": "italic",
      "lineHeight": "2.0",
      "letterSpacing": "0.03em",
      "primaryFont": "Libre Baskerville",
      "notes": "Rolling credits, footer attribution"
    },
    "nav": {
      "fontFamily": "'Libre Baskerville', Georgia, serif",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.0",
      "letterSpacing": "0.12em",
      "textTransform": "uppercase",
      "primaryFont": "Libre Baskerville"
    },
    "stat": {
      "fontFamily": "'Bebas Neue', sans-serif",
      "fontSize": "clamp(3rem, 6vw, 6rem)",
      "fontWeight": "400",
      "lineHeight": "1.0",
      "letterSpacing": "0.05em",
      "primaryFont": "Bebas Neue",
      "notes": "Large numeral callouts — amber accent color"
    }
  },
  "proprietaryFonts": []
}
