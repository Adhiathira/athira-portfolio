{
  "cssVars": {
    "--grid-container-max-width": "1440px",
    "--grid-container-padding": "32px",
    "--grid-columns": "12",
    "--grid-column-gap": "24px",
    "--grid-row-gap": "32px",
    "--grid-section-spacing-sm": "clamp(3rem, 5vw, 5rem)",
    "--grid-section-spacing-md": "clamp(4rem, 8vw, 9rem)",
    "--grid-section-spacing-lg": "clamp(5rem, 10vw, 15rem)",
    "--grid-section-spacing-xl": "clamp(6rem, 12vw, 28rem)"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingLeft": "32px",
    "paddingRight": "32px",
    "_twist": "Container max-width expanded to 1440px (from 1600px source, tuned for Figma layout hints: wide 1440px frames with split layouts and 3-column product grids). Gutters tightened to 24px column gap.",
    "_figmaNote": "Figma extraction shows 1440px frames with split-left-text-right-ui and 3-column cards. Max-width set to 1280px safe zone with 32px gutters."
  },
  "grids": {
    "default": {
      "display": "grid",
      "gridTemplateColumns": "repeat(12, 1fr)",
      "columnGap": "24px",
      "rowGap": "32px"
    },
    "split-2col": {
      "display": "grid",
      "gridTemplateColumns": "1fr 1fr",
      "columnGap": "32px",
      "rowGap": "0",
      "alignItems": "center",
      "parentSection": "feature"
    },
    "split-60-40": {
      "display": "grid",
      "gridTemplateColumns": "60fr 40fr",
      "columnGap": "32px",
      "alignItems": "center",
      "parentSection": "product-feature"
    },
    "cards-3col": {
      "display": "grid",
      "gridTemplateColumns": "repeat(3, 1fr)",
      "columnGap": "24px",
      "rowGap": "24px",
      "parentSection": "ecosystem"
    },
    "cards-4col": {
      "display": "grid",
      "gridTemplateColumns": "repeat(4, 1fr)",
      "columnGap": "24px",
      "rowGap": "24px",
      "parentSection": "mentorship"
    },
    "cards-2col": {
      "display": "grid",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "columnGap": "24px",
      "rowGap": "24px",
      "parentSection": "expanding"
    },
    "footer-5col": {
      "display": "grid",
      "gridTemplateColumns": "2fr 1fr 1fr 1fr 1fr",
      "columnGap": "32px",
      "parentSection": "footer"
    },
    "nav": {
      "display": "flex",
      "flexDirection": "row",
      "justifyContent": "space-between",
      "alignItems": "center",
      "gap": "32px",
      "parentSection": "header"
    }
  },
  "responsive": {
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "maxWidth": "1440px",
      "display": "block"
    },
    "bp-1024px": {
      "query": "(max-width: 1024px)",
      "maxWidth": "100%",
      "columnGap": "20px",
      "gridTemplateColumns": "repeat(8, 1fr)"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "maxWidth": "100%",
      "gridTemplateColumns": "1fr 1fr",
      "columnGap": "16px",
      "rowGap": "20px"
    },
    "bp-375px": {
      "query": "(max-width: 375px)",
      "maxWidth": "100%",
      "gridTemplateColumns": "1fr",
      "columnGap": "0",
      "rowGap": "16px",
      "paddingInline": "20px"
    }
  }
}
