{
  "geometry": {
    "height": 72,
    "heightScrolled": 60,
    "paddingInline": 32,
    "position": "fixed",
    "itemSpacing": 32,
    "logoWidth": 120,
    "logoHeight": 32,
    "logoPosition": "left",
    "alignment": "space-between",
    "_twist": "Nav height slimmed: buttermax source was 130px → reduced to 72px (intensity 3: -10px adjustment gives enterprise-precision nav, not theatrical). HeightScrolled 60px."
  },
  "background": {
    "backgroundColor": "#062914",
    "backgroundColorScrolled": "#062914",
    "backdropFilter": "none",
    "backdropFilterScrolled": "blur(12px)",
    "borderBottom": "none",
    "borderBottomScrolled": "1px solid #1A4B2A",
    "boxShadow": "none",
    "boxShadowScrolled": "0 1px 0 rgba(26, 75, 42, 0.5)",
    "transition": "all 0.45s cubic-bezier(0.215, 0.61, 0.355, 1)"
  },
  "typography": {
    "fontFamily": "'Inter', sans-serif",
    "fontSize": "1rem",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
    "textTransform": "none",
    "lineHeight": "1.5",
    "_twist": "Letter spacing on nav links applied at intensity 3: 0.08em — precise, authoritative. Source: buttermax. Font updated to Inter (available via Google Fonts CDN) to match type system."
  },
  "linkHover": {
    "backgroundPill": false,
    "color": "#9DBBA5",
    "transition": "color 0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "underline": {
      "type": "pseudo-element",
      "animation": {
        "property": "transform",
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left center",
        "duration": "0.26s",
        "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      },
      "color": "#9DBBA5",
      "thickness": "1px"
    }
  },
  "linkActive": {
    "indicator": "underline via pseudo-element",
    "color": "#FFFFFF"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "nav--scrolled",
    "propertiesChanged": [
      "height",
      "border-bottom",
      "box-shadow",
      "backdrop-filter"
    ],
    "duration": "0.26s",
    "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  },
  "dropdown": {
    "present": false,
    "trigger": null,
    "borderRadius": "8px",
    "boxShadow": "0 8px 24px rgba(0, 0, 0, 0.4)",
    "backgroundColor": "#0D3B1C",
    "borderColor": "#1A4B2A",
    "padding": "16px 24px",
    "animation": "opacity 0.21s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  },
  "cta": {
    "primary": {
      "text": "Get started",
      "backgroundColor": "#1E7E45",
      "color": "#FFFFFF",
      "borderRadius": "6px",
      "padding": "10px 20px",
      "fontWeight": "600",
      "letterSpacing": "0.06em"
    },
    "secondary": {
      "text": "Log in",
      "backgroundColor": "transparent",
      "color": "#FFFFFF",
      "borderRadius": "6px",
      "padding": "10px 16px",
      "fontWeight": "500"
    }
  },
  "characterDescription": "A precision-engineered dark forest nav — slim 72px bar on deep green canvas, Inter with deliberate 0.08em letter-spacing on links for authoritative legibility. Underline expands from left on hover. On scroll: height contracts to 60px, subtle border and backdrop blur engage. No theatrical overlay. Enterprise confidence through restraint."
}
