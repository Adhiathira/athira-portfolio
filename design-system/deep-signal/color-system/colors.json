  "elements": {
    "pageBackground": "#062914",
    "bodyText": "#FFFFFF",
    "headingText": "#FFFFFF",
    "linkColor": "#9DBBA5",
    "navBackground": "#062914",
    "navText": "#FFFFFF",
    "navLink": "#FFFFFF",
    "navBackgroundScrolled": "#062914",
    "navTextScrolled": "#FFFFFF",
