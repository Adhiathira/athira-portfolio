  "visual": [
    {
      "hex": "#062914",
      "role": "page-background",
      "description": "Deep forest green — the dominant canvas across all dark sections. Near-black green that grounds every surface."
    },
    {
      "hex": "#155527",
      "role": "primary",
      "description": "Forest green primary — used for primary surfaces, cards, and structural elements. The brand's dominant mid-tone."
    },
    {
      "hex": "#1E7E45",
      "role": "accent",
      "description": "Vivid forest green accent — used for primary CTA buttons, active states, and emphasis highlights."
    },
    {
      "hex": "#0D3B1C",
      "role": "surface-background",
      "description": "Slightly elevated dark green surface — used for cards, panels, and elevated content zones within dark sections."
    },
    {
      "hex": "#1A4B2A",
      "role": "border",
      "description": "Subtle green border — separating panels and UI elements against the dark background."
    },
    {
      "hex": "#2A6B3E",
      "role": "border-strong",
      "description": "Stronger green border — used on interactive elements and active containers."
    },
    {
      "hex": "#EEF5EE",
      "role": "light-background",
      "description": "Mint-tinted off-white — used for alternating light sections. Cool and calm, rooted in the green palette."
    },
    {
      "hex": "#FFFFFF",
      "role": "surface",
      "description": "Pure white — used as surface color within light sections and text-on-dark."
    },
    {
      "hex": "#FFFFFF",
      "role": "heading-text",
      "description": "Pure white headings on dark sections — maximum contrast against the forest green canvas."
    },
    {
      "hex": "#FFFFFF",
      "role": "body-text",
      "description": "White body text on dark sections — clean and legible against the deep forest background."
    },
    {
      "hex": "#9DBBA5",
      "role": "text-secondary",
      "description": "Muted sage green — secondary text, captions, and de-emphasized content on dark backgrounds."
    },
    {
      "hex": "#6B8F77",
      "role": "subtle-text",
      "description": "Low-priority muted green-grey — metadata labels and icon fills on dark sections."
    },
    {
      "hex": "#0A2410",
      "role": "text-on-light",
      "description": "Very dark forest green — primary text on light (#EEF5EE) sections. Strong contrast against light mint background."
    },
    {
      "hex": "#6B7280",
      "role": "text-secondary-on-light",
      "description": "Neutral grey — secondary text on light sections. Provides contrast without competing with the primary green voice."
    },
    {
      "hex": "#062914",
      "role": "nav-background",
      "description": "Navigation background matches the page background — transparent blending at top of page."
    },
    {
      "hex": "#FFFFFF",
      "role": "nav-link",
      "description": "Nav links rendered in white on the dark forest canvas."
    }
  ],
  "ctaButtons": [
    {
      "bg": "#1E7E45",
      "textColor": "#FFFFFF",
      "border": "#1E7E45",
      "role": "primary-cta"
    },
    {
      "bg": "transparent",
      "textColor": "#FFFFFF",
      "border": "#FFFFFF",
      "role": "ghost"
    },
    {
      "bg": "transparent",
      "textColor": "#9DBBA5",
      "border": "#9DBBA5",
      "role": "nav-link"
    },
    {
      "bg": "#155527",
      "textColor": "#FFFFFF",
      "border": "#2A6B3E",
      "role": "secondary-cta"
    },
    {
      "bg": "#EEF5EE",
      "textColor": "#0A2410",
      "border": "#EEF5EE",
      "role": "light-primary-cta"
    },
    {
      "bg": "transparent",
      "textColor": "#FFFFFF",
      "border": "#1A4B2A",
      "role": "utility"
    }
  ]
}
