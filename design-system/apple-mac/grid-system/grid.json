  "responsive": {
    "bp-569px": {
      "query": "(max-width: 569px)",
      "display": "none"
    },
    "bp-605px": {
      "query": "only screen and (max-width: 605px)",
      "display": "inline-block"
    },
    "bp-640px": {
      "query": "only screen and (max-width: 640px)",
      "flexDirection": "column",
      "display": "block"
    },
    "bp-641px": {
      "query": "only screen and (min-width: 641px) and (max-width: 833px)",
      "maxWidth": "50%"
    },
    "bp-734px": {
      "query": "only screen and (max-width: 734px)",
      "maxWidth": "100%",
      "display": "block",
      "flexDirection": "column",
      "columnGap": "28px",
      "rowGap": "28px"
    },
    "bp-735px": {
      "query": "(min-width: 735px) and (max-width: 1068px)",
      "maxWidth": "75%"
    },
    "bp-833px": {
      "query": "only screen and (max-width: 833px)",
      "display": "flex",
      "maxWidth": "none",
      "flexDirection": "column",
      "flexWrap": "wrap"
    },
    "bp-834px": {
      "query": "only screen and (min-width: 834px)",
      "display": "contents",
      "maxWidth": "calc(1024px - var(--r-globalnav-scrollbar-width))"
    }
  },
  "visual": [
    {
