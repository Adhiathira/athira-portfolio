{
  "hover": {
    "transform": "scale(0.97)",
    "transition": "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)",
    "boxShadow": "reduced",
    "cursor": "pointer",
    "description": "Clay squish on hover — element compresses slightly, shadow reduces, spring easing snaps back"
  },
  "active": {
    "transform": "scale(0.93) scaleX(1.03)",
    "transition": "all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1)",
    "boxShadow": "minimal",
    "description": "Deeper squish on active press — lateral spread suggests clay being pressed flat"
  },
  "focus": {
    "outlineWidth": "2px",
    "outlineStyle": "solid",
    "outlineColor": "var(--color-primary-action)",
    "outlineOffset": "3px",
    "borderRadius": "inherit",
    "transition": "outline-offset 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "disabled": {
    "opacity": "0.45",
    "cursor": "not-allowed",
    "transform": "none",
    "filter": "saturate(0.6)"
  },
  "cardHover": {
    "transform": "scale(0.98) translateY(-2px)",
    "transition": "all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)",
    "boxShadow": "0 20px 60px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.08)"
  },
  "buttonPrimary": {
    "rest": {
      "transform": "scale(1)",
      "boxShadow": "0 8px 24px rgba(223, 94, 18, 0.35), 0 3px 8px rgba(223, 94, 18, 0.2)"
    },
    "hover": {
      "transform": "scale(0.97)",
      "boxShadow": "0 4px 12px rgba(223, 94, 18, 0.25), 0 2px 4px rgba(223, 94, 18, 0.15)",
      "transition": "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "active": {
      "transform": "scale(0.93)",
      "boxShadow": "0 2px 6px rgba(223, 94, 18, 0.2)",
      "transition": "all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "easing": {
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "elastic": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
    "description": "Spring easing produces overshoot — elements snap past their target then settle, like clay being released"
  },
  "_twist": {
    "type": "D",
    "intensity": 4,
    "description": "Replaced all interaction easing with spring cubic-bezier(0.34, 1.56, 0.64, 1). Hover = scale(0.97) + shadow reduction (clay squish). Active = deeper squish scale(0.93) + lateral spread scaleX(1.03). Button shadows tinted to element color (burnt orange). Focus ring spring-animated outlineOffset.",
    "sourceSystem": "spun-ivory"
  }
}
