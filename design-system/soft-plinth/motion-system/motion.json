{
  "cssVars": {
    "motion-duration-instant": "80ms",
    "motion-duration-fast": "200ms",
    "motion-duration-base": "320ms",
    "motion-duration-slow": "500ms",
    "motion-duration-crawl": "800ms",
    "motion-duration-hero": "1000ms",
    "motion-easing-default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "motion-easing-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "motion-easing-elastic": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
    "motion-easing-in": "cubic-bezier(0.4, 0, 1, 1)",
    "motion-easing-out": "cubic-bezier(0, 0, 0.2, 1)",
    "motion-easing-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "transitions": {
    "micro": "80ms cubic-bezier(0.34, 1.56, 0.64, 1)",
    "base": "320ms cubic-bezier(0.34, 1.56, 0.64, 1)",
    "expand": "500ms cubic-bezier(0.34, 1.56, 0.64, 1)",
    "hero": "1000ms cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "keyframes": {
    "springIn": {
      "0%": { "opacity": "0", "transform": "scale(0.85) translateY(16px)" },
      "60%": { "opacity": "1", "transform": "scale(1.04) translateY(-4px)" },
      "80%": { "opacity": "1", "transform": "scale(0.98) translateY(1px)" },
      "100%": { "opacity": "1", "transform": "scale(1) translateY(0)" }
    },
    "clayInflate": {
      "0%": { "transform": "scale(0.88)", "opacity": "0" },
      "55%": { "transform": "scale(1.05)", "opacity": "1" },
      "75%": { "transform": "scale(0.97)" },
      "100%": { "transform": "scale(1)" }
    },
    "blobMorph": {
      "0%,100%": { "borderRadius": "60% 40% 30% 70% / 60% 30% 70% 40%" },
      "25%": { "borderRadius": "30% 60% 70% 40% / 50% 60% 30% 60%" },
      "50%": { "borderRadius": "50% 60% 30% 40% / 40% 30% 70% 70%" },
      "75%": { "borderRadius": "40% 50% 60% 30% / 70% 40% 50% 30%" }
    },
    "floatY": {
      "0%,100%": { "transform": "translateY(0px)" },
      "50%": { "transform": "translateY(-14px)" }
    }
  },
  "scrollReveal": {
    "defaultDelay": "0ms",
    "staggerStep": "60ms",
    "threshold": "0.15",
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "_twist": {
    "type": "C",
    "intensity": 4,
    "description": "Replaced all standard easing curves with spring/elastic variants. Every transition and keyframe uses cubic-bezier(0.34, 1.56, 0.64, 1) (spring) or cubic-bezier(0.68, -0.55, 0.265, 1.55) (elastic). Keyframes include 60-70% overshoot frames to produce clay-like bounce. Added blobMorph and clayInflate keyframes for Claymorphism.",
    "sourceSystem": "ivory-ledge"
  }
}
