{
  "geometry": {
    "height": "64px",
    "heightScrolled": "56px",
    "paddingInline": "34px",
    "position": "fixed",
    "top": "0",
    "zIndex": "100"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "16px",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
    "textTransform": "none",
    "lineHeight": "1.6"
  },
  "behavior": {
    "sticky": true,
    "scrolled": true,
    "scrollThreshold": "80px",
    "backdropBlur": "none",
    "transition": "all 0.32s cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "links": {
    "spacing": "32px",
    "decoration": "none",
    "hoverEffect": "scale(0.96)",
    "hoverTransition": "0.25s cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "logo": {
    "height": "32px",
    "hoverEffect": "scale(1.04)",
    "hoverTransition": "0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "mobile": {
    "breakpoint": "768px",
    "menuIcon": "hamburger",
    "menuAnimation": "spring-slide",
    "menuEasing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "_twist": {
    "type": "B",
    "intensity": 2,
    "description": "Letter spacing increased from 'normal' to 0.08em — wider tracking creates a more deliberate, tactile feel for navigation text, complementing the rounded Claymorphism aesthetic.",
    "sourceSystem": "pale-orison"
  }
}
