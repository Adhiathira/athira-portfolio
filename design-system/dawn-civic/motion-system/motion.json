{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "fadeIn",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "0"}},
          {"offset": "100%", "properties": {"opacity": "1"}}
        ]
      },
      {
        "name": "fadeOut",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "1"}},
          {"offset": "100%", "properties": {"opacity": "0"}}
        ]
      },
      {
        "name": "fadeInLeft",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "0", "transform": "translate3d(-100%, 0px, 0px)"}},
          {"offset": "100%", "properties": {"opacity": "1", "transform": "translate3d(0px, 0px, 0px)"}}
        ]
      },
      {
        "name": "fadeInRight",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "0", "transform": "translate3d(100%, 0px, 0px)"}},
          {"offset": "100%", "properties": {"opacity": "1", "transform": "translate3d(0px, 0px, 0px)"}}
        ]
      },
      {
        "name": "fadeInUp",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "0", "transform": "translate3d(0px, 100%, 0px)"}},
          {"offset": "100%", "properties": {"opacity": "1", "transform": "translate3d(0px, 0px, 0px)"}}
        ]
      },
      {
        "name": "fadeInDown",
        "steps": [
          {"offset": "0%", "properties": {"transform": "scaleY(0)", "transform-origin": "0px 0px"}},
          {"offset": "100%", "properties": {"transform": "scaleY(1)"}}
        ]
      },
      {
        "name": "slideInLeft",
        "steps": [
          {"offset": "0%", "properties": {"transform": "translate3d(-100%, 0px, 0px)", "visibility": "visible"}},
          {"offset": "100%", "properties": {"transform": "translate3d(0px, 0px, 0px)"}}
        ]
      },
      {
        "name": "slideInRight",
        "steps": [
          {"offset": "0%", "properties": {"transform": "translate3d(100%, 0px, 0px)", "visibility": "visible"}},
          {"offset": "100%", "properties": {"transform": "translate3d(0px, 0px, 0px)"}}
        ]
      },
      {
        "name": "zoomIn",
        "steps": [
          {"offset": "0%", "properties": {"opacity": "0", "transform": "scale3d(0.3, 0.3, 0.3)"}},
          {"offset": "50%", "properties": {"opacity": "1"}}
        ]
      },
      {
        "name": "loading",
        "steps": [
          {"offset": "0%", "properties": {"transform": "translate(-50%, -50%) rotate(0deg)"}},
          {"offset": "100%", "properties": {"transform": "translate(-50%, -50%) rotate(359.9deg)"}}
        ]
      }
    ],
    "transitionElements": [
      {
        "selector": ".header",
        "transition": {
          "property": "all",
          "duration": "1s",
          "timingFunction": "cubic-bezier(0.4, 0.0, 0.2, 1)"
        }
      },
      {
        "selector": ".nav-item",
        "transition": {
          "property": "opacity",
          "duration": "0.5s",
          "timingFunction": "cubic-bezier(0.4, 0.0, 0.2, 1)"
        }
      },
      {
        "selector": ".overlay",
        "transition": {
          "property": "background-color",
          "duration": "0.5s",
          "timingFunction": "cubic-bezier(0.4, 0.0, 0.2, 1)"
        }
      },
      {
        "selector": ".input-field",
        "transition": {
          "property": "background-position",
          "duration": "0.15s",
          "timingFunction": "ease-in-out"
        }
      }
    ],
    "timingTokens": {
      "durations": ["1s", "0.5s", "0.15s"],
      "easings": ["cubic-bezier(0.4, 0.0, 0.2, 1)", "ease-in-out"]
    }
  },
  "scrollAnimations": {
    "libraries": [],
    "elements": [],
    "parallaxElements": [],
    "patterns": ["slider", "slide", "modal-slide"]
  },
  "microInteractions": {
    "buttonTransitions": [
      {"selector": "button", "transition": "all", "transitionDuration": null},
      {"selector": "a", "transition": "all", "transitionDuration": null},
      {"selector": "button", "transition": "opacity 0.5s", "transitionDuration": "0.5s"}
    ],
    "customCursor": false,
    "hasSkeletonScreens": false
  }
}
