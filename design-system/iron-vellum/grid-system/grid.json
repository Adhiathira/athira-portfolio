{
  "_source": "griting",
  "_twist": "C. Container padding change (intensity 3, +12px): paddingInline 22px→34px. All other grid values unchanged.",
  "cssVars": {
    "--container-max-width": "1440px",
    "--container-padding-inline": "34px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1372px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "34px",
    "_twist": "paddingInline increased from 22px to 34px (intensity 3, +12px)"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0",
      "_note": "Full-bleed dark bg, text at bottom-left"
    },
    "ecosystem-cards": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "gritme-feature": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "unknown",
      "_note": "Left: text column, Right: product screenshot"
    },
    "testimonials": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    },
    "filter-pills": {
      "display": "flex",
      "gap": "8px",
      "columnCount": null
    },
    "blog-list": {
      "display": "flex",
      "flexDirection": "column",
      "columnCount": 1,
      "gap": null
    },
    "photoGrid": {
      "display": "absolute",
      "description": "Asymmetric two-column photo mosaic — left column 410px wide, right column 550px wide, staggered vertical offsets",
      "columnCount": 2,
      "gap": "staggered — not a uniform gap system"
    },
    "missionCentered": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "925px"
    },
    "bodyCopy": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "785px"
    },
    "fullBleed": {
      "display": "full-width",
      "description": "Background layers, globe image, CTA section — span full 1440px+",
      "columnCount": null
    },
    "tabBar": {
      "display": "flex",
      "justifyContent": "space-between",
      "width": "1146px",
      "height": "86px",
      "borderRadius": "20px"
    },
    "productSection": {
      "display": "grid",
      "templateColumns": "~33% 60%",
      "gap": "~64px"
    },
    "contentPanel": {
      "display": "flex",
      "flexDirection": "column",
      "width": "866px",
      "height": "640px",
      "borderRadius": "10px",
      "paddingInline": "~35px"
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  }
}
