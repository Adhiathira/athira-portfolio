{
  "_source": "hermes",
  "_twist": "B. Input border style change (intensity 3): bottom-only border (none none solid) → full border (solid, 1px) with border-radius: 4px added. Focus state updated to match. No color values changed.",
  "buttons": {
    "primary": {
      "default": {
        "opacity": "1",
        "cursor": "pointer",
        "transition": "all 0.2s ease-in-out"
      },
      "hover": {
        "opacity": "0.85",
        "transition": "all 0.2s ease-in-out"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    },
    "ghost": {
      "default": {
        "opacity": "1",
        "cursor": "pointer",
        "transition": "all 0.2s ease-in-out"
      },
      "hover": {
        "opacity": "0.8",
        "transition": "all 0.2s ease-in-out"
      }
    }
  },
  "inputs": {
    "default-input-1": {
      "selector": "#search-suggestion-field",
      "default": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "4px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "_twist": "Changed from bottom-only border (none none solid 0px 0px 1px) to full border (solid 1px) + border-radius 4px"
      },
      "focus": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "4px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "border 0.2s ease-in-out"
      }
    }
  },
  "links": {
    "nav-link": {
      "default": {
        "transition": "0.3s ease-in-out"
      },
      "hover": {
        "underline": {
          "type": "pseudo-element",
          "thickness": "1px",
          "animation": {
            "property": "width",
            "from": "0px",
            "to": "100%",
            "origin": "right to left",
            "duration": "0.3s",
            "easing": "ease-in-out"
          }
        }
      }
    },
    "inline-link": {
      "default": {
        "opacity": "1",
        "transition": "opacity 0.2s ease-in-out"
      },
      "hover": {
        "opacity": "0.7"
      }
    }
  },
  "cards": {
    "default": {
      "default": {
        "transition": "all 0.2s ease-in-out"
      },
      "hover": {
        "transform": "translateY(-2px)",
        "transition": "all 0.2s ease-in-out"
      }
    }
  },
  "navigation": {
    "scrollTransition": {
      "mechanism": "class-toggle",
      "triggerClass": "fixed",
      "duration": "0.3s",
      "easing": "ease-in-out",
      "colorInversion": false
    }
  }
}
