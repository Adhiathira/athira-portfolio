{
  "_source": "hermes",
  "_twist": "D. Letter spacing on nav links (intensity 3, 0.08em): typography.letterSpacing set to 0.08em — adds refined editorial air to the uppercase micro-text. All other nav properties unchanged.",
  "geometry": {
    "height": 50,
    "paddingInline": 0,
    "position": "static",
    "logoWidth": 20,
    "logoHeight": 20,
    "heightScrolled": 0,
    "itemSpacing": 24,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "transform 0.3s"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase",
    "lineHeight": "0.8125rem",
    "_twist": "letterSpacing set to 0.08em (intensity 3, was 'normal')"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "0.3s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "offset": "0px",
      "animation": {
        "property": "width",
        "from": "0px",
        "to": "100%",
        "origin": "right to left (inactive collapses right, expands left on hover)",
        "duration": "0.3s",
        "easing": "ease-in-out"
      }
    }
  },
  "linkActive": {
    "selector": ".category-link.active, .menu-link.active",
    "fontWeight": "400",
    "indicator": "underline via pseudo-element at full width"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "fixed",
    "propertiesChanged": [
      "position",
      "top",
      "left",
      "right",
      "background"
    ],
    "duration": "0.3s",
    "easing": "ease-in-out",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px",
    "boxShadow": null,
    "padding": "0px",
    "itemPadding": "0px 12px",
    "animation": "none declared"
  },
  "characterDescription": "An editorial navigation with spaced uppercase micro-typography at 0.08em — the wide letter spacing creates a deliberate pause between each character, giving the nav an archival, unhurried confidence. Hairline underline animations wipe from right-to-left on hover, snapping to full width on active state. The system operates at a luxury register without ornament."
}
