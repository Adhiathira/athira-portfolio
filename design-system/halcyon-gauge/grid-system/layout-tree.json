{
  "root": {
    "tag": "body",
    "background": "#f5f0e8",
    "children": [
      {
        "tag": "nav",
        "role": "site-navigation",
        "layout": "flex-row-space-between",
        "height": "72px",
        "position": "fixed",
        "background": "transparent",
        "backgroundScrolled": "#f5f0e8"
      },
      {
        "tag": "section",
        "role": "hero",
        "layout": "full-bleed",
        "paddingTop": "144px",
        "paddingBottom": "89px",
        "children": [
          { "tag": "div", "role": "bg-texture-layer", "class": "parallax-layers" },
          { "tag": "h1", "role": "heading", "font": "Cormorant Garamond 300", "class": "hero-title splitting-target" },
          { "tag": "p", "role": "subheading", "font": "Nunito 400" },
          { "tag": "a", "role": "cta-button", "variant": "primary" }
        ]
      },
      {
        "tag": "div",
        "role": "section-divider-1",
        "type": "svg-wave-sinusoidal"
      },
      {
        "tag": "section",
        "role": "instrument-bento",
        "layout": "bento-asymmetric",
        "background": "#ede7da",
        "children": [
          { "tag": "div", "role": "bento-large", "gridRow": "1/3" },
          { "tag": "div", "role": "bento-stat-1" },
          { "tag": "div", "role": "bento-stat-2" }
        ]
      },
      {
        "tag": "div",
        "role": "section-divider-2",
        "type": "svg-zigzag-angular"
      },
      {
        "tag": "section",
        "role": "catalog-grid",
        "layout": "three-column",
        "background": "#f5f0e8",
        "children": [
          { "tag": "h2", "role": "section-heading", "font": "Cormorant Garamond 400" },
          { "tag": "div", "role": "instrument-card", "repeat": 3 }
        ]
      },
      {
        "tag": "div",
        "role": "section-divider-3",
        "type": "svg-arch-inverted"
      },
      {
        "tag": "section",
        "role": "editorial-reading",
        "layout": "narrow-span",
        "background": "#ede7da",
        "children": [
          { "tag": "h3", "role": "label", "font": "Figtree 600 uppercase" },
          { "tag": "h2", "role": "section-heading", "font": "Cormorant Garamond 400 italic" },
          { "tag": "p", "role": "body-text", "font": "Nunito 400", "repeat": 3 }
        ]
      },
      {
        "tag": "div",
        "role": "section-divider-4",
        "type": "svg-diagonal-plane"
      },
      {
        "tag": "footer",
        "role": "site-footer",
        "layout": "grid-footer",
        "background": "#1a1814",
        "color": "#f5f0e8"
      }
    ]
  }
}
