{
  "_source": "weld-straw",
  "_agent": "interaction-states",
  "_twist": "weld-straw uses a warm orange button (#f37925) adapted for light register. Twist: introduced an inversion-swap pattern for the primary button — default state shows amber-clay fill (#b85c2a) with cream text, hover inverts to cream background with amber-clay text and amber border. This 'calibrated inversion' pattern mirrors how analog gauges show measurement — the state change is declarative, not decorative.",
  "buttons": {
    "primary-button": {
      "selector": "button.btn-primary, a.btn-primary",
      "default": {
        "backgroundColor": "#b85c2a",
        "color": "#f5f0e8",
        "borderColor": "#b85c2a",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineColor": "#b85c2a",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease"
      },
      "hover": {
        "backgroundColor": "#f5f0e8",
        "color": "#b85c2a",
        "borderColor": "#b85c2a",
        "borderWidth": "1px",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "_note": "TWIST: Inversion-swap — cream bg + amber text on hover"
      },
      "focus": {
        "outlineColor": "#b85c2a",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      },
      "active": {
        "backgroundColor": "#9a4b21",
        "color": "#f5f0e8"
      }
    },
    "ghost-button": {
      "selector": "button.btn-ghost, a.btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#1a1814",
        "borderColor": "#1a1814",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "background-color 0.2s ease, color 0.2s ease"
      },
      "hover": {
        "backgroundColor": "#1a1814",
        "color": "#f5f0e8",
        "borderColor": "#1a1814"
      },
      "focus": {
        "outlineColor": "#1a1814",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    },
    "utility-button": {
      "selector": "button.btn-utility",
      "default": {
        "backgroundColor": "#ede7da",
        "color": "#1a1814",
        "borderColor": "#cec8be",
        "borderWidth": "1px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "background-color 0.2s ease"
      },
      "hover": {
        "backgroundColor": "#e2dace",
        "color": "#1a1814"
      }
    }
  },
  "inputs": {
    "text-input": {
      "selector": "input[type='text'], input[type='email']",
      "default": {
        "color": "#1a1814",
        "backgroundColor": "#f5f0e8",
        "borderColor": "#cec8be",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineColor": "transparent",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "border-color 0.2s ease, box-shadow 0.2s ease"
      },
      "focus": {
        "color": "#1a1814",
        "borderColor": "#b85c2a",
        "outlineColor": "#b85c2a",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "0px",
        "boxShadow": "0 0 0 3px rgba(184, 92, 42, 0.15)"
      }
    }
  },
  "links": {
    "inline-link": {
      "selector": "a.inline-link",
      "default": {
        "color": "#b85c2a",
        "borderColor": "transparent",
        "textDecoration": "underline",
        "textDecorationColor": "rgba(184, 92, 42, 0.4)",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "color 0.2s ease, text-decoration-color 0.2s ease"
      },
      "hover": {
        "color": "#9a4b21",
        "textDecorationColor": "#9a4b21"
      }
    },
    "nav-link": {
      "selector": ".nav-link",
      "default": {
        "color": "#1a1814",
        "opacity": "0.8",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.2s ease"
      },
      "hover": {
        "opacity": "1",
        "color": "#1a1814"
      }
    }
  },
  "cards": {
    "instrument-card": {
      "selector": ".instrument-card",
      "default": {
        "backgroundColor": "#ede7da",
        "borderColor": "#cec8be",
        "borderWidth": "1px",
        "transition": "transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "transform": "translateY(-3px)",
        "boxShadow": "0 8px 32px rgba(26, 24, 20, 0.1)"
      }
    }
  },
  "navigation": {}
}
