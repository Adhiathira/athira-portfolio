{
  "geometry": {
    "height": 32,
    "heightScrolled": 32,
    "paddingInline": 0,
    "position": "absolute",
    "itemSpacing": 16,
    "logoPosition": "center",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "'Inter', system-ui, sans-serif",
    "fontSize": "1rem",
    "fontWeight": "500",
    "letterSpacing": "normal",
    "textTransform": "none",
    "lineHeight": "1.2"
  },
  "linkHover": {
    "opacity": 1,
    "backgroundPill": false,
    "transition": null,
    "underline": {
      "type": "text-decoration",
      "thickness": null,
      "offset": null
    }
  },
  "linkActive": {
    "selector": ".nav-link.w--current",
    "fontWeight": "500",
    "indicator": "underline"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "nav--scrolled",
    "propertiesChanged": [
      "color",
      "background-color",
      "padding-left",
      "padding-right"
    ],
    "duration": null,
    "easing": null,
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": "1.25rem",
    "boxShadow": null,
    "padding": "1.5rem 2rem",
    "itemPadding": "0px",
    "animation": null
  },
  "characterDescription": "Minimal dark-register navigation: Inter at medium weight, absolutely positioned transparent, logo centered for symmetry — the two link clusters flanking on either side like guards at a checkpoint. Height clamped at 32px for architectural precision.",
  "_twist": {
    "sourceSystem": "hydra",
    "type": "logo-center + height-clamp",
    "intensity": 4,
    "description": "logoPosition changed to center, height clamped to 32px (source was 21.1px; after -10px twist below usable threshold). Font fixed from Space Grotesk to Inter (Check C)."
  }
}
