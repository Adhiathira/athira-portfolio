{
  "cssVars": {
    "ds-container-max-width": "100vw",
    "ds-container-padding-left": "80px",
    "ds-container-padding-right": "20px"
  },
  "container": {
    "maxWidth": "100vw",
    "paddingLeft": "80px",
    "paddingRight": "20px"
  },
  "grids": {
    "main": {
      "display": "grid",
      "gridTemplateColumns": "repeat(12, 1fr)",
      "gap": "24px"
    },
    "asymmetric": {
      "display": "grid",
      "gridTemplateColumns": "80px 1fr 20px",
      "comment": "Full-bleed noir layout — content hugs the left, bleeds off the right"
    },
    "externalLink": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "normal 9.6px",
      "alignItems": "center",
      "childCount": "2"
    }
  },
  "responsive": {
    "bp-480px": {
      "query": "screen and (max-width: 480px)",
      "container": {
        "paddingLeft": "20px",
        "paddingRight": "20px"
      }
    },
    "bp-768px": {
      "query": "screen and (max-width: 768px)",
      "container": {
        "paddingLeft": "40px",
        "paddingRight": "20px"
      }
    }
  },
  "visual": [],
  "_twist": {
    "sourceSystem": "enpower-trading",
    "type": "full-bleed-asymmetric",
    "description": "Container set to 100vw with asymmetric padding 80px left / 20px right — content flush against left wall, the right edge bleeds off-frame like a crime scene photograph",
    "intensity": 4
  }
}
