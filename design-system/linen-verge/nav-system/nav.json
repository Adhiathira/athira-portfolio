{
  "geometry": {
    "height": 21.1171875,
    "paddingInline": 0,
    "position": "absolute",
    "itemSpacing": 16,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "\"Manrope\", sans-serif",
    "fontSize": "1rem",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
