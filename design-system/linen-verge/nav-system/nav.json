      "max-width",
      "padding-left",
      "padding-right",
      "z-index"
    ],
    "duration": null,
    "easing": null,
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": "1.25rem",
    "boxShadow": null,
    "padding": "1.5rem 2rem",
    "itemPadding": "0px",
    "animation": null
  },
  "characterDescription": "A minimal, typographically restrained navigation using Manrope at medium weight with 0.08em letter spacing, inheriting the type system's primary font rather than the source's Space Grotesk, with a transparent absolute positioning that inverts from dark to light on scroll via class toggle. The measured tracking gives nav links a quiet authority — open and considered, like text that knows it is being read.",
  "_twist": {
    "type": "letter-spacing-nav-links",
    "intensity": 3,
    "original": "normal",
    "result": "0.08em",
    "description": "Added 0.08em letter-spacing to nav link typography for a measured, editorial quality; font family updated from Space Grotesk to Manrope to match assembled type system"
  }
}
