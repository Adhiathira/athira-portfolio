{
  "_source": "vivid-block",
  "_twist": "Comic/Pop-Art spacing: bold generous internal padding for panels (comics breathe), tight external gutters between panels (comic page gutters are intentionally thin). Button padding wide for Bangers font.",
  "cssVars": {
    "--space-1": "8px",
    "--space-2": "16px",
    "--space-3": "24px",
    "--space-4": "32px",
    "--space-5": "48px",
    "--space-6": "64px",
    "--space-7": "80px",
    "--space-8": "120px",
    "--space-section-y": "80px",
    "--space-section-x": "clamp(1rem, 4vw, 2rem)",
    "--space-panel-padding": "32px",
    "--space-panel-gap": "4px",
    "--space-panel-gap-loose": "8px"
  },
  "elements": {
    "nav": {
      "height": "72px",
      "paddingInline": "32px"
    },
    "section": {
      "paddingTop": "80px",
      "paddingBottom": "80px"
    },
    "hero": {
      "paddingTop": "120px",
      "paddingBottom": "80px"
    },
    "footer": {
      "paddingTop": "64px",
      "paddingBottom": "64px",
      "paddingInline": "32px"
    },
    "button": {
      "paddingTop": "12px",
      "paddingRight": "32px",
      "paddingBottom": "12px",
      "paddingLeft": "32px",
      "note": "Wide horizontal padding for Bangers font — the letters are tall and need horizontal breathing room"
    },
    "panel": {
      "padding": "32px",
      "gap": "16px"
    },
    "card": {
      "padding": "32px",
      "gap": "16px"
    },
    "input": {
      "paddingTop": "12px",
      "paddingRight": "16px",
      "paddingBottom": "12px",
      "paddingLeft": "16px"
    }
  },
  "scale": {
    "name": "comic-panel-scale",
    "baseUnit": "8px",
    "steps": ["8px", "16px", "24px", "32px", "48px", "64px", "80px", "120px"],
    "note": "8px base unit. Panel padding (32px) is intentionally generous — comics need white space inside panels. Panel gaps (4px) are tight — comic gutters are thin."
  }
}
