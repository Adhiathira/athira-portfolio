{
  "_source": "copper-still",
  "_twist": "Comic/Pop-Art type overhaul: Bangers for all display/heading use (iconic comic book font), Comic Neue for body copy. Massive display sizes with letter-spacing for Bangers legibility. Bold, energetic, declarative.",
  "fontFaces": [
    {
      "family": "Bangers",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Bangers&display=swap",
      "resolvedName": "Bangers",
      "note": "Iconic comic book display font. Always weight 400 — this is its only weight. Requires letter-spacing 0.04–0.08em for legibility."
    },
    {
      "family": "Comic Neue",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap",
      "resolvedName": "Comic Neue",
      "note": "Humanist readable body font. The civilized evolution of Comic Sans — readable at body sizes."
    },
    {
      "family": "Comic Neue",
      "weight": "700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap",
      "resolvedName": "Comic Neue Bold"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "clamp(4rem, 8vw, 8rem)",
      "fontWeight": "400",
      "lineHeight": "1.0",
      "letterSpacing": "0.05em",
      "primaryFont": "Bangers",
      "note": "Hero headline. Massive, fills the comic panel. Letter-spacing is critical for Bangers."
    },
    "h2": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "clamp(2.5rem, 5vw, 4rem)",
      "fontWeight": "400",
      "lineHeight": "1.05",
      "letterSpacing": "0.04em",
      "primaryFont": "Bangers"
    },
    "h3": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "clamp(1.5rem, 3vw, 2rem)",
      "fontWeight": "400",
      "lineHeight": "1.1",
      "letterSpacing": "0.03em",
      "primaryFont": "Bangers"
    },
    "h4": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "1.25rem",
      "fontWeight": "400",
      "lineHeight": "1.2",
      "letterSpacing": "0.03em",
      "primaryFont": "Bangers"
    },
    "body": {
      "fontFamily": "Comic Neue, cursive",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0em",
      "primaryFont": "Comic Neue"
    },
    "p": {
      "fontFamily": "Comic Neue, cursive",
      "fontSize": "1.0625rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "primaryFont": "Comic Neue"
    },
    "label": {
      "fontFamily": "Comic Neue, cursive",
      "fontSize": "0.875rem",
      "fontWeight": "700",
      "lineHeight": "1.4",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase",
      "primaryFont": "Comic Neue Bold",
      "note": "Eyebrow/label text. Bold, uppercase, wide-tracked."
    },
    "button": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "1.25rem",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase",
      "primaryFont": "Bangers",
      "note": "Buttons use Bangers for that ZAP! energy. Wide letter-spacing."
    },
    "nav": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "1.125rem",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.06em",
      "textTransform": "uppercase",
      "primaryFont": "Bangers"
    },
    "stat": {
      "fontFamily": "Bangers, cursive",
      "fontSize": "clamp(3rem, 6vw, 6rem)",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.04em",
      "primaryFont": "Bangers",
      "note": "For stat numbers — massive Bangers in colored panels."
    }
  },
  "proprietaryFonts": []
}
