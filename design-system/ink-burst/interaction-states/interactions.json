{
  "_source": "vivid-block",
  "_twist": "Comic/Pop-Art interactions: spring scale on hover, hard offset shadow shifts direction on hover (comic depth), active press-down effect, bold dashed focus outline, spring easing throughout. box-shadow offset allowed (no blur).",
  "springEasing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
  "transitionBase": "0.2s cubic-bezier(0.34, 1.56, 0.64, 1)",
  "buttons": {
    "primary-button": {
      "default": {
        "backgroundColor": "#ff1744",
        "color": "#ffffff",
        "border": "3px solid #000000",
        "boxShadow": "4px 4px 0 #000000",
        "transform": "translate(0, 0)",
        "transition": "transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease"
      },
      "hover": {
        "backgroundColor": "#d50000",
        "transform": "translate(-2px, -2px) scale(1.02)",
        "boxShadow": "6px 6px 0 #000000",
        "note": "Shadow shifts to create lifted appearance — comic depth"
      },
      "active": {
        "transform": "translate(2px, 2px) scale(0.96)",
        "boxShadow": "2px 2px 0 #000000",
        "note": "Shadow shrinks on press — classic comic button press"
      },
      "focus": {
        "outline": "3px dashed #000000",
        "outlineOffset": "3px"
      },
      "disabled": {
        "opacity": "0.4",
        "cursor": "not-allowed",
        "transform": "none",
        "boxShadow": "none"
      }
    },
    "secondary-button": {
      "default": {
        "backgroundColor": "#ffeb3b",
        "color": "#000000",
        "border": "3px solid #000000",
        "boxShadow": "4px 4px 0 #000000",
        "transition": "transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "hover": {
        "transform": "translate(-2px, -2px) scale(1.02)",
        "boxShadow": "6px 6px 0 #000000"
      },
      "active": {
        "transform": "translate(2px, 2px) scale(0.96)",
        "boxShadow": "2px 2px 0 #000000"
      },
      "focus": {
        "outline": "3px dashed #000000",
        "outlineOffset": "3px"
      }
    }
  },
  "cards": {
    "comic-panel": {
      "default": {
        "border": "3px solid #000000",
        "boxShadow": "4px 4px 0 #000000",
        "transition": "transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "hover": {
        "transform": "translate(-3px, -3px)",
        "boxShadow": "7px 7px 0 #000000",
        "note": "Panel lifts — shadow expands"
      },
      "active": {
        "transform": "translate(1px, 1px)",
        "boxShadow": "3px 3px 0 #000000"
      }
    }
  },
  "links": {
    "nav-link": {
      "default": {
        "color": "#000000",
        "textDecoration": "none",
        "transition": "transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "hover": {
        "transform": "scale(1.05)",
        "textShadow": "2px 2px 0 #ff1744",
        "note": "Offset text shadow appears on hover — comic pop"
      }
    }
  },
  "inputs": {
    "text-input": {
      "default": {
        "border": "3px solid #000000",
        "boxShadow": "3px 3px 0 #000000",
        "transition": "box-shadow 0.2s ease"
      },
      "focus": {
        "outline": "3px dashed #000000",
        "outlineOffset": "2px",
        "boxShadow": "4px 4px 0 #ff1744"
      }
    }
  }
}
