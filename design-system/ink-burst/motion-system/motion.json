{
  "_source": "ember-round",
  "_twist": "Comic/Pop-Art motion overhaul: spring/bounce easing on everything, ZAP-in entrance, panel-slam, bounce scale, panel flip. All motion is energetic, snappy, over-the-top in the best comic way.",
  "springEasing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
  "gsapVersion": "3.12.5",
  "gsapCdn": "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js",
  "scrollTriggerCdn": "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js",
  "animations": {
    "zapIn": {
      "description": "ZAP entrance — element scales from 0 with slight rotation and snaps to position",
      "from": {
        "scale": 0,
        "rotation": 5,
        "opacity": 0
      },
      "to": {
        "scale": 1,
        "rotation": 0,
        "opacity": 1
      },
      "duration": 0.3,
      "ease": "back.out(2.5)",
      "note": "Use for hero headline, badges, speech bubbles appearing"
    },
    "bounce": {
      "description": "Bounce scale sequence — comic impact feel",
      "keyframes": [
        { "scale": 1, "duration": 0 },
        { "scale": 1.15, "duration": 0.1 },
        { "scale": 0.95, "duration": 0.1 },
        { "scale": 1.05, "duration": 0.1 },
        { "scale": 1, "duration": 0.1 }
      ],
      "totalDuration": 0.4,
      "note": "Use on hover or click events for interactive elements"
    },
    "panelSlam": {
      "description": "Panel slams into position from the left — comic panel reveal",
      "from": {
        "x": -100,
        "opacity": 0,
        "scale": 0.9
      },
      "to": {
        "x": 0,
        "opacity": 1,
        "scale": 1
      },
      "duration": 0.4,
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "note": "ScrollTrigger once:true. Use for feature cards entering viewport"
    },
    "panelFlip": {
      "description": "Comic panel page-turn effect — perspective rotateY",
      "from": {
        "rotationY": 90,
        "opacity": 0,
        "transformPerspective": 800
      },
      "to": {
        "rotationY": 0,
        "opacity": 1
      },
      "duration": 0.4,
      "ease": "back.out(1.5)",
      "note": "Use for panel-by-panel section reveals"
    },
    "slideInBold": {
      "description": "Bold slide in from left with overshoot spring",
      "from": {
        "x": -100,
        "opacity": 0
      },
      "to": {
        "x": 0,
        "opacity": 1
      },
      "duration": 0.4,
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "staggerReveal": {
      "description": "Staggered panel reveal for card grids",
      "stagger": 0.08,
      "from": {
        "y": 40,
        "opacity": 0,
        "scale": 0.92
      },
      "to": {
        "y": 0,
        "opacity": 1,
        "scale": 1
      },
      "duration": 0.35,
      "ease": "back.out(2)"
    }
  },
  "microInteractions": {
    "buttonHover": {
      "scale": 1.04,
      "duration": 0.2,
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "buttonActive": {
      "scale": 0.96,
      "duration": 0.1,
      "ease": "power2.in"
    },
    "cardHover": {
      "y": -4,
      "boxShadow": "6px 6px 0 #000000",
      "duration": 0.2,
      "ease": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "timing": {
    "fast": "0.2s",
    "standard": "0.3s",
    "emphasis": "0.4s",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  }
}
