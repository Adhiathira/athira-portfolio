{
  "cssVars": {
    "ds-duration-immediate": "0.05s",
    "ds-duration-fast": "0.05s",
    "ds-duration-base": "0.15s",
    "ds-duration-slow": "0.3s",
    "ds-duration-stagger": "0.04s",
    "ds-easing-default": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ds-easing-typewriter": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ds-easing-linear": "linear"
  },
  "keyframes": {
    "typewriter": {
      "0%": { "width": "0", "overflow": "hidden" },
      "100%": { "width": "100%", "overflow": "visible" }
    },
    "flicker": {
      "0%, 100%": { "opacity": "1" },
      "10%": { "opacity": "0.3" },
      "20%": { "opacity": "1" },
      "30%": { "opacity": "0.5" },
      "40%": { "opacity": "1" },
      "50%": { "opacity": "0.4" },
      "60%": { "opacity": "1" },
      "70%": { "opacity": "0.35" },
      "80%": { "opacity": "1" },
      "90%": { "opacity": "0.45" }
    },
    "xeroxReveal": {
      "0%": { "clip-path": "inset(100% 0 0 0)" },
      "20%": { "clip-path": "inset(80% 0 0 0)" },
      "40%": { "clip-path": "inset(60% 0 0 0)" },
      "60%": { "clip-path": "inset(40% 0 0 0)" },
      "80%": { "clip-path": "inset(20% 0 0 0)" },
      "100%": { "clip-path": "inset(0 0 0 0)" }
    },
    "bulge": {
      "0%": { "transform": "scale(1)" },
      "50%": { "transform": "scale(1.25)" },
      "100%": { "transform": "scale(1)" }
    },
    "stampIn": {
      "0%": { "transform": "scale(1.4)", "opacity": "0" },
      "100%": { "transform": "scale(1)", "opacity": "1" }
    }
  },
  "_twist": {
    "sourceSystem": "torn-press",
    "type": "easing-curve-swap",
    "intensity": 4,
    "description": "Twist C (easing curve swap), intensity 4. Every stepped easing that gave torn-press its mimeograph staccato — steps(1), steps(6, start), steps(6), steps(10) — is replaced with a single decisive editorial cubic-bezier(0.22, 1, 0.36, 1). Durations and keyframes are unchanged, so the same reveals now interpolate smoothly and land with a confident ease-out settle instead of snapping. The result reads as clean, professional editorial motion rather than a photocopier judder."
  }
}
