{
  "geometry": {
    "height": 153.5859375,
    "paddingInline": 0,
    "position": "relative",
    "itemSpacing": 16,
    "heightScrolled": 80,
    "logoPosition": "center",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": "rgba(0, 0, 0, 0.15) 0px 0.0625rem 0px 0px",
    "boxShadowScrolled": "transparent 0px -0.0625rem 0px 0px inset",
    "transition": "background-color 0.3s ease-out, color 0.3s ease-out, box-shadow 0.3s ease-out"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.05rem",
    "textTransform": "none",
    "lineHeight": "inherit"
  },
  "linkHover": {
    "fontWeight": "600",
    "backgroundPill": false,
    "transition": "opacity 0.3s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "0.125rem",
      "offset": "0",
      "animation": {
        "property": "width",
        "from": "0px",
        "to": "calc(100% - 1.45rem)",
        "origin": "right",
        "duration": "0.4s",
        "easing": "ease-in"
      }
    }
  },
  "linkActive": {
    "selector": ".header-flyout__anchor.level-1.mega-item--active",
    "fontWeight": "600",
    "indicator": "pseudo-element underline expanding from right to left"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "fixit--scrolled",
    "propertiesChanged": [
      "margin-top",
      "background-color",
      "box-shadow",
      "color"
    ],
    "duration": "0.3s",
    "easing": "ease-out",
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0",
    "boxShadow": "rgba(0, 0, 0, 0.15) 0px 0.0625rem 0px 0px inset",
    "padding": "1.675rem 0 1.875rem",
    "itemPadding": "0.75em 1.25em",
    "animation": "max-height 0.3s ease-in, opacity 0.3s ease-in 0.2s, visibility 0.3s ease-in 0.2s"
  },
  "characterDescription": "A luxury retail navigation system with a disciplined, architectural restraint — full-width mega-menu panels slide open with precise timing choreography, active states revealed through an expanding underline indicator rather than background fills. The hide-on-scroll behavior and transparent blend mode for hero pages signal a brand that treats the navigation as a frame, not a feature."
}
