{
  "meta": {
    "site": "half-tone",
    "extractor": "interaction-states",
    "description": "Precise, intentional interactions — every hover state has editorial deliberateness"
  },
  "button": {
    "hover": {
      "transform": "translateY(-2px)",
      "box_shadow": "0 8px 24px rgba(201, 74, 53, 0.3)",
      "duration": "300ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "active": {
      "opacity": 0.75,
      "transform": "none",
      "note": "Active state removes lift, reduces opacity — no scale distortion"
    },
    "focus": {
      "outline": "1px solid #c94a35",
      "outline_offset": "3px"
    }
  },
  "link": {
    "hover": {
      "color": "#c94a35",
      "underline": "scaleX reveal from left (0 → 1), 300ms",
      "duration": "300ms"
    },
    "focus": {
      "outline": "1px solid #c94a35",
      "outline_offset": "3px"
    }
  },
  "nav_link": {
    "hover": {
      "letter_spacing_delta": "+0.02em",
      "duration": "300ms",
      "note": "Subtle expansion — tactile, not dramatic"
    }
  },
  "panel": {
    "hover": "none",
    "note": "Panels do NOT respond to hover — they are structural, not interactive"
  },
  "card": {
    "hover": {
      "transform": "translateY(-4px)",
      "box_shadow": "0 12px 32px rgba(26, 23, 20, 0.12)",
      "duration": "300ms"
    }
  }
}
