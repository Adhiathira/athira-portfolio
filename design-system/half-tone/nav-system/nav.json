{
  "meta": {
    "site": "half-tone",
    "extractor": "nav-system",
    "description": "Minimal fixed nav — transparent over hero dark panel, fills with vellum on scroll"
  },
  "height": "68px",
  "position": "fixed",
  "z_index": 100,
  "layout": {
    "logo": "left-aligned",
    "links": "right-aligned",
    "logo_typeface": "Cormorant Garamond 600 1.5rem",
    "links_typeface": "Inter 0.8125rem tracking 0.06em uppercase"
  },
  "default_state": {
    "background": "transparent",
    "border_bottom": "none",
    "text_color": "#ffffff",
    "note": "Hero has dark left panel — nav text is white by default"
  },
  "scrolled_state": {
    "background": "rgba(244, 240, 235, 0.95)",
    "border_bottom": "1px solid rgba(26, 23, 20, 0.08)",
    "text_color": "#1a1714",
    "backdrop_filter": "blur(8px)",
    "scroll_threshold": "40px"
  },
  "links": [
    { "label": "Work", "href": "work.html" },
    { "label": "About", "href": "about.html" },
    { "label": "Contact", "href": "contact.html" },
    { "label": "Order a Book", "href": "contact.html", "style": "cta", "color": "#c94a35" }
  ],
  "mobile": {
    "breakpoint": "768px",
    "pattern": "hamburger → fullscreen overlay",
    "overlay_bg": "#f4f0eb",
    "links_font_size": "2rem"
  }
}
