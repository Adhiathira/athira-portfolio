{
  "meta": {
    "site": "half-tone",
    "extractor": "type-system",
    "description": "Editorial dual-typeface system: Cormorant Garamond for display gravity, Inter for body precision"
  },
  "fonts": {
    "display": {
      "family": "Cormorant Garamond",
      "fallback": "Georgia, serif",
      "weights": [300, 600],
      "source": "Google Fonts",
      "import_url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300;1,600&display=swap",
      "usage": "Headlines, display titles, editorial pull quotes"
    },
    "body": {
      "family": "Inter",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "weights": [300, 400, 500],
      "source": "Google Fonts",
      "import_url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap",
      "usage": "Body copy, nav, captions, metadata"
    }
  },
  "scale": {
    "h1": {
      "font_family": "Cormorant Garamond",
      "font_size": "clamp(4.5rem, 9vw, 11rem)",
      "line_height": 0.95,
      "letter_spacing": "-0.03em",
      "font_weight": 300,
      "usage": "Hero display title, section statements"
    },
    "h2": {
      "font_family": "Cormorant Garamond",
      "font_size": "clamp(2.5rem, 5vw, 5rem)",
      "line_height": 1.0,
      "letter_spacing": "-0.02em",
      "font_weight": 600,
      "usage": "Section headings, work titles"
    },
    "h3": {
      "font_family": "Cormorant Garamond",
      "font_size": "1.5rem",
      "line_height": 1.2,
      "letter_spacing": "-0.01em",
      "font_weight": 600,
      "usage": "Sub-headings, card titles"
    },
    "body": {
      "font_family": "Inter",
      "font_size": "1rem",
      "line_height": 1.75,
      "letter_spacing": "0",
      "font_weight": 300,
      "usage": "Paragraph copy, descriptions"
    },
    "caption": {
      "font_family": "Inter",
      "font_size": "0.75rem",
      "line_height": 1.5,
      "letter_spacing": "0.14em",
      "font_weight": 400,
      "text_transform": "uppercase",
      "usage": "Labels, captions, metadata, edition info"
    },
    "nav": {
      "font_family": "Inter",
      "font_size": "0.8125rem",
      "line_height": 1,
      "letter_spacing": "0.06em",
      "font_weight": 400,
      "text_transform": "uppercase",
      "usage": "Navigation links"
    },
    "large_number": {
      "font_family": "Cormorant Garamond",
      "font_size": "clamp(5rem, 12vw, 14rem)",
      "line_height": 0.9,
      "letter_spacing": "-0.04em",
      "font_weight": 300,
      "usage": "Editorial year markers, section numbers"
    }
  }
}
