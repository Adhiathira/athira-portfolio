{
  "geometry": {
    "height": 72,
    "heightScrolled": 52,
    "paddingInline": 22,
    "position": "sticky",
    "top": 0,
    "logoPosition": "center",
    "alignment": "split-wing",
    "_note": "Split-wing layout: nav items flank the centered logo — [Product, About] on left, [Contact, Blog] on right. Height condenses on scroll."
  },
  "background": {
    "color": "transparent",
    "colorScrolled": "rgba(0, 0, 0, 0.55)",
    "backdropFilter": null,
    "backdropFilterScrolled": "blur(14px) saturate(160%)",
    "borderBottom": null,
    "borderBottomScrolled": "1px solid rgba(255,255,255,0.08)"
  },
  "typography": {
    "fontFamily": "DM Sans",
    "fontSize": "16px",
    "fontWeight": "400",
    "letterSpacing": "-0.01em",
    "textTransform": "none"
  },
  "logo": {
    "fontFamily": "DM Sans",
    "fontWeight": "600",
    "fontSize": "36px",
    "letterSpacing": "-1.61px",
    "color": "#ffffff",
    "text": "riting",
    "_note": "Logo is 'riting' (lowercase) with a small brand icon to its left. Now centered in split-wing layout."
  },
  "items": ["Product", "About", "Contact", "Blog"],
  "itemLayout": {
    "left": ["Product", "About"],
    "right": ["Contact", "Blog"]
  },
  "itemGap": "36px",
  "transition": {
    "property": "height, background-color, backdrop-filter, border-bottom",
    "duration": "280ms",
    "easing": "ease"
  },
  "_consistencyFix": "fontFamily changed from 'Inter' to 'DM Sans' to match assembled type system (Check C fix)"
}
