{
  "cssVars": {
    "--grid-columns": "12",
    "--grid-gutter": "24px",
    "--grid-margin": "48px",
    "--grid-column-gap": "24px",
    "--grid-row-gap": "48px",
    "--grid-container-max": "1280px",
    "--grid-asymmetric-left": "5fr 7fr",
    "--grid-asymmetric-right": "7fr 5fr",
    "--grid-dense-columns": "4"
  },
  "container": {
    "maxWidth": "1280px",
    "paddingInline": "48px",
    "marginInline": "auto",
    "display": "grid",
    "gridTemplateColumns": "repeat(12, 1fr)",
    "columnGap": "24px"
  },
  "grids": {
    "full": {
      "gridColumn": "1 / -1",
      "description": "Full-width spanning all 12 columns — used for hero text, screenshot, and CTA band sections"
    },
    "asymmetric-left": {
      "gridTemplateColumns": "5fr 7fr",
      "columnGap": "24px",
      "description": "Left-weighted 2-column split (~40/60) — text left, product UI right"
    },
    "asymmetric-right": {
      "gridTemplateColumns": "7fr 5fr",
      "columnGap": "24px",
      "description": "Right-weighted 2-column split (~60/40) — product UI left, text right"
    },
    "dense-4": {
      "gridTemplateColumns": "repeat(4, 1fr)",
      "columnGap": "24px",
      "rowGap": "24px",
      "description": "4-column equal grid for card/icon grids"
    },
    "footer-5": {
      "gridTemplateColumns": "2fr 1fr 1fr 1fr 1fr",
      "columnGap": "24px",
      "description": "Footer 5-column layout: wide brand column + 4 equal link columns"
    }
  },
  "responsive": {
    "bp-425px": {
      "query": "only screen and (max-width: 425px)",
      "maxWidth": "100%",
      "display": "inline"
    },
    "bp-426px": {
      "query": "only screen and (min-width: 426px) and (max-width: 896px)",
      "maxWidth": "94%"
    },
    "bp-480px": {
      "query": "screen and (min-width: 480px)",
      "display": "none",
      "flexDirection": "row",
      "rowGap": "unset",
      "columnGap": "unset",
      "flexWrap": "nowrap"
    },
    "bp-530px": {
      "query": "only screen and (max-width: 530px)",
      "display": "block"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "maxWidth": "80%",
      "display": "inline-block",
      "gridTemplateColumns": "1fr",
      "asymmetricOverride": "stack"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "maxWidth": "60%",
      "gridTemplateColumns": "1fr",
      "asymmetricOverride": "stack"
    },
    "bp-768px": {
      "query": "screen and (min-width: 768px)",
      "display": "none",
      "flexDirection": "row",
      "rowGap": "unset",
      "columnGap": "unset",
      "flexWrap": "nowrap",
      "maxWidth": "116px",
      "gridMargin": "32px",
      "gridGutter": "16px"
    },
    "bp-812px": {
      "query": "screen and (min-width: 812px)",
      "flexDirection": "row",
      "gridTemplateColumns": "repeat(2, 1fr)"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-horizontal-bar",
      "description": "Fixed top navigation with logo centered (split-wing), items flanking left and right."
    },
    {
      "section": "hero",
      "layout": "full-width-centered-text",
      "description": "Full-viewport dark background with oversized left-aligned headline text spanning nearly the full width."
    },
    {
      "section": "product-demo-split",
      "layout": "asymmetric-left",
      "description": "Left column (~40% width) has large stacked headline text with CTAs; right column (~60% width) shows product UI."
    },
    {
      "section": "train-ai-split",
      "layout": "asymmetric-right",
      "description": "Left column shows UI card; right column has large headline text with CTA, reversing the column order."
    },
    {
      "section": "dense-features",
      "layout": "dense-4",
      "description": "4-column equal grid for feature cards, icon grids, or embed format variants."
    },
    {
      "section": "footer",
      "layout": "footer-5",
      "description": "Wide brand column on far left and four link columns."
    }
  ]
}
