{
  "cssVars": {
    "ds-font-family-display": "'VT323', monospace",
    "ds-font-family-heading": "'IBM Plex Mono', monospace",
    "ds-font-family-body": "'JetBrains Mono', monospace",
    "ds-font-family-mono": "'JetBrains Mono', monospace",
    "ds-font-size-3xl": "88px",
    "ds-font-size-2xl": "56px",
    "ds-font-size-xl": "40px",
    "ds-font-size-lg": "28px",
    "ds-font-size-md": "20px",
    "ds-font-size-base": "15px",
    "ds-font-size-sm": "13px",
    "ds-font-size-xs": "11px",
    "ds-font-weight-thin": "300",
    "ds-font-weight-regular": "400",
    "ds-font-weight-medium": "500",
    "ds-font-weight-semibold": "600",
    "ds-font-weight-bold": "700",
    "ds-line-height-tight": "1.1",
    "ds-line-height-snug": "1.3",
    "ds-line-height-normal": "1.5",
    "ds-line-height-relaxed": "1.7",
    "ds-letter-spacing-tight": "-0.01em",
    "ds-letter-spacing-normal": "0em",
    "ds-letter-spacing-wide": "0.05em",
    "ds-letter-spacing-wider": "0.1em",
    "ds-letter-spacing-widest": "0.15em"
  },
  "fontFaces": [
    {
      "role": "display",
      "resolvedName": "VT323",
      "weights": ["400"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=VT323&display=swap"
    },
    {
      "role": "heading",
      "resolvedName": "IBM Plex Mono",
      "weights": ["400", "500", "600", "700"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    },
    {
      "role": "body",
      "resolvedName": "JetBrains Mono",
      "weights": ["400", "500"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
    }
  ],
  "scale": {
    "h1": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "88px",
      "fontWeight": "400",
      "lineHeight": "1.0",
      "letterSpacing": "0.02em",
      "textTransform": "uppercase"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "40px",
      "fontWeight": "600",
      "lineHeight": "1.1",
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "28px",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "h4": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "20px",
      "fontWeight": "500",
      "lineHeight": "1.3",
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "15px",
      "fontWeight": "400",
      "lineHeight": "1.7",
      "letterSpacing": "0em"
    },
    "small": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "13px",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0em"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "11px",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.15em",
      "textTransform": "uppercase"
    },
    "mono": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "13px",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0em"
    }
  },
  "_twist": {
    "sourceSystem": "cerulean-draft",
    "intensity": 4,
    "twistDescription": "Replaced geometric sans system with full terminal/glitch typographic stack. VT323 400 (88px, uppercase, 0.02em tracking) as pixel-display headline — CRT terminal aesthetic. IBM Plex Mono 600 uppercase for h2/h3/h4 (5em tracking, wide intervals). JetBrains Mono 400 body (15px, 1.7 line-height) — developer font optimized for dark-background legibility. All fonts monospaced — no proportional type. Three Google Fonts CDN imports."
  }
}
