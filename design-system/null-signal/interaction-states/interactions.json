{
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#fd356e",
        "color": "#ffffff",
        "borderColor": "#fd356e",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontFamily": "'IBM Plex Mono', monospace",
        "fontWeight": "600",
        "fontSize": "13px",
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.15s ease-out"
      },
      "hover": {
        "backgroundColor": "#fd356e",
        "color": "#ffffff",
        "borderColor": "#fd356e",
        "boxShadow": "0 0 8px rgba(253, 53, 110, 0.6), 0 0 16px rgba(253, 53, 110, 0.3)",
        "transition": "all 0.15s ease-out"
      },
      "active": {
        "transform": "scale(0.97)",
        "transition": "all 0.1s ease-out"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "2px",
        "outlineColor": "#fd356e",
        "outlineStyle": "solid",
        "boxShadow": "0 0 0 2px rgba(253, 53, 110, 0.3)",
        "transition": "all 0.15s ease-out"
      }
    },
    "ghost": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#fd356e",
        "borderColor": "#fd356e",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontFamily": "'IBM Plex Mono', monospace",
        "fontWeight": "600",
        "fontSize": "13px",
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.15s ease-out"
      },
      "hover": {
        "backgroundColor": "rgba(253, 53, 110, 0.08)",
        "color": "#fd356e",
        "borderColor": "#fd356e",
        "boxShadow": "0 0 8px rgba(253, 53, 110, 0.4)",
        "transition": "all 0.15s ease-out"
      },
      "active": {
        "transform": "scale(0.97)",
        "transition": "all 0.1s ease-out"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "2px",
        "outlineColor": "#fd356e",
        "outlineStyle": "solid",
        "transition": "all 0.15s ease-out"
      }
    }
  },
  "inputs": {
    "default": {
      "backgroundColor": "#252529",
      "color": "#acacaf",
      "borderColor": "rgba(172, 172, 175, 0.25)",
      "borderWidth": "1px",
      "transition": "all 0.15s ease-out"
    },
    "focus": {
      "outlineWidth": "1px",
      "outlineOffset": "2px",
      "outlineColor": "#fd356e",
      "outlineStyle": "solid",
      "boxShadow": "0 0 0 2px rgba(253, 53, 110, 0.2)",
      "transition": "all 0.15s ease-out"
    }
  },
  "links": {
    "default": {
      "color": "#acacaf",
      "textDecoration": "none",
      "backgroundImage": "linear-gradient(to right, #fd356e, #fd356e)",
      "backgroundPosition": "0% 100%",
      "backgroundSize": "0% 1px",
      "backgroundRepeat": "no-repeat",
      "transition": "all 0.15s ease-out"
    },
    "hover": {
      "color": "#fd356e",
      "backgroundSize": "100% 1px",
      "transition": "all 0.15s ease-out"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid rgba(172, 172, 175, 0.12)",
      "boxShadow": "none",
      "transition": "all 0.15s ease-out"
    },
    "hover": {
      "border": "1px solid rgba(253, 53, 110, 0.4)",
      "boxShadow": "0 0 8px rgba(253, 53, 110, 0.15)",
      "transform": "translateY(-1px)",
      "transition": "all 0.15s ease-out"
    }
  },
  "navigation": {
    "link": {
      "default": {
        "color": "#acacaf",
        "opacity": "1",
        "backgroundImage": "linear-gradient(to right, #fd356e, #fd356e)",
        "backgroundPosition": "0% 100%",
        "backgroundSize": "0% 1px",
        "backgroundRepeat": "no-repeat",
        "transition": "all 0.15s ease-out"
      },
      "hover": {
        "color": "#fd356e",
        "backgroundSize": "100% 1px",
        "transition": "all 0.15s ease-out"
      },
      "active": {
        "color": "#fd356e",
        "fontWeight": "700",
        "backgroundSize": "100% 1px"
      }
    }
  },
  "_twist": {
    "sourceSystem": "lo-and-behold",
    "intensity": 4,
    "twistDescription": "Fast mechanical interactions — 0.15s ease-out for all states (vs 0.3–0.55s editorial). Buttons: neon glow box-shadow on hover (0 0 8px rgba(253,53,110,0.6)) for primary, (0 0 8px rgba(253,53,110,0.4)) for ghost. Links: magenta drawn-in underlines. Cards: translateY(-1px) with neon border glow. Active: scale(0.97). Focus: 1px magenta outline at 2px offset. All IBM Plex Mono uppercase typography on buttons. Machine-like precision — no organic ease."
  }
}
