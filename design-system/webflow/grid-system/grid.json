  "visual": [
    {
      "section": "announcement-bar",
      "layout": "full-width-centered",
      "description": "Single-row blue banner spanning full viewport width with centered text and inline arrow link."
    },
    {
      "section": "nav",
      "layout": "3-zone-horizontal",
      "description": "Sticky navigation with logo anchored left, nav links grouped in the center, and auth/CTA buttons anchored right."
    },
    {
      "section": "hero",
      "layout": "full-width-centered",
      "description": "Full-width centered heading and subtext with no image background, followed immediately by a horizontal row of 3 equal-width option cards below."
    },
    {
      "section": "hero-option-cards",
      "layout": "3-column-equal",
      "description": "Three equal-width cards (one partially clipped at left edge) presented in a horizontal row beneath the hero headline, each with label, body text, and an illustrative screenshot thumbnail."
    },
    {
      "section": "editor-showcase",
      "layout": "full-width-image",
      "description": "Full-viewport-width product UI screenshot used as a visual section break, with no text overlay."
    },
    {
      "section": "feature-pillars",
      "layout": "3-column-equal",
      "description": "Three equal-width columns each containing a landscape image, bold heading, body paragraph, and an underlined arrow link."
    },
    {
      "section": "brand-statement",
      "layout": "full-width-text-left",
      "description": "Dark full-bleed section with a large bold multi-line headline left-aligned and occupying the full width, no opposing column."
    },
    {
      "section": "social-proof-carousel",
      "layout": "horizontal-scroll-3-up",
      "description": "Full-width carousel showing 3 dark testimonial cards side-by-side with left/right navigation arrows anchored at the top right of the section heading."
    },
    {
      "section": "persona-features",
      "layout": "2-column-sidebar-content",
      "description": "Left narrow sidebar contains muted category labels (Agility, Impact, Collaboration); right wider column shows an expandable feature list with a product screenshot floating to the far right."
    },
    {
      "section": "cta-footer",
      "layout": "full-width-centered-dark",
      "description": "Dark full-bleed section with a large centered heading, single-line subtext, and two side-by-side CTA buttons centered horizontally."
    }
  ]
