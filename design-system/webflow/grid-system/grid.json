  "responsive": {
    "bp-479px": {
      "query": "screen and (max-width: 479px)",
      "maxWidth": "none",
      "display": "inherit",
      "rowGap": "0px",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "gridTemplateColumns": "1fr 1fr",
      "columnGap": "1rem",
      "gridTemplateRows": "auto"
    },
    "bp-767px": {
      "query": "screen and (max-width: 767px)",
      "display": "inherit",
      "rowGap": "0rem",
      "flexDirection": "row",
      "flexWrap": "nowrap",
      "maxWidth": "100%",
      "columnGap": "var(--_layout---spacing--margin-md)",
      "gridTemplateRows": "auto auto",
      "gridTemplateColumns": "1fr 1fr"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "96vw",
      "display": "block"
    },
    "bp-991px": {
      "query": "screen and (max-width: 991px)",
      "maxWidth": "728px",
      "display": "inherit",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "rowGap": "0rem",
      "columnGap": "1rem",
      "gridTemplateRows": "auto auto",
      "gridTemplateColumns": "1fr 1fr"
    },
    "bp-992px": {
      "query": "(min-width: 992px)",
      "display": "block"
    }
  },
  "visual": [
    {
      "section": "announcement-bar",
      "layout": "full-width-single-row",
      "description": "A slim full-width banner with centered text and an arrow link, sitting above the main navigation."
    },
    {
      "section": "primary-nav",
      "layout": "full-width-split-horizontal",
      "description": "Logo and primary nav links left-aligned, with secondary actions (Log in, Contact Sales, CTA button) right-aligned in a single horizontal row."
    },
    {
      "section": "hero",
      "layout": "full-width-centered-text-with-3-column-cards",
      "description": "Centered headline and subtext above a horizontal row of three equal-width feature cards (AI site builder, Template, Blank site), each card containing a label, description, and preview image."
    },
    {
      "section": "logo-strip",
      "layout": "full-width-horizontal-scroll-row",
      "description": "A dark marquee-style row of customer brand logos displayed in a single horizontal line spanning the full viewport width."
    },
    {
      "section": "feature-showcase-3col",
      "layout": "3-column-equal-with-images",
      "description": "Three equal-width columns each containing a large editorial image with an overlaid stat, quote, and attribution at the bottom."
    },
    {
      "section": "editorial-statement",
      "layout": "full-width-centered-text-with-cta",
      "description": "Centered large-body paragraph text with a single blue CTA button below it, flanked by generous white space."
    },
    {
      "section": "testimonial-carousel",
      "layout": "full-width-horizontal-scroll",
      "description": "A large-text partial headline bleeds off screen on the left while a multi-slide carousel of customer testimonial cards occupies the full width."
    },
    {
      "section": "feature-detail-split",
      "layout": "2-column-text-left-image-right",
      "description": "Left column contains a category label and a vertical list of expandable feature links; right column shows a large product UI screenshot with a colorful gradient background."
    },
    {
      "section": "feature-detail-split-2",
      "layout": "2-column-text-left-image-right",
      "description": "Same two-column pattern continues for a second feature category (Scale), with descriptive text and feature links on the left and a dark analytics dashboard UI on the right."
    },
    {
      "section": "competitive-cta-dark",
      "layout": "full-width-centered-overlay",
      "description": "Full-bleed dark section with centered headline, subtext, and two CTAs overlaid on a blurred gradient background with a floating product UI mockup below."
    },
    {
      "section": "footer",
      "layout": "4-column-link-grid",
      "description": "Four equal-width columns (Product, Solutions, Company, Community) each containing a bold category heading and a vertical list of text links below it."
    }
  ]
