{
  "containerWidth": "1280px",
  "containerPadding": "40px",
  "columns": 12,
  "gutter": "32px",
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1440px"
  },
  "layouts": {
    "paperStack": {
      "description": "Each section overlaps the next by 40px using negative margin-bottom",
      "sectionOverlap": "-40px",
      "zIndexIncrement": 1
    },
    "layerGrid": {
      "description": "12-col grid, cards at staggered z-index for depth perception",
      "columns": 12,
      "cardZIndexBase": 1,
      "cardZIndexStep": 1
    },
    "featureGrid": {
      "description": "3 layers stacked, alternating wider/narrower columns",
      "layout": [
        { "col": "7/12", "label": "primary" },
        { "col": "5/12", "label": "secondary" }
      ]
    },
    "hero": {
      "description": "Single centered column, layered paper shapes absolutely positioned behind headline",
      "maxWidth": "720px",
      "textAlign": "center",
      "layerCount": 5
    }
  }
}
