{
  "theme": "paper-cut-layered",
  "patterns": {
    "layerRise": {
      "description": "Z-index layers appear bottom-to-top in sequence, simulating paper stack assembly",
      "from": { "y": 30, "autoAlpha": 0 },
      "to": { "y": 0, "autoAlpha": 1 },
      "duration": 0.6,
      "stagger": 0.1,
      "ease": "power2.out"
    },
    "paperSlide": {
      "description": "Elements translate from underneath with shadow intensifying as they arrive",
      "from": { "y": 20, "autoAlpha": 0 },
      "to": { "y": 0, "autoAlpha": 1 },
      "duration": 0.5,
      "ease": "power2.out"
    },
    "cutReveal": {
      "description": "Clip-path geometric shape opens like a paper cut revealing content beneath",
      "from": { "clipPath": "polygon(50% 0%, 50% 0%, 50% 100%, 50% 100%)" },
      "to": { "clipPath": "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
      "duration": 0.6,
      "ease": "power2.inOut"
    },
    "shadowIntensify": {
      "description": "Box-shadow deepens on scroll entry as card rises into view",
      "fromShadow": "0 2px 8px rgba(26,20,16,0.04)",
      "toShadow": "0 8px 32px rgba(26,20,16,0.15)",
      "duration": 0.5,
      "ease": "power2.out"
    },
    "gentleFloat": {
      "description": "Cards breathe on hover with slight vertical translation",
      "y": -8,
      "duration": 0.35,
      "ease": "power2.out"
    }
  },
  "timingTokens": {
    "durations": ["0.4s", "0.5s", "0.6s"],
    "easings": ["power2.out", "power2.inOut", "ease-out"],
    "stagger": "0.1s",
    "hoverTransition": "0.35s ease-out"
  },
  "scrollTrigger": {
    "start": "top 80%",
    "once": true,
    "scrub": false
  },
  "reducedMotion": {
    "layerRise": { "duration": 0, "stagger": 0 },
    "paperSlide": { "duration": 0 },
    "cutReveal": { "duration": 0 }
  }
}
