{
  "hover": {
    "card": {
      "transform": "translateY(-8px)",
      "boxShadow": "0 12px 40px rgba(26, 20, 16, 0.22)",
      "transition": "0.35s ease-out"
    },
    "button": {
      "transform": "translateY(-2px)",
      "boxShadow": "0 4px 16px rgba(26, 20, 16, 0.20)",
      "transition": "0.35s ease-out"
    },
    "navLink": {
      "color": "#c65d3a",
      "transition": "0.2s ease-out"
    }
  },
  "focus": {
    "outline": "2px solid #c65d3a",
    "outlineOffset": "3px",
    "transition": "0.15s ease-out"
  },
  "active": {
    "transform": "translateY(0px)",
    "boxShadow": "0 2px 8px rgba(26, 20, 16, 0.10)"
  },
  "transitions": {
    "default": "0.35s ease-out",
    "fast":    "0.2s ease-out",
    "slow":    "0.5s ease-out"
  },
  "boxShadows": {
    "layerSm":    "0 2px 8px rgba(26, 20, 16, 0.08)",
    "layerMd":    "0 4px 20px rgba(26, 20, 16, 0.10)",
    "layerLg":    "0 8px 32px rgba(26, 20, 16, 0.15)",
    "layerHover": "0 12px 40px rgba(26, 20, 16, 0.22)"
  }
}
