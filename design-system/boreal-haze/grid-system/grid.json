{
  "cssVars": {
    "--grid-columns": "12",
    "--grid-gap": "28px",
    "--container-max-width": "1480px",
    "--container-padding-inline": "32px"
  },
  "container": {
    "maxWidth": "1480px",
    "paddingLeft": "32px",
    "paddingRight": "32px",
    "paddingInline": "32px"
  },
  "grids": {
    "standard": {
      "columns": 12,
      "gap": "28px",
      "description": "12-column grid with 28px gap — wider canvas for aurora gradient meshes."
    },
    "hero-full-bleed": {
      "columns": 1,
      "gap": "0px",
      "description": "Single-column full-bleed layout for wide hero sections."
    }
  },
  "responsive": {
    "bp-375px": { "query": "(max-width: 375px)", "columns": 4, "gap": "16px", "paddingInline": "20px" },
    "bp-768px": { "query": "(min-width: 768px)", "columns": 8, "gap": "20px", "paddingInline": "28px" },
    "bp-1024px": { "query": "screen and (min-width: 1024px)", "columns": 12, "gap": "24px", "paddingInline": "32px" },
    "bp-1440px": { "query": "screen and (min-width: 1440px)", "maxWidth": "1480px", "columns": 12, "gap": "28px", "paddingInline": "32px" }
  },
  "_twist": {
    "sourceSystem": "cartier",
    "intensity": 2,
    "description": "Twist B — Container expanded to 1480px and paddingInline to 32px. Gap 28px gives floating sections breathing room to read as luminous objects in dark space."
  }
}
