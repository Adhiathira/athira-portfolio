{
  "cssVars": {
    "ds-motion-duration-xs": "200ms",
    "ds-motion-duration-sm": "400ms",
    "ds-motion-duration-md": "800ms",
    "ds-motion-duration-lg": "1400ms",
    "ds-motion-duration-xl": "2200ms",
    "ds-motion-duration-aurora-drift": "8000ms",
    "ds-motion-duration-aurora-cycle": "20000ms",
    "ds-motion-easing-primary": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ds-motion-easing-drift": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ds-motion-easing-reveal": "cubic-bezier(0.0, 0.0, 0.2, 1)",
    "ds-motion-easing-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "ds-motion-stagger-delay": "120ms"
  },
  "transitions": {
    "link": { "duration": "400ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "properties": ["color", "text-shadow", "opacity"] },
    "button": { "duration": "400ms", "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)", "properties": ["background", "box-shadow", "transform", "border-color"] },
    "card": { "duration": "800ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "properties": ["box-shadow", "transform", "opacity", "filter"] },
    "nav": { "duration": "800ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "properties": ["background", "backdrop-filter", "border-color"] },
    "scroll-reveal": { "duration": "800ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "properties": ["opacity", "transform"] },
    "page-reveal": { "duration": "1400ms", "easing": "cubic-bezier(0.0, 0.0, 0.2, 1)", "properties": ["clip-path", "opacity"] }
  },
  "keyframes": {
    "auroraShimmer": "background-position 0%→100%→0% at 50%, duration 8000ms ease-in-out infinite",
    "glowPulse": "opacity 0.6→1→0.6 + filter blur(20px→12px→20px), duration 8000ms ease-in-out infinite",
    "auroraBand": "translateY+scaleX slow drift 0→-8px→4px→0, duration 20000ms ease-in-out infinite",
    "cosmicReveal": "clip-path inset(0 100% 0 0)→inset(0 0% 0 0) + opacity 0→1, duration 1400ms cinematic",
    "gradientDrift": "hue-rotate 0deg→15deg→-10deg→20deg→0 + brightness variation, duration 20000ms infinite",
    "auroraGlow": "text-shadow teal glow dim→bright→dim, duration 8000ms ease-in-out infinite",
    "particleDrift": "translateY+translateX+scale float+dissolve, duration 1400ms liquid easing",
    "borderGlow": "border-color + box-shadow teal pulse, duration 8000ms ease-in-out infinite"
  },
  "_twist": {
    "sourceSystem": "phosphor-haze",
    "intensity": 5,
    "description": "Twist C — Full Aurora Motion Reimagining. Liquid-emergence easing cubic-bezier(0.16,1,0.3,1) replaces all prior curves. Duration scale rebuilt: xs:200ms→aurora-cycle:20000ms. 8 new aurora keyframes added."
  }
}
