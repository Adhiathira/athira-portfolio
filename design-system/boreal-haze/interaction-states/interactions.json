{
  "_source": "cinder-shore",
  "_twist": "D — Aurora Glow Physics (intensity 4). Hover = scale(1.02) + teal glow. Cards use violet glow. Links use lime text-shadow. No color changes — luminosity only.",
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "transform": "scale(1)",
        "boxShadow": "none",
        "transition": "transform cubic-bezier(0.16, 1, 0.3, 1) 400ms, box-shadow cubic-bezier(0.16, 1, 0.3, 1) 400ms"
      },
      "hover": {
        "transform": "scale(1.02)",
        "boxShadow": "0 0 20px rgba(33,243,182,0.5), 0 0 60px rgba(33,243,182,0.25), 0 0 100px rgba(33,243,182,0.1)",
        "transition": "transform cubic-bezier(0.16, 1, 0.3, 1) 400ms, box-shadow cubic-bezier(0.16, 1, 0.3, 1) 400ms"
      },
      "focus": {
        "outline": "2px solid rgba(33,243,182,0.8)",
        "outlineOffset": "4px",
        "boxShadow": "0 0 0 4px rgba(33,243,182,0.2)"
      },
      "active": {
        "transform": "scale(0.98)",
        "boxShadow": "0 0 10px rgba(33,243,182,0.3), 0 0 30px rgba(33,243,182,0.15)",
        "transition": "transform cubic-bezier(0.16, 1, 0.3, 1) 300ms, box-shadow cubic-bezier(0.16, 1, 0.3, 1) 300ms"
      }
    }
  },
  "inputs": {
    "text": {
      "selector": "input[type=text], input[type=email], textarea",
      "default": { "borderColor": "rgba(255,255,255,0.1)", "boxShadow": "none" },
      "hover": { "borderColor": "rgba(33,243,182,0.5)" },
      "focus": {
        "borderColor": "rgba(33,243,182,0.8)",
        "boxShadow": "0 0 0 3px rgba(33,243,182,0.2), 0 0 20px rgba(33,243,182,0.1)",
        "outlineWidth": "0px"
      }
    }
  },
  "links": {
    "default": {
      "selector": "a:not(.btn):not(.nav-link)",
      "default": { "textShadow": "none", "transition": "text-shadow cubic-bezier(0.16, 1, 0.3, 1) 300ms" },
      "hover": {
        "textShadow": "0 0 8px rgba(226,255,101,0.8), 0 0 16px rgba(226,255,101,0.4)",
        "transition": "text-shadow cubic-bezier(0.16, 1, 0.3, 1) 300ms"
      },
      "focus": {
        "outline": "2px solid rgba(33,243,182,0.8)",
        "outlineOffset": "4px",
        "boxShadow": "0 0 0 4px rgba(33,243,182,0.2)"
      }
    }
  },
  "cards": {
    "default": {
      "selector": ".card",
      "default": {
        "transform": "translateY(0)",
        "boxShadow": "none",
        "transition": "transform cubic-bezier(0.16, 1, 0.3, 1) 400ms, box-shadow cubic-bezier(0.16, 1, 0.3, 1) 400ms"
      },
      "hover": {
        "transform": "translateY(-4px)",
        "boxShadow": "0 0 30px rgba(146,72,228,0.4), 0 0 80px rgba(146,72,228,0.2)",
        "transition": "transform cubic-bezier(0.16, 1, 0.3, 1) 400ms, box-shadow cubic-bezier(0.16, 1, 0.3, 1) 400ms"
      },
      "active": {
        "transform": "translateY(-2px)",
        "boxShadow": "0 0 15px rgba(146,72,228,0.25), 0 0 40px rgba(146,72,228,0.12)"
      }
    }
  },
  "navigation": {
    "link": {
      "selector": ".nav-link",
      "default": { "textShadow": "none" },
      "hover": { "textShadow": "0 0 8px rgba(226,255,101,0.8), 0 0 16px rgba(226,255,101,0.4)" },
      "focus": { "outline": "2px solid rgba(33,243,182,0.8)", "outlineOffset": "4px" }
    }
  },
  "auroraGlowTokens": {
    "tealGlow": "rgba(33,243,182,1)",
    "tealGlowStrong": "rgba(33,243,182,0.5)",
    "tealGlowMid": "rgba(33,243,182,0.25)",
    "tealFocusRing": "rgba(33,243,182,0.8)",
    "tealFocusGlow": "rgba(33,243,182,0.2)",
    "violetGlowStrong": "rgba(146,72,228,0.4)",
    "violetGlowSoft": "rgba(146,72,228,0.2)",
    "limeTextGlowStrong": "rgba(226,255,101,0.8)",
    "limeTextGlowSoft": "rgba(226,255,101,0.4)",
    "easingFunction": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationBase": "400ms"
  }
}
