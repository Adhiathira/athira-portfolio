{
  "_meta": {
    "theme": "Aurora/Gradient Glow",
    "twist": "B",
    "intensity": 2,
    "sourceSystem": "pale-orison",
    "description": "Dark transparent nav that gains an aurora teal hairline border-bottom when scrolled, suggesting aurora light along the horizon."
  },
  "geometry": {
    "height": "68px",
    "paddingX": "32px",
    "paddingY": "0px",
    "maxWidth": "1480px",
    "position": "fixed",
    "top": "0",
    "left": "0",
    "right": "0",
    "zIndex": 100
  },
  "default": {
    "background": "transparent",
    "backdropFilter": "none",
    "borderBottom": "none",
    "boxShadow": "none",
    "transition": "background 0.4s cubic-bezier(0.4,0,0.2,1), backdrop-filter 0.4s cubic-bezier(0.4,0,0.2,1), border-color 0.4s cubic-bezier(0.4,0,0.2,1)"
  },
  "scrolled": {
    "background": "rgba(22, 29, 37, 0.95)",
    "backdropFilter": "blur(16px)",
    "WebkitBackdropFilter": "blur(16px)",
    "borderBottom": "1px solid rgba(33, 243, 182, 0.3)",
    "boxShadow": "0 0 18px 0 rgba(33, 243, 182, 0.08)"
  },
  "logo": {
    "color": "#ffffff",
    "colorScrolled": "#ffffff",
    "fontFamily": "'Syne', sans-serif",
    "fontSize": "22px",
    "fontWeight": "800",
    "letterSpacing": "0.04em"
  },
  "links": {
    "color": "rgba(255, 255, 255, 0.8)",
    "colorScrolled": "rgba(255, 255, 255, 0.9)",
    "hoverColor": "rgba(226, 255, 101, 0.9)",
    "activeColor": "#e2ff65",
    "fontFamily": "'Inter', sans-serif",
    "fontSize": "15px",
    "fontWeight": "500",
    "letterSpacing": "0.04em",
    "gap": "36px",
    "transition": "text-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "cta": {
    "background": "transparent",
    "border": "1px solid rgba(33, 243, 182, 0.5)",
    "color": "#21f3b6",
    "hoverBackground": "rgba(33, 243, 182, 0.12)",
    "borderRadius": "4px",
    "paddingX": "18px",
    "paddingY": "8px",
    "fontSize": "13px",
    "fontWeight": "600",
    "letterSpacing": "0.06em",
    "textTransform": "uppercase"
  },
  "mobileMenu": {
    "breakpoint": "768px",
    "hamburgerColor": "#ffffff",
    "drawerBackground": "rgba(14, 19, 25, 0.98)",
    "drawerBackdropFilter": "blur(20px)",
    "drawerBorderRight": "1px solid rgba(33, 243, 182, 0.15)",
    "linkColor": "rgba(255, 255, 255, 0.85)",
    "linkHoverColor": "rgba(226, 255, 101, 0.9)",
    "linkFontSize": "22px",
    "linkLetterSpacing": "0.04em",
    "animationDuration": "0.35s",
    "animationEasing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "scrollBehavior": {
    "triggerOffsetPx": 20,
    "scrolledClass": "scrolled"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "15px",
    "letterSpacing": "0.04em"
  }
}
