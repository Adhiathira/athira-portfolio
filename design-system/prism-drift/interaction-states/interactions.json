{
  "sourceSystem": "flux-finance",
  "twist": "holographic chromatic interactions — hue-rotate on hover, rainbow box-shadow on focus, chromatic aberration on active",
  "intensity": 5,
  "buttons": {
    "default": {
      "transition": "all 240ms cubic-bezier(0.2, 0, 0, 1)",
      "cursor": "pointer"
    },
    "hover": {
      "transform": "scale(1.02)",
      "filter": "hue-rotate(20deg) saturate(1.4)",
      "transition": "all 240ms cubic-bezier(0.2, 0, 0, 1)"
    },
    "active": {
      "transform": "scale(0.98)",
      "filter": "hue-rotate(40deg) brightness(1.1)",
      "transition": "all 120ms cubic-bezier(0.2, 0, 0, 1)"
    },
    "focus": {
      "outline": "none",
      "boxShadow": "0 0 0 2px rgba(223,94,18,0.4), 0 0 0 4px rgba(111,200,180,0.25)"
    },
    "disabled": {
      "opacity": 0.38,
      "cursor": "not-allowed",
      "filter": "grayscale(0.6)"
    }
  },
  "inputs": {
    "default": {
      "transition": "border-color 200ms, box-shadow 200ms"
    },
    "focus": {
      "borderColor": "transparent",
      "boxShadow": "0 0 0 1px #df5e12, 0 0 0 2px rgba(255,100,0,0.2), 0 0 0 3px rgba(100,200,255,0.15), 0 0 0 4px rgba(100,255,150,0.1)",
      "outline": "none"
    },
    "error": {
      "borderColor": "#e53935",
      "boxShadow": "0 0 0 2px rgba(229,57,53,0.25)"
    }
  },
  "links": {
    "default": {
      "transition": "letter-spacing 200ms, color 200ms, filter 200ms"
    },
    "hover": {
      "letterSpacing": "0.02em",
      "filter": "brightness(1.2)",
      "color": "var(--color-accent-primary)"
    }
  },
  "cards": {
    "default": {
      "transition": "transform 300ms cubic-bezier(0.2, 0, 0, 1), box-shadow 300ms, filter 300ms"
    },
    "hover": {
      "transform": "translateY(-3px)",
      "filter": "hue-rotate(15deg)",
      "boxShadow": "0 20px 60px rgba(0,0,0,0.12)"
    }
  },
  "holographic": {
    "description": "Intensity-5 chromatic aberration interactions — hue-rotate on hover simulates angle-dependent spectral shift of iridescent foil",
    "hoverFilter": "hue-rotate(20deg) saturate(1.4)",
    "activeFilter": "hue-rotate(40deg) brightness(1.1)",
    "cardHoverFilter": "hue-rotate(15deg)",
    "springEasing": "cubic-bezier(0.2, 0, 0, 1)",
    "focusRainbowShadow": "0 0 0 1px #df5e12, 0 0 0 2px rgba(255,100,0,0.2), 0 0 0 3px rgba(100,200,255,0.15), 0 0 0 4px rgba(100,255,150,0.1)"
  }
}
