{
  "sourceSystem": "griting",
  "twist": "iridescent rainbow border-bottom on scroll + chromatic link hover",
  "intensity": 4,
  "layout": {
    "height": "72px",
    "paddingInline": "40px",
    "position": "fixed",
    "top": 0,
    "left": 0,
    "right": 0,
    "zIndex": 100,
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "space-between"
  },
  "default": {
    "background": "transparent",
    "borderBottom": "none",
    "backdropFilter": "none"
  },
  "scrolled": {
    "background": "rgba(255, 255, 255, 0.7)",
    "backdropFilter": "blur(18px) saturate(1.6)",
    "borderBottom": "1px solid transparent",
    "borderImage": "linear-gradient(90deg, #df5e12, #6fc8b4, #a3c4ff, #df5e12) 1",
    "borderImageAnimation": "iridescent-shift 4s linear infinite",
    "transition": "background 300ms, backdrop-filter 300ms"
  },
  "links": {
    "default": {
      "fontFamily": "inherit",
      "fontSize": "13px",
      "fontWeight": "700",
      "letterSpacing": "0.12em",
      "textTransform": "uppercase",
      "color": "var(--color-nav-text, #2b2b29)",
      "textDecoration": "none",
      "transition": "filter 400ms, letter-spacing 200ms"
    },
    "hover": {
      "filter": "hue-rotate(120deg) brightness(1.1)",
      "letterSpacing": "0.14em"
    },
    "active": {
      "filter": "hue-rotate(180deg) saturate(1.5)"
    }
  },
  "logo": {
    "fontFamily": "inherit",
    "fontSize": "18px",
    "fontWeight": "700",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "mobile": {
    "breakpoint": "768px",
    "hamburgerDisplay": "flex",
    "linksDisplay": "none"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "13px",
    "fontWeight": "700",
    "letterSpacing": "0.12em",
    "textTransform": "uppercase"
  }
}
