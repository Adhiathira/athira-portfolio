{
  "geometry": {
    "height": 46,
    "heightScrolled": 46,
    "paddingInline": 20,
    "position": "fixed",
    "logoPosition": "left",
    "itemSpacing": 28
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "14px",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "linkHover": {
    "backgroundPill": false,
    "underline": true,
    "animation": {
      "origin": "left to right",
      "duration": "0.55s",
      "thickness": "1px"
    }
  }
}
