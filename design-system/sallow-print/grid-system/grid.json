{
  "cssVars": {},
  "container": {
    "maxWidth": "1120px"
  },
  "grids": {
    "three-column": {
      "display": "grid",
      "templateColumns": "370px 370px 350px",
      "columnCount": "3",
      "templateRows": "auto",
      "gap": "26px",
      "childCount": "3"
    },
    "asymmetric-three-column": {
      "display": "grid",
      "templateColumns": "300px 300px 490px",
      "columnCount": "3",
      "templateRows": "auto",
      "gap": "26px",
      "childCount": "3"
    },
    "utility-two-column": {
      "display": "grid",
      "templateColumns": "86px 104px",
      "columnCount": "2",
      "templateRows": "20px",
      "gap": "26px 13px",
      "childCount": "2"
    },
    "carousel-strip": {
      "display": "grid",
      "templateColumns": "424px 424px 424px 424px 424px 424px 424px 0px",
      "columnCount": "8",
      "templateRows": "520px",
      "gap": "51px",
      "childCount": "7"
    }
  },
  "responsive": {
    "bp-479px": {
      "query": "screen and (max-width: 479px)",
      "maxWidth": "none",
      "display": "inherit",
      "flexWrap": "nowrap",
      "flexDirection": "column-reverse"
    },
    "bp-767px": {
      "query": "screen and (max-width: 767px)",
      "display": "inherit",
      "flexDirection": "row-reverse",
      "flexWrap": "wrap",
      "maxWidth": "100%"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "96vw",
      "display": "block"
    },
    "bp-991px": {
      "query": "screen and (max-width: 991px)",
      "maxWidth": "728px",
      "display": "inherit",
      "gridTemplateColumns": "1fr",
      "gridTemplateRows": "auto"
    },
    "bp-1120px": {
      "query": "screen and (min-width: 1120px)",
      "display": "block"
    },
    "bp-1440px": {
      "query": "screen and (min-width: 1440px)",
      "display": "flex",
      "maxWidth": "1120px"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "full-width-centered",
      "description": "Single centered column with large heading, subtext, and a UI mockup below."
    },
    {
      "section": "feature-split",
      "layout": "asymmetric-2-column",
      "description": "Left-aligned heading and body text, with two unequal-width feature cards side by side."
    },
    {
      "section": "card-grid",
      "layout": "three-column",
      "description": "Three equal-width cards in a row, centered heading above."
    },
    {
      "section": "footer",
      "layout": "2-column-split",
      "description": "Left-aligned brand name with legal links, right-aligned social icon links."
    }
  ]
}
