{
  "meta": {
    "source": "unseen-studio",
    "theme": "liquid-fluid-ui",
    "intensity": 4,
    "easing": {
      "fluidEase": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "description": "Primary easing for all liquid/fluid transitions — smooth deceleration without bounce"
    }
  },
  "buttons": {
    "default": {
      "transition": "transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94), background-color 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "transform": "scale(1)",
      "boxShadow": "none"
    },
    "hover": {
      "transform": "scale(1.03)",
      "boxShadow": "0 8px 32px 0 rgba(0,0,0,0.12), 0 2px 12px 0 rgba(0,0,0,0.08)",
      "transition": "transform 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "active": {
      "transform": "scale(0.97)",
      "boxShadow": "0 2px 8px 0 rgba(0,0,0,0.06)",
      "transition": "transform 120ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 120ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "focus": {
      "outline": "2px solid currentColor",
      "outlineOffset": "3px"
    },
    "disabled": {
      "opacity": 0.4,
      "filter": "grayscale(0.4)",
      "cursor": "not-allowed",
      "pointerEvents": "none"
    }
  },
  "cards": {
    "default": {
      "transition": "transform 350ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 350ms cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "transform": "translateY(0)",
      "boxShadow": "0 2px 12px 0 rgba(0,0,0,0.06)"
    },
    "hover": {
      "transform": "translateY(-4px)",
      "boxShadow": "0 16px 40px 0 rgba(0,0,0,0.18), 0 4px 16px 0 rgba(0,0,0,0.10)"
    },
    "active": {
      "transform": "translateY(-2px)",
      "boxShadow": "0 8px 20px 0 rgba(0,0,0,0.12)"
    }
  },
  "inputs": {
    "default": {
      "transition": "border-color 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "focus": {
      "borderColor": "currentColor",
      "boxShadow": "0 0 0 3px rgba(0,0,0,0.08), 0 0 12px 0 rgba(0,0,0,0.06)",
      "animation": {
        "name": "fluidInputPulse",
        "keyframes": "@keyframes fluidInputPulse { 0%, 100% { box-shadow: 0 0 0 3px rgba(0,0,0,0.08); } 50% { box-shadow: 0 0 0 4px rgba(0,0,0,0.13); } }",
        "duration": "2400ms",
        "timingFunction": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
        "iterationCount": "infinite"
      }
    }
  },
  "links": {
    "default": {
      "transition": "color 250ms cubic-bezier(0.25, 0.46, 0.45, 0.94), letter-spacing 250ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "hover": {
      "letterSpacing": "0.03em"
    }
  },
  "globalTokens": {
    "fluidEase": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "transitionDurationFast": "120ms",
    "transitionDurationBase": "300ms",
    "transitionDurationSlow": "400ms",
    "shadowBloomBlur": "30px",
    "shadowBloomOpacity": 0.18,
    "disabledOpacity": 0.4
  }
}
