{
  "geometry": {
    "height": 52.789,
    "paddingInline": 0,
    "position": "sticky",
    "heightScrolled": 52.789,
    "itemSpacing": 32,
    "logoPosition": "left"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "500",
    "letterSpacing": "0.04em"
  },
  "scrollState": {
    "backdropFilter": "blur(18px) saturate(1.4)",
    "backgroundTint": "rgba(255, 255, 255, 0.55)",
    "transition": "background 450ms cubic-bezier(0.25, 0.46, 0.45, 0.94), backdrop-filter 450ms cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "boxShadow": "0 2px 24px 0 rgba(0, 0, 0, 0.06)"
  },
  "linkHover": {
    "yTranslate": "-1px",
    "opacityShift": 0.72,
    "animation": {
      "type": "float",
      "duration": "450ms",
      "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    }
  },
  "mobileMenu": {
    "type": "full-page-overlay",
    "backdropFilter": "blur(24px) saturate(1.3)",
    "backgroundTint": "rgba(255, 255, 255, 0.72)",
    "openTransition": "opacity 450ms cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 450ms cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "entryTransform": "translateY(12px)"
  },
  "characterDescription": "A liquid-state nav shell — near-invisible at rest, breathing into frosted organic blur as the page scrolls. Links float upward a single pixel on hover with soft opacity wash. The mobile overlay dissolves in from below through gentle backdrop blur."
}
