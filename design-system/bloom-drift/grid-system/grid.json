{
  "cssVars": {
    "gutter": "96px",
    "gutter-mobile": "48px",
    "grid-gutter": "40px",
    "grid-gutter-mobile": "48px",
    "grid": "repeat(10, minmax(0, 1fr))",
    "grid-tablet": "repeat(6, minmax(0, 1fr))",
    "grid-mobile": "repeat(2, minmax(0, 1fr))",
    "megamenu-grid": "repeat(5, minmax(0, 1fr))",
    "container-max-width": "1600px",
    "container-padding": "80px"
  },
  "container": {
    "maxWidth": "1600px",
    "paddingInline": "80px",
    "width": "100%"
  },
  "responsive": {
    "bp-767px": {"query": "only screen and (max-width: 767px)", "gridTemplateColumns": "var(--grid-mobile)"},
    "bp-1023px": {"query": "only screen and (max-width: 1023px)", "gridTemplateColumns": "var(--grid-tablet)"},
    "bp-1024px": {"query": "only screen and (min-width: 1024px)", "gridTemplateColumns": "var(--grid)"}
  },
  "visual": []
}
