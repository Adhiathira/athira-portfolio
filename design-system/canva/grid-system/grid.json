{
  "cssVars": {},
  "container": {
    "maxWidth": "2560px",
    "paddingLeft": "32px",
    "paddingRight": "32px"
  },
  "grids": {},
  "responsive": {
    "bp-599px": {
      "query": "(max-width: 599px)",
      "flexDirection": "column",
      "display": "flex",
      "maxWidth": "calc(100% - 8px)"
    },
    "bp-600px": {
      "query": "(min-width: 600px)",
      "display": "none",
      "flexDirection": "row",
      "maxWidth": "100%",
      "flexWrap": "nowrap",
      "rowGap": "16px",
      "columnGap": "16px"
    },
    "bp-656px": {
      "query": "(max-height: 656px)",
      "display": "none"
    },
    "bp-899px": {
      "query": "(max-width: 899px)",
      "flexDirection": "column",
      "display": "flex",
      "maxWidth": "none"
    },
    "bp-900px": {
      "query": "(min-width: 900px)",
      "display": "none",
      "maxWidth": "600px",
      "flexDirection": "row",
      "gridTemplateColumns": "100%",
      "gridTemplateRows": "minmax(0px, 0fr)",
      "rowGap": "24px",
      "columnGap": "24px"
    },
    "bp-1040px": {
      "query": "screen and (min-width: 1040px)",
      "display": "initial"
    },
    "bp-1199px": {
      "query": "(max-width: 1199px)",
      "flexDirection": "column",
      "display": "flex"
    },
    "bp-1200px": {
      "query": "(min-width: 1200px)",
      "display": "none",
      "maxWidth": "unset",
      "rowGap": "24px",
      "columnGap": "24px"
    }
  },
  "visual": []
}