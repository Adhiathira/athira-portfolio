{
  "_twist": "Gap values scaled ×1.4 (Twist B, intensity 3). Source: griting-ellipsus.",
  "cssVars": {
    "--container-max-width": "1440px",
    "--container-padding-inline": "22px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1420px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto",
    "--grid-about-mission-width": "925px",
    "--grid-about-body-copy-width": "785px",
    "--grid-responsive-row-gap-md": "2.1rem",
    "--grid-responsive-col-gap-md": "2.1rem",
    "--grid-responsive-row-gap-lg": "3.5rem",
    "--grid-responsive-col-gap-lg": "3.5rem"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "22px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0"
    },
    "ecosystem-cards": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "feature": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "unknown"
    },
    "testimonials": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "56px",
      "_twist": "Gap scaled ×1.4 from 40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    },
    "filter-pills": {
      "display": "flex",
      "gap": "11.2px",
      "columnCount": null,
      "_twist": "Gap scaled ×1.4 from 8px"
    },
    "blog-list": {
      "display": "flex",
      "flexDirection": "column",
      "columnCount": 1,
      "gap": null
    }
  },
  "responsive": {
    "bp-520px": {
      "query": "(min-width: 520px)",
      "maxWidth": "60vw"
    },
    "bp-580px": {
      "query": "(min-width: 580px)",
      "maxWidth": "50%"
    },
    "bp-720px": {
      "query": "(min-width: 720px)",
      "flexDirection": "row",
      "maxWidth": "31.875rem"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "display": "none"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "flexDirection": "row",
      "display": "none",
      "maxWidth": "41.25rem"
    },
    "bp-780px": {
      "query": "(min-width: 780px)",
      "flexDirection": "row",
      "maxWidth": "unset",
      "rowGap": "2.1rem",
      "columnGap": "2.1rem",
      "_twist": "Gap values scaled ×1.4 from 1.5rem"
    },
    "bp-820px": {
      "query": "(min-width: 820px)",
      "rowGap": "3.5rem",
      "columnGap": "3.5rem",
      "_twist": "Gap values scaled ×1.4 from 2.5rem"
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12,
    "sectionRhythm": "alternating-dark-light"
  }
}
