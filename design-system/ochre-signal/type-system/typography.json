{
  "cssVars": {
    "--font-size-small": "13px",
    "--font-size-medium": "20px",
    "--font-size-large": "36px",
    "--font-size-x-large": "42px",
    "--content-size": "823px",
    "--wide-size": "1080px",
    "--font-letter-spacing-heading": "0.06em"
  },
  "fontFaces": [
    {
      "family": "Nunito",
      "weight": "200 900",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap",
      "resolvedName": "Nunito",
      "isGoogleFont": true
    },
    {
      "family": "Nunito Sans",
      "weight": "200 900",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,600;1,700;1,800;1,900&display=swap",
      "resolvedName": "Nunito Sans",
      "isGoogleFont": true
    },
    {
      "family": "Space Mono",
      "weight": "400 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
      "resolvedName": "Space Mono",
      "isGoogleFont": true,
      "_replacedFrom": "ETmodules (proprietary icon font, not web-accessible)"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Nunito, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "36px",
      "fontWeight": "300",
      "lineHeight": "50.4px",
      "letterSpacing": "0.06em",
      "wordSpacing": "0px",
      "textTransform": "uppercase",
      "primaryFont": "Nunito"
    },
    "h2": {
      "fontFamily": "Nunito, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "23px",
      "fontWeight": "300",
      "lineHeight": "36.8px",
      "letterSpacing": "0.06em",
      "wordSpacing": "0px",
      "textTransform": "uppercase",
      "primaryFont": "Nunito"
    },
    "h3": {
      "fontFamily": "Nunito, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "20px",
      "fontWeight": "300",
      "lineHeight": "30px",
      "letterSpacing": "0.06em",
      "wordSpacing": "0px",
      "textTransform": "uppercase",
      "primaryFont": "Nunito"
    },
    "h4": {
      "fontFamily": "Nunito, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "20px",
      "fontWeight": "300",
      "lineHeight": "32px",
      "letterSpacing": "0.06em",
      "wordSpacing": "0px",
      "textTransform": "uppercase",
      "primaryFont": "Nunito"
    },
    "body": {
      "fontFamily": "Nunito Sans, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "27.2px",
      "wordSpacing": "0px",
      "primaryFont": "Nunito Sans"
    },
    "p": {
      "fontFamily": "Nunito Sans, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "27.2px",
      "wordSpacing": "0px",
      "primaryFont": "Nunito Sans"
    },
    "link": {
      "fontFamily": "Nunito Sans, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "1.4",
      "wordSpacing": "0px",
      "primaryFont": "Nunito Sans"
    },
    "nav": {
      "fontFamily": "Nunito Sans, Helvetica, Arial, Lucida, sans-serif",
      "fontSize": "15px",
      "fontWeight": "300",
      "lineHeight": "14px",
      "letterSpacing": "1.5px",
      "wordSpacing": "0px",
      "primaryFont": "Nunito Sans"
    }
  },
  "_twist": {
    "type": "B. Letter spacing injection",
    "intensity": 3,
    "source": "cama-mind",
    "description": "Added --font-letter-spacing-heading: 0.06em for all heading levels. This tightens the airy, heavily tracked original letterSpacing (10.8px, 4.6px etc.) into a unified 0.06em relative system, giving headings a more considered, precise tracking consistent across scales. ETmodules icon font replaced with Space Mono (Google Fonts CDN)."
  }
}
