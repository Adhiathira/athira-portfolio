{
  "cssVars": {
    "grid-gutter": "0px",
    "grid-gap": "22px",
    "grid-cols": "12",
    "grid-add": "0px",
    "grid-width": "100%",
    "grid-contain": "min(var(--grid-width), calc(100% - 22px * 2))",
    "grid-columns-mobile": "4"
  },
  "container": {
    "maxWidth": "1216px",
    "paddingLeft": "22px",
    "paddingRight": "22px"
  },
  "grids": {
    "nav-primary": {
      "display": "grid",
      "templateColumns": "repeat(6, 1fr)",
      "columnCount": "6",
      "gap": "normal 22px"
    },
    "content-grid": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 22px"
    },
    "footer-grid": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 22px"
    }
  },
  "responsive": {
    "bp-384px": {
      "query": "(min-width: 384px)",
      "maxWidth": "384px"
    },
    "bp-700px": {
      "query": "(min-width: 700px)",
      "maxWidth": "700px",
      "flexWrap": "wrap",
      "rowGap": "22px",
      "columnGap": "78px",
      "gridTemplateColumns": "1fr 1fr",
      "flexDirection": "row"
    },
    "bp-1000px": {
      "query": "(min-width: 1000px)",
      "maxWidth": "1000px",
      "gridTemplateColumns": "1fr 1fr 1fr calc(20% - 18px)",
      "rowGap": "0px",
      "columnGap": "6px"
    },
    "bp-1216px": {
      "query": "(min-width: 1216px)",
      "maxWidth": "1216px"
    },
    "bp-1350px": {
      "query": "(min-width: 1350px)",
      "maxWidth": "1350px"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "full-bleed-image-with-overlay-text",
      "description": "Full-viewport background with navigation bar overlaid at top, large headline anchored bottom-left, CTA button below it."
    },
    {
      "section": "product-grid",
      "layout": "3-column-equal",
      "description": "Three equal-width columns on a warm surface, each containing product name, subtitle, price badge, and centered product image."
    },
    {
      "section": "footer",
      "layout": "2-zone-split",
      "description": "Left zone with newsletter subscribe; right zone with four equal-width link columns."
    }
  ],
  "_twist": {
    "type": "B. Gap value scaling",
    "intensity": 3,
    "factor": 1.375,
    "source": "opal-camera",
    "description": "columnGap and rowGap scaled ×1.375 (≈1.4 at intensity 3). Base gap 16px → 22px, column gap in bp-700px 56px → 78px. Creates more generous whitespace between columns, lending a spacious editorial feel."
  }
}
