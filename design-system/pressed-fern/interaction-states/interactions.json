{
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#000000",
        "color": "#fcf7f1",
        "borderColor": "#000000",
        "borderWidth": "1.5px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "hover": {
        "backgroundColor": "#000000",
        "color": "#fcf7f1",
        "borderColor": "#000000",
        "boxShadow": "0 4px 16px rgba(0, 0, 0, 0.12)",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "active": {
        "transform": "scale(0.98)",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "3px",
        "outlineColor": "#000000",
        "outlineStyle": "solid",
        "boxShadow": "0 0 0 1px rgba(0, 0, 0, 0.2)",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      }
    },
    "ghost": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#000000",
        "borderColor": "#000000",
        "borderWidth": "1.5px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "hover": {
        "backgroundColor": "rgba(0,0,0,0.04)",
        "color": "#000000",
        "borderColor": "#696969",
        "boxShadow": "0 2px 8px rgba(0, 0, 0, 0.08)",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "active": {
        "transform": "scale(0.98)",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "3px",
        "outlineColor": "#696969",
        "outlineStyle": "solid",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      }
    }
  },
  "inputs": {
    "default": {
      "backgroundColor": "#fcf7f1",
      "color": "#000000",
      "borderColor": "#000000",
      "borderWidth": "1px",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "focus": {
      "outlineWidth": "2px",
      "outlineOffset": "3px",
      "outlineColor": "#000000",
      "outlineStyle": "solid",
      "boxShadow": "0 0 0 1px rgba(0, 0, 0, 0.2)",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  },
  "links": {
    "default": {
      "color": "#000000",
      "textDecoration": "none",
      "backgroundImage": "linear-gradient(to right, #000000, #000000)",
      "backgroundPosition": "0% 100%",
      "backgroundSize": "0% 1px",
      "backgroundRepeat": "no-repeat",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "hover": {
      "color": "#000000",
      "backgroundSize": "100% 1px",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid #e8e3da",
      "boxShadow": "0 2px 8px rgba(0,0,0,0.04)",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "hover": {
      "border": "1px solid #696969",
      "boxShadow": "0 6px 16px rgba(0, 0, 0, 0.10)",
      "transform": "translateY(-2px)",
      "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  },
  "navigation": {
    "link": {
      "default": {
        "color": "#000000",
        "opacity": "1",
        "backgroundImage": "linear-gradient(to right, #000000, #000000)",
        "backgroundPosition": "0% 100%",
        "backgroundSize": "0% 1px",
        "backgroundRepeat": "no-repeat",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "hover": {
        "color": "#000000",
        "backgroundSize": "100% 1px",
        "transition": "all 0.55s cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "active": {
        "color": "#000000",
        "fontWeight": "600",
        "backgroundSize": "100% 1px"
      }
    }
  },
  "_twist": {
    "sourceSystem": "ochre-signal",
    "type": "organic-ink-absorption",
    "intensity": 4,
    "description": "Organic ink-absorption interaction patterns. All transitions 0.55s cubic-bezier(0.25, 0.1, 0.25, 1). Links feature drawn-in underlines via background-gradient transitioning 0% to 100% backgroundSize. Cards hover with subtle translateY(-2px) lift and shadow bloom. Active states use scale(0.98) for pressed-paper feel. Focus states use 2px outlines at 3px offset. No instant state changes — everything dissolves like ink absorption."
  }
}
