{
  "cssVars": {
    "ds-font-family-display": "'Cormorant Garamond', serif",
    "ds-font-family-heading": "'Cormorant Garamond', serif",
    "ds-font-family-body": "'EB Garamond', serif",
    "ds-font-family-mono": "'Courier Prime', monospace",
    "ds-font-family-secondary": "'Source Serif 4', serif",
    "ds-font-size-3xl": "90px",
    "ds-font-size-2xl": "60px",
    "ds-font-size-xl": "36px",
    "ds-font-size-lg": "28px",
    "ds-font-size-md": "20px",
    "ds-font-size-base": "17px",
    "ds-font-size-sm": "14px",
    "ds-font-size-xs": "12px",
    "ds-font-weight-display": "400",
    "ds-font-weight-heading": "600",
    "ds-font-weight-subheading": "500",
    "ds-font-weight-body": "400",
    "ds-font-weight-label": "600",
    "ds-line-height-display": "1.15",
    "ds-line-height-heading": "1.2",
    "ds-line-height-body": "1.75",
    "ds-line-height-label": "1.3",
    "ds-letter-spacing-display": "-0.01em",
    "ds-letter-spacing-heading": "0em",
    "ds-letter-spacing-body": "0em",
    "ds-letter-spacing-mono": "0.02em",
    "ds-letter-spacing-label": "0.05em"
  },
  "fontFaces": [
    {
      "resolvedName": "Cormorant Garamond",
      "role": "display-heading",
      "source": "google-fonts",
      "weights": [300, 400, 500, 600, 700]
    },
    {
      "resolvedName": "EB Garamond",
      "role": "body-editorial",
      "source": "google-fonts",
      "weights": [400, 500, 600]
    },
    {
      "resolvedName": "Courier Prime",
      "role": "mono-warm",
      "source": "google-fonts",
      "weights": [400, 700]
    },
    {
      "resolvedName": "Source Serif 4",
      "role": "secondary-editorial",
      "source": "google-fonts",
      "weights": [300, 400, 600]
    }
  ],
  "scaleRoles": {
    "h1": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "var(--ds-font-size-3xl)",
      "fontWeight": "var(--ds-font-weight-display)",
      "letterSpacing": "var(--ds-letter-spacing-display)",
      "lineHeight": "var(--ds-line-height-display)",
      "fontStyle": "italic"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "var(--ds-font-size-2xl)",
      "fontWeight": "var(--ds-font-weight-heading)",
      "letterSpacing": "var(--ds-letter-spacing-heading)",
      "lineHeight": "var(--ds-line-height-heading)"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "var(--ds-font-size-xl)",
      "fontWeight": "var(--ds-font-weight-subheading)",
      "letterSpacing": "var(--ds-letter-spacing-heading)",
      "lineHeight": "var(--ds-line-height-body)"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "var(--ds-font-size-base)",
      "fontWeight": "var(--ds-font-weight-body)",
      "letterSpacing": "var(--ds-letter-spacing-body)",
      "lineHeight": "var(--ds-line-height-body)"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "var(--ds-font-size-sm)",
      "fontWeight": "var(--ds-font-weight-label)",
      "letterSpacing": "var(--ds-letter-spacing-label)",
      "lineHeight": "var(--ds-line-height-label)"
    },
    "caption": {
      "fontFamily": "var(--ds-font-family-secondary)",
      "fontSize": "var(--ds-font-size-xs)",
      "fontWeight": "var(--ds-font-weight-body)",
      "letterSpacing": "var(--ds-letter-spacing-mono)",
      "lineHeight": "var(--ds-line-height-label)"
    }
  },
  "_twist": {
    "sourceSystem": "dark-array",
    "type": "organic-ink-editorial",
    "intensity": 4,
    "description": "Replaced cyberpunk HUD aesthetic with warm calligraphic editorial style. Cormorant Garamond (elegant serif display) replaces Orbitron for h1/h2 with generous line-heights and h1 italic styling. EB Garamond brings classical book typeface warmth to body copy with 1.75 line-height for editorial rhythm. Courier Prime replaces JetBrains Mono for warm typewriter feel. Removed uppercase transforms from headings to restore natural readability."
  }
}
