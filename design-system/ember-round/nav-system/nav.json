{
  "geometry": {
    "height": 74,
    "position": "fixed",
    "paddingInline": 16,
    "itemSpacing": 10,
    "logoPosition": "center",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "1.125em",
    "fontWeight": "500",
    "letterSpacing": "-0.02em",
    "textTransform": "none",
    "lineHeight": "1"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": null,
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".nav-bar__small-li.is--inactive",
    "fontWeight": "inherit",
    "indicator": "none"
  },
  "scrollTransition": {
    "mechanism": "none",
    "propertiesChanged": [],
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": "1em",
    "boxShadow": null,
    "padding": "1.25em 2.25em 2em",
    "itemPadding": "0.8125em 0 0.875em",
    "animation": "grid-template-rows: 0fr to 1fr (CSS grid expansion)"
  },
  "characterDescription": "A compact, pill-shaped floating nav bar with a centered logo and a hamburger-style menu trigger, expanding downward into a structured mega-panel with product columns and a banner card — conveying a refined, app-product sensibility with deliberate spatial hierarchy."
}
