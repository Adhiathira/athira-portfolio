  "scrollAnimations": {
    "patterns": [
      {
        "type": "scroll-driven-tab-switching",
        "_source": "griting",
        "description": "As user scrolls within the product section, the active tab switches between For Businesses / For Individuals / For Community, updating the content panel. No explicit timing values present in Figma export.",
        "trigger": "scroll position within section",
        "targets": ["tab-bar active state", "numbered list active item", "content panel"],
        "_screen": "landing-page-auditable-section"
      },
      {
        "type": "partner-tab-switching",
        "_source": "griting",
        "description": "Tab bar switches between Rapid-Growth Startups / AI-Transforming Companies / Multi-Disciplinary Talent Organizations. Progress bar fills to reflect active tab position. Progress bar fill color: #00693e. No timing values in Figma export.",
        "trigger": "tab click or scroll",
        "targets": ["tab label active state", "progress bar fill width", "partner content panel"],
        "_colorNote": "Progress bar fill recolored to griting green #00693e (was opux terracotta in original griting source)",
        "_screen": "partners-page-view-1"
      }
    ],
    "parallaxPatterns": [
