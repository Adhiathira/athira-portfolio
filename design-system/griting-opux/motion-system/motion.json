        "keyframes": ["mobile-parallax-hero", "mobile-parallax-faq"],
        "backgroundColorNote": "If a solid overlay is applied atop the parallax background, use rgba(0,54,32,0.6) (griting deep green) — never opux orange/terracotta."
      }
