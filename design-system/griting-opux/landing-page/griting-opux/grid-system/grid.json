{
  "_source": "griting (baseline) + opux (supplemental layout patterns)",
  "cssVars": {
    "--container-max-width": "1440px",
    "--container-padding-inline": "22px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1420px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "22px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0",
      "_note": "Full-bleed dark bg, text at bottom-left"
    },
    "ecosystem-cards": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "gritme-feature": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "unknown",
      "_note": "Left: text column, Right: product screenshot"
    },
    "testimonials": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    },
    "filter-pills": {
      "display": "flex",
      "gap": "8px",
      "columnCount": null
    },
    "blog-list": {
      "display": "flex",
      "flexDirection": "column",
      "columnCount": 1,
      "gap": null
    },
    "photoGrid": {
      "display": "absolute",
      "description": "Asymmetric two-column photo mosaic — left column 410px wide, right column 550px wide, staggered vertical offsets",
      "columnCount": 2,
      "gap": "staggered — not a uniform gap system",
      "_screen": "about-us"
    },
    "missionCentered": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "925px",
      "_screen": "about-us"
    },
    "bodyCopy": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "785px",
      "_screen": "about-us"
    },
    "fullBleed": {
      "display": "full-width",
      "description": "Background layers, globe image, CTA section — span full 1440px+",
      "columnCount": null,
      "_screen": "about-us"
    },
    "tabBar": {
      "display": "flex",
      "justifyContent": "space-between",
      "width": "1146px",
      "height": "86px",
      "borderRadius": "20px",
      "_note": "3 tabs evenly distributed: For Businesses / For Individuals / For Community. Sticky/condensed as user scrolls.",
      "_screen": "landing-page-auditable-section"
    },
    "productSection": {
      "display": "grid",
      "templateColumns": "~33% 60%",
      "gap": "~64px",
      "_note": "Asymmetric split: left = numbered scroll-nav list, right = content panel card",
      "_screen": "landing-page-auditable-section"
    },
    "contentPanel": {
      "display": "flex",
      "flexDirection": "column",
      "width": "866px",
      "height": "640px",
      "borderRadius": "10px",
      "paddingInline": "~35px",
      "_source": "reverse-engineered from node coordinates",
      "_screen": "landing-page-auditable-section"
    },
    "partnersNav": {
      "display": "flex",
      "justifyContent": "space-between",
      "paddingInline": "74px",
      "height": "88px",
      "logoLeft": "74px",
      "navLinksLeft": "calc(54.17% - 42px)",
      "navLinksWidth": "408px",
      "navLinksGap": "45px",
      "_screen": "partners-page-view-1"
    },
    "partnersHero": {
      "display": "full-bleed",
      "height": "1051px",
      "headlineTop": "301.5px",
      "subtitleTop": "436px",
      "subtitleWidth": "850px",
      "_screen": "partners-page-view-1"
    },
    "partnersTabBar": {
      "display": "flex",
      "flexDirection": "column",
      "top": "1463px",
      "width": "1212px",
      "left": "114px",
      "tabCount": "3",
      "progressBarHeight": "3px",
      "progressBarColor": "#c6c6c6",
      "progressBarFillColor": "#00995e",
      "tab1Label": "Rapid-Growth Startups",
      "tab2Label": "AI-Transforming Companies",
      "tab3Label": "Multi-Disciplinary Talent Organizations",
      "_note": "3 equal-width tab labels spanning 1212px from left-[114px]. Progress bar 3px height above labels. Fill indicates active tab.",
      "_screen": "partners-page-view-1"
    },
    "partnerContent": {
      "display": "grid",
      "templateColumns": "~33% text / ~40% photo",
      "contentLeft": "114px",
      "textColumnWidthApprox": "33%",
      "photoColumnWidthApprox": "40%",
      "_note": "Left text column ~33% of canvas width, right photo overlay panel, asymmetric 2-column split anchored at left-[114px].",
      "_screen": "partners-page-view-1"
    },
    "useCases": {
      "display": "flex",
      "flexDirection": "column",
      "sectionTop": "2510px",
      "cardCount": "3",
      "cardWidth": "900.514px",
      "cardHeight": "311px",
      "cardLeft": "calc(37.5% + 24.26px)",
      "cardPadding": "40px",
      "_screen": "partners-page-view-1"
    },
    "whatWeProvide": {
      "display": "grid",
      "templateColumns": "480px 480px",
      "rows": "2",
      "gap": "30px",
      "cardHeight": "285px",
      "cardWidth": "480px",
      "col1Left": "225px",
      "col2Left": "735px",
      "iconCircleSize": "64px",
      "iconCircleBorderColor": "#9f9fa9",
      "_screen": "partners-page-view-1"
    },
    "apiBullets": {
      "display": "flex",
      "flexDirection": "row",
      "sectionTop": "2235px",
      "width": "1216px",
      "alignment": "center",
      "itemCount": "3",
      "itemWidth": "352px",
      "inferredGap": "80px",
      "_screen": "partners-page-view-1"
    },
    "featureBullets": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "itemsPerRow": "2",
      "rowWidth": "938px",
      "rows": "2",
      "_screen": "partners-page-view-1"
    },

    "_opux_supplemental": "--- Opux layout patterns below. These do not override griting values. ---",

    "opux-hero-centered-column": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "column",
      "alignItems": "center",
      "contentWidth": "1280px",
      "contentInset": "224px",
      "columnWidthApprox": "50%",
      "_note": "Full-viewport hero with centered 50%-wide content column. Typographic layering: clean sans headline overlaid by oblique/script display type — deliberate collision, not alignment error. Background: animated 3D wireframe terrain spanning full page height."
    },
    "opux-promo-banner": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "row",
      "position": "fixed",
      "width": "1728px",
      "height": "48px",
      "contentWidth": "1280px",
      "contentInset": "224px",
      "closeButtonPosition": "absolute",
      "_note": "Full-width fixed announcement strip above the nav. Single row, centered content, close button pinned to right edge at x=1424px."
    },
    "opux-nav-split-left-right": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "row",
      "position": "fixed",
      "width": "1728px",
      "height": "81px",
      "contentInset": "56px",
      "logoWidth": "177px",
      "ctaGroupWidth": "304px",
      "ctaGroupGap": "24px",
      "_note": "Logo anchored far left at x=56px, CTA group (ghost button + terracotta filled button) anchored far right at x=1368px. Nothing in center. Nav is transparent — no background fill."
    },
    "opux-three-feature-cards": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "columnCount": 3,
      "_note": "Three equal-width frosted/semi-transparent dark cards in a horizontal row. Cards float on full-bleed terrain background — not contained in a section box. Pure type hierarchy, no icons."
    },
    "opux-asymmetric-audience-split": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "row",
      "gap": "96px",
      "justifyContent": "space-between",
      "alignItems": "center",
      "leftColumnWidth": "~35%",
      "rightColumnWidth": "~55%",
      "contentInset": "162px",
      "contentWidth": "1400px",
      "_note": "Left: large display headline (~35% width). Right: stacked audience segment list (~55% width) with icon, label, problem statement, and differentiator per segment. Segments separated by generous vertical spacing, not card-boxed."
    },
    "opux-how-it-works-steps": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "row",
      "gap": "96px",
      "sectionHeight": "733px",
      "contentInset": "162px",
      "contentWidth": "1400px",
      "leftColumnWidth": "420px",
      "rightColumnWidth": "884px",
      "rightColumnGap": "48px",
      "stepItemLayout": "flex-row",
      "stepItemGap": "24px",
      "_note": "Left: large section header (~420px). Right: stacked numbered step items, each flex-row with 24px gap. Three steps total, right column gap 48px between items."
    },
    "opux-floating-product-screenshot": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "column",
      "gap": "64px",
      "sectionHeight": "937px",
      "mockupWidth": "900px",
      "mockupHeight": "542px",
      "mockupInset": "412px",
      "screenshotWidth": "852px",
      "screenshotHeight": "542px",
      "_note": "Centered heading and subtitle above a browser-frame mockup (~900px wide, centered). Mockup appears to break section boundary, overlapping adjacent sections — depth/parallax suggestion without actual parallax."
    },
    "opux-pricing-two-column": {
      "_from": "opux",
      "display": "grid",
      "templateColumns": "434px 434px",
      "columnCount": 2,
      "templateRows": "521.188px",
      "gap": "32px",
      "containerWidth": "900px",
      "containerInset": "412px",
      "_note": "Symmetric two-column pricing card layout. Right card visually elevated (featured badge, stronger border). Monthly/Yearly toggle pill centered above cards."
    },
    "opux-faq-accordion": {
      "_from": "opux",
      "display": "flex",
      "flexDirection": "column",
      "gap": "16px",
      "sectionMaxWidth": "1024px",
      "containerWidth": "800px",
      "containerInset": "462px",
      "_note": "Centered accordion stack. Each FAQ item is full-width (800px), rounded-rect, question left + chevron right. Items separated by 16px gap. Frosted/transparent background on each item."
    },
    "opux-footer-three-column": {
      "_from": "opux",
      "display": "grid",
      "columnCount": 3,
      "gap": "60px",
      "containerWidth": "1280px",
      "containerInset": "222px",
      "logoColumnWidth": "580px",
      "_note": "Logo + copyright in left column (580px). Legal links in center. Support links in right. Dark background, minimal, no decorative elements."
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  },
  "_darkModeLayout": {
    "type": "full-bleed",
    "canvasWidth": "1440px",
    "canvasBackground": "black",
    "columns": 12,
    "gutterLeft": "114px",
    "gutterRight": "114px",
    "contentWidth": "1212px",
    "_note": "Dark cinematic layout used by partners-page. Primary gutter 114px. Secondary inset 225px for 2x2 grid. Nav uses 74px left anchor. Enterprise/partners design mode.",
    "_screen": "partners-page-view-1"
  },
  "_opuxResponsive": {
    "_from": "opux",
    "_note": "Opux responsive breakpoint strategy — supplemental to griting's 1440px desktop baseline. Opux uses a mobile-first fluid approach with these breakpoints:",
    "bp-480px": {
      "query": "(max-width: 480px)",
      "flexDirection": "column"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "flexWrap": "wrap",
      "rowGap": "8px",
      "columnGap": "8px",
      "flexDirection": "column",
      "maxWidth": "640px",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "flexDirection": "column",
      "rowGap": "32px",
      "columnGap": "32px",
      "maxWidth": "85%",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))"
    },
    "bp-968px": {
      "query": "(max-width: 968px)",
      "gridTemplateColumns": "1fr",
      "rowGap": "clamp(16px, 3vw, 24px)",
      "columnGap": "clamp(16px, 3vw, 24px)"
    },
    "bp-1024px": {
      "query": "(min-width: 1024px)",
      "maxWidth": "1024px",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))",
      "flexDirection": "row",
      "rowGap": "64px",
      "columnGap": "64px"
    },
    "bp-1280px": {
      "query": "(min-width: 1280px)",
      "maxWidth": "1280px"
    },
    "bp-1536px": {
      "query": "(min-width: 1536px)",
      "maxWidth": "1536px"
    }
  }
}
