{
  "buttons": {
    "primary": {
      "selector": "CTA button — Get in Touch / Try It Now",
      "default": {
        "background": "linear-gradient(90deg, #00693e, #00693e)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#003620",
        "boxShadow": "0px 1px 2px -1px rgba(9,6,63,0.4), 0px 0px 0px 1px #003620, inset 0px 1px 0px 0px rgba(255,255,255,0.16)",
        "fontSize": "18px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "letterSpacing": "-0.18px"
      },
      "hover": {
        "background": "linear-gradient(90deg, #008050, #008050)",
        "color": "#ffffff",
        "_inferred": true,
        "_note": "Hover state not shown in static Figma — inferred as slightly lighter brand green"
      },
      "active": {
        "background": "linear-gradient(90deg, #003620, #003620)",
        "color": "#ffffff",
        "_inferred": true
      }
    },
    "outline": {
      "selector": "Outline button — Learn More / Book Demo",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "borderColor": "#00693e",
        "_inferred": true,
        "_note": "Hover not shown in static Figma — inferred as doubled bg opacity"
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "outline-on-light": {
      "selector": "Outline button on light background (Book Demo in feature sections)",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#000000",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "_note": "Black text — this variant is used on light (#f5f6f5) backgrounds, contrasting with outline-on-dark which uses white text"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "color": "#000000",
        "_inferred": true
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "share-icon": {
      "selector": "Social share icon buttons",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "rgba(209,213,219,0.5)",
        "borderRadius": "40px",
        "size": "48px"
      },
      "hover": { "background": "#e5e7e5", "_inferred": true }
    },
    "filter-pill-active": {
      "selector": "Active category filter pill",
      "default": {
        "background": "#00693e",
        "color": "#ffffff",
        "borderRadius": "9999px",
        "borderColor": null,
        "height": "36px",
        "paddingInline": "16px"
      },
      "hover": {
        "background": "#004d2e",
        "color": "#ffffff"
      },
      "active": {
        "background": "#003d25",
        "color": "#ffffff"
      }
    },
    "filter-pill-inactive": {
      "selector": "Inactive category filter pill",
      "default": {
        "background": "#f3f4f3",
        "color": "#000000",
        "borderRadius": "9999px",
        "borderColor": "#e4e4e7",
        "height": "36px",
        "paddingInline": "16px"
      },
      "hover": {
        "background": "#e8e8e8",
        "color": "#031f18"
      },
      "active": {
        "background": "#d4d4d4",
        "color": "#031f18"
      }
    }
  },
  "links": {
    "nav": {
      "selector": "Navigation links",
      "default": {
        "color": "#ffffff",
        "textDecoration": "none",
        "fontSize": "16px",
        "fontFamily": "Inter"
      },
      "hover": {
        "color": "#ffffff",
        "textDecoration": "underline",
        "_inferred": true
      }
    },
    "nav-on-light": {
      "selector": "Navigation links on white background",
      "default": { "color": "#455451", "textDecoration": "none", "fontSize": "16px", "fontFamily": "Inter" },
      "hover": { "color": "#031f18", "textDecoration": "none", "_inferred": true }
    },
    "back-button": {
      "selector": "← All Post back navigation",
      "default": { "color": "#202b38", "textDecoration": "none", "fontSize": "16px" },
      "hover": { "color": "#031f18", "_inferred": true }
    },
    "article-title": {
      "selector": "Blog article title link",
      "default": {
        "color": "#031f18",
        "textDecoration": "underline"
      },
      "hover": {
        "color": "#00693e",
        "textDecoration": "underline",
        "_note": "hover color inferred — not explicit in static Figma"
      }
    }
  },
  "inputs": {
    "search": {
      "selector": "Blog search input",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "#d1d5db",
        "borderRadius": "10px",
        "placeholderColor": "#71717b",
        "height": "40px"
      },
      "focus": {
        "borderColor": "#00693e",
        "_note": "focus border color inferred — not explicit in static Figma"
      }
    }
  }
}
