{
  "cssVars": {
    "ds-font-family-display": "'Playfair Display', serif",
    "ds-font-family-heading": "'Cormorant Garamond', serif",
    "ds-font-family-body": "'Lora', serif",
    "ds-font-family-ornamental": "'Dancing Script', cursive",
    "ds-font-family-logo": "'Cormorant Garamond', serif",
    "ds-font-size-3xl": "96px",
    "ds-font-size-2xl": "56px",
    "ds-font-size-xl": "49px",
    "ds-font-size-lg": "30px",
    "ds-font-size-md": "22px",
    "ds-font-size-base": "18px",
    "ds-font-size-sm": "14px",
    "ds-font-size-xs": "12px",
    "ds-font-weight-regular": "400",
    "ds-font-weight-medium": "500",
    "ds-font-weight-semibold": "600",
    "ds-font-weight-bold": "700",
    "ds-line-height-display": "1.09",
    "ds-line-height-heading": "1.165",
    "ds-line-height-body": "1.445",
    "ds-line-height-relaxed": "1.7",
    "ds-letter-spacing-display": "-0.0375em",
    "ds-letter-spacing-heading": "-0.0245em",
    "ds-letter-spacing-body": "-0.017em",
    "ds-letter-spacing-logo": "-0.0447em",
    "ds-letter-spacing-ornamental": "0.028em"
  },
  "fontFaces": [
    {
      "role": "display",
      "resolvedName": "Playfair Display",
      "weights": ["400"],
      "style": "italic",
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,500;1,700&display=swap"
    },
    {
      "role": "heading",
      "resolvedName": "Cormorant Garamond",
      "weights": ["400", "500", "600", "700"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap"
    },
    {
      "role": "body",
      "resolvedName": "Lora",
      "weights": ["400", "500", "600"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&display=swap"
    },
    {
      "role": "ornamental",
      "resolvedName": "Dancing Script",
      "weights": ["400", "500", "600", "700"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&display=swap"
    }
  ],
  "scale": {
    "h1": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "96px",
      "fontWeight": "400",
      "fontStyle": "italic",
      "lineHeight": "1.09",
      "letterSpacing": "-0.0375em"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "49px",
      "fontWeight": "500",
      "lineHeight": "1.165",
      "letterSpacing": "-0.0245em"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "30px",
      "fontWeight": "500",
      "lineHeight": "1.2",
      "letterSpacing": "-0.0245em"
    },
    "h4": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "22px",
      "fontWeight": "500",
      "lineHeight": "1.3",
      "letterSpacing": "-0.0245em"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "1.445"
    },
    "small": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "12px",
      "fontWeight": "400",
      "lineHeight": "1.4"
    },
    "ornamental": {
      "fontFamily": "var(--ds-font-family-ornamental)",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0.028em"
    }
  },
  "_twist": {
    "sourceSystem": "ochre-ledger",
    "intensity": 4,
    "twistDescription": "Art Nouveau / Maximalist transformation: replaced utilitarian sans-serif (Space Grotesk + Inter) with theatrical high-contrast serif stack. Playfair Display italic 96px h1 (theatrical display). Cormorant Garamond 500 h2-h4 (period-appropriate elegant serif). Lora 18px body (warm, readable). Dancing Script for ornamental accents. All Google Fonts CDN. Four @imports."
  }
}
