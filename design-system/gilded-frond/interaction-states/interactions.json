{
  "transition": {
    "default": "0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "fast": "0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "slow": "0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  },
  "button": {
    "primary": {
      "default": {
        "background": "#b0915b",
        "color": "#ffffff",
        "border": "none",
        "borderRadius": "0px",
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "fontFamily": "'Cormorant Garamond', serif",
        "fontWeight": "600",
        "fontSize": "0.85rem"
      },
      "hover": {
        "background": "#92723d",
        "boxShadow": "0 8px 24px rgba(176, 145, 91, 0.35)",
        "transform": "translateY(-1px)"
      },
      "active": {
        "transform": "scale(0.98)",
        "boxShadow": "0 2px 8px rgba(176, 145, 91, 0.2)"
      },
      "focus": {
        "outline": "2px solid #b0915b",
        "outlineOffset": "3px"
      }
    },
    "ghost": {
      "default": {
        "background": "transparent",
        "color": "#b0915b",
        "border": "2px solid #b0915b",
        "borderRadius": "0px"
      },
      "hover": {
        "background": "#b0915b",
        "color": "#ffffff",
        "boxShadow": "0 4px 16px rgba(176, 145, 91, 0.25)"
      },
      "active": {
        "transform": "scale(0.98)"
      },
      "focus": {
        "outline": "2px solid #b0915b",
        "outlineOffset": "3px"
      }
    }
  },
  "link": {
    "default": {
      "color": "#b0915b",
      "textDecoration": "none",
      "backgroundImage": "linear-gradient(to right, #b0915b, #b0915b)",
      "backgroundRepeat": "no-repeat",
      "backgroundPosition": "0 100%",
      "backgroundSize": "0% 2px"
    },
    "hover": {
      "backgroundSize": "100% 2px",
      "transition": "background-size 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    }
  },
  "card": {
    "default": {
      "transition": "0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "border": "1px solid rgba(176, 145, 91, 0.15)"
    },
    "hover": {
      "transform": "translateY(-3px)",
      "boxShadow": "0 16px 48px rgba(0, 0, 0, 0.08)",
      "borderColor": "rgba(176, 145, 91, 0.45)"
    }
  },
  "nav": {
    "link": {
      "default": {
        "color": "#161616",
        "letterSpacing": "0.06em",
        "backgroundImage": "linear-gradient(to right, #b0915b, #b0915b)",
        "backgroundSize": "0% 1px",
        "backgroundRepeat": "no-repeat",
        "backgroundPosition": "0 100%"
      },
      "hover": {
        "backgroundSize": "100% 1px",
        "transition": "background-size 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      }
    }
  },
  "_twist": {
    "sourceSystem": "ochre-tempo",
    "intensity": 3,
    "twistDescription": "Organic ease (0.25, 0.46, 0.45, 0.94) slows all interactions to 0.6s — considered, never hurried. Buttons lift (+translateY) with a gold warmth box-shadow rather than flat color change. Underline reveals use a drawn-in gold hairline (background-size 0→100%) — the quintessential Art Nouveau link gesture."
  }
}
