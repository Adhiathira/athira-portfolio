{
  "geometry": {
    "height": 62,
    "paddingInline": 60,
    "position": "absolute",
    "itemSpacing": 10,
    "heightScrolled": 60,
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "Inconsolata, monospace",
    "fontSize": "calc(1rem * 0.9)",
    "fontWeight": "400",
    "letterSpacing": null,
    "textTransform": null,
    "lineHeight": null
  },
  "linkHover": {
    "transition": "color 0.2s",
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "offset": "-5px",
      "animation": {
        "property": "transform",
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left top",
        "duration": "0.3s",
        "easing": null
      }
    }
  },
  "linkActive": {
    "selector": ".menu__item.is-visible > .navlink > .navtext::after",
    "indicator": "underline"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "has-scrolled",
    "propertiesChanged": [
      "position",
      "height"
    ],
    "duration": null,
    "easing": null,
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": null,
    "boxShadow": null,
    "padding": "10px 0px",
    "itemPadding": "6px 20px",
    "animation": "scaleY from 0 to 1, transform-origin center top, duration 0.2s; wrapper translateY(-10px) to 0 with opacity 0 to 1, transition-delay 0.3s"
  },
  "characterDescription": "A monospaced, editorial navigation with a restrained underline-reveal hover mechanic and a theatrical two-tier megamenu system featuring skew-transform text animations — blending utilitarian type with high-fashion gesture to signal a brand operating at the intersection of craft and digital culture."
}