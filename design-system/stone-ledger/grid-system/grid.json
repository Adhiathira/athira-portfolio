{
  "cssVars": {
    "grid-space": "calc((100% - 11 * var(--grid-gap)) / 12)",
    "grid-gap": "2vw"
  },
  "container": {
    "maxWidth": "1100px",
    "paddingLeft": "32px",
    "paddingRight": "32px",
    "marginLeft": "auto",
    "marginRight": "auto"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "9.45px",
      "alignItems": "center",
      "childCount": "4",
      "parentSection": "header"
    },
    "header-right": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "181.44px",
      "childCount": "3",
      "parentSection": "header"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 34.56px",
      "childCount": "3"
    },
    "content": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 34.56px",
      "childCount": "4"
    },
    "footer-main": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 34.56px",
      "childCount": "2"
    },
    "footer-bottom": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "normal 34.56px",
      "childCount": "4"
    }
  },
  "responsive": {
    "bp-380px": {
      "query": "(max-width: 380px)",
      "display": "none"
    },
    "bp-812px": {
      "query": "(max-width: 812px)",
      "gridTemplateColumns": "repeat(6, minmax(0px, 1fr))",
      "flexDirection": "column",
      "maxWidth": "none",
      "flexWrap": "wrap",
      "rowGap": "0.1em",
      "columnGap": "0px"
    },
    "bp-1000px": {
      "query": "(max-width: 1000px)",
      "gridTemplateColumns": "repeat(6, minmax(0px, 1fr))",
      "rowGap": "5em"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "3-column-nav",
      "description": "Full-width navigation bar split into three zones: logo left-aligned, links center, CTA right."
    },
    {
      "section": "hero",
      "layout": "editorial-centered",
      "description": "Hero uses a contained 1100px max-width with generous 32px padding, 12-column grid for precise content control."
    }
  ]
}
