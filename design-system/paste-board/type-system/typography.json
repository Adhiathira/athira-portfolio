{
  "fontFaces": [
    {
      "family": "Caveat",
      "weight": "400 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&display=swap",
      "resolvedName": "Caveat",
      "role": "handwriting — headlines, annotations, sticky note text"
    },
    {
      "family": "Playfair Display",
      "weight": "400 700",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap",
      "resolvedName": "Playfair Display",
      "role": "editorial serif — h2 section headings, pull quotes"
    },
    {
      "family": "Lora",
      "weight": "400 600",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&display=swap",
      "resolvedName": "Lora",
      "role": "warm serif — body copy, paragraph text"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "'Caveat', cursive",
      "fontSize": "clamp(3.5rem, 7vw, 6rem)",
      "fontWeight": "700",
      "lineHeight": "1.05",
      "letterSpacing": "-0.01em",
      "primaryFont": "Caveat",
      "notes": "Handwritten hero headline — large, casual, slightly irregular"
    },
    "h2": {
      "fontFamily": "'Playfair Display', serif",
      "fontSize": "clamp(2rem, 4vw, 3rem)",
      "fontWeight": "400",
      "lineHeight": "1.2",
      "letterSpacing": "0em",
      "primaryFont": "Playfair Display",
      "notes": "Editorial section heading — typeset serif, feels printed"
    },
    "h3": {
      "fontFamily": "'Caveat', cursive",
      "fontSize": "clamp(1.5rem, 2.5vw, 2rem)",
      "fontWeight": "600",
      "lineHeight": "1.15",
      "letterSpacing": "0em",
      "primaryFont": "Caveat",
      "notes": "Sub-heading in handwriting — feature card titles, step headings"
    },
    "body": {
      "fontFamily": "'Lora', serif",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.7",
      "letterSpacing": "0em",
      "primaryFont": "Lora",
      "notes": "Warm serif body — feels printed on paper"
    },
    "label": {
      "fontFamily": "'Caveat', cursive",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.4",
      "letterSpacing": "0em",
      "primaryFont": "Caveat",
      "notes": "Handwritten annotation — image captions, metadata labels"
    },
    "sticky": {
      "fontFamily": "'Caveat', cursive",
      "fontSize": "1rem",
      "fontWeight": "600",
      "lineHeight": "1.5",
      "letterSpacing": "0em",
      "primaryFont": "Caveat",
      "notes": "Sticky note text — post-it UI components, callouts"
    },
    "quote": {
      "fontFamily": "'Playfair Display', serif",
      "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
      "fontWeight": "400",
      "fontStyle": "italic",
      "lineHeight": "1.35",
      "letterSpacing": "0em",
      "primaryFont": "Playfair Display",
      "notes": "Pull quote — large italic serif"
    }
  },
  "_twist": {
    "sourceSystem": "custom",
    "twistApplied": "Scrapbook typographic contrast system — Caveat (handwriting) for h1/h3/labels/sticky, Playfair Display (editorial serif) for h2/quotes, Lora (warm serif) for body. The contrast between casual handwriting and typeset serif creates the collage's visual tension."
  }
}
