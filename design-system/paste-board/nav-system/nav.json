{
  "height": "72px",
  "background": {
    "default": "#f5f0e8",
    "scrolled": "#fff8e7"
  },
  "borderBottom": {
    "default": "2px solid rgba(44, 36, 22, 0.15)",
    "scrolled": "2px solid rgba(44, 36, 22, 0.22)"
  },
  "logo": {
    "fontFamily": "'Caveat', cursive",
    "fontSize": "1.625rem",
    "fontWeight": "700",
    "color": "#2c2416",
    "notes": "Handwritten logo style — casual brand mark"
  },
  "links": {
    "fontFamily": "'Lora', serif",
    "fontSize": "0.875rem",
    "fontWeight": "400",
    "color": "#2c2416",
    "textTransform": "none",
    "letterSpacing": "0em",
    "hoverColor": "#e85d2f",
    "notes": "Lowercase Lora serif — collage is casual, no uppercase forced"
  },
  "cta": {
    "fontFamily": "'Lora', serif",
    "fontSize": "0.875rem",
    "fontWeight": "600",
    "bg": "#e85d2f",
    "color": "#ffffff",
    "borderRadius": "4px",
    "padding": "8px 20px"
  },
  "transitions": {
    "background": "background-color 0.3s ease",
    "borderBottom": "border-color 0.3s ease"
  },
  "_twist": {
    "sourceSystem": "custom",
    "twistApplied": "Seamless paper nav — same warm off-white as page, felt-tipped border-bottom at 0.15 opacity, Caveat handwritten logo, Lora serif links not uppercase, scrolled state shifts to slightly lighter surface-light tone."
  }
}
