{
  "hover": {
    "card": {
      "transform": "rotate(0deg) translateY(-4px)",
      "boxShadow": "6px 6px 16px rgba(0, 0, 0, 0.18)",
      "transition": "transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease",
      "notes": "Card straightens (rotation → 0deg) and lifts — paper being picked up"
    },
    "button": {
      "transform": "scale(1.03)",
      "transition": "transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease",
      "notes": "Slight spring scale — physical press feel"
    },
    "link": {
      "textDecoration": "underline",
      "color": "var(--color-accent)",
      "transition": "color 0.2s ease"
    },
    "tape": {
      "transform": "rotate(-6deg) scale(1.05)",
      "transition": "transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "focus": {
    "outline": "2px dashed #e85d2f",
    "outlineOffset": "3px",
    "notes": "Dashed accent focus ring — feels hand-drawn"
  },
  "active": {
    "button": {
      "transform": "scale(0.97)",
      "transition": "transform 0.15s ease"
    }
  },
  "shadows": {
    "paper": "3px 3px 8px rgba(0, 0, 0, 0.12)",
    "paperLift": "4px 4px 0 rgba(0, 0, 0, 0.08)",
    "polaroid": "2px 4px 12px rgba(0, 0, 0, 0.18)",
    "cardHover": "6px 6px 16px rgba(0, 0, 0, 0.18)",
    "stickyNote": "2px 2px 6px rgba(0, 0, 0, 0.1)"
  },
  "borderRadius": {
    "card": "2px",
    "button": "4px",
    "stickyNote": "2px",
    "polaroid": "2px",
    "tape": "2px",
    "notes": "Max 2-4px — paper has tiny natural radius. No pill shapes."
  },
  "_twist": {
    "sourceSystem": "custom",
    "twistApplied": "Paper-physics interaction states — hover straightens rotated cards (key metaphor), spring easing throughout, dashed accent focus ring, allowed paper box-shadows only. All transitions use spring cubic-bezier(0.34, 1.56, 0.64, 1)."
  }
}
