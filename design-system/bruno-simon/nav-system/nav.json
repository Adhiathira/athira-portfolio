{
  "geometry": {
    "height": 44,
    "position": "fixed",
    "itemSpacing": 3,
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "opacity 0.3s"
  },
  "typography": {
    "fontFamily": "Nunito, sans-serif",
    "fontWeight": "400"
  },
  "linkHover": {
    "opacity": 0.8,
    "backgroundPill": false,
    "transition": "transform 0.15s, opacity 0.15s",
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".menu .navigation .item.is-active .button-inner",
    "indicator": "background fill"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "is-started",
    "propertiesChanged": [
      "display"
    ],
    "colorInversion": false
  },
  "dropdown": {
    "present": false
  },
  "characterDescription": "A game-UI-style radial-gradient panel navigation with a hidden trigger button that slides in from the right edge, featuring tab-style section tabs with upward hover lift animations and a matching close button — evoking an immersive full-screen overlay menu with cinematic game interface aesthetics."
}