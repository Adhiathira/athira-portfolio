{
  "cssVars": {
    "--container-max-width": "1440px",
    "--container-padding-inline": "22px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1420px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto",
    "--grid-formless-sticky-gap": "80px",
    "--grid-formless-2col-baseline-gap": "48px",
    "--grid-formless-4col-flex-gap": "32px",
    "--grid-formless-4col-bar-gap": "60px",
    "--grid-formless-section-large-gap": "164px"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "22px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0",
      "_note": "Full-bleed dark bg, text at bottom-left"
    },
    "ecosystem-cards": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "gritme-feature": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "unknown",
      "_note": "Left: text column, Right: product screenshot"
    },
    "testimonials": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    },
    "filter-pills": {
      "display": "flex",
      "gap": "8px",
      "columnCount": null
    },
    "blog-list": {
      "display": "flex",
      "flexDirection": "column",
      "columnCount": 1,
      "gap": null
    },
    "photoGrid": {
      "display": "absolute",
      "description": "Asymmetric two-column photo mosaic — left column 410px wide, right column 550px wide, staggered vertical offsets",
      "columnCount": 2,
      "gap": "staggered — not a uniform gap system",
      "_screen": "about-us"
    },
    "missionCentered": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "925px",
      "_screen": "about-us"
    },
    "bodyCopy": {
      "display": "centered",
      "templateColumns": "1fr",
      "columnCount": 1,
      "containerWidth": "785px",
      "_screen": "about-us"
    },
    "fullBleed": {
      "display": "full-width",
      "description": "Background layers, globe image, CTA section — span full 1440px+",
      "columnCount": null,
      "_screen": "about-us"
    },
    "tabBar": {
      "display": "flex",
      "justifyContent": "space-between",
      "width": "1146px",
      "height": "86px",
      "borderRadius": "20px",
      "_note": "3 tabs evenly distributed: For Businesses / For Individuals / For Community. Sticky/condensed as user scrolls.",
      "_screen": "landing-page-auditable-section"
    },
    "productSection": {
      "display": "grid",
      "templateColumns": "~33% 60%",
      "gap": "~64px",
      "_note": "Asymmetric split: left = numbered scroll-nav list, right = content panel card",
      "_screen": "landing-page-auditable-section"
    },
    "contentPanel": {
      "display": "flex",
      "flexDirection": "column",
      "width": "866px",
      "height": "640px",
      "borderRadius": "10px",
      "paddingInline": "~35px",
      "_source": "reverse-engineered from node coordinates",
      "_screen": "landing-page-auditable-section"
    },
    "partnersNav": {
      "display": "flex",
      "justifyContent": "space-between",
      "paddingInline": "74px",
      "height": "88px",
      "logoLeft": "74px",
      "navLinksLeft": "calc(54.17% - 42px)",
      "navLinksWidth": "408px",
      "navLinksGap": "45px",
      "_screen": "partners-page-view-1"
    },
    "partnersHero": {
      "display": "full-bleed",
      "height": "1051px",
      "headlineTop": "301.5px",
      "subtitleTop": "436px",
      "subtitleWidth": "850px",
      "_screen": "partners-page-view-1"
    },
    "partnersTabBar": {
      "display": "flex",
      "flexDirection": "column",
      "top": "1463px",
      "width": "1212px",
      "left": "114px",
      "tabCount": "3",
      "progressBarHeight": "3px",
      "progressBarColor": "#c6c6c6",
      "progressBarFillColor": "#00995e",
      "tab1Label": "Rapid-Growth Startups",
      "tab2Label": "AI-Transforming Companies",
      "tab3Label": "Multi-Disciplinary Talent Organizations",
      "_note": "3 equal-width tab labels spanning 1212px from left-[114px]. Progress bar 3px height above labels. Fill indicates active tab.",
      "_screen": "partners-page-view-1"
    },
    "partnerContent": {
      "display": "grid",
      "templateColumns": "~33% text / ~40% photo",
      "contentLeft": "114px",
      "textColumnWidthApprox": "33%",
      "photoColumnWidthApprox": "40%",
      "_note": "Left text column ~33% of canvas width, right photo overlay panel, asymmetric 2-column split anchored at left-[114px].",
      "_screen": "partners-page-view-1"
    },
    "useCases": {
      "display": "flex",
      "flexDirection": "column",
      "sectionTop": "2510px",
      "cardCount": "3",
      "cardWidth": "900.514px",
      "cardHeight": "311px",
      "cardLeft": "calc(37.5% + 24.26px)",
      "cardPadding": "40px",
      "_screen": "partners-page-view-1"
    },
    "whatWeProvide": {
      "display": "grid",
      "templateColumns": "480px 480px",
      "rows": "2",
      "gap": "30px",
      "cardHeight": "285px",
      "cardWidth": "480px",
      "col1Left": "225px",
      "col2Left": "735px",
      "iconCircleSize": "64px",
      "iconCircleBorderColor": "#9f9fa9",
      "_screen": "partners-page-view-1"
    },
    "apiBullets": {
      "display": "flex",
      "flexDirection": "row",
      "sectionTop": "2235px",
      "width": "1216px",
      "alignment": "center",
      "itemCount": "3",
      "itemWidth": "352px",
      "inferredGap": "80px",
      "_screen": "partners-page-view-1"
    },
    "featureBullets": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "itemsPerRow": "2",
      "rowWidth": "938px",
      "rows": "2",
      "_screen": "partners-page-view-1"
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  },
  "_darkModeLayout": {
    "type": "full-bleed",
    "canvasWidth": "1440px",
    "canvasBackground": "black",
    "columns": 12,
    "gutterLeft": "114px",
    "gutterRight": "114px",
    "contentWidth": "1212px",
    "_note": "Dark cinematic layout used by partners-page. Primary gutter 114px. Secondary inset 225px for 2x2 grid. Nav uses 74px left anchor. Enterprise/partners design mode.",
    "_screen": "partners-page-view-1"
  },
  "responsive": {
    "_note": "Responsive breakpoint system from formless. Griting had no breakpoint definitions. These align with standard modern responsive conventions and are compatible with griting's 1440px desktop-first canvas. The 1440px breakpoint is griting's primary design target.",
    "_source": "formless",
    "bp-640px": {
      "query": "(min-width: 640px)",
      "maxWidth": "640px"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "768px"
    },
    "bp-1024px": {
      "query": "(min-width: 1024px)",
      "maxWidth": "1024px",
      "display": "block",
      "gridTemplateColumns": "repeat(3, minmax(0px, 1fr))",
      "flexDirection": "row",
      "rowGap": "0px",
      "columnGap": "0px"
    },
    "bp-1280px": {
      "query": "(min-width: 1280px)",
      "maxWidth": "1280px",
      "rowGap": "106px",
      "columnGap": "106px"
    },
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "maxWidth": "1440px",
      "_note": "Griting primary canvas width — primary design target"
    }
  },
  "formlessLayouts": {
    "_note": "Formless-inspired structural layout variants incorporated into griting. Griting's 1440px max-width and 22px container paddingInline take precedence throughout.",
    "formless-editorial": {
      "display": "block",
      "marginInline": "244px",
      "maxWidth": "calc(100% - 488px)",
      "_description": "Formless's signature editorial column with 244px gutters. Used for text-heavy sections requiring premium whitespace. Griting primary container remains 1440px/22px."
    },
    "formless-two-column-split": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "gap": "48px",
      "alignItems": "flex-end",
      "_description": "Left column: large heading/CTA. Right column: body text at matching baseline. Spatial tension through deliberate asymmetry. Gap: 48px."
    },
    "formless-sticky-scroll": {
      "display": "sticky-panel-sequence",
      "panelCount": 3,
      "gap": "80px",
      "divider": "1px solid #1a1a1a",
      "leftColumn": "large-visual or 3D object",
      "rightColumn": "oversized-numeral + service-title + body",
      "_description": "Three sequential sticky panels with 80px gap. In griting context: used for GritMe Talent / Incubation / Mentorship sections with UI mockup on left, text on right, separated by thin vertical rule."
    },
    "formless-4col-flex-wrap": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "32px",
      "flexWrap": "wrap",
      "justifyContent": "center",
      "childCount": 4,
      "_description": "Wrappable 4-column flex row with 32px gap and center justification. In griting context: applicable to 'New Infrastructure' 4-pillar section or any 4-up card grid."
    },
    "formless-4col-bottom-aligned-bar": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "60px",
      "alignItems": "flex-end",
      "childCount": 4,
      "_description": "Bottom-aligned 4-item row with 60px gap. Used in formless for the nav/bar row. In griting context: applicable as an alternative footer bar or top-strip pattern."
    },
    "formless-overlapping-grid": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "overlap": true,
      "verticalOffset": "staggered",
      "_description": "Three overlapping cards with staggered vertical positions. Anchored by large display headline spanning full width above. In griting context: use for testimonials section."
    },
    "formless-full-width-lockup": {
      "display": "flex",
      "justifyContent": "center",
      "alignItems": "center",
      "width": "100vw",
      "typography": "display-scale (80px)",
      "_description": "Full-viewport-width brand lockup that appears at (1) bottom of hero and (2) terminal footer. Creates a visual frame that opens and closes the page. In griting: shows 'GRITING' wordmark at display scale."
    }
  },
  "layout-tree": {
    "_ref": "See layout-tree.json for full section-by-section tree. Formless layout variants (formless-editorial, formless-two-column-split, formless-sticky-scroll, formless-overlapping-grid, formless-full-width-lockup) are available as named classes — see formlessLayouts above and grid.css."
  }
}
