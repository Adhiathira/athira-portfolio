{
  "_merge": {
    "sources": ["griting", "formless"],
    "dominant": "griting",
    "strategy": "All griting interaction states kept verbatim. Three formless patterns added: ghost→fill button (green-adapted), opacity-link (opacity:0.6 hover), card scale-on-hover (scale(1.025), 0.5s cubic-bezier(0.4,0,0.2,1))."
  },
  "buttons": {
    "primary": {
      "selector": "CTA button — Get in Touch / Try It Now",
      "default": {
        "background": "linear-gradient(90deg, #00693e, #00693e)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#003620",
        "boxShadow": "0px 1px 2px -1px rgba(9,6,63,0.4), 0px 0px 0px 1px #003620, inset 0px 1px 0px 0px rgba(255,255,255,0.16)",
        "fontSize": "18px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "letterSpacing": "-0.18px"
      },
      "hover": {
        "background": "linear-gradient(90deg, #008050, #008050)",
        "color": "#ffffff",
        "_inferred": true,
        "_note": "Hover state not shown in static Figma — inferred as slightly lighter brand green"
      },
      "active": {
        "background": "linear-gradient(90deg, #003620, #003620)",
        "color": "#ffffff",
        "_inferred": true
      }
    },
    "outline": {
      "selector": "Outline button — Learn More / Book Demo",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "borderColor": "#00693e",
        "_inferred": true,
        "_note": "Hover not shown in static Figma — inferred as doubled bg opacity"
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "outline-on-light": {
      "selector": "Outline button on light background (Book Demo in feature sections)",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#000000",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "_note": "Black text — used on light (#f5f6f5) backgrounds"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "color": "#000000",
        "_inferred": true
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "share-icon": {
      "selector": "Social share icon buttons",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "rgba(209,213,219,0.5)",
        "borderRadius": "40px",
        "size": "48px"
      },
      "hover": { "background": "#e5e7e5", "_inferred": true }
    },
    "filter-pill-active": {
      "selector": "Active category filter pill",
      "default": {
        "background": "#00693e",
        "color": "#ffffff",
        "borderRadius": "9999px",
        "borderColor": null,
        "height": "36px",
        "paddingInline": "16px"
      },
      "hover": { "background": "#004d2e", "color": "#ffffff" },
      "active": { "background": "#003d25", "color": "#ffffff" }
    },
    "filter-pill-inactive": {
      "selector": "Inactive category filter pill",
      "default": {
        "background": "#f3f4f3",
        "color": "#000000",
        "borderRadius": "9999px",
        "borderColor": "#e4e4e7",
        "height": "36px",
        "paddingInline": "16px"
      },
      "hover": { "background": "#e8e8e8", "color": "#031f18" },
      "active": { "background": "#d4d4d4", "color": "#031f18" }
    },
    "primary-cta": {
      "selector": "Get in Touch button (landing-page-auditable-section)",
      "default": {
        "background": "#00693e",
        "color": "#ffffff",
        "borderRadius": "8px",
        "boxShadow": "0px 1px 2px -1px rgba(9,6,63,0.4), 0px 0px 0px 1px #3960f9, inset 0px 1px 0px 0px rgba(255,255,255,0.16)",
        "height": "52px",
        "width": "154px",
        "fontSize": "18px",
        "fontFamily": "Inter Variable",
        "letterSpacing": "-0.18px"
      },
      "hover": { "background": "#005c35", "color": "#ffffff", "_inferred": true },
      "active": { "background": "#004d2c", "color": "#ffffff", "_inferred": true },
      "_screen": "landing-page-auditable-section"
    },
    "secondary-outline": {
      "selector": "Book Demo button (landing-page-auditable-section)",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#000000",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "height": "52px",
        "fontSize": "17px",
        "fontFamily": "Inter Variable"
      },
      "hover": { "background": "rgba(0,105,62,0.12)", "color": "#000000", "_inferred": true },
      "active": { "background": "rgba(0,105,62,0.18)", "color": "#000000", "_inferred": true },
      "_screen": "landing-page-auditable-section"
    },
    "hero-primary": {
      "selector": "Start a Pilot with Us — frosted glass gradient button (partners-page)",
      "default": {
        "background": "linear-gradient(to bottom, rgba(255,255,255,0.75), rgba(255,255,255,0.56))",
        "color": "#000000",
        "borderRadius": "8px",
        "borderColor": "#ffffff",
        "borderWidth": "1px",
        "paddingBlock": "15px",
        "paddingInline": "21px",
        "fontSize": "24px",
        "fontFamily": "Inter",
        "fontWeight": "500",
        "gap": "12px",
        "boxShadow": "0px 1px 0px 0px rgba(0,0,0,0.05), 0px 4px 4px 0px rgba(0,0,0,0.05), 0px 10px 10px 0px rgba(0,0,0,0.1)",
        "hasGlowDecoration": true,
        "glowDescription": "Conic gradient glow behind button, blur-[10px], mix-blend-screen, opacity-20"
      },
      "hover": { "background": "rgba(255,255,255,0.85)", "_inferred": true },
      "_screen": "partners-page-view-1"
    },
    "ghost-glass": {
      "selector": "Join waitlist / Sample Readiness Report / Join Program / Start journey (partners-page)",
      "default": {
        "background": "rgba(255,255,255,0.02)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#ffffff",
        "borderWidth": "1px",
        "paddingBlock": "6px",
        "paddingInline": "16px",
        "fontSize": "18px",
        "fontFamily": "Inter",
        "fontWeight": "500",
        "gap": "8px",
        "height": "50px",
        "backdropFilter": "blur(10px)",
        "boxShadow": "0px 1px 22px 0px rgba(255,255,255,0.1), 0px 4px 4px 0px rgba(0,0,0,0.05), 0px 10px 10px 0px rgba(0,0,0,0.1)",
        "innerShadow": "inset 0px 1px 3px 0px rgba(199,220,255,0.35), inset 0px 0px 20px 0px rgba(198,204,255,0.2)"
      },
      "hover": { "background": "rgba(255,255,255,0.08)", "_inferred": true },
      "_screen": "partners-page-view-1"
    },
    "tab-active": {
      "selector": "Active tab text button (partners-page)",
      "default": {
        "fontFamily": "Inter",
        "fontWeight": "600",
        "fontSize": "24px",
        "color": "#f4f2f0",
        "background": "none",
        "border": "none",
        "activeIndicator": { "background": "#00995e", "_note": "Progress bar fill beneath active tab" }
      },
      "_screen": "partners-page-view-1"
    },
    "tab-inactive": {
      "selector": "Inactive tab text buttons (partners-page)",
      "default": {
        "fontFamily": "Inter",
        "fontWeight": "500",
        "fontSize": "24px",
        "color": "#f4f2f0",
        "background": "none",
        "border": "none",
        "_note": "Inactive tabs share #f4f2f0 color with active — only font weight distinguishes state (500 vs 600)"
      },
      "_screen": "partners-page-view-1"
    },
    "formless-ghost-fill": {
      "selector": "Ghost→fill CTA button (from formless, adapted to griting green palette)",
      "_source": "formless — ghost-to-fill primary CTA pattern, colors adapted to griting (#00693e)",
      "default": {
        "background": "transparent",
        "color": "#00693e",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "transition": "background-color 0.3s cubic-bezier(0.4,0,0.2,1), color 0.3s cubic-bezier(0.4,0,0.2,1), border-color 0.3s cubic-bezier(0.4,0,0.2,1)",
        "_note": "Transparent background with griting green border. Fills solid on hover, inverting text to white."
      },
      "hover": {
        "background": "#00693e",
        "color": "#ffffff",
        "borderColor": "#00693e",
        "_note": "Solid fill to griting green; text inverts to white"
      },
      "active": {
        "background": "#003620",
        "color": "#ffffff",
        "borderColor": "#003620",
        "_inferred": true
      }
    }
  },
  "links": {
    "nav": {
      "selector": "Navigation links",
      "default": { "color": "#ffffff", "textDecoration": "none", "fontSize": "16px", "fontFamily": "Inter" },
      "hover": { "color": "#ffffff", "textDecoration": "underline", "_inferred": true }
    },
    "nav-on-light": {
      "selector": "Navigation links on white background",
      "default": { "color": "#455451", "textDecoration": "none", "fontSize": "16px", "fontFamily": "Inter" },
      "hover": { "color": "#031f18", "textDecoration": "none", "_inferred": true }
    },
    "back-button": {
      "selector": "← All Post back navigation",
      "default": { "color": "#202b38", "textDecoration": "none", "fontSize": "16px" },
      "hover": { "color": "#031f18", "_inferred": true }
    },
    "article-title": {
      "selector": "Blog article title link",
      "default": { "color": "#031f18", "textDecoration": "underline" },
      "hover": { "color": "#00693e", "textDecoration": "underline", "_note": "hover color inferred" }
    },
    "formless-opacity-link": {
      "selector": "Nav and icon links using opacity fade on hover (from formless)",
      "_source": "formless — nav/icon link opacity:0.6 hover pattern",
      "default": {
        "color": "#ffffff",
        "opacity": 1,
        "textDecoration": "none",
        "transition": "opacity 0.3s cubic-bezier(0.4,0,0.2,1)",
        "_note": "No color change on hover — opacity alone signals interactivity. Use on dark backgrounds."
      },
      "hover": {
        "color": "#ffffff",
        "opacity": 0.6
      },
      "active": {
        "color": "#ffffff",
        "opacity": 0.6
      }
    }
  },
  "inputs": {
    "search": {
      "selector": "Blog search input",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "#d1d5db",
        "borderRadius": "10px",
        "placeholderColor": "#71717b",
        "height": "40px"
      },
      "focus": { "borderColor": "#00693e", "_note": "focus border color inferred" }
    }
  },
  "tabs": {
    "scroll-tab": {
      "active": { "color": "#00693e", "fontWeight": "600", "background": "white" },
      "inactive": { "color": "#031f18", "fontWeight": "600", "background": "transparent" },
      "inactive-secondary": { "color": "#000000", "fontWeight": "600", "background": "transparent" },
      "_screen": "landing-page-auditable-section"
    },
    "partner-tab": {
      "active": { "fontWeight": "600", "color": "#f4f2f0", "fontSize": "24px", "progressBarFill": "#00995e" },
      "inactive": { "fontWeight": "500", "color": "#f4f2f0", "fontSize": "24px" },
      "_screen": "partners-page-view-1"
    }
  },
  "numberedList": {
    "active": {
      "color": "#031f18",
      "opacity": 1,
      "bulletBackground": "#00693e",
      "bulletSize": "12px",
      "_screen": "landing-page-auditable-section"
    },
    "inactive": {
      "color": "rgba(3,31,24,0.6)",
      "opacity": 0.6,
      "bulletBackground": "none",
      "_screen": "landing-page-auditable-section"
    }
  },
  "progressBar": {
    "track": { "background": "#c6c6c6", "height": "3px" },
    "fill": {
      "background": "#00995e",
      "widthForTab1": "366px",
      "widthForTab3": "383px",
      "leftForTab3": "829px",
      "totalWidth": "1212px",
      "_note": "Tab 1 (left third): fill 366px. Tab 3 (right third): fill left-[829px] w-[383px].",
      "_screen": "partners-page-view-1"
    }
  },
  "cards": {
    "formless-card-hover": {
      "selector": "Cards with scale-on-hover lift (from formless)",
      "_source": "formless — card hover scale pattern",
      "default": {
        "transition": "transform 0.5s cubic-bezier(0.4,0,0.2,1)",
        "_note": "Parent must have overflow:hidden. Apply transition to the card's inner content element."
      },
      "hover": {
        "transform": "scale(1.025)",
        "_note": "Subtle scale lift adds dimensionality. 0.5s duration gives deliberate, premium feel."
      }
    }
  }
}
