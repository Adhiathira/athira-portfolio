{
  "cssVars": {
    "ds-font-family-display": "'JetBrains Mono', monospace",
    "ds-font-family-heading": "'JetBrains Mono', monospace",
    "ds-font-family-body": "'IBM Plex Mono', monospace",
    "ds-font-family-mono": "'JetBrains Mono', monospace",
    "ds-font-size-3xl": "clamp(1.75rem, 4vw, 2.5rem)",
    "ds-font-size-2xl": "clamp(1.25rem, 3vw, 1.5rem)",
    "ds-font-size-xl": "1.125rem",
    "ds-font-size-lg": "1rem",
    "ds-font-size-md": "0.9375rem",
    "ds-font-size-base": "0.875rem",
    "ds-font-size-sm": "0.8125rem",
    "ds-font-size-xs": "0.75rem",
    "ds-font-weight-regular": "400",
    "ds-font-weight-medium": "500",
    "ds-font-weight-semibold": "600",
    "ds-font-weight-bold": "700",
    "ds-line-height-tight": "1.1",
    "ds-line-height-snug": "1.3",
    "ds-line-height-normal": "1.5",
    "ds-line-height-relaxed": "1.6",
    "ds-letter-spacing-tight": "-0.02em",
    "ds-letter-spacing-normal": "0em",
    "ds-letter-spacing-wide": "0.05em",
    "ds-letter-spacing-wider": "0.1em",
    "ds-letter-spacing-widest": "0.15em"
  },
  "fontFaces": [
    {
      "role": "heading",
      "resolvedName": "JetBrains Mono",
      "weights": ["400", "500", "600", "700"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    },
    {
      "role": "body",
      "resolvedName": "IBM Plex Mono",
      "weights": ["400", "500"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
    }
  ],
  "scale": {
    "h1": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "clamp(1.75rem, 4vw, 2.5rem)",
      "fontWeight": "700",
      "lineHeight": "1.1",
      "letterSpacing": "-0.02em",
      "textTransform": "none"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "1.5rem",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0em",
      "textTransform": "none"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "1.125rem",
      "fontWeight": "500",
      "lineHeight": "1.3",
      "letterSpacing": "0em",
      "textTransform": "none"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0em"
    },
    "small": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "0.8125rem",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0em"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "0.75rem",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.1em",
      "textTransform": "uppercase"
    },
    "code": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0em"
    }
  },
  "_twist": {
    "sourceSystem": "null-signal",
    "intensity": 5,
    "twistDescription": "Full monospace stack — no proportional fonts. JetBrains Mono for all headings (h1 700 -0.02em, h2 600, h3 500). IBM Plex Mono for body (0.875rem, 1.6 line-height — terminal-readable). Labels: JetBrains Mono 0.75rem uppercase 0.1em tracking. Code: JetBrains Mono 0.875rem. Fluid type via clamp() for h1. Two Google Fonts CDN imports. Zero serif fonts — this is a machine interface."
  }
}
