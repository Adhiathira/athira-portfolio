{
  "geometry": {
    "height": 48,
    "heightScrolled": 48,
    "paddingInline": 40,
    "paddingBlock": 0,
    "position": "fixed",
    "itemSpacing": 24,
    "logoPosition": "left",
    "alignment": "right"
  },
  "background": {
    "color": "#1a1a1a",
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": "1px solid rgba(57, 255, 20, 0.4)",
    "borderBottomScrolled": "1px solid rgba(57, 255, 20, 0.8)",
    "boxShadow": null,
    "boxShadowScrolled": "0 1px 16px rgba(57, 255, 20, 0.08)",
    "transition": "border-color 80ms step-start"
  },
  "typography": {
    "fontFamily": "'JetBrains Mono', monospace",
    "fontSize": "0.75rem",
    "fontWeight": "600",
    "letterSpacing": "0.1em",
    "textTransform": "uppercase",
    "lineHeight": "1.2"
  },
  "logo": {
    "prefix": ">_",
    "fontFamily": "'JetBrains Mono', monospace",
    "fontWeight": "700",
    "fontSize": "0.875rem",
    "letterSpacing": "-0.02em",
    "color": "#39ff14"
  },
  "linkHover": {
    "color": "#39ff14",
    "transition": "color 80ms step-start",
    "underline": null
  },
  "linkActive": {
    "color": "#39ff14",
    "fontWeight": "700"
  },
  "scrollTransition": {
    "mechanism": "class",
    "triggerClass": "scrolled",
    "propertiesChanged": ["borderBottomColor", "boxShadow"],
    "duration": "80ms",
    "easing": "step-start"
  },
  "dropdown": {
    "present": false
  },
  "mobileMenu": {
    "toggleIcon": "≡",
    "background": "#0d0d0d",
    "border": "1px solid rgba(57, 255, 20, 0.4)",
    "linkColor": "#d4d4d4",
    "linkHoverColor": "#39ff14",
    "fontFamily": "'JetBrains Mono', monospace",
    "fontSize": "0.875rem",
    "padding": "24px"
  },
  "characterDescription": "Terminal top bar — 48px height, phosphor green bottom border (0.4 → 0.8 on scroll). JetBrains Mono 0.75rem uppercase, 0.1em tracking. Logo has >_ prefix in #39ff14. Background #1a1a1a (slightly lighter than #0d0d0d page). Nav links #d4d4d4 → #39ff14 on hover. Transition: 80ms step-start — instant, machine-like.",
  "_twist": {
    "sourceSystem": "null-signal",
    "intensity": 5,
    "description": "Terminal nav bar. 48px compact. #1a1a1a surface. Phosphor green bottom edge border (1px solid). JetBrains Mono 0.75rem uppercase. Logo: >_ BRAND in phosphor green. Link hover: color snaps to #39ff14 at 80ms step-start. No hamburger — ≡ symbol for mobile. Zero blur effects."
  }
}
