{
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#39ff14",
        "color": "#0d0d0d",
        "borderColor": "#39ff14",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "0",
        "outlineWidth": "0px",
        "fontFamily": "'JetBrains Mono', monospace",
        "fontWeight": "600",
        "fontSize": "0.75rem",
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 80ms step-start"
      },
      "hover": {
        "backgroundColor": "#0d0d0d",
        "color": "#39ff14",
        "borderColor": "#39ff14",
        "boxShadow": "0 0 8px rgba(57, 255, 20, 0.5), inset 0 0 0 1px #39ff14",
        "transition": "all 80ms step-start"
      },
      "active": {
        "backgroundColor": "#39ff14",
        "color": "#0d0d0d",
        "transform": "none",
        "transition": "all 80ms step-start"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "3px",
        "outlineColor": "#39ff14",
        "outlineStyle": "dashed",
        "transition": "all 80ms step-start"
      },
      "disabled": {
        "opacity": "0.3",
        "cursor": "not-allowed"
      }
    },
    "ghost": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#39ff14",
        "borderColor": "#39ff14",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "0",
        "outlineWidth": "0px",
        "fontFamily": "'JetBrains Mono', monospace",
        "fontWeight": "600",
        "fontSize": "0.75rem",
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 80ms step-start"
      },
      "hover": {
        "backgroundColor": "#39ff14",
        "color": "#0d0d0d",
        "borderColor": "#39ff14",
        "transition": "all 80ms step-start"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "3px",
        "outlineColor": "#39ff14",
        "outlineStyle": "dashed",
        "transition": "all 80ms step-start"
      },
      "disabled": {
        "opacity": "0.3",
        "cursor": "not-allowed"
      }
    }
  },
  "inputs": {
    "default": {
      "backgroundColor": "#111111",
      "color": "#d4d4d4",
      "borderColor": "rgba(57, 255, 20, 0.2)",
      "borderWidth": "1px",
      "borderRadius": "0",
      "fontFamily": "'IBM Plex Mono', monospace",
      "fontSize": "0.875rem",
      "transition": "all 80ms step-start"
    },
    "focus": {
      "outlineWidth": "1px",
      "outlineOffset": "2px",
      "outlineColor": "#39ff14",
      "outlineStyle": "dashed",
      "borderColor": "#39ff14",
      "transition": "all 80ms step-start"
    },
    "disabled": {
      "opacity": "0.3",
      "cursor": "not-allowed"
    }
  },
  "links": {
    "default": {
      "color": "#d4d4d4",
      "textDecoration": "none",
      "transition": "color 80ms step-start"
    },
    "hover": {
      "color": "#39ff14",
      "transition": "color 80ms step-start"
    },
    "active": {
      "color": "#39ff14"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid rgba(57, 255, 20, 0.2)",
      "backgroundColor": "#111111",
      "boxShadow": "none",
      "borderRadius": "0",
      "transition": "all 80ms step-start"
    },
    "hover": {
      "border": "1px solid #39ff14",
      "backgroundColor": "#141414",
      "boxShadow": "0 0 12px rgba(57, 255, 20, 0.15)",
      "transition": "all 80ms step-start"
    }
  },
  "navigation": {
    "link": {
      "default": {
        "color": "#d4d4d4",
        "transition": "color 80ms step-start"
      },
      "hover": {
        "color": "#39ff14",
        "transition": "color 80ms step-start"
      },
      "active": {
        "color": "#39ff14",
        "fontWeight": "700"
      }
    }
  },
  "_twist": {
    "sourceSystem": "null-signal",
    "intensity": 5,
    "twistDescription": "Terminal cursor + highlight states. Hover: text switches to accent phosphor green (#39ff14), no background change for links. Active/selected: reverse — background becomes accent, text becomes dark. Focus: 1px dashed phosphor outline at 3px offset (terminal-style dashed focus, not solid rounded). Disabled: opacity 0.3, cursor not-allowed. Transition: 80ms step-start — snappy, mechanical, instant. Zero border-radius. Primary button hover inverts: green→black background swap (reverse video — classic terminal selection). Ghost hover fills with phosphor green."
  }
}
