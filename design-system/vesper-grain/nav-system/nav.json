{
  "geometry": {
    "height": 24,
    "paddingInline": 0,
    "position": "fixed",
    "itemSpacing": 71.5,
    "logoPosition": "center",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": "1px solid",
    "borderBottomScrolled": "1px solid currentcolor",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "0.5s"
  },
  "typography": {
    "fontFamily": null,
    "fontSize": "0.9375rem",
    "fontWeight": null,
    "letterSpacing": "0.5px",
    "textTransform": "uppercase",
    "lineHeight": "1rem"
  },
  "linkHover": {
    "transition": null,
    "underline": {
      "type": "none"
    }
  },
  "linkActive": null,
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "hide-header",
    "propertiesChanged": [
      "transform",
      "opacity"
    ],
    "duration": "0.5s",
    "easing": null,
    "colorInversion": false
  },
  "dropdown": {
    "present": false
  },
  "characterDescription": "A restrained, editorial navigation with uppercase typography and fluid responsive scaling across breakpoints. The hide-on-scroll mechanism conveys a refined, gallery-like quietness — function receding to let content lead."
}
