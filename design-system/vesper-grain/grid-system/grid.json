{
  "cssVars": {
    "consent-studio-modal-max-width": "720px"
  },
  "container": {
    "maxWidth": "921.6px"
  },
  "grids": {
    "grid-1": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "25.805px",
      "justifyContent": "center",
      "alignItems": "flex-start",
      "childCount": "6"
    }
  },
  "responsive": {
    "bp-540px": {
      "query": "screen and (min-width: 540px)",
      "display": "flex",
      "rowGap": "2.8em",
      "columnGap": "2.8em",
      "flexDirection": "column",
      "gridTemplateColumns": "1fr"
    },
    "bp-600px": {
      "query": "(max-width: 600px)",
      "display": "block",
      "maxWidth": "100vw"
    },
    "bp-650px": {
      "query": "only screen and (min-width: 650px)",
      "maxWidth": "max(31.3rem, 33.3333vw)"
    },
    "bp-700px": {
      "query": "only screen and (min-width: 700px)",
      "display": "grid",
      "gridTemplateColumns": "1fr 1fr 360px",
      "maxWidth": "472px",
      "flexDirection": "column",
      "flexWrap": "wrap"
    },
    "bp-767px": {
      "query": "only screen and (max-width: 767px)",
      "maxWidth": "none",
      "flexDirection": "column",
      "display": "none"
    },
    "bp-768px": {
      "query": "only screen and (min-width: 768px)",
      "maxWidth": "88.8889vw",
      "display": "block",
      "rowGap": "1.55556vw",
      "columnGap": "1.55556vw"
    },
    "bp-1000px": {
      "query": "only screen and (min-width: 1000px)",
      "display": "flex",
      "gridTemplateColumns": "2fr 1fr",
      "rowGap": "33.6px",
      "columnGap": "33.6px"
    },
    "bp-1023px": {
      "query": "only screen and (max-width: 1023px)",
      "maxWidth": "94.4444vw",
      "flexDirection": "column"
    }
  },
  "visual": [
    {
      "section": "primary-nav",
      "layout": "three-zone-horizontal",
      "description": "Navigation splits into three zones: hamburger+Search on left, centered logo, and utility icons on right."
    },
    {
      "section": "hero",
      "layout": "full-width-media-with-overlay-controls",
      "description": "Full-viewport-width video/image hero with a pause control bottom-left."
    },
    {
      "section": "category-scroll",
      "layout": "horizontal-equal-columns",
      "description": "Equal-width columns each containing a product image above a category label."
    },
    {
      "section": "feature-split",
      "layout": "two-column-equal-media",
      "description": "Full-width row divided into two equal halves, each filled edge-to-edge with a product photograph."
    },
    {
      "section": "editorial-text",
      "layout": "two-column-media-text",
      "description": "Left column is a full-bleed product photo; right column contains label, headline, body, and link."
    },
    {
      "section": "footer",
      "layout": "two-zone-horizontal",
      "description": "Footer places social icons left and legal links plus copyright right, on a dark background."
    }
  ]
}
