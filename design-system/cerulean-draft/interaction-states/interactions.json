{
  "buttons": {
    "default-button-1": {
      "selector": "button",
      "default": {
        "opacity": "1",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      },
      "disabled": {
        "opacity": "0.4",
        "cursor": "not-allowed",
        "pointerEvents": "none"
      }
    }
  },
  "inputs": {
    "default-input": {
      "selector": "input, textarea",
      "default": {
        "borderColor": "rgba(27, 27, 55, 0.2)",
        "borderWidth": "0 0 1px 0",
        "outlineWidth": "0px",
        "transition": "border-color 0.2s ease-in-out"
      },
      "focus": {
        "borderColor": "rgba(27, 27, 55, 1)",
        "outlineWidth": "0px"
      }
    }
  },
  "links": {
    "default-link": {
      "selector": "a",
      "default": {
        "opacity": "1",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      }
    },
    "nav-link": {
      "selector": "nav a",
      "default": {
        "opacity": "1",
        "fontWeight": "400",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      },
      "hover": {
        "opacity": "0.75",
        "fontWeight": "400",
        "transition": "opacity 0.2s ease-in-out",
        "cursor": "pointer"
      }
    }
  },
  "cards": {
    "default-card": {
      "selector": ".card",
      "default": {
        "opacity": "1",
        "transition": "opacity 0.3s ease-in-out, transform 0.3s ease-in-out",
        "cursor": "pointer"
      },
      "hover": {
        "opacity": "0.75",
        "transform": "translateY(-2px)",
        "transition": "opacity 0.3s ease-in-out, transform 0.3s ease-in-out",
        "cursor": "pointer"
      }
    }
  },
  "navigation": {
    "primary-nav-link": {
      "selector": "nav a",
      "default": {
        "opacity": "1",
        "fontWeight": "400",
        "transition": "opacity 0.2s ease-in-out"
      },
      "hover": {
        "opacity": "0.75",
        "fontWeight": "400",
        "transition": "opacity 0.2s ease-in-out"
      }
    }
  },
  "_twist": {
    "type": "D",
    "description": "Hover opacity injection at intensity 3: opacity 0.75 applied to all hover states for links, nav links, buttons, and cards. Unified opacity-fade hover vocabulary across the interaction system. Transition timing 0.2s ease-in-out retained from botanist source.",
    "sourceSystem": "botanist"
  }
}
