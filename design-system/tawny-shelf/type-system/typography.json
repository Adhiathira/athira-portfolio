{
  "_meta": {
    "sourceSystem": "apple",
    "agentIndex": 2,
    "intensity": 3,
    "twist": "B. Letter spacing injection — 0.06em added as --font-letter-spacing-heading; all Apple proprietary fonts (SF Pro Text, SF Pro Display) replaced with Google Fonts: DM Sans for body/nav roles, Cormorant Garamond for display/editorial roles (both found in known-google-fonts.md). All woff2 src blocks replaced with Google Fonts CDN @import."
  },
  "cssVars": {
    "font-primary": "DM Sans",
    "font-secondary": "Cormorant Garamond",
    "font-mono": "JetBrains Mono",
    "font-letter-spacing-heading": "0.06em",
    "font-letter-spacing-body": "-0.01em",
    "sk-body-text-color": "rgb(29, 29, 31)",
    "sk-headline-text-color": "rgb(29, 29, 31)",
    "sk-body-background-color": "rgb(255, 255, 255)",
    "sk-body-font-stack": "text",
    "sk-body-link-color": "rgb(0, 102, 204)",
    "sk-footnote-font-size": "0.6em"
  },
  "fontFaces": [
    {
      "family": "DM Sans",
      "weight": "300 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&display=swap",
      "resolvedName": "DM Sans",
      "webAccessible": true,
      "googleFonts": true
    },
    {
      "family": "Cormorant Garamond",
      "weight": "300 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Cormorant Garamond",
      "webAccessible": true,
      "googleFonts": true
    },
    {
      "family": "JetBrains Mono",
      "weight": "400",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&display=swap",
      "resolvedName": "JetBrains Mono",
      "webAccessible": true,
      "googleFonts": true
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Cormorant Garamond, Georgia, serif",
      "fontSize": "64px",
      "fontWeight": "600",
      "lineHeight": "68px",
      "letterSpacing": "0.06em",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "h2": {
      "fontFamily": "Cormorant Garamond, Georgia, serif",
