{
  "cssVars": {
    "tile-max-width": "300px"
  },
  "container": {
    "maxWidth": "663px"
  },
  "grids": {
    "primary-12col": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "24px",
      "parentSection": "section"
    },
    "feature-2col": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "columnCount": "2",
      "gap": "24px",
      "parentSection": "section"
    },
    "feature-asymmetric": {
      "display": "grid",
      "templateColumns": "55.5% 44.5%",
      "columnCount": "2",
      "gap": "24px",
      "parentSection": "section"
    }
  },
  "responsive": {
    "bp-320px": {
      "query": "only screen and (max-width: 320px)",
      "display": "none"
    },
    "bp-640px": {
      "query": "only screen and (max-width: 640px)",
      "flexDirection": "column",
      "display": "block"
    },
    "bp-734px": {
      "query": "only screen and (max-width: 734px)",
      "maxWidth": "100%",
      "display": "none",
      "flexDirection": "column",
      "rowGap": "0px",
      "gridTemplateColumns": "repeat(9, minmax(80px, 92px))"
    },
    "bp-834px": {
      "query": "only screen and (min-width: 834px)",
      "display": "contents"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-horizontal-nav",
      "description": "Single-row navigation bar spanning full width with logo left-anchored, evenly spaced text links across the center, and action items on the far right."
    },
    {
      "section": "hero-editorial",
      "layout": "full-width-centered-stacked-text",
      "description": "Tight editorial container (663px max-width) with centered headline stacked above supporting body, with media anchored below fold."
    },
    {
      "section": "feature-cards",
      "layout": "asymmetric-2-column-cards",
      "description": "Two-column asymmetric grid with feature text on one side and media on the other, alternating direction per row."
    }
  ],
  "_twist": {
    "sourceSystem": "lumen-draft",
    "twistApplied": "Container max-width adjustment at intensity 2 — tightened by 15%: 780px → 663px. Creates a more editorial, constrained reading column.",
    "intensity": 2
  }
}
