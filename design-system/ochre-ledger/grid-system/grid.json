{
  "_source": "cerulean-draft",
  "_twist": "B. Gap value scaling (intensity 3, ×1.4): featured-post grid gap scaled 40px → 56px. Creates more generous white space between split-column editorial layouts, reinforcing the ochre-ledger breathing-room aesthetic. No color values changed.",
  "cssVars": {
    "--container-max-width": "1296px",
    "--container-padding-inline": "22px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-gap-features": "unknown",
    "--section-width": "1274px",
    "--grid-blog-featured-columns": "60fr 40fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto",
    "--grid-featured-gap": "56px"
  },
  "container": {
    "maxWidth": "1296px",
    "paddingInline": "22px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "unknown"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0",
      "_note": "Full-width, text anchored bottom-left"
    },
    "features": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "unknown"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "60fr 40fr",
      "columnCount": 2,
      "gap": "56px",
      "_twist": "gap scaled 40px → 56px (×1.4, intensity 3)"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "unknown"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  }
}
