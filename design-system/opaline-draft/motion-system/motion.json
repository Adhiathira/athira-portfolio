{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "mobile-parallax-hero",
        "steps": [
          { "offset": "0%", "properties": { "background-position-y": "0px" } },
          { "offset": "100%", "properties": { "background-position-y": "-150px" } }
        ]
      },
      {
        "name": "mobile-parallax-faq",
        "steps": [
          { "offset": "0%", "properties": { "background-position-y": "0px" } },
          { "offset": "100%", "properties": { "background-position-y": "-150px" } }
        ]
      },
      {
        "name": "chatMessageFadeIn",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(12px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "fadeIn",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(-8px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "fade-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(10px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "scale-in",
        "steps": [
          { "offset": "0%", "properties": { "transform": "scale(0.95)", "opacity": "0" } },
          { "offset": "100%", "properties": { "transform": "scale(1)", "opacity": "1" } }
        ]
      },
      {
        "name": "shake",
        "steps": [
          { "offset": "0%, 100%", "properties": { "transform": "translate(0px)" } },
          { "offset": "25%", "properties": { "transform": "translate(-5px)" } },
          { "offset": "75%", "properties": { "transform": "translate(5px)" } }
        ]
      },
      {
        "name": "shimmer",
        "steps": [
          { "offset": "100%", "properties": { "transform": "translate(100%)" } }
        ]
      },
      {
        "name": "pulse",
        "steps": [
          { "offset": "50%", "properties": { "opacity": "0.5" } }
        ]
      },
      {
        "name": "spin",
        "steps": [
          { "offset": "100%", "properties": { "transform": "rotate(360deg)" } }
        ]
      },
      {
        "name": "sonner-fade-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "scale(0.8)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "scale(1)" } }
        ]
      },
      {
        "name": "sonner-fade-out",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "1", "transform": "scale(1)" } },
          { "offset": "100%", "properties": { "opacity": "0", "transform": "scale(0.8)" } }
        ]
      }
    ],
    "transitionElements": [
      {
        "selector": ".opaline-banner-close",
        "transition": {
          "property": "all",
          "duration": "0.2s",
          "timingFunction": "ease-in-out"
        }
      },
      {
        "selector": ".opaline-button-ghost",
        "transition": {
          "property": "all",
          "duration": "0.3s",
          "timingFunction": "ease-in-out"
        }
      },
      {
        "selector": ".opaline-button-primary",
        "transition": {
          "property": "all",
          "duration": "0.2s",
          "timingFunction": "ease-in-out"
        }
      },
      {
        "selector": ".opaline-card",
        "transition": {
          "property": "all",
          "duration": "0.3s",
          "timingFunction": "ease-in-out"
        }
      },
      {
        "selector": ".opaline-pricing-card",
        "transition": {
          "property": "transform, box-shadow",
          "duration": "0.3s, 0.3s",
          "timingFunction": "ease-in-out, ease-in-out"
        }
      },
      {
        "selector": ".opaline-faq-item",
        "transition": {
          "property": "all",
          "duration": "0.3s",
          "timingFunction": "ease-in-out"
        }
      }
    ],
    "timingTokens": {
      "durations": ["0.2s", "0.3s"],
      "easings": ["ease-in-out"]
    }
  },
  "scrollAnimations": {
    "patterns": [
      {
        "type": "scroll-driven-tab-switching",
        "description": "As user scrolls within a product section, active tab switches updating the content panel.",
        "trigger": "scroll position within section",
        "targets": ["tab-bar active state", "content panel"]
      }
    ],
    "parallaxPatterns": [
      {
        "type": "mobile-parallax-background",
        "description": "CSS-driven background-position-y parallax on hero and FAQ sections for mobile viewports.",
        "keyframes": ["mobile-parallax-hero", "mobile-parallax-faq"]
      }
    ]
  },
  "microInteractions": {
    "buttonTransitions": [
      {
        "selector": "button",
        "transition": "0.2s ease-in-out",
        "transitionDuration": "0.2s"
      },
      {
        "selector": "button",
        "transition": "0.3s ease-in-out",
        "transitionDuration": "0.3s"
      }
    ],
    "customCursor": false,
    "loadingStates": [],
    "hasSkeletonScreens": false
  },
  "performance": {
    "totalAnimatedElements": 20,
    "simultaneousAnimations": 0,
    "videoLoad": "light",
    "complexAnimations": 8,
    "reducedMotionSupport": true
  },
  "_twist": {
    "type": "easing-curve-swap",
    "sourceSystem": "griting-opux",
    "intensity": 3,
    "original": "cubic-bezier(0.4, 0, 0.2, 1)",
    "result": "ease-in-out",
    "description": "Primary easing swapped from cubic-bezier(0.4,0,0.2,1) to ease-in-out across all transitions. Produces a more symmetrical, breathing motion quality — the system now decelerates as carefully as it accelerates."
  }
}
