{
  "cssVars": {},
  "container": {
    "maxWidth": "1530px"
  },
  "grids": {
    "grid-1": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "normal 56px",
      "alignItems": "center",
      "childCount": "3",
      "parentSection": "header",
      "_twist": "columnGap scaled ×1.4 from 40px → 56px"
    },
    "grid-2": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "normal 50.4px",
      "childCount": "4",
      "parentSection": "footer",
      "_twist": "columnGap scaled ×1.4 from 36px → 50.4px"
    }
  },
  "responsive": {
    "bp-961px": {
      "query": "(max-width: 961px)",
      "maxWidth": "none",
      "flexDirection": "column",
      "rowGap": "16.8px",
      "columnGap": "16.8px",
      "_twist": "gaps scaled ×1.4 from 12px → 16.8px"
    },
    "bp-1279px": {
      "query": "(max-width: 1279px)",
      "flexDirection": "column",
      "display": "flex",
      "rowGap": "49px",
      "_twist": "rowGap scaled ×1.4 from 35px → 49px"
    },
    "bp-1350px": {
      "query": "(max-width: 1350px)",
      "columnGap": "16.8px",
      "_twist": "columnGap scaled ×1.4 from 12px → 16.8px"
    },
    "bp-1500px": {
      "query": "(max-width: 1500px)",
      "columnGap": "42px",
      "_twist": "columnGap scaled ×1.4 from 30px → 42px"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "split-left-text-right-image",
      "description": "Full-viewport hero with text and CTA anchored bottom-left (~40% width) and a large image filling the right 60%."
    },
    {
      "section": "feature-1",
      "layout": "split-right-text-left-image",
      "description": "Full-bleed section with a photograph occupying the left ~55% and text block with heading, body, and CTA on the right ~45%."
    }
  ],
  "_twist": {
    "type": "gap-value-scaling",
    "sourceSystem": "linen-verge",
    "intensity": 3,
    "factor": 1.4,
    "description": "All columnGap and rowGap values in grids and responsive breakpoints scaled ×1.4. Container max-width retained at 1530px from source. The increased column gutter gives each section more air between elements — editorial breathing room for a precision-instrument aesthetic."
  }
}
