{
  "buttons": {
    "primary": {
      "selector": "CTA button — Get in Touch / Try It Now",
      "default": {
        "background": "linear-gradient(90deg, #00693e, #00693e)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#003620",
        "boxShadow": "0px 1px 2px -1px rgba(9,6,63,0.4), 0px 0px 0px 1px #003620, inset 0px 1px 0px 0px rgba(255,255,255,0.16)",
