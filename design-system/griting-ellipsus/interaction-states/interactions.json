  "_meta": {
    "source": "griting (primary) + ellipsus (interaction patterns)",
    "mergeStrategy": "Griting is the brand base — all colors, typography, and concepts from griting are preserved verbatim. Ellipsus contributes: (1) explicit cursor:pointer on all interactive elements, (2) granular transition timing strings (0.3s normal, 0.1s active), (3) box-shadow elevation on hover for primary button and cards, (4) navigation section with accent-on-hover pattern remapped to griting primary green (#00693e) and background (#003620), (5) cards section with griting-colored elevation shadows.",
    "primaryColor": "#00693e",
    "backgroundColor": "#003620"
  }
