{
  "_source": "bramble-dyce",
  "_twist": "Underline hover animation slowed from 0.3s to 0.55s and thickened from 1px to 1.5px",
  "geometry": {
    "height": 64,
    "paddingInline": 64,
    "position": "fixed",
    "itemSpacing": 36,
    "alignment": "space-between",
    "_zones": "wordmark-left | links-center | cta-right"
  },
  "background": {
    "initial": "transparent",
    "scrolled": "#f9f7f4",
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": "1px solid #e8e2d9",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease"
  },
  "typography": {
    "fontFamily": "'Manrope', system-ui, sans-serif",
    "fontSize": "11px",
    "fontWeight": "500",
    "letterSpacing": "0.12em",
    "textTransform": "uppercase",
    "lineHeight": "1"
  },
  "wordmark": {
    "fontFamily": "'EB Garamond', Georgia, serif",
    "fontSize": "22px",
    "fontWeight": "500",
    "letterSpacing": "-0.4px",
    "color": "#1a1714"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "background-size 0.55s cubic-bezier(0.16, 1, 0.3, 1)",
    "underline": {
      "type": "background-image-draw",
      "thickness": "1.5px",
      "offset": "0",
      "animation": {
        "property": "background-size",
        "from": "0% 1.5px",
        "to": "100% 1.5px",
        "origin": "left",
        "duration": "0.55s",
        "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  },
  "linkActive": {
    "fontWeight": "500",
    "indicator": "underline-draw-full"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "nav--scrolled",
    "triggerOffset": 80,
    "propertiesChanged": [
      "background-color",
      "border-bottom-color"
    ],
    "duration": "0.4s",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "colorInversion": false
  },
  "dropdown": {
    "present": false
  },
  "mobileMenu": {
    "trigger": "hamburger",
    "breakpoint": "768px",
    "type": "fullscreen-overlay",
    "background": "#f9f7f4",
    "animation": "clip-path iris: circle(0% at 50% 50%) → circle(150% at 50% 50%)",
    "duration": "0.55s",
    "ease": "power4.inOut"
  },
  "characterDescription": "A minimal three-zone letterpress bar: EB Garamond wordmark at left, sparse Manrope uppercase links center (11px, 0.12em tracking), ghost CTA right. Transparent over hero, converts to warm linen (#f9f7f4) surface with fine 1px bone border on scroll. Hover affordance is a left-origin underline draw — 1.5px weight, 0.55s measured pace — no fills, no pills, no dropdowns."
}
