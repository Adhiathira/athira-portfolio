{
  "cssVars": {},
  "container": {
    "maxWidth": "400px"
  },
  "grids": {},
  "responsive": {
    "bp-300px": {
      "query": "screen and (max-height: 300px), screen and (max-width: 800px) and (orientation: landscape)",
      "display": "inline"
    },
    "bp-400px": {
      "query": "only screen and (max-width: 400px)",
      "display": "block"
    },
    "bp-479px": {
      "query": "(max-width: 479px)",
      "display": "block"
    },
    "bp-490px": {
      "query": "(max-width: 490px)",
      "display": "block"
    },
    "bp-500px": {
      "query": "only screen and (max-width: 500px)",
      "display": "block"
    },
    "bp-600px": {
      "query": "only screen and (max-width: 600px)",
      "display": "block"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "display": "inline-block"
    },
    "bp-768px": {
      "query": "(min-width: 768px) and (max-width: 980px)",
      "display": "none"
    }
  },
  "visual": []
}