{
  "_meta": {
    "sourceSystem": "formless",
    "twist": "D — letter spacing on nav links intensity 3: 0.08em added"
  },
  "geometry": {
    "height": "64px",
    "heightScrolled": "56px",
    "logoPosition": "left",
    "itemSpacing": "32px",
    "paddingHorizontal": "77px"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "16px",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
    "textTransform": "none",
    "lineHeight": "1"
  },
  "colors": {
    "background": "transparent",
    "backgroundScrolled": "rgba(255, 255, 255, 0.96)",
    "text": "#000000",
    "textScrolled": "#000000",
    "link": "#533afd",
    "linkScrolled": "#533afd",
    "border": "none",
    "borderScrolled": "1px solid rgba(214, 217, 252, 0.6)"
  },
  "linkHover": {
    "backgroundPill": false,
    "animation": {
      "type": "underline",
      "origin": "left to right",
      "duration": "0.3s",
      "thickness": "1px",
      "color": "#533afd"
    }
  },
  "scrollBehavior": {
    "collapses": true,
    "addsBackground": true,
    "addsShadow": false,
    "transition": "0.3s ease-in-out"
  },
  "logo": {
    "type": "text",
    "fontFamily": "inherit",
    "fontSize": "18px",
    "fontWeight": "600",
    "letterSpacing": "-0.04em"
  },
  "cta": {
    "primary": {
      "label": "Get started",
      "bg": "#533afd",
      "text": "#ffffff",
      "border": "#533afd"
    },
    "secondary": {
      "label": "Sign in",
      "bg": "transparent",
      "text": "#533afd",
      "border": "transparent"
    }
  }
}
