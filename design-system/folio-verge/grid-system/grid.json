{
  "_meta": {
    "sourceSystem": "weld-flint",
    "twist": "B — gap value scaling intensity 3: columnGap 40px × 1.4 = 56px, rowGap 16px × 1.4 ≈ 22px"
  },
  "cssVars": {
    "--grid-container-maxWidth": "1220px",
    "--grid-container-paddingLeft": "77px",
    "--grid-container-paddingRight": "77px",
    "--grid-column-gap": "56px",
    "--grid-row-gap": "22px"
  },
  "container": {
    "maxWidth": "1220px",
    "paddingLeft": "77px",
    "paddingRight": "77px"
  },
  "grids": {
    "row-flex": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "22px",
      "childCount": "4",
      "parentSection": "section"
    },
    "marquee-content": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "56px",
      "alignItems": "center",
      "childCount": "8"
    },
    "benefits-grid": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "templateRows": "auto",
      "childCount": "3"
    }
  },
  "responsive": {
    "bp-768px": {
      "query": "(min-width: 768px) and (max-width: 991.98px)",
      "display": "flex",
      "flexWrap": "wrap",
      "rowGap": "22px",
      "columnGap": "22px",
      "maxWidth": "none"
    },
    "bp-992px": {
      "query": "(min-width: 992px)",
      "maxWidth": "min(820px, -32px + 100vw)",
      "display": "flex",
      "flexDirection": "column",
      "rowGap": "22px",
      "columnGap": "22px",
      "flexWrap": "nowrap"
    },
    "bp-1024px": {
      "query": "(min-width: 1024px)",
      "maxWidth": "1220px",
      "display": "flex",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "columnGap": "56px",
      "gridTemplateColumns": "repeat(4, minmax(0px, 1fr))",
      "gridTemplateRows": "1fr",
      "rowGap": "22px"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-split",
      "description": "Fixed top navigation bar with logo left, centered menu links, and auth CTAs on the right."
    },
    {
      "section": "hero",
      "layout": "full-width-left-aligned",
      "description": "Full-width hero with large left-aligned headline text and subtitle below."
    }
  ]
}
