{
  "_meta": {
    "sourceSystem": "stone-ledger",
    "twist": "A — hover transition speed snappier intensity 3: all hover durations −0.1s (clamped min 0.05s)"
  },
  "buttons": {
    "default-button-1": {
      "selector": "button.promo-banner-close",
      "default": {
        "color": "rgb(161, 161, 170)",
        "borderColor": "rgb(161, 161, 170)",
        "borderWidth": "0px",
        "outlineColor": "rgb(161, 161, 170)",
        "outlineWidth": "0px",
        "outlineOffset": "2px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "0.1s"
      },
      "hover": {
        "backgroundColor": "rgba(255, 255, 255, 0.1)",
        "color": "rgb(255, 255, 255)",
        "borderColor": "rgb(255, 255, 255)",
        "borderWidth": "0px",
        "outlineColor": "rgb(255, 255, 255)",
        "outlineWidth": "0px",
        "outlineOffset": "2px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "0.1s"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    },
    "ghost-button": {
      "selector": "button.button-ghost",
      "default": {
        "color": "rgb(83, 58, 253)",
        "borderColor": "rgb(83, 58, 253)",
        "borderWidth": "1px",
        "outlineColor": "rgb(83, 58, 253)",
        "outlineWidth": "0px",
        "outlineOffset": "2px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "0.2s",
        "borderStyle": "solid"
      },
      "hover": {
        "backgroundColor": "rgba(83, 58, 253, 0.08)",
        "color": "rgb(83, 58, 253)",
        "borderColor": "rgb(83, 58, 253)",
        "borderWidth": "1px",
        "opacity": "1",
        "transform": "matrix(1, 0, 0, 1, 0, -2)",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "0.2s",
        "borderStyle": "solid"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    },
    "primary-button": {
      "selector": "button.button-primary",
      "default": {
        "backgroundColor": "rgb(83, 58, 253)",
        "color": "rgb(255, 255, 255)",
        "borderColor": "rgb(83, 58, 253)",
        "borderWidth": "1px",
        "outlineColor": "rgb(255, 255, 255)",
        "outlineWidth": "0px",
        "outlineOffset": "2px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "0.1s ease-in-out"
      },
      "hover": {
        "backgroundColor": "rgb(66, 42, 220)",
        "color": "rgb(255, 255, 255)",
        "outlineWidth": "0px",
        "outlineOffset": "2px",
        "opacity": "0.95",
        "transform": "matrix(1, 0, 0, 1, 0, -1)",
        "cursor": "pointer",
        "transition": "0.1s ease-in-out"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    }
  },
  "inputs": {
    "default-input": {
      "selector": "input[type='text'], input[type='email']",
      "default": {
        "borderStyle": "none none solid",
        "borderWidth": "0 0 1px",
        "borderColor": "rgb(214, 217, 252)",
        "transition": "0.1s ease-in-out"
      },
      "focus": {
        "borderColor": "rgb(83, 58, 253)",
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    }
  },
  "links": {
    "primary-link": {
      "selector": "a.link-primary",
      "default": {
        "color": "rgb(83, 58, 253)",
        "borderWidth": "0px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "0.1s ease-in-out"
      },
      "hover": {
        "color": "rgb(115, 137, 255)",
        "opacity": "0.85",
        "transform": "matrix(1, 0, 0, 1, 0, -1)",
        "cursor": "pointer",
        "transition": "0.1s ease-in-out"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    }
  },
  "cards": {
    "default-card": {
      "selector": ".card",
      "default": {
        "transition": "0.2s ease-in-out",
        "transform": "none"
      },
      "hover": {
        "transform": "translateY(-4px)",
        "transition": "0.2s ease-in-out"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "selector": "nav a",
      "default": {
        "color": "rgb(0, 0, 0)",
        "transition": "0.1s ease-in-out",
        "opacity": "1"
      },
      "hover": {
        "color": "rgb(83, 58, 253)",
        "opacity": "1",
        "transition": "0.1s ease-in-out"
      }
    }
  }
}
