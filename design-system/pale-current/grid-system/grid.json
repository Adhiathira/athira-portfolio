{
  "cssVars": {
    "root-icon-xs-max-width": "12px",
    "root-icon-s-max-width": "16px",
    "root-icon-m-max-width": "20px",
    "root-icon-l-max-width": "24px",
    "root-icon-xl-max-width": "32px",
    "root-icon-2xl-max-width": "40px",
    "root-icon-3xl-max-width": "48px",
    "root-icon-4xl-max-width": "64px"
  },
  "container": {
    "maxWidth": "1328px",
    "paddingLeft": "86.3984px",
    "paddingRight": "86.3984px"
  },
  "grids": {
    "ai-resources-for-business-lead": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "32px normal",
      "flexWrap": "wrap",
      "childCount": "2"
    },
    "explore-frontier-transformatio": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "flexWrap": "wrap",
      "alignItems": "center",
      "childCount": "2"
    },
    "ask-microsoft": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "flexWrap": "wrap",
      "childCount": "2"
    },
    "carousel-container": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "childCount": "7",
      "parentSection": "Products Section"
    },
    "secure-and-govern-ai": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "childCount": "3"
    },
    "list-item__inner": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "normal 8px",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "In Page quick links"
    }
  },
  "responsive": {
    "bp-539px": {
      "query": "screen and (max-device-width: 539px)",
      "display": "none"
    },
    "bp-540px": {
      "query": "(min-width: 540px)",
      "maxWidth": "100%",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "display": "flex",
      "columnGap": "1.75rem",
      "gridTemplateColumns": "0px repeat(4, 1fr)",
      "gridTemplateRows": "repeat(13, min-content)",
      "rowGap": "0px"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "maxWidth": "none"
    },
    "bp-767px": {
      "query": "only screen and (max-width: 767px)",
      "display": "flex"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "rowGap": "7px",
      "columnGap": "7px",
      "flexDirection": "column",
      "maxWidth": "350px",
      "display": "block"
    },
    "bp-859px": {
      "query": "screen and (max-width: 859px)",
      "display": "flex",
      "maxWidth": "none"
    },
    "bp-860px": {
      "query": "(min-width: 860px)",
      "maxWidth": "100%",
      "display": "none",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "gridTemplateColumns": "repeat(2,calc((100% * var(--plan-detail-card-width)/ 24) - 8px))",
      "gridTemplateRows": "repeat(13, min-content)",
      "columnGap": "1.4rem",
      "rowGap": "0px"
    },
    "bp-1083px": {
      "query": "screen and (max-width: 1083px)",
      "display": "flex",
      "flexWrap": "wrap",
      "flexDirection": "column"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "split-2col",
      "description": "Left column contains label, headline, body text, and CTA button; right column contains a video thumbnail with play button."
    },
    {
      "section": "sticky-subnav",
      "layout": "full-width-nav",
      "description": "Full-width horizontal tab bar that sticks below the main navigation."
    },
    {
      "section": "feature-grid",
      "layout": "full-width-centered-header-plus-4col-cards",
      "description": "Centered headline above a horizontal row of 4 equal-width product cards."
    },
    {
      "section": "footer",
      "layout": "multi-column-footer",
      "description": "Multi-column link grid followed by a legal/utility bar."
    }
  ],
  "_twist": {
    "type": "gap-value-scaling",
    "intensity": 3,
    "factor": 1.4,
    "description": "Gap value scaling (expand, ×1.4) applied to responsive breakpoints. bp-540px columnGap 1.25rem → 1.75rem, bp-768px columnGap and rowGap 5px → 7px, bp-860px columnGap 1rem → 1.4rem."
  }
}
