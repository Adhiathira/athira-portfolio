{
  "geometry": {
    "height": 72,
    "paddingInline": 60,
    "position": "fixed",
    "logoPosition": "left",
    "alignment": "right",
    "itemSpacing": 40
  },
  "background": {
    "color": "transparent",
    "colorScrolled": "rgba(10,10,10,0.95)",
    "backdropFilter": "none",
    "backdropFilterScrolled": "blur(12px)",
    "borderBottom": "none",
    "borderBottomScrolled": "1px solid rgba(42,42,42,0.6)"
  },
  "typography": {
    "fontFamily": "DM Sans",
    "fontSize": "0.875rem",
    "fontWeight": "400",
    "letterSpacing": "0.1em",
    "textTransform": "uppercase",
    "color": "#f2f2f2"
  },
  "logo": {
    "fontFamily": "DM Serif Display",
    "fontWeight": "400",
    "fontSize": "1.5rem",
    "letterSpacing": "-0.01em",
    "lineHeight": "72px",
    "color": "#f2f2f2",
    "text": "Dark Frame",
    "hasImageMark": false
  },
  "items": ["Portfolio", "Licensing", "About", "Contact"],
  "linkHover": {
    "color": "#c9a96e",
    "underline": false,
    "transition": "color 250ms ease-out"
  },
  "activeState": {
    "color": "#c9a96e",
    "borderBottom": "1px solid #c9a96e"
  },
  "scrollBehavior": {
    "threshold": 80,
    "addedClass": "scrolled",
    "description": "JS adds .scrolled class after 80px scroll — triggers background transition"
  },
  "_source": "Photography editorial nav — transparent over imagery, opaque dark on scroll"
}
