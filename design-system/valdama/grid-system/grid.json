{
  "cssVars": {},
  "container": {
    "maxWidth": "1200px",
    "paddingLeft": "15px",
    "paddingRight": "15px"
  },
  "grids": {},
  "responsive": {
    "bp-320px": {
      "query": "(max-width: 320px)",
      "flexDirection": "column"
    },
    "bp-575px": {
      "query": "(max-width: 575px)",
      "flexDirection": "column",
      "display": "block",
      "maxWidth": "90%"
    },
    "bp-576px": {
      "query": "(min-width: 576px)",
      "maxWidth": "540px",
      "display": "flex",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "columnGap": "1.25rem"
    },
    "bp-767px": {
      "query": "screen and (max-width: 767px)",
      "flexDirection": "column",
      "display": "block"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "720px",
      "flexDirection": "row",
      "flexWrap": "nowrap",
      "display": "flex"
    },
    "bp-800px": {
      "query": "(max-width: 800px)",
      "maxWidth": "calc(100% - 10px)"
    },
    "bp-991px": {
      "query": "(max-width: 991px)",
      "flexDirection": "column",
      "display": "none"
    },
    "bp-992px": {
      "query": "(min-width: 992px)",
      "maxWidth": "960px",
      "flexDirection": "row",
      "flexWrap": "nowrap",
      "display": "flex"
    }
  },
  "visual": []
}