{
  "_source": "weld-ivory",
  "_twist": "E. Item spacing change (intensity 3: +10px to itemSpacing). More spread nav links create editorial breathing room. Letter spacing from base preserved.",
  "geometry": {
    "height": 86,
    "heightScrolled": 76,
    "paddingInline": 36,
    "position": "fixed",
    "itemSpacing": 64
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "12px",
    "fontWeight": "400",
    "letterSpacing": "0.10em",
    "textTransform": "uppercase"
  },
  "linkHover": {
    "backgroundPill": false,
    "underline": true,
    "animation": {
      "duration": "0.3s",
      "origin": "left to right"
    }
  },
  "scrollBehavior": {
    "backgroundTransition": "0.3s ease-in-out",
    "heightTransition": "0.3s ease-in-out",
    "collapseOnScroll": true
  }
}
