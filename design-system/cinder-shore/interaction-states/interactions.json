{
  "_source": "prabal-gurung",
  "_twist": "D. Hover opacity (intensity 3: opacity 0.75 on hover for links and cards). Added full interaction states for inputs, links, cards, and navigation. No color values changed.",
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "var(--color-cta-primary-bg)",
        "color": "var(--color-cta-primary-text)",
        "borderColor": "var(--color-cta-primary-bg)",
        "borderWidth": "1px",
        "outlineColor": "transparent",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.17s ease-in-out, transform 0.17s ease-in-out"
      },
      "hover": {
        "opacity": "0.85",
        "transform": "translateY(-1px)",
        "transition": "opacity 0.17s ease-in-out, transform 0.17s ease-in-out"
      },
      "focus": {
        "outlineColor": "var(--color-cta-primary-bg)",
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      },
      "active": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "secondary": {
      "selector": ".btn-secondary",
      "default": {
        "backgroundColor": "transparent",
        "color": "var(--color-body-text)",
        "borderColor": "var(--color-body-text)",
        "borderWidth": "1px",
        "opacity": "1",
        "cursor": "pointer",
        "transition": "opacity 0.17s ease-in-out"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "opacity 0.17s ease-in-out"
      }
    }
  },
  "inputs": {
    "text": {
      "selector": "input[type='text'], input[type='email'], textarea",
      "default": {
        "borderStyle": "none none solid",
        "borderWidth": "0 0 1px",
        "borderColor": "var(--color-border)",
        "outlineWidth": "0px",
        "opacity": "1",
        "transition": "border-color 0.17s ease-in-out"
      },
      "focus": {
        "borderColor": "var(--color-body-text)",
        "outlineWidth": "0px"
      },
      "hover": {
        "borderColor": "var(--color-accent)"
      }
    }
  },
  "links": {
    "default": {
      "selector": "a:not(.btn):not(.nav-link)",
      "default": {
        "color": "var(--color-link)",
        "textDecoration": "underline",
        "opacity": "1",
        "transition": "opacity 0.17s ease-in-out"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "opacity 0.17s ease-in-out"
      }
    }
  },
  "cards": {
    "default": {
      "selector": ".card",
      "default": {
        "opacity": "1",
        "transform": "translateY(0)",
        "transition": "opacity 0.17s ease-in-out, transform 0.2s ease-out",
        "cursor": "default"
      },
      "hover": {
        "opacity": "0.75",
        "transform": "translateY(-2px)",
        "transition": "opacity 0.17s ease-in-out, transform 0.2s ease-out"
      }
    }
  },
  "navigation": {
    "link": {
      "selector": ".nav-link",
      "default": {
        "color": "var(--color-nav-text)",
        "opacity": "1",
        "transition": "opacity 0.17s ease-in-out"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "opacity 0.17s ease-in-out"
      }
    }
  }
}
