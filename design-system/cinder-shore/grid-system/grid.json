{
  "_source": "fluent-health",
  "_twist": "C. Container padding change (intensity 3: +12px to paddingLeft and paddingRight). Applied symmetrically. Creates more generous editorial margins.",
  "cssVars": {
    "grid-columns": "12",
    "grid-column-gap": "24px",
    "grid-row-gap": "24px",
    "container-max-width": "1200px",
    "container-padding-left": "36px",
    "container-padding-right": "36px"
  },
  "container": {
    "maxWidth": "1200px",
    "paddingLeft": "36px",
    "paddingRight": "36px"
  },
  "grids": {
    "feature-grid": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "alignItems": "flex-start",
      "childCount": "3"
    },
    "two-col": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "columnCount": "2",
      "gap": "24px",
      "childCount": "2"
    },
    "pricing-grid": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "justifyContent": "center",
      "alignItems": "flex-start",
      "childCount": "4"
    },
    "testimonials-grid": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": "3",
      "gap": "24px",
      "childCount": "3"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "(max-width: 375px)",
      "flexDirection": "column",
      "maxWidth": "100%",
      "rowGap": "20px",
      "columnGap": "20px",
      "display": "flex",
      "flexWrap": "nowrap",
      "containerPaddingLeft": "20px",
      "containerPaddingRight": "20px"
    },
    "bp-768px": {
      "query": "(min-width: 375px) and (max-width: 768px)",
      "flexDirection": "column",
      "maxWidth": "100%",
      "rowGap": "20px",
      "columnGap": "20px",
      "display": "flex",
      "flexWrap": "nowrap",
      "containerPaddingLeft": "24px",
      "containerPaddingRight": "24px"
    },
    "bp-1024px": {
      "query": "(min-width: 769px) and (max-width: 1024px)",
      "maxWidth": "100%",
      "flexDirection": "column",
      "rowGap": "20px",
      "columnGap": "20px",
      "display": "flex",
      "flexWrap": "nowrap",
      "gridTemplateColumns": "repeat(2, 1fr)"
    },
    "bp-1440px": {
      "query": "(min-width: 1025px)",
      "maxWidth": "1200px",
      "display": "grid",
      "gridTemplateColumns": "repeat(12, 1fr)",
      "columnGap": "24px",
      "rowGap": "24px"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-split",
      "description": "Navigation bar split between logo on the left and links + CTA on the right."
    },
    {
      "section": "hero",
      "layout": "2-column-text-left-visual-right",
      "description": "Hero splits into left text/CTA column (60%) and a media panel on the right (40%)."
    },
    {
      "section": "features",
      "layout": "3-column-equal",
      "description": "Three equal-width feature cards in a horizontal row with 24px gaps."
    },
    {
      "section": "how-it-works",
      "layout": "2-column-steps-left-screenshot-right",
      "description": "Numbered step list on the left alongside a large product screenshot occupying the right half."
    },
    {
      "section": "testimonials",
      "layout": "3-column-equal",
      "description": "Three testimonial cards in a horizontal row."
    },
    {
      "section": "pricing",
      "layout": "4-column-equal",
      "description": "Four pricing tier cards in a horizontal row."
    },
    {
      "section": "cta",
      "layout": "full-width-centered-card",
      "description": "A single large centered card with headline and CTA button."
    },
    {
      "section": "footer",
      "layout": "full-width-split",
      "description": "Footer with logo left and link columns right."
    }
  ]
}
