  "visual": [
    { "hex": "#ffffff", "role": "page-background", "description": "Pure white — the unprinted page, the void before content." },
    { "hex": "#1d1d1f", "role": "heading-text", "description": "Near-black for all text. No hierarchy through color — only scale." },
    { "hex": "#6e6e73", "role": "muted-text", "description": "Medium gray for secondary and fine-print content." },
    { "hex": "#0071e3", "role": "primary-action", "description": "Blue — primary CTA and link color." },
    { "hex": "#e30000", "role": "accent-red", "description": "Red — alerts, errors, brutal accent marks." },
    { "hex": "#ffe045", "role": "accent-yellow", "description": "Yellow — secondary accent and highlight." },
    { "hex": "#000000", "role": "border", "description": "Pure black for all borders, rules, and dividers." },
    { "hex": "#f5f5f7", "role": "surface-background", "description": "Near-white for alternating section backgrounds." }
  ],
  "ctaButtons": [
