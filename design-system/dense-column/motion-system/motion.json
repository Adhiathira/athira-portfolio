{
  "cssVars": {
    "ds-motion-duration-instant": "0s",
    "ds-motion-duration-fast": "0s",
    "ds-motion-duration-base": "0s",
    "ds-motion-duration-slow": "0s",
    "ds-motion-duration-enter": "0s",
    "ds-motion-easing-default": "step-start",
    "ds-motion-easing-in": "step-start",
    "ds-motion-easing-out": "step-start",
    "ds-motion-easing-inout": "step-start",
    "ds-motion-stagger-delay": "0s"
  },
  "transitions": {
    "link": {
      "duration": "0s",
      "easing": "step-start",
      "properties": ["color", "background-color"]
    },
    "button": {
      "duration": "0s",
      "easing": "step-start",
      "properties": ["background-color", "color", "border-color"]
    },
    "card": {
      "duration": "0s",
      "easing": "step-start",
      "properties": ["border", "transform"]
    },
    "nav": {
      "duration": "0s",
      "easing": "step-start",
      "properties": ["background-color", "color"]
    }
  },
  "keyframes": {},
  "_twist": {
    "sourceSystem": "unseen-studio",
    "intensity": 5,
    "description": "Zero Motion: ALL transition durations set to 0s. Easing replaced with step-start — binary state change, no intermediate frames. No keyframe animations. No entrance animations. No scroll-triggered choreography. The page is a static document. Movement is navigation, not decoration. Anti-animation as ideology."
  }
}
