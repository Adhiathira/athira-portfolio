{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "slideFromLeft",
        "steps": [
          { "offset": "0%", "properties": { "transform": "translateX(-100%)", "opacity": "0" } },
          { "offset": "100%", "properties": { "transform": "translateX(0)", "opacity": "1" } }
        ]
      },
      {
        "name": "constructBar",
        "steps": [
          { "offset": "0%", "properties": { "width": "0", "opacity": "0" } },
          { "offset": "100%", "properties": { "width": "100%", "opacity": "1" } }
        ]
      },
      {
        "name": "gridReveal",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0" } },
          { "offset": "33%", "properties": { "opacity": "0.33" } },
          { "offset": "66%", "properties": { "opacity": "0.66" } },
          { "offset": "100%", "properties": { "opacity": "1" } }
        ]
      }
    ],
    "timingTokens": {
      "durations": ["0.12s", "0.25s", "0.4s", "0.5s"],
      "easings": ["linear"],
      "stagger": "0.06s"
    },
    "transitionElements": [
      { "selector": "a", "transition": { "property": "all", "duration": "0.12s", "timingFunction": "linear" } },
      { "selector": "button", "transition": { "property": "background-color, color, border-color", "duration": "0.15s, 0.15s, 0.15s", "timingFunction": "linear, linear, linear" } }
    ]
  },
  "scrollAnimations": {
    "libraries": [],
    "elements": [],
    "parallaxElements": [],
    "patterns": []
  },
  "microInteractions": {
    "buttonTransitions": [
      { "selector": "a", "transition": "0.12s linear" },
      { "selector": "button", "transition": "0.15s linear" }
    ],
    "customCursor": false
  },
  "_twist": {
    "sourceSystem": "pale-ledger",
    "type": "linear-mechanical",
    "intensity": 5,
    "description": "Linear Mechanical: All easing replaced with linear — constant velocity, no acceleration curves. Industrial precision, like a printing press or loom mechanism. Durations: 0.12s fast, 0.25s base, 0.5s slow, 0.4s entrance, 0.06s stagger. New keyframes: slideFromLeft (horizontal linear entrance), constructBar (width reveals from 0→100% like press advancing), gridReveal (4-step opacity staircase for grid structure disclosure)."
  }
}
