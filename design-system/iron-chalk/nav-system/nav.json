{
  "geometry": {
    "height": 72,
    "paddingInline": 22,
    "position": "fixed",
    "logoPosition": "left",
    "alignment": "right",
    "itemSpacing": 24
  },
  "background": {
    "color": "#1c1a1a",
    "colorScrolled": "#1c1a1a",
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null
  },
  "typography": {
    "fontFamily": "Barlow",
    "fontSize": "14.256px",
    "fontWeight": "300",
    "letterSpacing": "0.08em",
    "textTransform": "none",
    "color": "#f4f4f4",
    "_twist": "Agent 7 Twist D intensity 3: letterSpacing 0.08em added to nav links for refined typographic spacing"
  },
  "logo": {
    "fontFamily": "Barlow Condensed",
    "fontWeight": "600",
    "fontSize": "28px",
    "letterSpacing": "-0.02em",
    "lineHeight": "72px",
    "color": "#f4f4f4",
    "hasImageMark": false
  },
  "items": ["Product", "Features", "Pricing", "About"],
  "linkHover": {
    "backgroundPill": false,
    "underline": true,
    "animation": {
      "origin": "left to right",
      "duration": "0.3s"
    },
    "thickness": "1px"
  },
  "_variants": {
    "on-dark": {
      "background": "#1c1a1a",
      "linkColor": "#f4f4f4",
      "logoColor": "#f4f4f4",
      "borderBottom": null,
      "_context": "Dark nav bar — matches osmo-supply dark nav pill aesthetic"
    },
    "on-light": {
      "background": "#f4f4f4",
      "linkColor": "#201d1d",
      "logoColor": "#201d1d",
      "borderBottom": "1px solid #eaeaea",
      "_context": "Used on light-background interior pages"
    },
    "editorial-fixed": {
      "height": 72,
      "paddingInline": 56,
      "position": "fixed",
      "itemSpacing": 45,
      "_context": "Editorial variant — generous horizontal padding, wide item spacing for luxury/editorial feel"
    }
  }
}
