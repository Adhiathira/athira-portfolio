{
  "cssVars": {
    "sk-focus-offset-container": "3px",
    "tile-max-width": "300px"
  },
  "container": {
    "maxWidth": "808px",
    "_twist": "Agent 4 Twist A intensity 3: container maxWidth tightened 15% (950px → 808px) for a more editorial, narrow column feel"
  },
  "grids": {
    "primary-12col": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "24px",
      "parentSection": "section"
    },
    "feature-2col": {
      "display": "grid",
      "templateColumns": "67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px",
      "columnCount": "12",
      "templateRows": "548px 504px",
      "gap": "24px",
      "childCount": "3",
      "parentSection": "section"
    },
    "feature-2col-b": {
      "display": "grid",
      "templateColumns": "67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px",
      "columnCount": "12",
      "templateRows": "414px",
      "gap": "24px",
      "childCount": "1",
      "parentSection": "section"
    },
    "feature-tall": {
      "display": "grid",
      "templateColumns": "67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px",
      "columnCount": "12",
      "templateRows": "750px",
      "gap": "24px",
      "childCount": "2",
      "parentSection": "section"
    },
    "headline-tall": {
      "display": "grid",
      "templateColumns": "67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px 67.5px",
      "columnCount": "12",
      "templateRows": "125px 780px",
      "gap": "24px",
      "childCount": "2",
      "parentSection": "section"
    }
  },
  "responsive": {
    "bp-320px": {
      "query": "only screen and (max-width: 320px)",
      "maxWidth": "8.33333%",
      "display": "none"
    },
    "bp-640px": {
      "query": "only screen and (max-width: 640px)",
      "flexDirection": "column",
      "display": "block"
    },
    "bp-734px": {
      "query": "only screen and (max-width: 734px)",
      "maxWidth": "100%",
      "display": "none",
      "flexDirection": "column",
      "rowGap": "0px",
      "gridTemplateRows": "unset",
      "gridTemplateColumns": "repeat(9, minmax(80px, 92px))"
    },
    "bp-768px": {
      "query": "only screen and (min-width: 768px)",
      "display": "flex",
      "flexDirection": "column",
      "maxWidth": "56%"
    },
    "bp-834px": {
      "query": "only screen and (min-width: 834px)",
      "display": "contents",
      "maxWidth": "808px"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-horizontal-nav",
      "description": "Single-row navigation bar spanning full width with logo left, navigation links centered, and two icon buttons on the far right."
    },
    {
      "section": "hero",
      "layout": "full-width-centered-headline",
      "description": "Full-bleed section with a small eyebrow label, a massive two-line display headline centered, and a narrow body text block with a text link below it."
    },
    {
      "section": "feature-split",
      "layout": "asymmetric-2-column-image-text",
      "description": "Section with an oversized display headline on the left half, and a body-text paragraph anchored to the right column."
    },
    {
      "section": "feature-cards",
      "layout": "2-column-card-grid-over-gradient",
      "description": "Gradient background section containing two equal-width rounded cards side by side."
    },
    {
      "section": "immersive-full",
      "layout": "full-width-hero-with-centered-feature-card",
      "description": "Full-bleed section with an oversized display headline at the top left and a large centered rounded card — asymmetric split within the card."
    }
  ]
}
