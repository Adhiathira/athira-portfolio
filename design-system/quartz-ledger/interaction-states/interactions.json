{
  "buttons": {
    "default-button-1": {
      "selector": "button, .btn",
      "default": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.75s, background 0.45s, color 0.45s",
        "borderStyle": "solid"
      },
      "hover": {
        "backgroundColor": "rgba(0, 0, 0, 1)",
        "color": "rgb(255, 255, 255)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "outlineColor": "rgb(255, 255, 255)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.75s, background 0.45s, color 0.45s",
        "borderStyle": "solid"
      },
      "active": {
        "backgroundColor": "rgb(0, 0, 0)",
        "color": "rgb(255, 255, 255)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "outlineColor": "rgb(255, 255, 255)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.75s, background 0.45s, color 0.45s",
        "borderStyle": "solid"
      },
      "focus": {
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "outlineStyle": "solid",
        "_twist": "Twist E intensity 3: outlineWidth 2px + outlineOffset 2px"
      }
    }
  },
  "inputs": {
    "default-input-1": {
      "selector": "input, textarea",
      "default": {
        "color": "rgb(197, 197, 197)",
        "borderColor": "rgb(197, 197, 197)",
        "borderWidth": "0px 0px 1px",
        "outlineColor": "rgb(197, 197, 197)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "all",
        "borderStyle": "none none solid"
      },
      "focus": {
        "color": "rgb(40, 40, 40)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "0px 0px 1px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "outlineStyle": "solid",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "all",
        "borderStyle": "none none solid",
        "_twist": "Twist E intensity 3: outlineWidth 2px + outlineOffset 2px"
      }
    }
  },
  "links": {
    "default-link-1": {
      "selector": "a",
      "default": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "0px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "0.45s"
      },
      "hover": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "0px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "0.750001",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "0.45s"
      },
      "active": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "0px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "0.75",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "0.45s"
      },
      "focus": {
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "outlineStyle": "solid",
        "_twist": "Twist E intensity 3: outlineWidth 2px + outlineOffset 2px"
      }
    }
  },
  "cards": {
    "default-card-1": {
      "selector": ".card",
      "default": {
        "opacity": "1",
        "transition": "opacity 0.45s, transform 0.45s"
      },
      "hover": {
        "opacity": "0.92",
        "transform": "translateY(-2px)",
        "transition": "opacity 0.45s, transform 0.45s"
      },
      "focus": {
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "outlineStyle": "solid"
      }
    }
  },
  "navigation": {
    "navLink": {
      "selector": "nav a",
      "default": {
        "opacity": "1",
        "transition": "opacity 0.3s"
      },
      "hover": {
        "opacity": "0.8",
        "transition": "opacity 0.3s"
      },
      "focus": {
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "2px",
        "outlineStyle": "solid"
      }
    }
  }
}
