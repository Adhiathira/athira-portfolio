{
  "videos": {
    "count": 0,
    "hasHeroVideo": false,
    "items": [],
    "animatedGifs": 3,
    "libraries": [
      "gsap",
      "aos"
    ]
  },
  "cssAnimations": {
    "keyframes": [
      {
        "name": "fade",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0" } },
          { "offset": "100%", "properties": { "opacity": "1" } }
        ]
      },
      {
        "name": "fadeUp",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(20px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0)" } }
        ]
      },
      {
        "name": "pulse-loading",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "1" } },
          { "offset": "50%", "properties": { "opacity": "0.25" } },
          { "offset": "100%", "properties": { "opacity": "1" } }
        ]
      }
    ],
    "transitionElements": [
      {
        "selector": "header, .site-header",
        "transition": { "property": "color, background", "duration": "0.3s", "timingFunction": "ease" },
        "_source": "0.2s × 1.5"
      },
      {
        "selector": ".wrapper, .page-content",
        "transition": { "property": "opacity, transform", "duration": "0.9s", "timingFunction": "ease" },
        "_source": "0.6s × 1.5"
      },
      {
        "selector": "nav a, .navlink",
        "transition": { "property": "color", "duration": "0.3s", "timingFunction": "ease" },
        "_source": "0.2s × 1.5"
      },
      {
        "selector": ".slide__image",
        "transition": { "property": "opacity", "duration": "0.75s", "timingFunction": "ease" },
        "_source": "0.5s × 1.5"
      },
      {
        "selector": ".product__block, .content-block",
        "transition": { "property": "opacity, transform", "duration": "0.9s", "timingFunction": "ease" },
        "_source": "0.6s × 1.5"
      },
      {
        "selector": "img",
        "transition": { "property": "all", "duration": "0.15s", "timingFunction": "ease-in-out" },
        "_source": "0.1s × 1.5"
      },
      {
        "selector": ".announcement-bar",
        "transition": { "property": "opacity, transform", "duration": "0.9s", "timingFunction": "ease" },
        "_source": "0.6s × 1.5 (delay 225ms)"
      }
    ],
    "timingTokens": {
      "fast": "0.15s",
      "base": "0.3s",
      "slow": "0.75s",
      "slower": "0.9s",
      "easing-default": "ease",
      "easing-linear": "linear",
      "easing-in-out": "ease-in-out"
    }
  },
  "scrollAnimations": {
    "libraries": ["aos"],
    "elements": [
      {
        "selector": "section, .section",
        "attributes": {
          "data-aos": "fade",
          "data-aos-delay": "225",
          "data-aos-duration": "900"
        }
      },
      {
        "selector": ".hero-content, .page-title",
        "attributes": {
          "data-aos": "fade-up",
          "data-aos-delay": "225",
          "data-aos-duration": "900"
        }
      },
      {
        "selector": ".product__block, .card, .grid-item",
        "attributes": {
          "data-aos": "fade-up",
          "data-aos-delay": "150",
          "data-aos-duration": "900"
        }
      }
    ]
  },
  "microInteractions": {
    "buttonTransitions": [
      {
        "selector": "button, .btn",
        "transition": "color 0.45s, border 0.45s, background 0.45s",
        "transitionDuration": "0.45s",
        "_source": "0.3s × 1.5"
      },
      {
        "selector": "a",
        "transition": "color 0.45s, border 0.45s",
        "transitionDuration": "0.45s",
        "_source": "0.3s × 1.5"
      }
    ]
  },
  "performance": {
    "willChange": ["transform", "opacity"],
    "reducedMotion": "prefers-reduced-motion: reduce"
  }
}
