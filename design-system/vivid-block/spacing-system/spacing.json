{
  "_source": "halcyon-gauge",
  "_agent": "spacing-system",
  "_twist": "Global x1.35 scale factor on all numeric px values (Twist A, intensity 3). Flat Design 2.0 needs expansive white space between color blocks. Added --space-flat-block (160px) as a dedicated section-separator token for flat color-block layouts.",
  "cssVars": {
    "--space-1": "11px",
    "--space-2": "18px",
    "--space-3": "28px",
    "--space-4": "46px",
    "--space-5": "74px",
    "--space-6": "120px",
    "--space-7": "194px",
    "--space-section-y": "108px",
    "--space-section-x": "clamp(1.5rem, 5vw, 6rem)",
    "--space-flat-block": "160px"
  },
  "elements": {
    "nav": {
      "paddingRight": "clamp(1.5rem, 5vw, 6rem)",
      "paddingLeft": "clamp(1.5rem, 5vw, 6rem)",
      "height": "96px"
    },
    "section": {
      "paddingTop": "108px",
      "paddingBottom": "120px"
    },
    "section-large": {
      "paddingTop": "120px",
      "paddingBottom": "194px"
    },
    "article": {
      "paddingTop": "74px",
      "paddingRight": "74px",
      "paddingBottom": "120px",
      "paddingLeft": "74px",
      "gap": "46px",
      "rowGap": "46px",
      "columnGap": "46px"
    },
    "footer": {
      "paddingTop": "74px",
      "paddingRight": "clamp(1.5rem, 5vw, 6rem)",
      "paddingBottom": "74px",
      "paddingLeft": "clamp(1.5rem, 5vw, 6rem)",
      "gap": "0 74px",
      "columnGap": "74px"
    },
    "button": {
      "paddingTop": "16px",
      "paddingRight": "38px",
      "paddingBottom": "16px",
      "paddingLeft": "38px",
      "marginTop": "11px",
      "borderRadius": "2px"
    },
    "input": {
      "paddingTop": "18px",
      "paddingRight": "22px",
      "paddingBottom": "18px",
      "paddingLeft": "22px",
      "marginBottom": "11px",
      "borderRadius": "2px"
    },
    "p": {
      "marginBottom": "28px"
    },
    "li": {
      "marginBottom": "11px"
    },
    "hero": {
      "paddingTop": "194px",
      "paddingBottom": "120px"
    },
    "card": {
      "padding": "46px",
      "gap": "28px",
      "borderRadius": "2px"
    },
    "grid": {
      "paddingTop": "46px",
      "paddingRight": "46px",
      "paddingBottom": "46px",
      "paddingLeft": "46px"
    }
  },
  "scale": {
    "name": "golden-ratio-scaled",
    "baseUnit": "11px",
    "ratio": 1.618,
    "steps": ["11px", "18px", "28px", "46px", "74px", "120px", "194px"],
    "note": "TWIST: Original halcyon-gauge golden-ratio scale multiplied by 1.35 for Flat Design 2.0. Generous air between color blocks is structural, not decorative."
  }
}
