{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "fade-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0" } },
          { "offset": "100%", "properties": { "opacity": "1" } }
        ]
      },
      {
        "name": "fade-out",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "1" } },
          { "offset": "100%", "properties": { "opacity": "0" } }
        ]
      },
      {
        "name": "slide-up",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(20px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "slide-in-left",
        "steps": [
          { "offset": "0%", "properties": { "transform": "translateX(-100%)" } },
          { "offset": "100%", "properties": { "transform": "translateX(0px)" } }
        ]
      },
      {
        "name": "slide-out-left",
        "steps": [
          { "offset": "0%", "properties": { "transform": "translateX(0px)" } },
          { "offset": "100%", "properties": { "transform": "translateX(-100%)" } }
        ]
      },
      {
        "name": "scale-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "scale(0.75)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "scale(1)" } }
        ]
      },
      {
        "name": "pulse",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "1" } },
          { "offset": "25%", "properties": { "opacity": "0.4" } },
          { "offset": "50%", "properties": { "opacity": "1" } },
          { "offset": "100%", "properties": { "opacity": "1" } }
        ]
      },
      {
        "name": "rotate-full",
        "steps": [
          { "offset": "0%", "properties": { "transform": "rotate(0deg)" } },
          { "offset": "100%", "properties": { "transform": "rotate(360deg)" } }
        ]
      },
      {
        "name": "step-reveal",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "clipPath": "inset(0 100% 0 0)" } },
          { "offset": "100%", "properties": { "opacity": "1", "clipPath": "inset(0 0% 0 0)" } }
        ]
      }
    ],
    "animatedElements": [
      {
        "selector": ".animated-pulse",
        "animation": {
          "name": "pulse",
          "duration": "0.8s",
          "timingFunction": "linear",
          "iterationCount": "infinite"
        }
      }
    ],
    "transitionElements": [
      {
        "selector": ".btn, button",
        "transition": {
          "property": "background-color, border-color, color",
          "duration": "0.09s, 0.09s, 0.09s",
          "timingFunction": "linear, linear, linear"
        }
      },
      {
        "selector": ".fade-element",
        "transition": {
          "property": "opacity",
          "duration": "0.12s",
          "timingFunction": "linear"
        }
      },
      {
        "selector": ".transform-element",
        "transition": {
          "property": "transform",
          "duration": "0.12s",
          "timingFunction": "linear"
        }
      },
      {
        "selector": ".accordion, .drawer",
        "transition": {
          "property": "grid-template-rows",
          "duration": "0.18s",
          "timingFunction": "linear"
        }
      },
      {
        "selector": ".overlay",
        "transition": {
          "property": "opacity",
          "duration": "0.18s",
          "timingFunction": "linear"
        }
      }
    ],
    "timingTokens": {
      "durations": ["0.09s", "0.12s", "0.18s", "0.8s"],
      "easings": ["linear", "cubic-bezier(0, 0, 1, 1)"],
      "stepCounts": {
        "step-reveal-fast": "steps(4, end)",
        "step-reveal-medium": "steps(6, end)",
        "step-reveal-slow": "steps(8, end)"
      }
    }
  },
