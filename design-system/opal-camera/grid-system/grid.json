{
  "cssVars": {
    "opal-gutter": "0px",
    "opal-grid-gap": "16px",
    "opal-grid-cols": "12",
    "opal-grid-add": "0px",
    "opal-grid-width": "100%",
    "opal-grid-contain": "min(var(--opal-grid-width),calc(100% - 16px * 2))",
    "naps-columns": "4"
  },
  "container": {},
  "grids": {
    "nav-d-primary": {
      "display": "grid",
      "templateColumns": "120px 120px 120px 120px 120px 120px",
      "columnCount": "6",
      "templateRows": "228px",
      "gap": "normal 16px",
      "childCount": "3"
    },
    "relative": {
      "display": "grid",
      "templateColumns": "119.992px 119.992px 119.992px 120px",
      "columnCount": "4",
      "templateRows": "47px",
      "gap": "normal 16px",
      "childCount": "2"
    },
    "mx-auto": {
      "display": "grid",
      "templateColumns": "120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px",
      "columnCount": "12",
      "templateRows": "1476.34px",
      "gap": "normal 16px",
      "childCount": "1",
      "parentSection": "section"
    },
    "relative-2": {
      "display": "grid",
      "templateColumns": "120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px",
      "columnCount": "12",
      "templateRows": "230.5px",
      "gap": "normal 16px",
      "childCount": "2",
      "parentSection": "footer"
    },
    "mx-auto-2": {
      "display": "grid",
      "templateColumns": "120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px 120px",
      "columnCount": "12",
      "templateRows": "50px",
      "gap": "normal 16px",
      "childCount": "1",
      "parentSection": "footer"
    },
    "relative-3": {
      "display": "grid",
      "templateColumns": "120px 120px 120px 120px 120px 120px 120px 120px 120px 120px",
      "columnCount": "10",
      "templateRows": "50px",
      "gap": "normal 16px",
      "childCount": "2",
      "parentSection": "footer"
    }
  },
  "responsive": {
    "bp-384px": {
      "query": "(min-width: 384px)",
      "maxWidth": "384px"
    },
    "bp-700px": {
      "query": "(min-width: 700px)",
      "maxWidth": "700px",
      "display": "none",
      "flexWrap": "wrap",
      "rowGap": "16px",
      "columnGap": "56px",
      "gridTemplateColumns": "1fr 1fr",
      "flexDirection": "row"
    },
    "bp-850px": {
      "query": "(max-width: 850px)",
      "maxWidth": "240%"
    },
    "bp-870px": {
      "query": "(max-height: 870px) and (min-width: 1000px) and (max-width: 1350px), (max-height: 925px) and (min-width: 1350px)",
      "display": "none"
    },
    "bp-1000px": {
      "query": "(min-width: 1000px)",
      "maxWidth": "1000px",
      "display": "none",
      "gridTemplateColumns": "1fr 1fr 1fr calc(20% - 12.8px)",
      "rowGap": "0px",
      "columnGap": "4px"
    },
    "bp-1216px": {
      "query": "(min-width: 1216px)",
      "maxWidth": "1216px"
    },
    "bp-1300px": {
      "query": "(min-width: 1300px)",
      "maxWidth": "1300px",
      "display": "block"
    },
    "bp-1350px": {
      "query": "(min-width: 1350px)",
      "maxWidth": "1350px",
      "display": "block"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "full-bleed-image-with-overlay-text",
      "description": "Full-viewport background photo with navigation bar overlaid at top, large headline text anchored bottom-left, and a pill-shaped CTA button below it; a newsletter input panel floats top-right over the image."
    },
    {
      "section": "nav-dropdown",
      "layout": "multi-column-dropdown-overlay",
      "description": "Navigation dropdown expands below the nav bar showing three columns (Products, Company, Resources) with vertical link lists, overlaid on the hero image."
    },
    {
      "section": "cinematic-photo-band",
      "layout": "full-bleed-image",
      "description": "A single full-width cropped lifestyle photograph spanning the entire viewport width with no text, acting as a visual divider between sections."
    },
    {
      "section": "product-grid",
      "layout": "3-column-equal",
      "description": "Three equal-width columns on a light background, each containing a product name, subtitle, pill-shaped price badge, and a centered product image below."
    },
    {
      "section": "brand-wordmark",
      "layout": "full-bleed-display-type",
      "description": "A single oversized brand name rendered in ultra-heavy black type that bleeds off all four edges of the viewport, sitting on a white background."
    },
    {
      "section": "footer",
      "layout": "2-zone-split",
      "description": "Left zone contains a newsletter subscribe heading, description text, and a pill CTA button; right zone contains four equal-width link columns (Products, Company, Resources, Social), all sitting below the brand wordmark."
    },
    {
      "section": "footer-legal",
      "layout": "3-column-full-width-bar",
      "description": "A thin bottom bar with company name left-aligned, copyright text centered, and an up-arrow scroll button right-aligned."
    }
  ]
}