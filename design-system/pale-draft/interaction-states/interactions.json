{
  "buttons": {
    "default-button": {
      "default": {
        "cursor": "pointer",
        "transition": "all 0.098s ease"
      },
      "hover": {
        "opacity": "0.85",
        "transition": "all 0.098s ease"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "1px",
        "outlineStyle": "solid"
      }
    }
  },
  "inputs": {
    "default-input-1": {
      "selector": "input, textarea",
      "default": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "borderStyle": "solid"
      },
      "focus": {
        "color": "rgb(0, 0, 0)",
        "borderColor": "rgb(0, 0, 0)",
        "borderWidth": "1px",
        "outlineColor": "rgb(0, 0, 0)",
        "outlineWidth": "2px",
        "outlineOffset": "1px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "border-color 0.098s ease-out, box-shadow 0.098s ease-out",
        "borderStyle": "solid"
      }
    }
  },
  "links": {
    "default-link": {
      "default": {
        "color": "rgb(0, 0, 0)",
        "opacity": "1",
        "transition": "opacity 0.098s ease"
      },
      "hover": {
        "opacity": "0.65",
        "transition": "opacity 0.098s ease"
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "1px",
        "outlineStyle": "solid"
      }
    }
  },
  "cards": {
    "default-card": {
      "default": {
        "opacity": "1",
        "transition": "opacity 0.15s ease, transform 0.15s ease"
      },
      "hover": {
        "opacity": "0.75",
        "transform": "translateY(-2px)",
        "transition": "opacity 0.15s ease, transform 0.15s ease"
      }
    }
  },
  "navigation": {
    "default-nav-item": {
      "default": {
        "textDecoration": "none",
        "position": "relative",
        "opacity": "1",
        "transition": "opacity 0.098s ease"
      },
      "hover": {
        "opacity": "0.75",
        "underline": {
          "width": "100%",
          "fromWidth": "0%",
          "transition": "width 0.3s ease-in-out",
          "origin": "right"
        }
      },
      "focus": {
        "outlineWidth": "2px",
        "outlineOffset": "1px",
        "outlineStyle": "solid"
      }
    }
  }
}
