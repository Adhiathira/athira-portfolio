{
  "geometry": {
    "height": 44,
    "paddingInline": 24,
    "position": "static",
    "logoWidth": 20,
    "logoHeight": 20,
    "heightScrolled": 40,
    "itemSpacing": 24,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "transform 0.3s"
  },
  "typography": {
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.03em",
    "textTransform": "uppercase",
    "lineHeight": "0.8125rem"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "0.3s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "offset": "0px",
      "animation": {
        "property": "width",
        "from": "0px",
        "to": "100%",
        "origin": "right",
        "duration": "0.3s",
        "easing": "ease-in-out"
      }
    }
  },
  "linkActive": {
    "selector": ".category-link.active, .menu-link.active",
    "indicator": "underline"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "fixed",
    "propertiesChanged": [
      "position",
      "top",
      "left",
      "right",
      "background"
    ],
    "duration": "0.3s",
    "easing": "ease",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": null,
    "boxShadow": null,
    "padding": null,
    "itemPadding": "0px 12px",
    "animation": null
  },
  "characterDescription": "A restrained, functional tool navigation that communicates precision through sparseness — uppercase micro-type with measured letter spacing, minimal chrome, and a signature animated underline that draws inward from right on hover, signaling deliberate engineering clarity over decorative convention. Designed for focus: slim profile, no visual noise, every element earning its place in a workspace where users are building hardware."
}
