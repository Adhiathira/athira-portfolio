{
  "cssVars": {},
  "container": {},
  "grids": {},
  "responsive": {
    "bp-300px": {
      "query": "screen and (max-height: 300px), screen and (max-width: 800px) and (orientation: landscape)",
      "display": "inline"
    },
    "bp-320px": {
      "query": "(min-width: 320px) and (max-width: 480px)",
      "display": "none"
    },
    "bp-479px": {
      "query": "(max-width: 479px)",
      "display": "block",
      "maxWidth": "50%"
    },
    "bp-480px": {
      "query": "screen and (max-width: 480px)",
      "gridTemplateColumns": "repeat(1, 1fr)",
      "maxWidth": "50%"
    },
    "bp-576px": {
      "query": "(min-width: 576px)",
      "maxWidth": "500px"
    },
    "bp-640px": {
      "query": "(min-width: 640px)",
      "flexDirection": "row",
      "rowGap": "16px",
      "columnGap": "16px",
      "display": "table-cell"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "display": "none",
      "maxWidth": "calc(-20px + 100vw)",
      "gridTemplateColumns": "repeat(1, minmax(0px, 1fr))",
      "rowGap": "10px",
      "columnGap": "10px"
    },
    "bp-768px": {
      "query": "screen and (max-width: 768px)",
      "display": "block",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "maxWidth": "100%"
    }
  },
  "visual": []
}