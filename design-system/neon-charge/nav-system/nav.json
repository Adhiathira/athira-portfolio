{
  "geometry": {
    "height": "72px",
    "heightScrolled": "56px",
    "logoPosition": "left",
    "itemSpacing": "36px",
    "paddingLeft": "40px",
    "paddingRight": "40px",
    "position": "fixed",
    "blurBackdrop": true
  },
  "typography": {
    "fontSize": "0.875rem",
    "fontWeight": 600,
    "textTransform": "uppercase",
    "letterSpacing": "0.1em"
  },
  "linkHover": {
    "backgroundPill": false,
    "animation": {
      "type": "underline",
      "origin": "left to right",
      "thickness": "1px",
      "duration": "0.25s",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}
