{
  "geometry": {
    "height": 96,
    "paddingInline": 48,
    "position": "fixed",
    "itemSpacing": 25,
    "logoWidth": 24,
    "logoHeight": 24,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "transform 150ms"
  },
  "typography": {
    "fontFamily": "'Helvetica Now Text Medium', Helvetica, Arial, sans-serif",
    "fontSize": "1rem",
    "fontWeight": "500",
    "letterSpacing": "normal",
    "textTransform": "none",
    "lineHeight": "1.5"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "border-bottom 0ms",
    "underline": {
      "type": "border",
      "thickness": "2px",
      "offset": "0px",
      "animation": {
        "property": "opacity",
        "from": "transparent",
        "to": "solid",
        "origin": "bottom",
        "duration": "0ms",
        "easing": "linear"
      }
    }
  },
  "linkActive": {
    "selector": ".menu-hover-trigger-link:hover",
    "fontWeight": "500",
    "indicator": "underline"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "is-hidden",
    "propertiesChanged": [
      "transform"
    ],
    "duration": "150ms",
    "easing": "linear",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px 0px 8px 8px",
    "boxShadow": null,
    "padding": "0px 48px 36px",
    "itemPadding": "6px 12px",
    "animation": "max-height 250ms; opacity 100ms, transform 100ms on open; transform 300ms 200ms, opacity 200ms linear on reveal"
  },
  "characterDescription": "A clean, utilitarian fixed navigation built on a 12-column grid with a centered mega-menu overlay — communicating athletic authority through tight Helvetica typography, instant border-bottom link indicators, and a no-nonsense slide-hide-on-scroll behavior that prioritizes content real estate."
}