{
  "_meta": {
    "source": "griting-voltage merge",
    "base": "griting",
    "enrichment": "still-voltage",
    "mergeNotes": "Griting interaction states are the base, kept verbatim in color and character. still-voltage contributes its precise cubic-bezier transition timing (0.455,0.03,0.515,0.955 snap easing and 0.165,0.84,0.44,1 ease-out), bottom-border-only underline button pattern, opacity-based disabled state, and navigation hover pattern — all re-mapped to griting's green brand palette (#00693e primary, #003620 background). still-voltage's electric blue (srgb 0.0745341 0.399346 0.886564) is replaced by griting brand green (#00693e) throughout."
  },
  "buttons": {
    "primary": {
      "selector": "CTA button — Get in Touch / Try It Now",
      "default": {
        "background": "linear-gradient(90deg, #00693e, #00693e)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#003620",
        "boxShadow": "0px 1px 2px -1px rgba(9,6,63,0.4), 0px 0px 0px 1px #003620, inset 0px 1px 0px 0px rgba(255,255,255,0.16)",
        "fontSize": "18px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "letterSpacing": "-0.18px",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.45s cubic-bezier(0.165, 0.84, 0.44, 1)"
      },
      "hover": {
        "background": "linear-gradient(90deg, #008050, #008050)",
        "color": "#ffffff",
        "_inferred": true,
        "_note": "Hover state lightens brand green. Transition easing from still-voltage (0.165,0.84,0.44,1 ease-out snap)."
      },
      "active": {
        "background": "linear-gradient(90deg, #003620, #003620)",
        "color": "#ffffff",
        "_inferred": true
      }
    },
    "outline": {
      "selector": "Outline button — Learn More / Book Demo",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "borderColor": "#00693e",
        "_inferred": true,
        "_note": "Hover not shown in static Figma — inferred as doubled bg opacity. Snap easing from still-voltage."
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "outline-on-light": {
      "selector": "Outline button on light background (Book Demo in feature sections)",
      "default": {
        "background": "rgba(0,105,62,0.06)",
        "color": "#000000",
        "borderRadius": "8px",
        "borderColor": "#00693e",
        "borderWidth": "1px",
        "boxShadow": "1px 2px 8px 0px rgba(0,0,0,0.02)",
        "fontSize": "17px",
        "fontFamily": "Inter Variable",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)",
        "_note": "Black text — this variant is used on light (#f5f6f5) backgrounds, contrasting with outline-on-dark which uses white text"
      },
      "hover": {
        "background": "rgba(0,105,62,0.12)",
        "color": "#000000",
        "_inferred": true
      },
      "active": {
        "background": "rgba(0,105,62,0.20)",
        "_inferred": true
      }
    },
    "share-icon": {
      "selector": "Social share icon buttons",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "rgba(209,213,219,0.5)",
        "borderRadius": "40px",
        "size": "48px",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.165, 0.84, 0.44, 1)"
      },
      "hover": { "background": "#e5e7e5", "_inferred": true }
    },
    "filter-pill-active": {
      "selector": "Active category filter pill",
      "default": {
        "background": "#00693e",
        "color": "#ffffff",
        "borderRadius": "9999px",
        "borderColor": null,
        "height": "36px",
        "paddingInline": "16px",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "background": "#004d2e",
        "color": "#ffffff"
      },
      "active": {
        "background": "#003d25",
        "color": "#ffffff"
      }
    },
    "filter-pill-inactive": {
      "selector": "Inactive category filter pill",
      "default": {
        "background": "#f3f4f3",
        "color": "#000000",
        "borderRadius": "9999px",
        "borderColor": "#e4e4e7",
        "height": "36px",
        "paddingInline": "16px",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "background": "#e8e8e8",
        "color": "#031f18"
      },
      "active": {
        "background": "#d4d4d4",
        "color": "#031f18"
      }
    },
    "underline-nav-toggle": {
      "selector": "Dropdown toggle / nav tab with bottom-border underline",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "backgroundColor": "transparent",
        "color": "#031f18",
        "borderColor": "transparent transparent #031f18",
        "borderWidth": "0px 0px 2px",
        "borderStyle": "none none solid",
        "outlineWidth": "0px",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#00693e",
        "borderColor": "transparent transparent #00693e",
        "_note": "still-voltage's electric blue accent replaced with griting brand green #00693e"
      }
    },
    "media-control": {
      "selector": "Video playback / media control button",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "backgroundColor": "#f3f4f3",
        "color": "#031f18",
        "borderWidth": "0px",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.165, 0.84, 0.44, 1)"
      },
      "hover": {
        "backgroundColor": "#e5e7e5",
        "_note": "Griting light grey hover; still-voltage's white-to-grey pattern preserved in character, mapped to griting surface colors"
      }
    },
    "circle-nav-btn": {
      "selector": "Circle icon navigation button (carousel prev/next)",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "backgroundColor": "#003620",
        "color": "#ffffff",
        "borderWidth": "0px",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "background-color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), box-shadow 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "backgroundColor": "#00693e",
        "color": "#ffffff",
        "_note": "Hover lifts to brand green from deep background green"
      },
      "disabled": {
        "backgroundColor": "#003620",
        "color": "#ffffff",
        "opacity": "0.3",
        "cursor": "default",
        "_note": "Opacity-based disabled state from still-voltage; color mapped to griting background green"
      }
    }
  },
  "links": {
    "nav": {
      "selector": "Navigation links",
      "default": {
        "color": "#ffffff",
        "textDecoration": "none",
        "fontSize": "16px",
        "fontFamily": "Inter",
        "cursor": "pointer",
        "transition": "border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#ffffff",
        "textDecoration": "underline",
        "_inferred": true
      }
    },
    "nav-on-light": {
      "selector": "Navigation links on white background",
      "default": {
        "color": "#455451",
        "textDecoration": "none",
        "fontSize": "16px",
        "fontFamily": "Inter",
        "cursor": "pointer",
        "transition": "border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#031f18",
        "textDecoration": "none",
        "_inferred": true
      }
    },
    "back-button": {
      "selector": "Back navigation",
      "default": {
        "color": "#202b38",
        "textDecoration": "none",
        "fontSize": "16px",
        "cursor": "pointer",
        "transition": "color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": { "color": "#031f18", "_inferred": true }
    },
    "article-title": {
      "selector": "Blog article title link",
      "default": {
        "color": "#031f18",
        "textDecoration": "underline",
        "cursor": "pointer",
        "transition": "color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#00693e",
        "textDecoration": "underline",
        "_note": "hover color inferred — not explicit in static Figma"
      }
    },
    "nav-banner": {
      "selector": "Banner / announcement link",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "backgroundColor": "#00693e",
        "color": "#ffffff",
        "borderWidth": "0px",
        "boxShadow": "rgba(0, 0, 0, 0) 0px 0px 0px 100px inset",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "box-shadow 0.45s cubic-bezier(0.165, 0.84, 0.44, 1)",
        "_note": "still-voltage's inset-shadow-fill hover technique; base color mapped to griting primary green"
      },
      "hover": {
        "backgroundColor": "#00693e",
        "color": "#ffffff",
        "boxShadow": "rgba(0, 0, 0, 0.15) 0px 0px 0px 100px inset",
        "_note": "Inset shadow darkens button on hover — still-voltage technique preserved, griting green maintained"
      }
    },
    "footer-link": {
      "selector": "Footer list item links",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "color": "#455451",
        "borderWidth": "0px",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#031f18",
        "_note": "Muted secondary text lifts to griting deep green on hover"
      }
    }
  },
  "inputs": {
    "search": {
      "selector": "Blog search input",
      "default": {
        "background": "#f3f4f3",
        "borderColor": "#d1d5db",
        "borderRadius": "10px",
        "placeholderColor": "#71717b",
        "height": "40px"
      },
      "focus": {
        "borderColor": "#00693e",
        "_note": "focus border color inferred — not explicit in static Figma"
      }
    }
  },
  "navigation": {
    "nav-link-primary": {
      "selector": "Primary navigation link",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "color": "#031f18",
        "borderWidth": "0px",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#00693e",
        "_note": "still-voltage's electric blue hover re-mapped to griting brand green #00693e"
      }
    },
    "nav-link-secondary": {
      "selector": "Secondary navigation link",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "color": "#455451",
        "borderWidth": "0px",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "border 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955), color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#00693e",
        "_note": "still-voltage secondary nav hover; blue replaced with griting primary green"
      }
    },
    "footer-nav-link": {
      "selector": "Footer navigation list link",
      "_source": "still-voltage pattern re-mapped to griting palette",
      "default": {
        "color": "#84848a",
        "borderWidth": "0px",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "color 0.45s cubic-bezier(0.455, 0.03, 0.515, 0.955)"
      },
      "hover": {
        "color": "#031f18",
        "_note": "Meta grey lifts to griting deep green on hover"
      }
    }
  }
}
