{
  "geometry": {
    "height": 72,
    "heightScrolled": 52,
    "paddingInline": 22,
    "position": "sticky",
    "top": 0,
    "logoPosition": "center",
    "alignment": "split-wing",
    "_note": "Split-wing layout: nav items flank the centered logo — [Product, About] on left, [Contact, Blog] on right. Height condenses on scroll."
  },
  "background": {
    "color": "transparent",
    "colorScrolled": "#f0ece0",
    "backdropFilter": null,
    "backdropFilterScrolled": "blur(12px) saturate(140%)",
    "borderBottom": null,
    "borderBottomScrolled": "1px solid rgba(26,18,0,0.08)"
  },
  "typography": {
    "fontFamily": "DM Sans",
    "fontSize": "16px",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "none"
  },
  "logo": {
    "fontFamily": "DM Sans",
    "fontWeight": "600",
    "fontSize": "36px",
    "letterSpacing": "-1.61px",
    "color": "#1a1200",
    "text": "Gilded Tempo"
  },
  "items": ["Studio", "Work", "Process", "Contact"],
  "itemLayout": {
    "left": ["Studio", "Work"],
    "right": ["Process", "Contact"]
  },
  "itemGap": "36px",
  "transition": {
    "property": "height, background-color, backdrop-filter, border-bottom",
    "duration": "381ms",
    "easing": "ease"
  },
  "linkHover": {
    "style": "underline",
    "animation": {
      "property": "width",
      "from": "0%",
      "to": "100%",
      "origin": "left to right",
      "duration": "0.50s",
      "thickness": "1px"
    }
  },
  "_twist": "Twist D: Letter spacing on nav links — intensity 3 (0.08em). Added letterSpacing: '0.08em' to typography. Creates open, airy link spacing that complements the warm cream color register and deliberate motion timing. Nav transition duration updated to 381ms to match assembled motion system."
}
