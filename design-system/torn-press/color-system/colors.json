      "description": "Maximum black — full ink saturation. No softening."
    },
    {
      "hex": "#1c1d21",
      "role": "heading-text",
      "description": "Near-black for headlines — slightly warm, like xerox toner on white stock."
    },
    {
      "hex": "#ee7421",
      "role": "accent",
      "description": "DayGlo orange — the single color that breaks the black/white field. Used sparingly: sticker, stamp, urgent callout. Cannot be ignored."
    },
    {
      "hex": "#f5f5f4",
      "role": "surface-subtle",
      "description": "Off-white — aged newsprint. Used for section backgrounds that need differentiation without escape from the paper register."
    },
    {
      "hex": "#e8e8e6",
      "role": "surface-muted",
      "description": "Grey paper — photocopy residue. Dividers, utility backgrounds."
    },
    {
      "hex": "rgba(0, 0, 0, 0.12)",
      "role": "border",
      "description": "Semi-transparent black border — printed edge, not designed edge."
    },
    {
      "hex": "rgba(0, 0, 0, 0.55)",
