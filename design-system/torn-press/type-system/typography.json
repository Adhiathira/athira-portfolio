{
  "cssVars": {
    "ds-font-family-display": "'Oswald', Impact, sans-serif",
    "ds-font-family-heading": "'Oswald', Impact, sans-serif",
    "ds-font-family-body": "'IBM Plex Mono', 'Courier Prime', monospace",
    "ds-font-family-mono": "'IBM Plex Mono', monospace",
    "ds-font-family-nav": "'Oswald', sans-serif",
    "ds-font-size-environmental": "360px",
    "ds-font-size-3xl": "72px",
    "ds-font-size-2xl": "56.88px",
    "ds-font-size-xl": "42.66px",
    "ds-font-size-lg": "31.86px",
    "ds-font-size-base": "16px",
    "ds-font-size-sm": "14px",
    "ds-font-size-xs": "12px",
    "ds-font-weight-display": "900",
    "ds-font-weight-heading": "700",
    "ds-font-weight-body": "400",
    "ds-font-weight-label": "600",
    "ds-line-height-display": "64px",
    "ds-line-height-heading": "1.05",
    "ds-line-height-body": "24px",
    "ds-line-height-label": "1.2",
    "ds-letter-spacing-display": "-0.04em",
    "ds-letter-spacing-heading": "-0.03em",
    "ds-letter-spacing-body": "0",
    "ds-letter-spacing-label": "0.08em"
  },
  "fontFaces": [
    {
      "resolvedName": "Oswald",
      "role": "display-heading-nav",
      "source": "google-fonts",
      "weights": [400, 700, 900]
    },
    {
      "resolvedName": "IBM Plex Mono",
      "role": "body-mono",
      "source": "google-fonts",
      "weights": [400, 600]
    }
  ],
  "typeScale": {
    "environmental": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "360px",
      "fontWeight": "900",
      "lineHeight": "320px",
      "letterSpacing": "-0.08em",
      "textTransform": "uppercase",
      "description": "Environmental background text — too large to read as language, used as texture"
    },
    "h1": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "72px",
      "fontWeight": "900",
      "lineHeight": "64px",
      "letterSpacing": "-0.04em",
      "textTransform": "uppercase"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "56.88px",
      "fontWeight": "900",
      "lineHeight": "48px",
      "letterSpacing": "-0.04em",
      "textTransform": "uppercase"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "42.66px",
      "fontWeight": "700",
      "lineHeight": "40px",
      "letterSpacing": "-0.03em",
      "textTransform": "uppercase"
    },
    "h4": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "31.86px",
      "fontWeight": "700",
      "lineHeight": "32px",
      "letterSpacing": "-0.02em",
      "textTransform": "uppercase"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "24px",
      "letterSpacing": "0"
    },
    "button": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "14px",
      "fontWeight": "700",
      "lineHeight": "18px",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "nav": {
      "fontFamily": "var(--ds-font-family-nav)",
      "fontSize": "16px",
      "fontWeight": "700",
      "lineHeight": "20px",
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "12px",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  },
  "_twist": {
    "sourceSystem": "studio-twofold",
    "type": "typeface-collision-punk",
    "intensity": 5,
    "description": "Punk/zine typeface collision: Oswald (condensed grotesque at 900 weight) for all headings/nav vs IBM Plex Mono (cold typewriter) for body. Two fonts that clash like cut-and-paste magazine letters. Environmental text at 360px for pure-texture background. Headings all-caps with tight negative tracking. Body monospace creates raw, photocopied quality."
  }
}
