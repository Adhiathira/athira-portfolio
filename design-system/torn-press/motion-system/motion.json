{
  "cssVars": {
    "ds-duration-immediate": "0.05s",
    "ds-duration-fast": "0.05s",
    "ds-duration-base": "0.15s",
    "ds-duration-slow": "0.3s",
    "ds-duration-stagger": "0.04s",
    "ds-easing-default": "steps(1)",
    "ds-easing-typewriter": "steps(6, start)",
    "ds-easing-linear": "linear"
  },
  "keyframes": {
    "typewriter": {
      "0%": { "width": "0", "overflow": "hidden" },
      "100%": { "width": "100%", "overflow": "visible" }
    },
    "flicker": {
      "0%, 100%": { "opacity": "1" },
      "10%": { "opacity": "0.3" },
      "20%": { "opacity": "1" },
      "30%": { "opacity": "0.5" },
      "40%": { "opacity": "1" },
      "50%": { "opacity": "0.4" },
      "60%": { "opacity": "1" },
      "70%": { "opacity": "0.35" },
      "80%": { "opacity": "1" },
      "90%": { "opacity": "0.45" }
    },
    "xeroxReveal": {
      "0%": { "clip-path": "inset(100% 0 0 0)" },
      "20%": { "clip-path": "inset(80% 0 0 0)" },
      "40%": { "clip-path": "inset(60% 0 0 0)" },
      "60%": { "clip-path": "inset(40% 0 0 0)" },
      "80%": { "clip-path": "inset(20% 0 0 0)" },
      "100%": { "clip-path": "inset(0 0 0 0)" }
    },
    "bulge": {
      "0%": { "transform": "scale(1)" },
      "50%": { "transform": "scale(1.25)" },
      "100%": { "transform": "scale(1)" }
    },
    "stampIn": {
      "0%": { "transform": "scale(1.4)", "opacity": "0" },
      "100%": { "transform": "scale(1)", "opacity": "1" }
    }
  },
  "_twist": {
    "sourceSystem": "teenage-engineering",
    "type": "staccato-steps",
    "intensity": 4,
    "description": "All easing curves replaced with steps(1) for hard, unsmoothed jumps — nothing interpolates. Base duration 0.15s, fast 0.05s. Typewriter reveal via steps(6, start). Flicker effect with stepped opacity drops. xeroxReveal clip-path with 6-step staircase (no smooth interpolation). stampIn for stamp-press effect. The UI snaps like a mimeograph machine."
  }
}
