{
  "geometry": {
    "height": 73.5,
    "paddingInline": 60,
    "position": "fixed",
    "itemSpacing": 42.69,
    "logoWidth": 147,
    "logoHeight": 25.5,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "opacity 0.3s"
  },
  "typography": {
    "fontFamily": "D-DIN-Bold",
    "fontSize": "0.813rem",
    "fontWeight": "700",
    "letterSpacing": "0.09em",
    "textTransform": "uppercase",
    "lineHeight": "94%"
  },
  "linkHover": {
    "backgroundPill": false,
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".open",
    "indicator": "opacity-increase"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "header-hide",
    "propertiesChanged": [
      "opacity"
    ],
    "duration": "0.3s",
    "easing": "ease",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click"
  },
  "characterDescription": "A fixed, full-bleed navigation with a cinematic gradient veil that fades to transparent — designed to float over immersive full-bleed content without interrupting it. Typography is compact, all-caps, and tightly tracked, projecting authority and aerospace-grade precision."
}