{
  "geometry": {
    "height": 73.5,
    "paddingInline": 60,
    "position": "fixed",
    "itemSpacing": 42.69,
    "logoWidth": 147,
    "logoHeight": 25.5,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "opacity 0.3s"
  },
  "typography": {
    "fontFamily": "D-DIN-Bold",
    "fontSize": "0.813rem",
    "fontWeight": "700",
    "letterSpacing": "0.09em",
