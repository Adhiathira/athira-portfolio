{
  "_source": "halcyon-gauge",
  "_agent": "type-system",
  "_twist": "Line height loosening +0.2 applied to all numeric line-height values (Twist F, intensity 4). Organic, airy spacing reminiscent of analog editorial print. Fonts: Cormorant Garamond (display/headings), Figtree (UI/labels), Nunito (body) — all confirmed Google Fonts.",
  "cssVars": {
    "--font-display": "'Cormorant Garamond', Georgia, serif",
    "--font-ui":      "'Figtree', system-ui, sans-serif",
    "--font-body":    "'Nunito', system-ui, sans-serif",
    "--font-label":   "'Figtree', system-ui, sans-serif"
  },
  "fontFaces": [
    {
      "family": "Cormorant Garamond",
      "weight": "300 700",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap",
      "resolvedName": "Cormorant Garamond",
      "webAccessible": true,
      "googleFont": true
    },
    {
      "family": "Figtree",
      "weight": "300 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Figtree",
      "webAccessible": true,
      "googleFont": true
    },
    {
      "family": "Nunito",
      "weight": "400 700",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Nunito",
      "webAccessible": true,
      "googleFont": true
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Cormorant Garamond, Georgia, serif",
      "fontSize": "clamp(3rem, 7vw, 6rem)",
      "fontWeight": "300",
      "lineHeight": "1.25",
      "letterSpacing": "-0.02em",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "h2": {
      "fontFamily": "Cormorant Garamond, Georgia, serif",
      "fontSize": "clamp(2rem, 4.5vw, 4rem)",
      "fontWeight": "400",
      "lineHeight": "1.30",
      "letterSpacing": "-0.01em",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "h3": {
      "fontFamily": "Figtree, system-ui, sans-serif",
      "fontSize": "clamp(0.75rem, 1.2vw, 0.875rem)",
      "fontWeight": "600",
      "lineHeight": "1.60",
      "letterSpacing": "0.1em",
      "textTransform": "uppercase",
      "wordSpacing": "0px",
      "primaryFont": "Figtree",
      "webAccessible": true
    },
    "h4": {
      "fontFamily": "Figtree, system-ui, sans-serif",
      "fontSize": "clamp(0.75rem, 1vw, 0.8125rem)",
      "fontWeight": "500",
      "lineHeight": "1.60",
      "letterSpacing": "0.08em",
      "textTransform": "uppercase",
      "wordSpacing": "0px",
      "primaryFont": "Figtree",
      "webAccessible": true
    },
    "body": {
      "fontFamily": "Nunito, system-ui, sans-serif",
      "fontSize": "clamp(1rem, 1.15vw, 1.125rem)",
      "fontWeight": "400",
      "lineHeight": "1.90",
      "wordSpacing": "0px",
      "primaryFont": "Nunito",
      "webAccessible": true
    },
    "p": {
      "fontFamily": "Nunito, system-ui, sans-serif",
      "fontSize": "clamp(1rem, 1.15vw, 1.125rem)",
      "fontWeight": "400",
      "lineHeight": "1.90",
      "wordSpacing": "0px",
      "primaryFont": "Nunito",
      "webAccessible": true
    },
    "caption": {
      "fontFamily": "Figtree, system-ui, sans-serif",
      "fontSize": "0.75rem",
      "fontWeight": "400",
      "lineHeight": "1.70",
      "letterSpacing": "0.02em",
      "primaryFont": "Figtree",
      "webAccessible": true
    },
    "button": {
      "fontFamily": "Figtree, system-ui, sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "600",
      "lineHeight": "1.20",
      "letterSpacing": "0.04em",
      "primaryFont": "Figtree",
      "webAccessible": true
    },
    "link": {
      "fontFamily": "Nunito, system-ui, sans-serif",
      "fontSize": "inherit",
      "fontWeight": "600",
      "lineHeight": "inherit",
      "textDecoration": "underline",
      "primaryFont": "Nunito",
      "webAccessible": true
    }
  },
  "proprietaryFonts": []
}
