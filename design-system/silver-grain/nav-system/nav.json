{
  "geometry": {
    "height": 46.59375,
    "paddingInline": 48,
    "position": "static",
    "itemSpacing": 88,
    "heightScrolled": 139,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": "0 -1px rgb(var(--header-separation-border-color)) inset",
    "boxShadowScrolled": null,
    "transition": "background 0.2s, color 0.2s, border 0.2s, box-shadow 0.2s"
  },
  "typography": {
    "fontFamily": "'Figtree', system-ui, sans-serif",
    "fontSize": "calc(0.75rem * 1.5)",
    "fontWeight": "bold",
    "letterSpacing": "0.15em",
    "textTransform": "normal",
    "lineHeight": "2px"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "transform 0.2s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "2px",
      "offset": "0px",
      "animation": {
        "property": "transform",
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left",
        "duration": "0.2s",
        "easing": "ease-in-out"
      }
    }
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "is-solid",
    "propertiesChanged": ["background", "color", "border", "box-shadow"],
    "duration": "0.2s",
    "easing": "ease",
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px",
    "boxShadow": "2px 2px 6px rgba(0,0,0,0.05)",
    "padding": "1.125rem 0",
    "itemPadding": "0.375rem 1.5625rem"
  },
  "characterDescription": "A refined editorial navigation with 0.15em letter-spacing on all links — the wide-set tracking of analog film title cards and classic broadsheet mastheads. Generous height (46.59px) commands visual weight like a printed nameplate. The scaleX underline pseudo-element signals interactivity with quiet precision.",
  "_fixes": "fontFamily changed from 'Simply-ChocolateCOMPBold' to 'Figtree' (Check C: nav font not present in assembled type system)",
  "_twist": "Letter spacing 0.15em (analog film title tracking); nav height +16px for editorial presence (source: simply-chocolate)"
}
