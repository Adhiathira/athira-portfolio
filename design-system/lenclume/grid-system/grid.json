  "visual": [
    {
      "section": "hero",
      "layout": "full-width-image-with-overlapping-text",
      "description": "Full-bleed food photography hero with oversized serif display type centered and overlapping the image, dual navigation bars (top persistent nav + centered overlay nav), and vertical rotated sidebar labels on both left ('SIMON ROGAN') and right ('RESERVATION') edges."
    },
    {
      "section": "about-intro",
      "layout": "full-width-text",
      "description": "Single-column full-width text block with a large serif paragraph spanning nearly the entire viewport width, with no image or column splits."
    },
    {
      "section": "about-portraits",
      "layout": "2-column-asymmetric",
      "description": "Two unequal-width editorial photos side by side — left column narrower (~40%), right column wider (~55%) — with generous white space between and around them, no captions visible."
    },
    {
      "section": "cta-pair",
      "layout": "2-column-equal-cta",
      "description": "Two pill-shaped CTA buttons ('VIEW OUR FULL TASTING MENU' and 'BOOK A STAY') side by side in equal-width columns centered in a white strip, separated by the sticky nav bar overlapping the top edge."
    },
    {
      "section": "full-bleed-dish",
      "layout": "full-width-image",
      "description": "Full-viewport-width food photography with no text overlay, functioning as a visual separator between content sections."
    },
    {
      "section": "news-grid",
      "layout": "3-column-staggered-editorial",
      "description": "News items arranged in a 3-column grid with date + title pairs, but deliberately staggered — columns 1 and 3 are offset vertically from column 2, creating a cascading asymmetric rhythm rather than a uniform row grid, with a right-aligned arrow pagination control."
    },
    {
      "section": "newsletter",
      "layout": "full-width-image-centered-form",
      "description": "Full-bleed landscape photography background with a centered single-column form (label, email input, submit button) stacked vertically in the middle of the viewport."
    },
    {
      "section": "footer",
      "layout": "4-column-horizontal-bar",
      "description": "Narrow yellow footer bar with four items distributed across the full width: copyright left, 'BACK TO TOP' center-left, 'PRIVACY POLICY' center-right, and 'SITE BY (GP)' right."
    }
  ]
