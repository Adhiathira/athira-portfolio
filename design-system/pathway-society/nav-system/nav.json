{
  "geometry": {
    "height": 140,
    "paddingInline": 0,
    "position": "static",
    "itemSpacing": 0,
    "logoWidth": 10.1953125,
    "logoHeight": 10.1953125,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "1.0625rem",
    "fontWeight": "400",
    "letterSpacing": "normal",
    "textTransform": "none",
    "lineHeight": "70px"
  },
  "linkHover": {
    "transition": "0.2s linear",
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".menu-item.current-menu-item > .menu-link, .current-menu-ancestor > .menu-link",
    "indicator": "color-change"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "ast-theme-transparent-header",
    "propertiesChanged": [
      "background-color",
      "color"
    ],
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": null,
    "boxShadow": null,
    "padding": null,
    "itemPadding": "0.9em 1em",
    "animation": "visibility toggle with pseudo-element gap bridge"
  },
  "characterDescription": "A utility-forward WordPress Astra theme navigation with transparent-header scroll inversion — links are compact and inline with restrained 0.2s linear transitions, relying entirely on color shifts (no underlines or motion) to communicate state. The system is engineered for functional clarity over expressive personality, with a structured dropdown hierarchy and mobile-breakpoint accordion fallback."
}