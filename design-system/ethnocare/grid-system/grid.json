  "responsive": {
    "bp-499px": {
      "query": "(max-width: 499px)",
      "gridTemplateColumns": "1fr min-content",
      "display": "grid"
    },
    "bp-500px": {
      "query": "(min-width: 500px)",
      "gridTemplateColumns": "2fr 1fr 1fr",
      "display": "flex",
      "columnGap": "var(--grid-gutter)"
    },
    "bp-640px": {
      "query": "screen and (max-width: 640px)",
      "maxWidth": "none",
      "flexDirection": "column",
      "display": "flex"
    },
    "bp-699px": {
      "query": "(max-width: 699px)",
      "display": "none",
      "gridTemplateColumns": "1fr",
      "flexDirection": "column",
      "maxWidth": "21.25rem",
      "rowGap": "var(--grid-margin)"
    },
    "bp-700px": {
      "query": "(min-width: 700px)",
      "display": "flex",
      "flexWrap": "wrap",
      "gridTemplateColumns": "repeat(3, 1fr)",
      "flexDirection": "column",
      "gridTemplateRows": "1fr 1fr",
      "columnGap": "var(--grid-gutter)",
      "rowGap": "var(--grid-gutter)"
    },
    "bp-999px": {
      "query": "(max-width: 999px)",
      "display": "flex",
      "flexDirection": "column",
      "rowGap": "1.875rem",
      "maxWidth": "20rem",
      "columnGap": "0.5em"
    },
    "bp-1000px": {
      "query": "(min-width: 1000px)",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "maxWidth": "500px",
      "display": "grid",
      "columnGap": "var(--grid-gutter)",
      "flexDirection": "row-reverse",
      "flexWrap": "wrap"
    },
    "bp-1400px": {
      "query": "(min-width: 1400px)",
      "gridTemplateColumns": "calc((100vw - (var(--grid-gutter) * (var(--grid-columns) - 1)) - (var(--grid-margin) * 2)) / var(--grid-columns) * 8 + var(--grid-gutter) * (8 - 1)) calc((100vw - (var(--grid-gutter) * (var(--grid-columns) - 1)) - (var(--grid-margin) * 2)) / var(--grid-columns) * 4 + var(--grid-gutter) * (4 - 1))"
    }
  },
  "visual": [
    {
      "section": "announcement-bar",
      "layout": "full-width-banner",
      "description": "Single-row full-width dark banner with centered text and a close button on the far right."
    },
    {
      "section": "navigation",
      "layout": "horizontal-nav-full-width",
      "description": "Full-width horizontal navigation with logo left, centered nav links, and Menu plus cart icon on the far right."
    },
    {
      "section": "hero",
      "layout": "full-width-text-overlay",
      "description": "Full-viewport dark background with large all-caps display text 'OVERLAY' centered horizontally, rendered in a dark gray tone creating a low-contrast typographic hero."
    },
    {
      "section": "products-grid",
      "layout": "asymmetric-2-column",
      "description": "Two product cards visible in an asymmetric layout — one card occupies roughly the left third of the viewport, a second card appears anchored to the far right edge, with a large dark gap between them suggesting off-screen cards in a horizontally scrolling or wide-spaced grid."
    },
    {
      "section": "product-detail-blank",
      "layout": "full-width-dark",
      "description": "Several frames show a nearly fully black viewport with only the navigation bar visible, suggesting a scroll-triggered reveal or lazy-loaded content section between product cards."
    }
  ]
}