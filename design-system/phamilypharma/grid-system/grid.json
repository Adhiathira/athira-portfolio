  "responsive": {
    "bp-640px": {
      "query": "only screen and (max-width: 640px)",
      "display": "none",
      "flexDirection": "column",
      "maxWidth": "75%"
    },
    "bp-641px": {
      "query": "only screen and (min-width: 641px)",
      "maxWidth": "33.3333%",
      "display": "none",
      "rowGap": "3rem",
      "columnGap": "3rem",
      "flexDirection": "row",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "flexWrap": "wrap"
    },
    "bp-768px": {
      "query": "only screen and (width >= 768px)",
      "flexDirection": "row"
    },
    "bp-771px": {
      "query": "only screen and (height >= 771px) and (width >= 920px)",
      "maxWidth": "32rem"
    },
    "bp-920px": {
      "query": "only screen and (width >= 920px)",
      "rowGap": "6rem",
      "columnGap": "6rem"
    },
    "bp-980px": {
      "query": "only screen and (width >= 980px)",
      "maxWidth": "32rem",
      "flexDirection": "row",
      "rowGap": "3rem",
      "columnGap": "3rem"
    },
    "bp-1024px": {
      "query": "only screen and (max-width: 1024px)",
      "display": "none",
      "maxWidth": "18rem"
    },
    "bp-1025px": {
      "query": "only screen and (min-width: 1025px)",
      "maxWidth": "25%",
      "rowGap": "18rem",
      "columnGap": "18rem",
      "flexDirection": "row",
      "flexWrap": "nowrap",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))",
      "display": "flex"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "split-nav",
      "description": "Full-width navigation bar with 3 left links, centered logo, and 3 right links symmetrically split."
    },
    {
      "section": "hero",
      "layout": "full-width-centered",
      "description": "Full-width dark green hero with centered headline stack, subtitle, and two pill CTA buttons; oversized cartoon hand illustrations float left and right outside the text column."
    },
    {
      "section": "mission-statement",
      "layout": "full-width-centered",
      "description": "Full-width off-white section with a large centered headline label on a pink background block, transitioning into the next section."
    },
    {
      "section": "mission-cards",
      "layout": "single-column-offset",
      "description": "Two large white rounded cards stacked vertically and horizontally offset (first card left-aligned, second card right-aligned), each splitting icon illustration right and text left (or reversed), on an off-white background."
    },
    {
      "section": "features-split",
      "layout": "asymmetric-3col",
      "description": "3-column layout: left column holds a large bold headline and CTA button, center column has a single floating cartoon hand illustration, right column contains a vertical stack of numbered feature cards."
    },
    {
      "section": "audience-cta",
      "layout": "2-col-equal",
      "description": "Two equal-width rounded cards side by side on off-white background, each with a pink background, bold headline, and a centered white pill button."
    },
    {
      "section": "featured-listings",
      "layout": "full-width-centered-with-carousel",
      "description": "Centered section heading with full-width 3-column pharmacy listing card row below, with pill carousel navigation controls centered underneath."
    },
    {
      "section": "search-filter",
      "layout": "full-width-card",
      "description": "Large single white rounded card containing a 2-column dropdown row (Région/Département), checkbox filter row, and two equal side-by-side colored filter panels (dark green and pink) with tag chips."
    },
    {
      "section": "community",
      "layout": "full-width-centered",
      "description": "Centered heading and subtext, followed by a 2-column split: left dark green rounded card with animated text, right pink rounded card with thematic tag chips."
    },
    {
      "section": "resources-blog",
      "layout": "sidebar-content",
      "description": "Two-column layout with a wide main content column (article list with thumbnail, tags, date, title, excerpt) on the left and a narrower right sidebar with community CTA card and event card."
    },
    {
      "section": "team-map",
      "layout": "full-width-illustrated",
      "description": "Full-width off-white section with a thin outline illustration of a French regional map, circular team member portrait photos positioned geographically on the map."
    },
    {
      "section": "footer-cta",
      "layout": "2-col-equal",
      "description": "Two equal-width dark green rounded cards side by side at the bottom of the page."
    }
  ]
