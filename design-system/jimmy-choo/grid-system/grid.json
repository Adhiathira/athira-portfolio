  "responsive": {
    "bp-425px": {
      "query": "only screen and (max-width: 425px)",
      "display": "block"
    },
    "bp-426px": {
      "query": "only screen and (min-width: 426px) and (max-width: 896px)",
      "display": "inline-block",
      "flexWrap": "wrap"
    },
    "bp-530px": {
      "query": "only screen and (max-width: 530px)",
      "display": "block"
    },
    "bp-600px": {
      "query": "only screen and (max-width: 600px)",
      "maxWidth": "none"
    },
    "bp-767px": {
      "query": "only screen and (max-width: 767px)",
      "display": "block",
      "maxWidth": "767px",
      "flexDirection": "column-reverse",
      "flexWrap": "wrap",
      "columnGap": "0px",
      "rowGap": "24px",
      "gridTemplateColumns": "[grid-start] repeat(6, 1fr) [grid-end]"
    },
    "bp-768px": {
      "query": "only screen and (min-width: 768px) and (max-width: 1024px)",
      "display": "block",
      "maxWidth": "1440px",
      "gridTemplateColumns": "repeat(7, 1fr)",
      "flexWrap": "wrap",
      "gridTemplateRows": "1fr",
      "rowGap": "16px",
      "columnGap": "16px"
    },
    "bp-896px": {
      "query": "only screen and (max-width: 896px) and (max-height: 425px) and (orientation: landscape)",
      "maxWidth": "85%",
      "display": "none"
    },
    "bp-959px": {
      "query": "only screen and (max-width: 959px)",
      "display": "inline",
      "maxWidth": "112px",
      "flexWrap": "nowrap",
      "gridTemplateColumns": "1fr",
      "columnGap": "8px",
      "rowGap": "8px",
      "flexDirection": "column"
    }
  },
  "visual": [
    {
