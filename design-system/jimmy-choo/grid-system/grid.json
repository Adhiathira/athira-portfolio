    },
    {
      "section": "footer-newsletter-nav",
      "layout": "asymmetric-left-right",
      "description": "Footer split into a narrow left column with newsletter signup and social icons, and a wide right zone with four equal-width navigation columns (SUPPORT, SERVICES, OUR COMPANY, LEGAL)."
