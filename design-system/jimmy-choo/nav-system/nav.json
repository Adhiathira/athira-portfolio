{
  "geometry": {
    "height": 937,
    "paddingInline": 0,
    "position": "fixed",
    "itemSpacing": 49,
    "logoWidth": 153.5,
    "logoHeight": 153.5,
    "heightScrolled": 65,
    "logoPosition": "center",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "top 0.3s"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.92rem",
    "fontWeight": "normal",
    "letterSpacing": "normal",
    "textTransform": "capitalize",
    "lineHeight": "1.08rem"
  },
  "linkHover": {
    "opacity": 0.8,
    "backgroundPill": false,
    "transition": null,
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".menu-shipping-destinations .country-select-list > li.is-active, .menu-shipping-destinations .country-select-list > li.selected",
    "fontWeight": "600",
    "indicator": "bold"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "scrolled-down",
    "propertiesChanged": [
      "top",
      "background-color",
      "height",
      "fill",
      "visibility"
    ],
    "duration": "0.3s",
    "easing": "ease",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": null,
    "boxShadow": null,
    "padding": "10px 0px",
    "itemPadding": "4px 8px 4px 16px",
    "animation": "transform 0.3s, visibility 0.3s"
  },
  "characterDescription": "A structured, utility-first luxury retail navigation with a prominent centered logo, slide-in mobile drawer, and a large-logo hero mode that collapses gracefully on scroll — prioritizing product clarity and global commerce utility over decorative gesture."
}