{
  "geometry": {
    "height": 937,
    "paddingInline": 0,
    "position": "fixed",
    "itemSpacing": 59,
    "logoWidth": 153.5,
    "logoHeight": 153.5,
    "heightScrolled": 65,
    "logoPosition": "center",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "top 0.3s"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.92rem",
    "fontWeight": "normal",
    "letterSpacing": "0.08em",
    "textTransform": "capitalize",
    "lineHeight": "1.08rem"
  },
  "linkHover": {
    "opacity": 0.8,
    "backgroundPill": false,
    "transition": null,
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "fontWeight": "600",
    "indicator": "bold"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "scrolled-down",
    "propertiesChanged": [
      "top",
      "background-color",
      "height",
      "fill",
      "visibility"
    ],
    "duration": "0.3s",
    "easing": "ease",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": null,
    "boxShadow": null,
    "padding": "10px 0px",
    "itemPadding": "4px 8px 4px 16px",
    "animation": "transform 0.45s, visibility 0.45s"
  },
  "characterDescription": "A structured, precision-minimal navigation with centered logo, generously spaced nav link items (59px between items), tracked nav link letters (0.08em), and a large-logo hero mode that collapses gracefully on scroll. The expanded item spacing creates generous intervals between navigation elements, reinforcing an editorial breathing rhythm at the top of the page.",
  "_twist": "Twist E intensity 3: itemSpacing increased from 49px to 59px (+10px) — creates more generous breathing room between navigation link items"
}
