{
  "_source": "kreor",
  "_agent": "Agent 6 — interaction-states",
  "_twist": "Twist E: Accent color transplant — replace kreor's orange accent (rgb(238,116,33)) with Quorum Press's ink black (#1c1d21) for primary interactions, and introduce a secondary warm amber (#c8860a) as the hover/active accent. Transitions inherit quorum-press easing cubic-bezier(0.76,0,0.24,1) at 0.45s base. Focus rings use 2px offset amber outline.",
  "buttons": {
    "primary-button": {
      "selector": "button.primary, .btn-primary",
      "default": {
        "backgroundColor": "#1c1d21",
        "color": "#ffffff",
        "borderColor": "#1c1d21",
        "borderWidth": "1.5px",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "all 0.45s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "backgroundColor": "#c8860a",
        "color": "#ffffff",
        "borderColor": "#c8860a",
        "transform": "translateY(-1px)"
      },
      "active": {
        "backgroundColor": "#a36c08",
        "color": "#ffffff",
        "borderColor": "#a36c08",
        "transform": "translateY(0px)"
      },
      "focus": {
        "outlineColor": "#c8860a",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "3px"
      }
    },
    "secondary-button": {
      "selector": "button.secondary, .btn-secondary",
      "default": {
        "backgroundColor": "transparent",
        "color": "#1c1d21",
        "borderColor": "#1c1d21",
        "borderWidth": "1.5px",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "all 0.45s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "backgroundColor": "#1c1d21",
        "color": "#ffffff",
        "borderColor": "#1c1d21"
      },
      "active": {
        "backgroundColor": "#000000",
        "color": "#ffffff",
        "borderColor": "#000000"
      },
      "focus": {
        "outlineColor": "#c8860a",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "3px"
      }
    },
    "ghost-button": {
      "selector": "button.ghost, .btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "rgba(0,0,0,0.55)",
        "borderColor": "transparent",
        "borderWidth": "0",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "color 0.26s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "color": "#1c1d21"
      },
      "active": {
        "color": "#c8860a"
      }
    }
  },
  "inputs": {
    "text-input": {
      "default": {
        "borderColor": "rgba(0,0,0,0.2)",
        "borderWidth": "1px",
        "transition": "border-color 0.26s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "focus": {
        "borderColor": "#1c1d21",
        "outlineColor": "#c8860a",
        "outlineWidth": "2px",
        "outlineOffset": "2px"
      }
    }
  },
  "links": {
    "body-link": {
      "default": {
        "color": "#1c1d21",
        "textDecoration": "underline",
        "textDecorationColor": "rgba(0,0,0,0.25)",
        "transition": "text-decoration-color 0.26s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "textDecorationColor": "#c8860a"
      }
    }
  },
  "cards": {
    "card-hover": {
      "default": {
        "transform": "none",
        "boxShadow": "none",
        "transition": "transform 0.45s cubic-bezier(0.76, 0, 0.24, 1), box-shadow 0.45s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "transform": "translateY(-4px)",
        "boxShadow": "0 12px 40px rgba(0,0,0,0.10)"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "default": {
        "color": "#000000",
        "transition": "color 0.26s cubic-bezier(0.76, 0, 0.24, 1)"
      },
      "hover": {
        "color": "#c8860a"
      },
      "active": {
        "color": "#1c1d21",
        "fontWeight": "500"
      }
    }
  }
}
