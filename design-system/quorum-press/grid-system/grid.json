{
  "_source": "ochre-ledger",
  "_agent": "Agent 4 — grid-system",
  "_twist": "Twist C: Column inversion — swap the featured-post asymmetric 60/40 split to a 40/60 split (text-first → image-first). Add a 5-column micro-grid for data/stat panels alongside the existing 3-column and footer grids. Container max-width reduced from 1296px to 1200px for tighter editorial measure. Gap scaling retained (×1.4 from cerulean-draft ancestry).",
  "cssVars": {
    "--container-max-width": "1200px",
    "--container-padding-inline": "24px",
    "--grid-cols-features": "3",
    "--grid-cols-footer": "5",
    "--grid-cols-stats": "5",
    "--section-width": "1152px",
    "--grid-blog-featured-columns": "40fr 60fr",
    "--grid-blog-list-columns": "1fr",
    "--grid-filter-bar-columns": "1fr auto",
    "--grid-featured-gap": "56px",
    "--grid-stats-gap": "32px"
  },
  "container": {
    "maxWidth": "1200px",
    "paddingInline": "24px"
  },
  "grids": {
    "nav": {
      "display": "flex",
      "templateColumns": "auto 1fr auto",
      "columnCount": 3,
      "gap": "0"
    },
    "hero": {
      "display": "grid",
      "templateColumns": "1fr",
      "columnCount": 1,
      "gap": "0",
      "_note": "Full-width, text anchored bottom-left"
    },
    "features": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": 3,
      "gap": "40px"
    },
    "featured-post": {
      "display": "grid",
      "templateColumns": "40fr 60fr",
      "columnCount": 2,
      "gap": "56px",
      "_twist": "Inverted from 60/40 → 40/60 (image-first reading)"
    },
    "stats": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "32px",
      "_note": "New 5-col micro-grid for data panels and stat rows"
    },
    "footer": {
      "display": "grid",
      "templateColumns": "repeat(5, 1fr)",
      "columnCount": 5,
      "gap": "40px"
    },
    "filter-bar": {
      "display": "flex",
      "justifyContent": "space-between",
      "columnCount": null,
      "gap": null
    }
  },
  "layout": {
    "type": "full-bleed",
    "heroPattern": "full-bleed",
    "columns": 12
  }
}
