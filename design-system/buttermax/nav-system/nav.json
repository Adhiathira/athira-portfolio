{
  "geometry": {
    "height": 130,
    "paddingInline": 0,
    "position": "fixed",
    "itemSpacing": 9,
    "logoWidth": 36,
    "logoHeight": 39,
    "logoPosition": "left",
    "alignment": "right"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1)"
  },
  "typography": {
    "fontFamily": "'__myFont_2f1432', '__myFont_Fallback_2f1432', Helvetica, ui-sans-serif",
    "fontSize": "1.4rem",
    "fontWeight": "500",
    "letterSpacing": "-0.05em",
    "textTransform": "uppercase",
    "lineHeight": "1.11"
  },
  "linkHover": {
    "backgroundPill": true,
    "backgroundPillBorderRadius": "20px",
    "transition": "color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1), border-color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1)",
    "underline": {
      "type": "pseudo-element",
      "animation": {
        "property": "transform",
        "from": "scaleY(0)",
        "to": "none",
        "origin": "center bottom",
        "duration": "0.45s",
        "easing": "cubic-bezier(0.215, 0.61, 0.355, 1)"
      }
    }
  },
  "linkActive": {
    "selector": ".HeaderButton_button__QcGH0.HeaderButton_active__DTFW2",
    "indicator": "filled pill via pseudo-element"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "Header_open__S_ovN",
    "propertiesChanged": [
      "mix-blend-mode",
      "clip-path",
      "opacity",
      "z-index",
      "pointer-events"
    ],
    "duration": "0.75s",
    "easing": "cubic-bezier(0.215, 0.61, 0.355, 1)",
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": null,
    "boxShadow": null,
    "padding": "0px 3rem 3rem",
    "itemPadding": "0px",
    "animation": "clip-path 0.65s cubic-bezier(0.215, 0.61, 0.355, 1)"
  },
  "characterDescription": "A high-tension, uppercase typographic navigation with theatrical overlay expansion — pill-shaped CTA buttons fill from center-bottom on hover via scaleY pseudo-elements, while the full-screen menu erupts via clip-path inset collapse. The system oscillates between difference blend-mode and direct color themes, projecting a bold, editorial confidence that prioritizes motion choreography over conventional link affordances."
}