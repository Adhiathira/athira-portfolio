{
  "geometry": {
    "position": "fixed",
    "paddingInline": "5vw",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": "blur(2px)",
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "\"Summer loving sans\", sans-serif",
    "fontSize": "10vw",
    "fontWeight": "normal",
    "letterSpacing": "normal",
    "textTransform": "none",
    "lineHeight": "0.8"
  },
  "linkHover": {
    "transition": "0.2s",
    "underline": {
      "type": "none"
    }
  },
  "linkActive": {
    "selector": ".menu_title.w--current",
    "fontWeight": "normal",
    "indicator": "none"
  },
  "scrollTransition": {
    "mechanism": "none",
    "propertiesChanged": [],
    "colorInversion": false
  },
  "dropdown": {
    "present": false
  },
  "characterDescription": "A full-screen overlay navigation with massive fluid-type menu titles scaled by viewport width, giving it an editorial, immersive character typical of high-design creative studio sites. The menu collapses the entire viewport into a typographic statement, using a display serif/script font at extreme scale to prioritize brand expression over functional density."
}