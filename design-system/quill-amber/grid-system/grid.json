{
  "_source": "lusion",
  "_twist": "Agent 4: Gap tightened from 2vw to 1.5vw for a more editorial, compact column rhythm. Container max-width capped at 1440px with auto margins. Responsive breakpoints shifted: 812px→768px, 1000px→1024px for standard viewport harmony.",
  "cssVars": {
    "grid-space": "calc((100% - 11 * var(--grid-gap)) / 12)",
    "grid-gap": "1.5vw",
    "grid-columns": "12",
    "grid-max-width": "1440px"
  },
  "container": {
    "maxWidth": "1440px",
    "paddingInline": "clamp(24px, 4vw, 80px)",
    "marginInline": "auto"
  },
  "grids": {
    "site-nav": {
      "display": "flex",
      "flexDirection": "row",
      "justifyContent": "space-between",
      "alignItems": "center",
      "gap": "14.18px",
      "childCount": "3",
      "parentSection": "header"
    },
    "header-right": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "181.44px",
      "childCount": "3",
      "parentSection": "header"
    },
    "home-hero": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "templateRows": "auto auto",
      "gap": "normal 1.5vw",
      "childCount": "3"
    },
    "home-features": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "templateRows": "auto auto auto",
      "gap": "46.66px 1.5vw",
      "childCount": "4"
    },
    "home-split": {
      "display": "grid",
      "templateColumns": "1.4fr 1fr",
      "columnCount": "2",
      "gap": "1.5vw",
      "childCount": "2"
    },
    "home-three-col": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "columnCount": "3",
      "gap": "1.5vw",
      "childCount": "3"
    },
    "footer-middle": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "templateRows": "auto",
      "gap": "normal 1.5vw",
      "childCount": "2"
    },
    "footer-bottom": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "templateRows": "auto",
      "gap": "normal 1.5vw",
      "childCount": "4"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "(max-width: 375px)",
      "display": "none"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "gridTemplateColumns": "repeat(4, 1fr)",
      "display": "none",
      "flexDirection": "column",
      "maxWidth": "none",
      "flexWrap": "wrap",
      "rowGap": "0.1em",
      "columnGap": "0px"
    },
    "bp-1024px": {
      "query": "(max-width: 1024px)",
      "display": "none",
      "gridTemplateColumns": "repeat(6, 1fr)",
      "rowGap": "5em"
    },
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "maxWidth": "1440px",
      "marginInline": "auto"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "3-column-nav",
      "description": "Full-width navigation bar: logo left, center links, right CTA cluster."
    },
    {
      "section": "hero",
      "layout": "12-col-asymmetric",
      "description": "Headline spans cols 1–8, supporting visual occupies cols 9–12. Below: full-bleed SVG waveform or gradient element."
    },
    {
      "section": "features",
      "layout": "asymmetric-feature-rows",
      "description": "Alternating 60/40 and 40/60 column splits for media+text pairs, creating rhythm without repetition."
    },
    {
      "section": "metrics",
      "layout": "3-col-equal",
      "description": "Three equal columns for large numerical stats with animated counters."
    },
    {
      "section": "footer",
      "layout": "12-col-link-columns",
      "description": "5-column link grid within a warm-surface contained card above the page edge."
    }
  ]
}
