{
  "geometry": {
    "height": 50,
    "paddingInline": 0,
    "position": "static",
    "logoWidth": 20,
    "logoHeight": 20,
    "heightScrolled": 0,
    "itemSpacing": 24,
    "logoPosition": "left",
    "alignment": "center"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "transform 0.3s"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.1em",
    "textTransform": "uppercase",
    "lineHeight": "0.8125rem"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "0.3s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "offset": "0px",
      "animation": {
        "property": "width",
        "from": "0px",
        "to": "100%",
        "origin": "right to left (inactive collapses right, expands left on hover)",
        "duration": "0.3s",
        "easing": "ease-in-out"
      }
    }
  },
  "linkActive": {
    "selector": ".category-link.active, .menu-link.active",
    "fontWeight": "400",
    "indicator": "underline via pseudo-element at full width"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "fixed",
    "propertiesChanged": [
      "position",
      "top",
      "left",
      "right",
      "background"
    ],
    "duration": "0.3s",
    "easing": "ease",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px",
    "boxShadow": null,
    "padding": "0px",
    "itemPadding": "0px 12px",
    "animation": "none declared"
  },
  "characterDescription": "A restrained, editorial navigation rooted in French luxury codes — uppercase micro-typography with generous 0.1em letter-spacing that opens each character into deliberate air, hairline underline animations that wipe in from right-to-left on hover and snap to full width on active state, and a seamless transparency-to-solid transition on scroll that preserves surface warmth without drama."
}