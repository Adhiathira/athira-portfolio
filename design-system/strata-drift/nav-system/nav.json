{
  "height": "72px",
  "position": "fixed",
  "zIndex": 100,
  "defaultState": {
    "background": "transparent",
    "backdropFilter": "none",
    "borderBottom": "none",
    "description": "Floating above depth layers. Transparent to show parallax layers beneath."
  },
  "scrolledState": {
    "background": "rgba(15, 17, 23, 0.85)",
    "backdropFilter": "blur(20px)",
    "borderBottom": "1px solid rgba(232, 230, 240, 0.08)",
    "description": "Depth glass effect. Frosted layer sits in its own z-plane above page content."
  },
  "logo": {
    "fontFamily": "Space Grotesk",
    "fontWeight": "700",
    "fontSize": "1.25rem",
    "color": "#7c6ce4",
    "letterSpacing": "-0.02em"
  },
  "links": {
    "fontFamily": "Inter",
    "fontSize": "0.8125rem",
    "fontWeight": "500",
    "textTransform": "uppercase",
    "letterSpacing": "0.08em",
    "color": "#a8a4c0",
    "hoverColor": "#e8e6f0",
    "transition": "color 0.3s ease-out"
  },
  "activeLink": {
    "color": "#7c6ce4"
  },
  "cta": {
    "fontFamily": "Inter",
    "fontSize": "0.875rem",
    "fontWeight": "500",
    "background": "#7c6ce4",
    "color": "#ffffff",
    "padding": "10px 24px",
    "borderRadius": "6px",
    "hoverBackground": "#9584f0",
    "hoverShadow": "0 8px 30px rgba(124, 108, 228, 0.35)",
    "transition": "all 0.3s ease-out"
  },
  "transition": {
    "property": "background, backdrop-filter, border-bottom",
    "duration": "0.4s",
    "timingFunction": "ease-out"
  },
  "_source": "custom nav for strata-drift parallax depth system",
  "_twist": "72px fixed nav floating above depth layers. Transparent initially (reveals parallax beneath), glassmorphic on scroll (depth glass layer effect). Logo in accent purple, links uppercase lavender."
}
