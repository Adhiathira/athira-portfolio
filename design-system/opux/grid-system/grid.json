    },
    {
      "section": "nav",
      "layout": "split-left-right",
      "description": "Logo anchored far left, login link and CTA button anchored far right, nothing in center."
    },
    {
      "section": "hero",
      "layout": "full-width-centered-overlay",
      "description": "Full-viewport background (animated mesh/grid texture) with all text and two CTA buttons centered in the middle column, large typographic logo letters ('OPUX') rendered as ghost outlines in the background behind the copy."
    },
    {
      "section": "problem-statement",
      "layout": "full-width-centered",
      "description": "Single centered text block spanning roughly 60% of viewport width, no columns, above the 'What Opux Delivers' heading."
    },
    {
      "section": "feature-cards",
      "layout": "3-column-equal",
