    },
    {
      "section": "built-for-builders",
      "layout": "full-width-centered",
      "description": "Large centered headline and subline spanning the full width, no columns."
    },
    {
      "section": "audience-segments",
      "layout": "asymmetric-2-column",
      "description": "Left column holds a large heading (~40% width), right column stacks two audience blocks (Indie Hackers and Agencies), each with an icon, category label, and problem/win copy."
    },
    {
      "section": "see-in-action",
      "layout": "full-width-centered-with-browser-mockup",
      "description": "Centered heading and subline above a browser-frame mockup image that spans roughly 70% of viewport width."
    },
    {
      "section": "pricing",
      "layout": "2-column-cards-with-toggle",
      "description": "Centered heading and subline, a Monthly/Yearly toggle pill above two side-by-side pricing cards of equal width; right card is visually elevated with a 'Most Popular' badge."
    },
    {
      "section": "pricing-cta",
      "layout": "2-column-equal",
      "description": "Two equal-width CTA button blocks side by side, one for each pricing tier."
    },
    {
      "section": "faq",
      "layout": "single-column-accordion",
      "description": "Centered heading and subline above a stacked list of full-width accordion rows, each with a question and a chevron toggle on the right."
    },
    {
      "section": "footer",
      "layout": "3-column-logo-legal-support",
      "description": "Logo and copyright text in the left column, Legal links in the center column, Support links in the right column, all on a dark background."
