  "responsive": {
    "bp-480px": {
      "query": "(max-width: 480px)",
      "flexDirection": "column"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "flexWrap": "wrap",
      "rowGap": "8px",
      "columnGap": "8px",
      "flexDirection": "column",
      "maxWidth": "640px",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "flexDirection": "column",
      "rowGap": "32px",
      "columnGap": "32px",
      "maxWidth": "85%",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))"
    },
    "bp-968px": {
      "query": "(max-width: 968px)",
      "gridTemplateColumns": "1fr",
      "rowGap": "clamp(16px, 3vw, 24px)",
      "columnGap": "clamp(16px, 3vw, 24px)"
    },
    "bp-1024px": {
      "query": "(min-width: 1024px)",
      "maxWidth": "1024px",
      "display": "block",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))",
      "flexDirection": "row",
      "rowGap": "64px",
      "columnGap": "64px"
    },
    "bp-1280px": {
      "query": "(min-width: 1280px)",
      "maxWidth": "1280px"
    },
    "bp-1536px": {
      "query": "(min-width: 1536px)",
      "maxWidth": "1536px"
    }
  },
  "visual": [
    {
      "section": "announcement-bar",
      "layout": "full-width-centered",
