  "responsive": {
    "bp-550px": {
      "query": "(min-width: 550px)",
      "columnGap": "var(--gap)",
      "gridTemplateColumns": "repeat(2, 1fr)"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "display": "none",
      "flexDirection": "column",
      "rowGap": "0px",
      "columnGap": "0px"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "386px",
      "display": "grid",
      "gridTemplateColumns": "var(--shape-size) 1fr var(--shape-size)",
      "gridTemplateRows": "auto 1fr auto",
      "rowGap": "0px",
      "columnGap": "0px",
      "flexWrap": "nowrap",
      "flexDirection": "column"
    },
    "bp-991px": {
      "query": "(max-width: 991px)",
      "display": "block",
      "flexWrap": "wrap"
    },
    "bp-992px": {
      "query": "(min-width: 992px)",
      "maxWidth": "660px",
      "gridTemplateColumns": "repeat(2, 1fr)"
    },
    "bp-1200px": {
      "query": "(min-width: 1200px)",
      "columnGap": "var(--gap)",
      "display": "grid",
      "gridTemplateColumns": "repeat(2, 1fr)"
    }
  },
  "visual": [
    {
      "section": "hero-intro",
      "layout": "full-width-typographic-split",
      "description": "Massive typographic headline 'ART DIR-ECTOR' split across two halves of the viewport with oversized coral/salmon text on dark green background, a tilted project image card overlaid in the lower-left quadrant, and a 3D bubble-logo mark in the upper-left."
    },
    {
      "section": "hero-scroll-2",
      "layout": "full-width-typographic-split",
      "description": "Continuation of the scrolling hero with 'DIGI-TAL' text dominating both columns, a small bio paragraph anchored mid-left, and a placeholder rectangle visible in the upper-right quadrant."
    },
    {
      "section": "hero-scroll-3",
      "layout": "full-width-centered-type",
      "description": "Dark background with the word 'BLOIUIUELIT' (distorted/morphing headline) spanning nearly full viewport width, with 'UP NEXT / SELECTED PROJECTS' stacked centered in the lower half."
    },
    {
      "section": "projects-horizontal-scroll",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "A centered project preview card (~60% viewport width) with full-bleed background imagery bleeding left and right, and a partially visible project title/description panel cropped on the far right."
    },
    {
      "section": "projects-card-detail",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "Same horizontal scroll layout showing a project card (Baptiste Glaymann) centered with a blurred/bleed atmospheric background image and a partially visible next project panel on the right edge."
    },
    {
      "section": "projects-card-hyperbolic",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "Centered project preview card showing the Hyperbolic site, with colorful atmospheric imagery bleeding left and right beyond the card boundary, and a cropped next-project panel at the far right."
    },
    {
      "section": "projects-card-azarian",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "Centered card displaying 'The Azarian Journey' project on a desaturated purple-toned full-bleed background, with a project dot-pagination indicator below the card."
    },
    {
      "section": "projects-card-atelier",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "Atelier.M project card centered with teal/gold atmospheric bleed background, dot navigation below, and a partially visible next project description panel cropped at the right viewport edge."
    },
    {
      "section": "projects-card-brandblack",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "BrandBlack project card centered over a bleed background, with dot navigation below and the beginning of a next project card (purple/pink) starting to enter frame at the bottom."
    },
    {
      "section": "projects-card-houseof",
      "layout": "centered-card-with-bleed-sidebars",
      "description": "Houses Of project card centered on a deep purple bleed background, followed immediately below by another project card (4thsex, bright green/pink) beginning to enter the viewport."
    },
    {
      "section": "persistent-nav-footer-bar",
      "layout": "three-column-fixed-bar",
      "description": "A persistent fixed bottom bar present across all screenshots with three anchored elements: location status left, availability status center, and contact link right."
    },
    {
      "section": "persistent-section-nav",
      "layout": "vertical-dot-navigation",
      "description": "A vertical column of 6 dot indicators fixed to the left edge of the viewport, with one dot filled/highlighted to indicate current section position."
    }
  ]
