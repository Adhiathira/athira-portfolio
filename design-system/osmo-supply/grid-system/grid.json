  "responsive": {
    "bp-479px": {
      "query": "screen and (max-width: 479px)",
      "maxWidth": "none",
      "display": "inherit"
    },
    "bp-600px": {
      "query": "only screen and (min-width: 600px)",
      "display": "block"
    },
    "bp-767px": {
      "query": "screen and (max-width: 767px)",
      "display": "inherit",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "columnGap": "var(--gap-xxl)",
      "rowGap": "var(--gap-xxl)",
      "maxWidth": "none",
      "gridTemplateRows": "0fr"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "96vw",
      "display": "block"
    },
    "bp-991px": {
      "query": "screen and (max-width: 991px)",
      "maxWidth": "728px",
      "display": "inherit",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "columnGap": "0.5em",
      "rowGap": "0.5em",
      "gridTemplateColumns": "1fr"
    }
  },
