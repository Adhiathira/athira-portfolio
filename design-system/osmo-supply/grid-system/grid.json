{
  "cssVars": {
    "dash-col-gap": "1.5em",
    "dash-content-max-width": "60em",
    "gap-xxl": "2.5em",
    "gap-l": "1.875em",
    "gap-xl": "2em",
    "gap-sm": "1.25em",
    "gap-xxs": ".5em",
    "gap-xs": ".75em",
    "gap-m": "1.5em",
    "gap-s": "1em",
    "nav-bar-max-width-small": "38em",
    "container-padding": "1.875em"
  },
  "container": {
    "maxWidth": "1425.6px",
    "paddingLeft": "36px",
    "paddingRight": "36px"
  },
  "grids": {
    "page-transition-course": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "28.8px",
      "childCount": "3"
    },
    "member": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "justifyContent": "center",
      "childCount": "2",
      "parentSection": "section"
    },
    "pricing-home__scribble": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "19.2px",
      "alignItems": "flex-end",
      "childCount": "2",
      "parentSection": "section"
    },
    "pricing-for": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "9.6px",
      "justifyContent": "center",
      "alignItems": "flex-start",
      "childCount": "2",
      "parentSection": "section"
    },
    "pricing-card__price": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "10.8px",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "section"
    },
    "dev-toolkit": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "36px",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "3",
      "parentSection": "section"
    },
    "reel__content": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "48px",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "3",
      "parentSection": "section"
    },
    "reel__scribble": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "9.6px",
      "alignItems": "flex-end",
      "childCount": "2",
      "parentSection": "section"
    },
    "intro__row": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "childCount": "2",
      "parentSection": "section"
    },
    "intro__row-2": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "childCount": "2",
      "parentSection": "section"
    },
    "dennis": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "24px",
      "childCount": "2",
      "parentSection": "section"
    },
    "product-slider__nav": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "2.4px",
      "flexWrap": "wrap",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "5",
      "parentSection": "section"
    },
    "button": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "12px",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "section"
    },
    "button-2": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "12px",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "section"
    },
    "button-3": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "12px",
      "justifyContent": "center",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "section"
    }
  },
  "responsive": {
    "bp-479px": {
      "query": "screen and (max-width: 479px)",
      "maxWidth": "none",
      "display": "inherit"
    },
    "bp-600px": {
      "query": "only screen and (min-width: 600px)",
      "display": "block"
    },
    "bp-767px": {
      "query": "screen and (max-width: 767px)",
      "display": "inherit",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "columnGap": "var(--gap-xxl)",
      "rowGap": "var(--gap-xxl)",
      "maxWidth": "none",
      "gridTemplateRows": "0fr"
    },
    "bp-768px": {
      "query": "(min-width: 768px)",
      "maxWidth": "96vw",
      "display": "block"
    },
    "bp-991px": {
      "query": "screen and (max-width: 991px)",
      "maxWidth": "728px",
      "display": "inherit",
      "flexDirection": "column",
      "flexWrap": "nowrap",
      "columnGap": "0.5em",
      "rowGap": "0.5em",
      "gridTemplateColumns": "1fr"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "centered-bar",
      "description": "Fixed navigation bar centered horizontally with hamburger menu on left, logo in center, and Login/Join buttons on right, floating above content."
    },
    {
      "section": "announcement-ticker",
      "layout": "full-width-marquee",
      "description": "Full-width horizontal scrolling ticker strip in lime green directly below the nav, displaying repeated text in monospace uppercase."
    },
    {
      "section": "hero",
      "layout": "full-width-centered",
      "description": "Full-width centered hero with large display headline spanning ~80% of viewport width, followed by a subtitle with inline pill/chip-styled keyword tags."
    },
    {
      "section": "hero-cards-carousel",
      "layout": "overlapping-rotated-cards",
      "description": "Three oversized product/resource cards displayed in a fanned layout with perspective rotation — left and right cards tilt outward, center card is upright — bleeding beyond viewport edges."
    },
    {
      "section": "about-statement",
      "layout": "full-width-centered",
      "description": "Full-width centered section with a single large paragraph of body text spanning roughly 60% of viewport width."
    },
    {
      "section": "video-reel",
      "layout": "centered-media-with-flanking-text",
      "description": "Center-aligned video thumbnail flanked by large ghost/muted text ('Play' on left, 'Reel' on right) at the same vertical level, with a handwritten annotation below."
    },
    {
      "section": "creator-profile",
      "layout": "asymmetric-2-column",
      "description": "Two-column split: left column (~40% width) shows a creator photo on a purple background card with name overlay; right column (~60% width) shows a dark circle containing a content card with latest-update feed."
    },
    {
      "section": "vault-preview",
      "layout": "full-width-centered-mockup",
      "description": "Centered section with a browser/app UI mockup at ~70% viewport width showing the Vault dashboard interface, with descriptive text above."
    },
    {
      "section": "value-propositions",
      "layout": "full-width-centered",
      "description": "Full-width section with a large centered heading and a 'About the Vault' CTA button centered below it."
    },
    {
      "section": "features-list",
      "layout": "full-width-centered-large-heading",
      "description": "Full-width section with an enormous multi-line heading spanning nearly 100% of viewport width, followed by a 2-column definition/feature list with left-aligned bold labels and right-aligned paragraph descriptions."
    },
    {
      "section": "membership-cards",
      "layout": "3-column-overlapping-cards",
      "description": "Three membership offering cards in a horizontal row — left (purple) and right (lime green) cards are partially cropped by viewport edges, while a dark center card is fully visible and elevated/centered."
    },
    {
      "section": "testimonials-map",
      "layout": "asymmetric-2-column",
      "description": "Two-column layout: left column (~35% width) contains a dark oval with a world map graphic; right column (~65% width) contains a large testimonial card on a purple background with avatar, quote, name, and role."
    },
    {
      "section": "pricing",
      "layout": "2-column-card-grid",
      "description": "Two equal-width pricing tier cards side-by-side on a dark background — left card is light/white, right card is purple — each with price, billing toggle, description, and CTA button."
    },
    {
      "section": "made-with-osmo",
      "layout": "full-width-oversized-text-with-carousel",
      "description": "Full-width dark section with three oversized words ('Made', 'with', 'Osmo') spread horizontally across the viewport, above a horizontally scrolling gallery of rotated/fanned project screenshots."
    }
  ]
}