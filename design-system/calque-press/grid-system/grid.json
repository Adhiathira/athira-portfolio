{
  "cssVars": {},
  "container": {
    "maxWidth": "1220px",
    "paddingLeft": "77px",
    "paddingRight": "77px"
  },
  "grids": {
    "content-row": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "childCount": "4",
      "parentSection": "section"
    },
    "marquee-content": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "40px",
      "alignItems": "center",
      "childCount": "8"
    },
    "twelve-col": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "childCount": "3"
    }
  },
  "responsive": {},
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-split",
      "description": "Fixed top navigation bar with logo left, centered menu links, and CTA on the right."
    },
    {
      "section": "hero",
      "layout": "full-width-left-aligned",
      "description": "Full-width light hero with large left-aligned headline, subtitle below, editorial white ground."
    },
    {
      "section": "feature-grid",
      "layout": "3-column-equal",
      "description": "Three equal-width cards in a uniform grid row."
    },
    {
      "section": "feature-section",
      "layout": "2-column-split-50-50",
      "description": "Two-column layout with bold left headline and right descriptive paragraph."
    },
    {
      "section": "cta-closing",
      "layout": "full-width-centered",
      "description": "Full-width section with centered large headline and two CTA buttons."
    },
    {
      "section": "footer",
      "layout": "6-column-grid",
      "description": "Footer with logo on far left, then 5 link group columns evenly spaced."
    }
  ]
}
