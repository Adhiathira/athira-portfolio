{
  "geometry": {
    "height": 27.9765625,
    "paddingInline": 0,
    "position": "static",
    "itemSpacing": 0,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": null
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "1.3rem",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "none",
    "lineHeight": "1.3rem"
  },
  "linkHover": {
    "transition": "color 0.5s ease-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "7px",
      "offset": "0px",
      "animation": {
        "property": "width",
        "from": "0px",
        "to": "auto",
        "origin": "right",
        "duration": "0.5s",
        "easing": "ease-out"
      }
    }
  },
  "linkActive": {
    "fontFamily": "inherit",
    "fontWeight": "400",
    "indicator": "underline"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "dark",
    "propertiesChanged": ["color", "fill", "stroke"],
    "duration": "0.5s",
    "easing": "ease-out",
    "colorInversion": true
  },
  "mobileMenu": {
    "present": true,
    "trigger": "button",
    "animation": "translateX"
  },
  "dropdown": {
    "present": false
  },
  "characterDescription": "A restrained, typographically confident navigation carrying a clean geometric sans at open letter-spacing — the 0.08em tracking gives nav links a measured, editorial distance that reinforces the system's precision without ornament. The logo left, compact height, and color-inversion scroll mechanism together encode legibility as the primary value."
}
