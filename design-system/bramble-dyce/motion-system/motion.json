{
  "_source": "simply-chocolate",
  "_twist": "simply-chocolate uses Shopify-standard transitions (CSS keyframes, no GSAP, minimal easing). Twist: adopt the brand's slow-reveal philosophy but execute it through GSAP ScrollTrigger with deliberate long-duration eases — think letterpress impression timing, where elements press into view rather than sliding. No color changes in any motion token.",
  "gsap": {
    "version": "3.x",
    "plugins": ["ScrollTrigger", "SplitText"],
    "globalDefaults": {
      "ease": "power3.out",
      "duration": 0.9
    }
  },
  "transitions": {
    "pageEnter": {
      "type": "fade",
      "duration": "0.6s",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "sectionReveal": {
      "trigger": "scroll",
      "start": "top 82%",
      "ease": "power3.out",
      "duration": 0.85,
      "stagger": 0.08
    }
  },
  "scrollBehavior": {
    "smoothScroll": true,
    "library": "lenis",
    "lenisConfig": {
      "duration": 1.4,
      "easing": "t => Math.min(1, 1.001 - Math.pow(2, -10 * t))"
    },
    "scrollTriggerDefaults": {
      "start": "top 80%",
      "once": true
    }
  },
  "hoverAnimations": {
    "links": {
      "type": "underline-draw",
      "duration": "0.35s",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "origin": "left"
    },
    "cards": {
      "type": "elastic-magnetic",
      "gsapEase": "elastic.out(1, 0.25)",
      "magnetStrength": 0.25,
      "returnDuration": 1.1
    },
    "buttons": {
      "type": "surface-lift",
      "duration": "0.25s",
      "transform": "translateY(-1px)",
      "boxShadow": "0 4px 16px rgba(26,23,20,0.12)"
    }
  },
  "pageLoad": {
    "sequence": [
      { "target": "nav", "delay": 0, "duration": 0.5, "ease": "power2.out" },
      { "target": "hero-eyebrow", "delay": 0.15, "duration": 0.6 },
      { "target": "hero-headline", "delay": 0.25, "duration": 1.0, "characterScatter": true },
      { "target": "hero-body", "delay": 0.5, "duration": 0.7 },
      { "target": "hero-cta", "delay": 0.65, "duration": 0.5 }
    ]
  },
  "cssAnimations": {
    "keyframes": [
      {
        "name": "press-in",
        "steps": [
          { "offset": "0%", "properties": { "transform": "scale(1.02)", "opacity": "0" } },
          { "offset": "100%", "properties": { "transform": "scale(1)", "opacity": "1" } }
        ]
      },
      {
        "name": "slow-float",
        "steps": [
          { "offset": "0%", "properties": { "transform": "translateY(0px)" } },
          { "offset": "50%", "properties": { "transform": "translateY(-8px)" } },
          { "offset": "100%", "properties": { "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "stroke-march",
        "steps": [
          { "offset": "0%", "properties": { "stroke-dashoffset": "0" } },
          { "offset": "100%", "properties": { "stroke-dashoffset": "-20" } }
        ]
      }
    ],
    "durations": {
      "slow-float": "6s",
      "press-in": "0.85s",
      "stroke-march": "3s"
    }
  },
  "scrollAnimations": {
    "characterScatter": {
      "library": "Splitting.js",
      "gsapConfig": {
        "x": "gsap.utils.random(-250, 250)",
        "y": "gsap.utils.random(-120, 120)",
        "rotation": "gsap.utils.random(-60, 60)",
        "opacity": 0,
        "scale": "gsap.utils.random(0.3, 1.5)",
        "stagger": { "each": 0.02, "from": "random" },
        "ease": "back.out(2)",
        "duration": 0.65
      }
    },
    "svgStrokeDraw": {
      "scrub": 2,
      "start": "top 70%",
      "end": "bottom 20%"
    },
    "clipPathIris": {
      "from": "circle(0% at 50% 50%)",
      "to": "circle(100% at 50% 50%)",
      "ease": "power4.inOut",
      "duration": 1.4
    },
    "parallaxStack": {
      "layers": ["-50%", "-25%", "-10%"],
      "scrub": [2, 1.5, 1]
    },
    "scatteredAssembly": {
      "stagger": { "each": 0.06, "from": "random" },
      "ease": "power3.out",
      "duration": 1.0
    }
  }
}
