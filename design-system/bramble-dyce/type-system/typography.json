    "CormorantGaramond": { "onGoogleFonts": true, "url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400" },
    "Inter": { "onGoogleFonts": true, "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600" }
  },
  "cssVars": {
    "--font-display": "'Cormorant Garamond', Georgia, serif",
    "--font-body": "'Inter', system-ui, sans-serif",
    "--font-logo": "'Cormorant Garamond', Georgia, serif",
    "--font-nav": "'Inter', system-ui, sans-serif",
    "--font-size-display": "80px",
    "--font-size-logo": "28px",
    "--font-size-nav": "13px",
    "--font-size-btn-primary": "14px",
    "--font-size-btn-secondary": "13px",
    "--line-height-display": "84px",
    "--tracking-display": "-2.4px",
    "--tracking-logo": "-0.8px",
    "--tracking-btn": "0.06em",
    "--font-size-section-heading": "52px",
    "--font-size-card-heading": "28px",
    "--font-size-section-body": "18px",
    "--line-height-section-heading": "56px",
    "--line-height-section-body": "28px",
    "--tracking-section-heading": "-1.6px",
    "--tracking-card-heading": "-0.4px",
