    "--tracking-body": "-0.1px",
    "--tracking-meta": "0.04em",
    "--font-size-eyebrow": "11px",
    "--tracking-eyebrow": "0.12em",
    "--font-size-label": "12px",
    "--tracking-label": "0.1em"
  },
  "fontFaces": [
    {
      "family": "Cormorant Garamond",
      "weight": "300 500",
