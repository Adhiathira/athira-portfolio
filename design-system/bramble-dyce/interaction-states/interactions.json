{
  "_source": "cama-mind",
  "_twist": "cama-mind uses opacity fades (0.73) and transform:scale(1.1) for hover. Twist: replace scale-based hover with a refined underline-draw pattern from the letterpress tradition — links reveal a 1px drawn underline from left origin on hover, buttons gain a precise surface lift (Y-1px + shadow), cards use elastic magnetic response. All transitions slowed to 0.35s minimum for deliberate feel.",
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "color": "#f9f7f4",
        "backgroundColor": "#2c2318",
        "borderColor": "#2c2318",
        "borderWidth": "1px",
        "borderRadius": "2px",
        "opacity": "1",
        "fontWeight": "500",
        "letterSpacing": "0.08em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.25s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "color": "#f9f7f4",
        "backgroundColor": "#1a1510",
        "borderColor": "#1a1510",
        "opacity": "1",
        "transform": "translateY(-1px)",
        "boxShadow": "0 4px 16px rgba(26,23,20,0.18)",
        "cursor": "pointer",
        "transition": "all 0.25s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "active": {
        "transform": "translateY(0px)",
        "boxShadow": "0 1px 4px rgba(26,23,20,0.10)",
        "transition": "all 0.1s ease"
      }
    },
    "secondary": {
      "selector": ".btn-secondary",
      "default": {
        "color": "#2c2318",
        "backgroundColor": "transparent",
        "borderColor": "#2c2318",
        "borderWidth": "1px",
        "borderRadius": "2px",
        "opacity": "1",
        "fontWeight": "500",
        "letterSpacing": "0.08em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.25s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "color": "#f9f7f4",
        "backgroundColor": "#2c2318",
        "borderColor": "#2c2318",
        "opacity": "1",
        "cursor": "pointer",
        "transition": "all 0.25s cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  },
  "inputs": {
    "text-field": {
      "default": {
        "borderColor": "#c9c3bb",
        "borderWidth": "1px",
        "borderRadius": "2px",
        "backgroundColor": "#f9f7f4",
        "color": "#1a1714",
        "transition": "border-color 0.2s ease"
      },
      "focus": {
        "borderColor": "#2c2318",
        "outline": "none",
        "boxShadow": "0 0 0 2px rgba(44,35,24,0.08)",
        "transition": "border-color 0.2s ease"
      }
    }
  },
  "links": {
    "body-link": {
      "selector": "a",
      "default": {
        "color": "#2c2318",
        "textDecoration": "none",
        "backgroundImage": "linear-gradient(currentColor, currentColor)",
        "backgroundPosition": "0 100%",
        "backgroundRepeat": "no-repeat",
        "backgroundSize": "0% 1px",
        "transition": "background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1)",
        "cursor": "pointer"
      },
      "hover": {
        "backgroundSize": "100% 1px",
        "transition": "background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1)"
      }
    },
    "muted-link": {
      "default": {
        "color": "#7a7268",
        "opacity": "1",
        "transition": "color 0.25s ease"
      },
      "hover": {
        "color": "#2c2318",
        "transition": "color 0.25s ease"
      }
    }
  },
  "cards": {
    "feature-card": {
      "default": {
        "transform": "translate(0, 0)",
        "boxShadow": "0 1px 3px rgba(26,23,20,0.06)",
        "transition": "box-shadow 0.3s ease"
      },
      "hover": {
        "boxShadow": "0 8px 32px rgba(26,23,20,0.10)",
        "transition": "box-shadow 0.3s ease"
      }
    },
    "elastic-card": {
      "_note": "Elastic magnetic — handled via GSAP in JS, not CSS transition",
      "magnetStrength": 0.25,
      "returnEase": "elastic.out(1, 0.25)",
      "returnDuration": 1.1
    }
  },
  "navigation": {
    "nav-link": {
      "default": {
        "color": "#2c2318",
        "opacity": "1",
        "fontWeight": "400",
        "letterSpacing": "0.04em",
        "textDecoration": "none",
        "backgroundSize": "0% 1px",
        "transition": "background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "backgroundSize": "100% 1px",
        "transition": "background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "active": {
        "fontWeight": "500",
        "backgroundSize": "100% 1px"
      }
    }
  }
}
