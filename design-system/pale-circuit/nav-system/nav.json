{
  "geometry": {
    "height": 130,
    "heightScrolled": 100,
    "paddingInline": 0,
    "position": "fixed",
    "itemSpacing": 9,
    "logoWidth": 36,
    "logoHeight": 39,
    "logoPosition": "left",
    "alignment": "right"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1)"
  },
  "typography": {
    "fontFamily": "'Archivo', sans-serif",
    "fontSize": "1.3125rem",
    "fontWeight": "500",
    "letterSpacing": "-0.05em",
    "textTransform": "uppercase",
    "lineHeight": "1.11"
  },
  "linkHover": {
    "backgroundPill": true,
    "backgroundPillBorderRadius": "20px",
    "transition": "color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1), border-color 0.45s cubic-bezier(0.215, 0.61, 0.355, 1)",
    "underline": {
      "type": "pseudo-element",
      "animation": {
        "property": "transform",
        "from": "scaleY(0)",
        "to": "none",
        "origin": "center bottom",
        "duration": "0.45s",
        "easing": "cubic-bezier(0.215, 0.61, 0.355, 1)"
      }
    }
  },
  "linkActive": {
    "selector": ".nav-btn.nav-btn--active",
    "indicator": "filled pill via pseudo-element"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "nav--scrolled",
    "propertiesChanged": [
      "background-color",
      "box-shadow",
      "height"
    ],
    "duration": "0.45s",
    "easing": "cubic-bezier(0.215, 0.61, 0.355, 1)",
    "colorInversion": false
  },
  "dropdown": {
    "present": false,
    "trigger": null,
    "borderRadius": null,
    "boxShadow": null,
    "padding": null,
    "itemPadding": null,
    "animation": null
  },
  "characterDescription": "A restrained, uppercase condensed navigation with editorial confidence — the compressed Archivo letterforms at 1.3125rem track tightly inward, pill-shaped hover fills emerge from center-bottom via scaleY pseudo-elements. The nav sits high at 130px on fresh load, settling to 100px on scroll. Clean, functional geometry that subordinates itself to the editorial content below.",
  "_twist": "Nav typography size decreased from 1.4rem to 1.3125rem (Twist C, intensity 3); font replaced from proprietary __myFont_2f1432 to 'Archivo' to align with assembled type system (Check C fix)"
}
