      "resolvedName": "Lora",
      "webAccessible": true
    },
    {
      "family": "Lora",
      "weight": "500",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Lora:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Lora",
      "webAccessible": true
    },
    {
      "family": "Lora",
      "weight": "600",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Lora:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Lora",
      "webAccessible": true
    },
    {
      "family": "Lora",
      "weight": "700",
