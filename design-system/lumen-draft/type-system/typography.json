      "resolvedName": "Cormorant Garamond",
      "webAccessible": true
    },
    {
      "family": "Lora",
      "weight": "300",
      "style": "normal",
      "src": "https://fonts.googleapis.com/css2?family=Lora:wght@300;400;500;600;700&display=swap",
      "resolvedName": "Lora",
      "webAccessible": true,
      "_note": "Google Fonts CDN import. Replaces Newsreader (not on Google Fonts list)."
    },
    {
      "family": "Lora",
      "weight": "400",
      "style": "normal",
