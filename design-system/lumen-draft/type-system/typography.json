  "typeScale": {
    "h1": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "41.6px",
      "fontWeight": "300",
      "lineHeight": "41.6px",
      "letterSpacing": "var(--font-letter-spacing-heading, 0.06em)",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true,
      "_note": "Cormorant Garamond replaces proprietary Goyard. Letter spacing now uses --font-letter-spacing-heading (0.06em)."
    },
    "h2": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "25px",
      "letterSpacing": "var(--font-letter-spacing-heading, 0.06em)",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "h3": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "20px",
      "fontWeight": "300",
      "lineHeight": "22px",
      "letterSpacing": "var(--font-letter-spacing-heading, 0.06em)",
      "wordSpacing": "0px",
      "textTransform": "uppercase",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "body": {
      "fontFamily": "Lora, serif",
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": "20px",
      "wordSpacing": "0px",
      "primaryFont": "Lora",
      "webAccessible": true,
      "_note": "Lora replaces Newsreader (not on Google Fonts list)."
    },
    "p": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": "20px",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "button": {
      "fontFamily": "Cormorant Garamond, Lora, Helvetica Neue, Helvetica, Arial, sans-serif",
      "fontSize": "0px",
      "fontWeight": "700",
      "lineHeight": "25.6px",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "small": {
      "fontFamily": "Lora, serif",
      "fontSize": "12px",
      "fontWeight": "400",
      "lineHeight": "20px",
      "wordSpacing": "0px",
      "primaryFont": "Lora",
      "webAccessible": true
    },
    "link": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "12px",
      "fontWeight": "400",
      "lineHeight": "2px",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    },
    "nav": {
      "fontFamily": "Cormorant Garamond, serif",
      "fontSize": "12px",
      "fontWeight": "400",
      "lineHeight": "2px",
      "wordSpacing": "0px",
      "primaryFont": "Cormorant Garamond",
      "webAccessible": true
    }
  },
  "proprietaryFonts": []
