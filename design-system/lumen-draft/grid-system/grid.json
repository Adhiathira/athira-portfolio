  "responsive": {
    "bp-320px": {
      "query": "only screen and (max-width: 320px)",
      "maxWidth": "8.33333%",
      "display": "none"
    },
    "bp-640px": {
      "query": "only screen and (max-width: 640px)",
      "flexDirection": "column",
      "display": "block"
    },
    "bp-641px": {
      "query": "only screen and (min-width: 641px) and (max-width: 833px)",
      "maxWidth": "50%"
    },
    "bp-734px": {
      "query": "only screen and (max-width: 734px)",
      "maxWidth": "100%",
      "display": "none",
      "flexDirection": "column",
      "rowGap": "0px",
      "gridTemplateRows": "unset",
      "gridTemplateColumns": "repeat(9, minmax(80px, 92px))"
    },
    "bp-735px": {
      "query": "only screen and (min-width: 735px)",
      "display": "flex",
      "flexDirection": "column",
      "maxWidth": "56%"
    },
    "bp-833px": {
      "query": "only screen and (max-width: 833px)",
      "display": "flex",
      "maxWidth": "none",
      "flexDirection": "column",
      "flexWrap": "wrap"
    },
    "bp-834px": {
      "query": "only screen and (min-width: 834px)",
      "display": "contents",
      "maxWidth": "calc(1024px - var(--r-globalnav-scrollbar-width))"
    },
    "bp-900px": {
      "query": "only screen and (max-width: 900px)",
      "maxWidth": "8.33333%",
      "display": "none"
    }
  },
  "visual": [
    {
      "section": "nav",
      "layout": "full-width-horizontal-nav",
      "description": "Single-row navigation bar spanning full width with logo centered-left, evenly spaced text links across the middle, and two icon buttons (search, bag) on the far right."
    },
    {
      "section": "hero-siri-product-scatter",
      "layout": "full-width-overlapping-scatter",
      "description": "Full-width section with the Siri wordmark centered in the viewport and Apple devices (iPhone, HomePod, AirPods, Apple Watch, Apple TV Remote, iPad) scattered around it at various angles with no grid alignment — deliberate asymmetric composition."
    },
    {
      "section": "siri-value-props-text",
      "layout": "full-width-centered-stacked-text",
      "description": "Full-width light-gray section with four centered headline paragraphs stacked vertically, each line using a gradient text color that shifts across the set (magenta to purple to blue to teal)."
    },
    {
      "section": "apple-intelligence-dark-hero",
      "layout": "full-width-centered-headline",
      "description": "Full-bleed black section with a small eyebrow label top-left, a massive two-line gradient headline centered, and a narrow centered body text block with a text link below it."
    },
    {
      "section": "on-the-go-phone-split",
      "layout": "asymmetric-2-column-image-text",
      "description": "Light section with an oversized display headline on the left half continuing off-screen, two cropped iPhone mockups side-by-side in the left column, and a body-text paragraph anchored to the right column."
    },
    {
      "section": "hands-free-phone-feature",
      "layout": "2-column-image-text",
      "description": "White section with a large tilted iPhone mockup on the left occupying roughly 40% of the width, and a multi-line body paragraph on the right at approximately 35% width with generous whitespace separating them."
    },
    {
      "section": "siri-command-cards",
      "layout": "2-column-card-grid-over-gradient",
      "description": "Purple-to-pink gradient background section containing two equal-width rounded cards side by side, each showing a Siri voice command headline with a UI result screenshot below it."
    },
    {
      "section": "in-the-car-headline",
      "layout": "full-width-oversized-headline-with-image",
      "description": "White section with an extremely large display headline left-aligned taking up about 55% of the width, a body paragraph right-aligned in the remaining space, and a cropped car interior photo bleeding out of the bottom-left."
    },
    {
      "section": "carplay-car-image-cards",
      "layout": "full-width-image-above-2-column-cards",
      "description": "Blue-to-purple gradient section with a full-width rounded car interior image on top, then two equal-width rounded cards below — one white, one dark — each containing a Siri command example with a phone mockup."
    },
    {
      "section": "facetime-purple-section",
      "layout": "full-width-2-column-phones",
      "description": "Deep purple full-bleed section with two phone mockups side by side, one showing a FaceTime call with a Memoji and the other showing a dark screen, with section text beginning to appear at the bottom transitioning to a new context."
    },
    {
      "section": "working-out-teal-gradient",
      "layout": "full-width-hero-with-centered-feature-card",
      "description": "Teal-to-white gradient section with an oversized display headline at the top left and a large centered rounded card containing a Siri command on the left and an Apple Watch mockup on the right — asymmetric split within the card."
    }
  ]
