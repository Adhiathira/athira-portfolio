{
  "twist": "From vesper-grain's bottom-border underline system (border 0.3s cubic-bezier easing), kept the underline expand mechanic but changed the easing to cubic-bezier(0.19, 1, 0.22, 1) — an expo-out curve that gives the hover reveal a snap of precision. Focus states use a 1px rule offset (no box-shadow glow). No color state changes animate.",
  "buttons": {
    "primary-cta": {
      "selector": "button.qm-btn-primary",
      "default": {
        "backgroundColor": "#1a1a18",
        "color": "#f5f4f0",
        "borderColor": "#1a1a18",
        "borderWidth": "1px",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "opacity 0.3s cubic-bezier(0.19, 1, 0.22, 1)"
      },
      "hover": {
        "backgroundColor": "#1a1a18",
        "color": "#f5f4f0",
        "borderColor": "#1a1a18",
        "borderWidth": "1px",
        "opacity": "0.78",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "opacity 0.3s cubic-bezier(0.19, 1, 0.22, 1)"
      },
      "focus": {
        "backgroundColor": "#1a1a18",
        "color": "#f5f4f0",
        "borderColor": "#1a1a18",
        "borderWidth": "1px",
        "outlineColor": "#1a1a18",
        "outlineWidth": "1px",
        "outlineOffset": "3px",
        "opacity": "1",
        "cursor": "pointer"
      }
    },
    "secondary-cta": {
      "selector": "button.qm-btn-secondary",
      "default": {
        "backgroundColor": "transparent",
        "color": "#1a1a18",
        "borderColor": "#1a1a18",
        "borderWidth": "1px",
        "opacity": "1",
        "cursor": "pointer",
        "transition": "opacity 0.3s cubic-bezier(0.19, 1, 0.22, 1)"
      },
      "hover": {
        "backgroundColor": "transparent",
        "color": "#1a1a18",
        "borderColor": "#1a1a18",
        "borderWidth": "1px",
        "opacity": "0.7",
        "cursor": "pointer"
      },
      "focus": {
        "outlineColor": "#1a1a18",
        "outlineWidth": "1px",
        "outlineOffset": "3px"
      }
    }
  },
  "links": {
    "nav-link": {
      "selector": "a.qm-nav-link",
      "default": {
        "color": "#1a1a18",
        "borderBottomColor": "transparent",
        "borderBottomWidth": "1px",
        "borderBottomStyle": "solid",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "border-bottom-color 0.3s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.3s cubic-bezier(0.19, 1, 0.22, 1)"
      },
      "hover": {
        "color": "#1a1a18",
        "borderBottomColor": "#1a1a18",
        "borderBottomWidth": "1px",
        "opacity": "1",
        "cursor": "pointer"
      },
      "focus": {
        "outlineColor": "#1a1a18",
        "outlineWidth": "1px",
        "outlineOffset": "3px"
      }
    }
  },
  "cards": {
    "feature-card": {
      "selector": ".qm-card",
      "default": {
        "transform": "none",
        "boxShadow": "none",
        "transition": "transform 0.65s cubic-bezier(0.19, 1, 0.22, 1)"
      },
      "hover": {
        "transform": "translateY(-4px)",
        "boxShadow": "0 8px 24px rgba(26, 26, 24, 0.08)"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "selector": "a.qm-nav-link",
      "default": { "color": "#1a1a18", "opacity": "1" },
      "hover": { "opacity": "0.6" },
      "active": { "opacity": "1", "borderBottomColor": "#1a1a18" }
    }
  }
}
