{
  "twist": "Heights Agency nav had minimal geometry data (46px height, 30px item spacing, static position). Kept those as the baseline but added a full nav typographic spec using the type system, and introduced a scroll-reveal behavior where the nav gains a hairline bottom border on scroll rather than changing background. The nav stays transparent/warm-ivory — it does not go dark on scroll.",
  "geometry": {
    "height": 62,
    "paddingInline": "clamp(24px, 5vw, 96px)",
    "position": "fixed",
    "itemSpacing": 36,
    "zIndex": 100
  },
  "typography": {
    "fontFamily": "Jost, Helvetica, Arial, sans-serif",
    "fontSize": "11px",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "states": {
    "default": {
      "background": "#f5f4f0",
      "borderBottom": "none",
      "text": "#1a1a18"
    },
    "scrolled": {
      "background": "#f5f4f0",
      "borderBottom": "1px solid #b1ada7",
      "text": "#1a1a18",
      "transition": "border-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "links": {
    "default": { "color": "#1a1a18", "opacity": "1" },
    "hover": { "opacity": "0.6", "transition": "opacity 0.3s cubic-bezier(0.19, 1, 0.22, 1)" },
    "active": { "opacity": "1", "borderBottom": "1px solid #1a1a18" }
  },
  "cta": {
    "bg": "#1a1a18",
    "text": "#f5f4f0",
    "border": "#1a1a18",
    "borderRadius": "2px",
    "padding": "10px 20px",
    "fontSize": "11px",
    "letterSpacing": "0.1em",
    "textTransform": "uppercase"
  },
  "logo": {
    "position": "left",
    "fontFamily": "Cormorant Garamond, Georgia, serif",
    "fontSize": "18px",
    "fontWeight": "400",
    "letterSpacing": "0.08em"
  },
  "mobile": {
    "breakpoint": "768px",
    "menuType": "slide-down",
    "menuBackground": "#f5f4f0"
  }
}
