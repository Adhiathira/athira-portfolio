{
  "cssVars": {
    "ds-font-family-display": "'Orbitron', 'JetBrains Mono', monospace",
    "ds-font-family-heading": "'Orbitron', 'JetBrains Mono', monospace",
    "ds-font-family-body": "'Figtree', system-ui, sans-serif",
    "ds-font-family-mono": "'JetBrains Mono', monospace",
    "ds-font-family-secondary": "'Questrial', system-ui, sans-serif",
    "ds-font-size-3xl": "100px",
    "ds-font-size-2xl": "70px",
    "ds-font-size-xl": "2.5rem",
    "ds-font-size-lg": "1.75rem",
    "ds-font-size-md": "1.25rem",
    "ds-font-size-base": "1rem",
    "ds-font-size-sm": "0.875rem",
    "ds-font-size-xs": "0.75rem",
    "ds-font-weight-display": "900",
    "ds-font-weight-heading": "700",
    "ds-font-weight-subheading": "600",
    "ds-font-weight-body": "400",
    "ds-font-weight-label": "600",
    "ds-line-height-display": "0.95",
    "ds-line-height-heading": "1.05",
    "ds-line-height-body": "1.6",
    "ds-line-height-label": "1.2",
    "ds-letter-spacing-display": "-0.02em",
    "ds-letter-spacing-heading": "-0.015em",
    "ds-letter-spacing-body": "0.01em",
    "ds-letter-spacing-mono": "0.05em",
    "ds-letter-spacing-label": "0.08em"
  },
  "fontFaces": [
    {
      "resolvedName": "Orbitron",
      "role": "display-heading",
      "source": "google-fonts",
      "weights": [400, 500, 600, 700, 800, 900]
    },
    {
      "resolvedName": "JetBrains Mono",
      "role": "mono-buttons-links",
      "source": "google-fonts",
      "weights": [300, 400, 500, 600, 700]
    },
    {
      "resolvedName": "Figtree",
      "role": "body-nav",
      "source": "google-fonts",
      "weights": [300, 400, 500, 600, 700]
    },
    {
      "resolvedName": "Questrial",
      "role": "secondary-labels",
      "source": "google-fonts",
      "weights": [400]
    }
  ],
  "scaleRoles": {
    "h1": {
      "fontFamily": "var(--ds-font-family-display)",
      "fontSize": "var(--ds-font-size-3xl)",
      "fontWeight": "var(--ds-font-weight-display)",
      "letterSpacing": "var(--ds-letter-spacing-display)",
      "lineHeight": "var(--ds-line-height-display)",
      "textTransform": "uppercase"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "var(--ds-font-size-2xl)",
      "fontWeight": "var(--ds-font-weight-heading)",
      "letterSpacing": "var(--ds-letter-spacing-heading)",
      "lineHeight": "var(--ds-line-height-heading)",
      "textTransform": "uppercase"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-heading)",
      "fontSize": "var(--ds-font-size-xl)",
      "fontWeight": "var(--ds-font-weight-subheading)",
      "letterSpacing": "var(--ds-letter-spacing-heading)",
      "lineHeight": "var(--ds-line-height-heading)",
      "textTransform": "uppercase"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "var(--ds-font-size-base)",
      "fontWeight": "var(--ds-font-weight-body)",
      "letterSpacing": "var(--ds-letter-spacing-body)",
      "lineHeight": "var(--ds-line-height-body)"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "var(--ds-font-size-sm)",
      "fontWeight": "var(--ds-font-weight-label)",
      "letterSpacing": "var(--ds-letter-spacing-label)",
      "lineHeight": "var(--ds-line-height-label)",
      "textTransform": "uppercase"
    },
    "caption": {
      "fontFamily": "var(--ds-font-family-secondary)",
      "fontSize": "var(--ds-font-size-xs)",
      "fontWeight": "var(--ds-font-weight-body)",
      "letterSpacing": "var(--ds-letter-spacing-mono)",
      "lineHeight": "var(--ds-line-height-label)"
    }
  },
  "_twist": {
    "sourceSystem": "girlboss",
    "type": "cyberpunk-override",
    "intensity": 4,
    "description": "Heading fonts replaced with Orbitron (display/h2: 100px/900, h3: 70px/700) for sci-fi HUD aesthetic. JetBrains Mono introduced as the mono/button/link family. Figtree retained for body legibility. Questrial for secondary labels. All headings uppercase with tight tracking."
  }
}
