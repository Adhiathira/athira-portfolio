    },
    "hover": {
      "color": "#e4e4e7",
      "textDecoration": "underline",
      "transition": "color 0.11s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid #2c2c30",
      "boxShadow": "none"
    },
    "hover": {
      "border": "1px solid #acacaf",
      "boxShadow": "0 0 0 1px rgba(0,0,0,0.8), 0 0 0 2px rgba(172,172,175,0.4), 0 0 12px rgba(172,172,175,0.1)",
