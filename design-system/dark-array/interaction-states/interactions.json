      "borderColor": "#fd356e",
      "boxShadow": "0 0 0 1px #fd356e, 0 0 8px rgba(253,53,110,0.3)",
      "outline": "none"
    }
  },
  "links": {
    "default": {
      "color": "#acacaf",
