    }
  },
  "navigation": {
    "link": {
      "default": { "color": "#acacaf", "opacity": "1" },
      "hover": {
        "color": "#ffffff",
        "textShadow": "0 0 8px rgba(255,255,255,0.4)",
        "transition": "color 0.11s cubic-bezier(0.4, 0, 0.2, 1), text-shadow 0.06s linear"
      },
      "active": { "color": "#fd356e", "fontWeight": "600" }
    }
  },
  "_twist": {
    "sourceSystem": "opaline-draft",
    "type": "neon-halo-box-shadow",
    "intensity": 4,
    "description": "Neon halo on hover: double box-shadow — inner 2px black ring + outer colored glow. Transition: 0.11s for color/border (cubic-bezier(0.4,0,0.2,1)), 0.06s linear for box-shadow. Focus ring with glow expansion. All states machine-precise: no bounce, no decay."
  }
