{
  "cssVars": {},
  "container": {
    "maxWidth": "700px"
  },
  "grids": {},
  "responsive": {
    "bp-480px": {
      "query": "only screen and (max-width: 480px)",
      "display": "none"
    },
    "bp-767px": {
      "query": "only screen and (max-width: 767px)",
      "display": "none",
      "flexWrap": "wrap",
      "gridTemplateColumns": "repeat(2, 160px)",
      "maxWidth": "65vw"
    },
    "bp-768px": {
      "query": "only screen and (min-width: 768px)",
      "display": "flex",
      "rowGap": "20px",
      "columnGap": "20px",
      "gridTemplateColumns": "repeat(auto-fill, 200px)",
      "maxWidth": "200px"
    }
  },
  "visual": []
}