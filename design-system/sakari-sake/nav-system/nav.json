{
  "_meta": {
    "theme": "Aurora/Gradient Glow",
    "twist": "B",
    "intensity": 2,
    "sourceSystem": "sakari-sake",
    "description": "Dark transparent nav that gains an aurora gradient border-bottom when scrolled, suggesting aurora light along the horizon."
  },
  "geometry": {
    "height": "68px",
    "paddingX": "32px",
    "paddingY": "0px",
    "maxWidth": "1440px",
    "position": "fixed",
    "top": "0",
    "left": "0",
    "right": "0",
    "zIndex": 100
  },
  "default": {
    "background": "transparent",
    "backdropFilter": "none",
    "borderBottom": "none",
    "boxShadow": "none",
    "transition": "background 0.4s ease, backdrop-filter 0.4s ease, border-bottom 0.4s ease, box-shadow 0.4s ease"
  },
  "scrolled": {
    "background": "rgba(22, 29, 37, 0.95)",
    "backdropFilter": "blur(16px)",
    "WebkitBackdropFilter": "blur(16px)",
    "borderBottom": "1px solid rgba(33, 243, 182, 0.3)",
    "boxShadow": "0 0 18px 0 rgba(33, 243, 182, 0.08)",
    "transition": "background 0.4s ease, backdrop-filter 0.4s ease, border-bottom 0.4s ease, box-shadow 0.4s ease"
  },
  "logo": {
    "color": "#ffffff",
    "colorScrolled": "#ffffff",
    "fontFamily": "Mirador-SemiBold, Georgia, serif",
    "fontSize": "20px",
    "fontWeight": "600",
    "letterSpacing": "0.04em",
    "textTransform": "none",
    "animationClass": "auroraGlow",
    "animation": {
      "name": "auroraGlow",
      "keyframes": {
        "0%": { "filter": "drop-shadow(0 0 0px rgba(33, 243, 182, 0))" },
        "50%": { "filter": "drop-shadow(0 0 6px rgba(33, 243, 182, 0.45))" },
        "100%": { "filter": "drop-shadow(0 0 0px rgba(33, 243, 182, 0))" }
      },
      "duration": "3.6s",
      "timingFunction": "ease-in-out",
      "iterationCount": "infinite",
      "trigger": "always"
    }
  },
  "links": {
    "color": "rgba(255, 255, 255, 0.78)",
    "colorScrolled": "rgba(255, 255, 255, 0.88)",
    "hoverColor": "rgba(226, 255, 101, 0.9)",
    "activeColor": "#e2ff65",
    "fontFamily": "Roboto-Regular, Helvetica Neue, Helvetica, Arial, sans-serif",
    "fontSize": "13px",
    "fontWeight": "500",
    "letterSpacing": "0.04em",
    "textTransform": "uppercase",
    "lineHeight": "1",
    "transition": "color 0.2s ease",
    "gap": "36px",
    "underlineOnHover": false,
    "hoverUnderlineColor": "rgba(226, 255, 101, 0.6)"
  },
  "cta": {
    "label": "Order Now",
    "background": "transparent",
    "backgroundScrolled": "rgba(33, 243, 182, 0.12)",
    "border": "1px solid rgba(33, 243, 182, 0.5)",
    "borderScrolled": "1px solid rgba(33, 243, 182, 0.7)",
    "color": "rgba(33, 243, 182, 0.9)",
    "colorScrolled": "#21f3b6",
    "hoverBackground": "rgba(33, 243, 182, 0.18)",
    "hoverColor": "#ffffff",
    "borderRadius": "4px",
    "paddingX": "18px",
    "paddingY": "8px",
    "fontSize": "12px",
    "fontWeight": "600",
    "letterSpacing": "0.06em",
    "textTransform": "uppercase",
    "transition": "background 0.25s ease, color 0.25s ease, border-color 0.25s ease"
  },
  "mobileMenu": {
    "breakpoint": "768px",
    "hamburgerColor": "#ffffff",
    "hamburgerColorScrolled": "#ffffff",
    "drawerBackground": "rgba(14, 19, 25, 0.98)",
    "drawerBackdropFilter": "blur(20px)",
    "drawerBorderRight": "1px solid rgba(33, 243, 182, 0.15)",
    "linkColor": "rgba(255, 255, 255, 0.85)",
    "linkHoverColor": "rgba(226, 255, 101, 0.9)",
    "drawerWidth": "100vw",
    "drawerPaddingX": "28px",
    "drawerPaddingTop": "100px",
    "linkFontSize": "22px",
    "linkLetterSpacing": "0.04em",
    "linkGap": "28px",
    "animationDuration": "0.35s",
    "animationEasing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "scrollBehavior": {
    "triggerOffsetPx": 20,
    "scrolledClass": "nav--scrolled",
    "defaultClass": "nav--default"
  },
  "auroraAccent": {
    "teal": "rgba(33, 243, 182, 0.3)",
    "tealSolid": "#21f3b6",
    "lime": "rgba(226, 255, 101, 0.9)",
    "limeSolid": "#e2ff65",
    "glowSpread": "18px",
    "glowOpacity": 0.08,
    "borderHairlineWidth": "1px"
  }
}
