{
  "container": {
    "maxWidth": "1200px",
    "paddingInline": "40px",
    "paddingInlineMobile": "20px"
  },
  "readingLayouts": {
    "readingColumn": {
      "maxWidth": "680px",
      "margin": "0 auto",
      "description": "Primary reading column — optimal measure for long-form text"
    },
    "wideReading": {
      "maxWidth": "800px",
      "margin": "0 auto",
      "description": "Wider reading column for feature sections"
    },
    "twoColWithMargin": {
      "display": "grid",
      "gridTemplateColumns": "1fr 280px",
      "gap": "64px",
      "mainTextMaxWidth": "640px",
      "sidebarWidth": "280px",
      "description": "Main text column + annotations sidebar"
    },
    "fullBleedPullQuote": {
      "maxWidth": "none",
      "paddingInline": "40px",
      "description": "Full-bleed pull quote — edge to edge with horizontal padding only"
    },
    "chapterHeader": {
      "maxWidth": "none",
      "paddingBlock": "120px 80px",
      "description": "Full-width chapter header with generous vertical rhythm"
    },
    "threeCol": {
      "display": "grid",
      "gridTemplateColumns": "repeat(3, 1fr)",
      "gap": "48px",
      "description": "Three-column feature cards"
    },
    "twoCol": {
      "display": "grid",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "gap": "64px",
      "description": "Two-column testimonials"
    },
    "statThreeCol": {
      "display": "grid",
      "gridTemplateColumns": "repeat(3, 1fr)",
      "gap": "40px",
      "description": "Three-column stats with annotation below"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "(max-width: 375px)",
      "container": "padding 20px",
      "readingColumn": "100%",
      "twoColWithMargin": "single column"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "threeCol": "single column",
      "twoCol": "single column",
      "twoColWithMargin": "single column, no sidebar"
    },
    "bp-1024px": {
      "query": "(max-width: 1024px)",
      "threeCol": "2 columns",
      "twoColWithMargin": "1fr 220px"
    },
    "bp-1440px": {
      "query": "(min-width: 1440px)",
      "container": "max 1200px centered"
    }
  }
}
