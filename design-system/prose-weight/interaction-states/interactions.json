{
  "links": {
    "default": {
      "color": "#1a1714",
      "textDecoration": "none",
      "transition": "color 200ms ease-out, text-decoration 200ms ease-out"
    },
    "hover": {
      "color": "#8b1f2e",
      "textDecoration": "underline",
      "textDecorationColor": "#8b1f2e",
      "textUnderlineOffset": "3px"
    },
    "active": {
      "color": "#6b1522",
      "textDecoration": "underline"
    },
    "visited": {
      "color": "#6b6560"
    }
  },
  "focus": {
    "outlineStyle": "2px solid #8b1f2e",
    "outlineOffset": "2px",
    "description": "All focusable elements: 2px solid wine red, 2px offset"
  },
  "selection": {
    "background": "#fff3cd",
    "color": "#1a1714",
    "description": "Soft yellow highlight selection — like a physical highlighter pen"
  },
  "footnoteHover": {
    "description": "Hovering a footnote marker reveals the annotation in the margin",
    "trigger": "hover on [data-footnote]",
    "action": "display adjacent .annotation element",
    "animation": "slide in from x:8, 300ms ease-out"
  },
  "buttons": {
    "primary": {
      "default": {
        "background": "#8b1f2e",
        "color": "#faf7f2",
        "border": "1px solid #8b1f2e",
        "padding": "12px 28px"
      },
      "hover": {
        "background": "#6b1522",
        "border": "1px solid #6b1522"
      },
      "focus": {
        "outline": "2px solid #8b1f2e",
        "outlineOffset": "2px"
      }
    },
    "ghost": {
      "default": {
        "background": "transparent",
        "color": "#1a1714",
        "border": "1px solid rgba(26,23,20,0.25)",
        "padding": "12px 28px"
      },
      "hover": {
        "border": "1px solid #1a1714"
      }
    }
  },
  "navigation": {
    "default": {
      "color": "#1a1714",
      "fontWeight": "400"
    },
    "hover": {
      "color": "#8b1f2e"
    },
    "active": {
      "color": "#8b1f2e",
      "fontWeight": "600"
    }
  },
  "characterDescription": "Reading-quiet interactions: no bold effects, no shadows, no scales. Links reveal their wine-red identity only on hover, underline confirms the intention. Focus is clear but unobtrusive. Selection is the literal highlighter pen. The page breathes — interactions are a whisper, not a shout."
}
