{
  "fontFaces": [
    {
      "family": "Playfair Display",
      "weight": "400 700",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap",
      "resolvedName": "Playfair Display",
      "webAccessible": true,
      "role": "heading-serif"
    },
    {
      "family": "Lora",
      "weight": "400 700",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&display=swap",
      "resolvedName": "Lora",
      "webAccessible": true,
      "role": "body-serif"
    },
    {
      "family": "Source Sans Pro",
      "weight": "300 400 600",
      "style": "normal italic",
      "src": "https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,300;0,400;0,600;1,400&display=swap",
      "resolvedName": "Source Sans Pro",
      "webAccessible": true,
      "role": "ui-caption"
    }
  ],
  "typeScale": {
    "h1": {
      "fontFamily": "Playfair Display, Georgia, serif",
      "fontSize": "clamp(2.5rem, 5vw, 4rem)",
      "fontWeight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "-0.01em",
      "primaryFont": "Playfair Display",
      "webAccessible": true,
      "role": "chapter-title"
    },
    "h2": {
      "fontFamily": "Playfair Display, Georgia, serif",
      "fontSize": "clamp(1.75rem, 3.5vw, 2.5rem)",
      "fontWeight": "600",
      "lineHeight": "1.3",
      "letterSpacing": "-0.005em",
      "primaryFont": "Playfair Display",
      "webAccessible": true,
      "role": "section-heading"
    },
    "h3": {
      "fontFamily": "Lora, Georgia, serif",
      "fontSize": "clamp(1.25rem, 2vw, 1.75rem)",
      "fontWeight": "700",
      "lineHeight": "1.4",
      "letterSpacing": "0",
      "primaryFont": "Lora",
      "webAccessible": true,
      "role": "subhead"
    },
    "body": {
      "fontFamily": "Lora, Georgia, serif",
      "fontSize": "1.1rem",
      "fontWeight": "400",
      "lineHeight": "1.85",
      "letterSpacing": "0.005em",
      "primaryFont": "Lora",
      "webAccessible": true,
      "role": "long-form-reading"
    },
    "pullQuote": {
      "fontFamily": "Playfair Display, Georgia, serif",
      "fontSize": "clamp(1.5rem, 3vw, 2rem)",
      "fontWeight": "400",
      "fontStyle": "italic",
      "lineHeight": "1.5",
      "letterSpacing": "0.01em",
      "primaryFont": "Playfair Display",
      "webAccessible": true,
      "role": "pull-quote"
    },
    "caption": {
      "fontFamily": "Source Sans Pro, Helvetica, Arial, sans-serif",
      "fontSize": "0.8125rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0.01em",
      "primaryFont": "Source Sans Pro",
      "webAccessible": true,
      "role": "caption-annotation"
    },
    "readingProgress": {
      "fontFamily": "Source Sans Pro, Helvetica, Arial, sans-serif",
      "fontSize": "0.6875rem",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.12em",
      "textTransform": "uppercase",
      "primaryFont": "Source Sans Pro",
      "webAccessible": true,
      "role": "reading-progress-label"
    },
    "dropCap": {
      "fontFamily": "Playfair Display, Georgia, serif",
      "fontSize": "5rem",
      "fontWeight": "700",
      "lineHeight": "0.85",
      "color": "#8b1f2e",
      "float": "left",
      "marginRight": "-0.08em",
      "primaryFont": "Playfair Display",
      "webAccessible": true,
      "role": "drop-cap"
    },
    "chapterNumber": {
      "fontFamily": "Playfair Display, Georgia, serif",
      "fontSize": "clamp(0.75rem, 1.5vw, 1rem)",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.2em",
      "textTransform": "uppercase",
      "color": "#c49b7c",
      "primaryFont": "Playfair Display",
      "webAccessible": true,
      "role": "chapter-number-label"
    },
    "nav": {
      "fontFamily": "Source Sans Pro, Helvetica, Arial, sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1",
      "letterSpacing": "0.01em",
      "primaryFont": "Source Sans Pro",
      "webAccessible": true,
      "role": "navigation"
    }
