      "wordSpacing": "0px",
      "fontFeatureSettings": "normal",
      "primaryFont": "DM Sans",
      "webAccessible": true,
      "_note": "Weight shifted from 300 to 500; line-height loosened from 35.2px to 40px."
    },
    "h3": {
      "fontFamily": "'DM Sans', system-ui, sans-serif",
      "fontSize": "26px",
      "fontWeight": "500",
      "lineHeight": "32.5px",
      "letterSpacing": "-0.26px",
      "wordSpacing": "0px",
      "fontFeatureSettings": "normal",
      "primaryFont": "DM Sans",
