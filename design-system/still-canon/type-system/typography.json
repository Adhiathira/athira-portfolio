  "proprietaryFonts": [],
  "replacedFonts": [
    {
      "original": "sohne-var",
      "replacement": "DM Sans",
      "reason": "sohne-var is a proprietary Klim Type Foundry font. DM Sans is the closest Google Fonts match: humanist grotesque, optically-corrected, low-contrast, strong UI performance."
    }
  ]
