{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "fadeIn",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "visibility": "hidden" } },
          { "offset": "100%", "properties": { "opacity": "1", "visibility": "visible" } }
        ]
      },
      {
        "name": "slideInFromTop",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(-2%) scale(0.96)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px) scale(1)" } }
        ]
      },
      {
        "name": "slideInFromRight",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translate(4%) scale(0.98)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translate(0px) scale(1)" } }
        ]
      },
      {
        "name": "spinning",
        "steps": [
          { "offset": "0%", "properties": { "transform": "rotate(0deg)" } },
          { "offset": "100%", "properties": { "transform": "rotate(360deg)" } }
        ]
      },
      {
        "name": "pulse-opacity",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0.6" } },
          { "offset": "80%", "properties": { "opacity": "1" } },
          { "offset": "100%", "properties": { "opacity": "0.6" } }
        ]
      },
      {
        "name": "marquee",
        "steps": [
          { "offset": "0%", "properties": { "transform": "translateX(0px)" } },
          { "offset": "100%", "properties": { "transform": "translateX(-50%)" } }
        ]
      }
    ],
    "timingTokens": {
      "durations": ["0.195s", "0.3s", "0.45s", "72s"],
      "easings": [
        "cubic-bezier(0.4, 0, 0.2, 1)",
        "cubic-bezier(0.215, 0.61, 0.355, 1)",
        "linear",
        "ease"
      ]
    }
  },
  "scrollAnimations": {
    "libraries": [],
    "elements": [],
    "parallaxElements": [],
    "patterns": []
  },
  "performance": {
    "usesHardwareAcceleration": true,
    "reducedMotionSupport": true
  },
  "_source": "slite",
  "_twist": "All durations scaled 1.5x; ease-in-out replaced with cubic-bezier(0.4, 0, 0.2, 1)",
  "_intensity": 3
}
