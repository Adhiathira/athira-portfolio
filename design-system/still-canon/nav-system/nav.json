{
  "geometry": {
    "height": 36.7,
    "paddingInline": 48,
    "position": "fixed",
    "itemSpacing": 88,
    "heightScrolled": 131,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": "1px solid rgb(var(--header-separation-border-color))",
    "boxShadow": "0 -1px rgb(var(--header-separation-border-color)) inset",
    "boxShadowScrolled": null,
    "transition": "background 0.2s, color 0.2s, border 0.2s, box-shadow 0.2s"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "calc(0.75rem * 1.5)",
    "fontWeight": "bold",
    "letterSpacing": "0.0em",
    "textTransform": "normal",
    "lineHeight": "2px"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": "transform 0.2s ease-in-out",
    "underline": {
      "type": "pseudo-element",
      "thickness": "2px",
      "offset": "0px",
      "animation": {
        "property": "transform",
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left",
        "duration": "0.2s",
        "easing": "ease-in-out"
      }
    }
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "is-solid",
    "propertiesChanged": [
      "background",
      "color",
      "border",
      "box-shadow"
    ],
    "duration": "0.2s",
    "easing": "ease",
    "colorInversion": true
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": "0px",
    "boxShadow": "2px 2px 6px rgb(var(--color) / .05)",
    "padding": "1.125rem 0",
    "itemPadding": "0.375rem 1.5625rem",
    "animation": "pseudo-element top border scaleX(0) to scaleX(1) over 0.25s ease-in-out 50ms"
  },
  "characterDescription": "A refined, editorial navigation fixed to the viewport as a persistent floating overlay, using a precise scaleX pseudo-element underline animation to signal interactivity. A border-bottom materialises on scroll via the is-solid class toggle, visually anchoring the nav against page content beneath it as the user moves past the hero section. Font inherits DM Sans from the base type system.",
  "_consistencyFix": "fontFamily corrected from 'Simply-ChocolateCOMPBold' (proprietary) to 'inherit' — picks up DM Sans from the assembled type-system."
}
