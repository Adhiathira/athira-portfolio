    {
      "hex": "#fef9c3",
      "role": "page-background",
      "description": "Warm pale yellow used as the dominant page background throughout the site."
    },
    {
      "hex": "#f9c8d0",
      "role": "hero-background",
      "description": "Soft pink used as a large section background, particularly in the Kahlúa x Dunkin' split section."
    },
    {
      "hex": "#b2e8e0",
      "role": "surface-background",
      "description": "Mint/aqua green used as an accent section background for the social feed area."
    },
    {
      "hex": "#d9d0c7",
      "role": "surface-background-alt",
      "description": "Warm greige/taupe used as a card background in the bottom editorial grid."
    },
    {
      "hex": "#ffffff",
      "role": "surface-background-light",
      "description": "Pure white used as card and modal surfaces."
    },
    {
      "hex": "#ba0c2f",
      "role": "primary-action",
      "description": "Deep Kahlúa red used for primary CTA buttons and prominent UI accents."
    },
    {
      "hex": "#ffd502",
      "role": "secondary-action",
      "description": "Bright yellow used for secondary CTA buttons like 'VIEW ALL KAHLÚA DRINKS' and 'VIEW ALL KAHLÚA PRODUCTS'."
    },
    {
      "hex": "#e8809a",
      "role": "accent",
      "description": "Muted rose/pink used for the brand logo, large typographic headlines, and decorative type on the yellow background."
    },
    {
      "hex": "#1b1b1b",
      "role": "body-text",
      "description": "Near-black used for body copy, navigation text, and dark button labels."
    },
    {
      "hex": "#623c2c",
      "role": "heading-text",
      "description": "Dark brown used for button text on yellow CTAs, grounding them in the brand's coffee heritage."
    },
    {
      "hex": "#034d96",
      "role": "link",
      "description": "Deep blue used for hyperlinks within cookie consent copy."
    },
    {
      "hex": "#efefef",
      "role": "border",
      "description": "Light grey used as a subtle border or surface tone on icon-style buttons."
    },
    {
      "hex": "#ffffff",
      "role": "nav-text",
      "description": "White used for nav text and icons in the overlay/transparent nav state at top of page."
    },
    {
      "hex": "#fef9c3",
      "role": "nav-background-scrolled",
      "description": "The same warm pale yellow extends into the nav background once the page is scrolled, giving it a continuous page-color feel."
    },
    {
      "hex": "#e8809a",
      "role": "nav-text-scrolled",
      "description": "The Kahlúa logo renders in muted rose/pink in both nav states."
    }
