{
  "cssVars": {
    "global-content-max-width": "calc(var(--global-content-max-width-setting) / var(--desktop-design-reference) * var(--screen-width-static))",
    "global-content-max-width-setting": "1110",
    "better-reviews-star-gap": "15px"
  },
  "container": {
    "maxWidth": "730px",
    "paddingLeft": "50px",
    "paddingRight": "50px"
  },
  "grids": {
    "site-header": {
      "display": "grid",
      "templateColumns": "54px 135px 64px",
      "columnCount": "3",
      "templateRows": "0px 0px 52px 0px",
      "childCount": "4"
    },
    "group-container__grid-container": {
      "display": "grid",
      "templateColumns": "768px 768px",
      "columnCount": "2",
      "templateRows": "1090.78px",
      "gap": "0px 32px",
      "childCount": "2",
      "parentSection": "section"
    }
  },
  "responsive": {
    "bp-375px": {
      "query": "screen and (min-width: 375px)",
      "flexDirection": "column",
      "rowGap": "0px",
      "columnGap": "0px"
    },
    "bp-400px": {
      "query": "only screen and (max-width: 400px)",
      "maxWidth": "40%"
    },
    "bp-401px": {
      "query": "(min-width: 401px) and (max-width: 576px)",
      "maxWidth": "80%"
    },
    "bp-480px": {
      "query": "(max-width: 480px)",
      "gridTemplateColumns": "1fr",
      "flexDirection": "column",
      "rowGap": "8px",
      "columnGap": "8px"
    },
    "bp-600px": {
      "query": "(max-width: 600px)",
      "display": "flex",
      "flexDirection": "column",
      "rowGap": "5px",
      "columnGap": "5px"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "gridTemplateColumns": "repeat(2, 1fr)",
      "display": "none"
    },
    "bp-680px": {
      "query": "(min-width: 680px)",
      "display": "inline-block"
    },
    "bp-768px": {
      "query": "screen and (min-width: 768px)",
      "flexDirection": "var(--direction-portrait)",
      "maxWidth": "calc(1000/var(--portrait-design-reference)*var(--screen-width-portrait))",
      "display": "var(--display-arrows-portrait)",
      "gridTemplateColumns": "var(--grid-template-columns-custom-portrait, repeat(var(--grid-columns-portrait, 1), var(--grid-auto-columns-custom-size, var(--grid-auto-columns, auto))))",
      "gridTemplateRows": "var(--grid-template-rows-custom-portrait)",
      "columnGap": "calc(10/var(--portrait-design-reference)*var(--screen-width-portrait))"
    }
  },
  "visual": [
    {
      "section": "age-gate",
      "layout": "full-width-centered",
      "description": "Single full-viewport section with all elements center-aligned vertically and horizontally on a solid yellow background, containing logo, heading, date input row, checkbox row, and legal text stacked in a single column."
    },
    {
      "section": "logo",
      "layout": "single-column-center",
      "description": "Brand logo centered horizontally at the top of the content stack, no surrounding elements."
    },
    {
      "section": "heading",
      "layout": "single-column-center",
      "description": "Large bold uppercase 'ID CHECK' heading centered below the logo with significant top margin."
    },
    {
      "section": "date-input-row",
      "layout": "3-column-inline",
      "description": "Three equal-width bordered input fields (MM, DD, YYYY) arranged horizontally in a row, followed by a square OK button, all center-aligned as a single inline group."
    },
    {
      "section": "checkbox-row",
      "layout": "inline-label-pair",
      "description": "A checkbox and 'Remember me' label aligned horizontally and centered, with a secondary note line below it."
    },
    {
      "section": "legal-text",
      "layout": "single-column-center",
      "description": "Small multi-line legal copy centered below the checkbox, followed by an 'Enjoy Responsibly!' line."
    }
  ]
}