{
  "geometry": {
    "height": 56,
    "paddingInline": 48,
    "position": "sticky",
    "heightScrolled": 56,
    "itemSpacing": 40,
    "logoPosition": "left",
    "borderBottom": "2px solid #000000"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "0.6875rem",
    "fontWeight": "600",
    "letterSpacing": "0.1em",
    "textTransform": "uppercase"
  },
  "defaultState": {
    "background": "transparent",
    "borderBottom": "2px solid #000000",
    "backdropFilter": "none"
  },
  "scrollState": {
    "background": "#ffffff",
    "borderBottom": "2px solid #000000",
    "backdropFilter": "none",
    "transition": "background 0ms step-end"
  },
  "linkHover": {
    "textShadow": "1px 1px 0 #000000",
    "animation": {
      "type": "iso-lift",
      "duration": "0ms",
      "easing": "step-end",
      "description": "Instant mechanical snap — hard 3D letter-lift via text-shadow"
    }
  },
  "mobileMenu": {
    "type": "full-page-overlay",
    "background": "#ffffff",
    "border": "2px solid #000000",
    "openTransition": "transform 200ms cubic-bezier(0.4, 0, 0.2, 1)",
    "entryTransform": "translateY(-100%)"
  },
  "characterDescription": "Technical blueprint nav — near-invisible at rest against page, a precise 2px border-bottom as the only grounding line. On scroll, snaps to white (step-end, no fade). Links click into their 3D letter-lift state instantly — mechanical, deliberate."
}
