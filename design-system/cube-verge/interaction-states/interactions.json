{
  "meta": {
    "source": "pale-draft",
    "theme": "isometric",
    "intensity": 4,
    "easing": {
      "isoCrisp": "cubic-bezier(0.4, 0, 0.2, 1)",
      "description": "Mechanical precision easing — no bounce, no spring. Arrives at tolerance."
    }
  },
  "buttons": {
    "default": {
      "transition": "transform 200ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1)",
      "transform": "none",
      "boxShadow": "4px 4px 0px #000000",
      "borderRadius": "0px"
    },
    "hover": {
      "transform": "translateY(-2px) translateX(1px)",
      "boxShadow": "6px 6px 0px #000000",
      "transition": "transform 200ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "active": {
      "transform": "translateY(1px) translateX(-1px)",
      "boxShadow": "1px 1px 0px #000000",
      "transition": "transform 120ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 120ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "focus": {
      "outline": "2px solid #000000",
      "outlineOffset": "4px"
    },
    "disabled": {
      "opacity": 0.4,
      "cursor": "not-allowed",
      "pointerEvents": "none",
      "boxShadow": "2px 2px 0px rgba(0,0,0,0.3)"
    }
  },
  "cards": {
    "default": {
      "transition": "transform 180ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 180ms cubic-bezier(0.4, 0, 0.2, 1)",
      "transform": "none",
      "boxShadow": "4px 4px 0px rgba(0,0,0,0.15)",
      "borderRadius": "0px"
    },
    "hover": {
      "transform": "translate(-3px, -3px)",
      "boxShadow": "6px 6px 0px rgba(0,0,0,0.15)",
      "transition": "transform 180ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 180ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "active": {
      "transform": "translate(-1px, -1px)",
      "boxShadow": "2px 2px 0px rgba(0,0,0,0.12)"
    }
  },
  "inputs": {
    "default": {
      "transition": "border-color 200ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1)",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "#000000",
      "borderRadius": "0px"
    },
    "focus": {
      "borderWidth": "2px",
      "borderColor": "#000000",
      "boxShadow": "2px 2px 0px #000000",
      "outline": "none"
    }
  },
  "links": {
    "default": {
      "transition": "opacity 180ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "hover": {
      "opacity": 0.65
    }
  },
  "globalTokens": {
    "isoCrisp": "cubic-bezier(0.4, 0, 0.2, 1)",
    "transitionDurationFast": "120ms",
    "transitionDurationBase": "200ms",
    "shadowOffsetX": "4px",
    "shadowOffsetY": "4px",
    "shadowBlur": "0px",
    "shadowColor": "#000000",
    "disabledOpacity": 0.4
  }
}
