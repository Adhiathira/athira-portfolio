{
  "cssVars": {
    "--font-display": "'Rajdhani', sans-serif",
    "--font-body": "'Inter', sans-serif",
    "--font-mono": "'IBM Plex Mono', monospace"
  },
  "fontFaces": [
    {
      "role": "display",
      "family": "Rajdhani",
      "resolvedName": "Rajdhani",
      "weights": [400, 500, 600, 700],
      "source": "google-fonts",
      "cdnImport": "@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');"
    },
    {
      "role": "body",
      "family": "Inter",
      "resolvedName": "Inter",
      "weights": [300, 400, 500, 600],
      "source": "google-fonts"
    },
    {
      "role": "mono",
      "family": "IBM Plex Mono",
      "resolvedName": "IBM Plex Mono",
      "weights": [400, 500],
      "source": "google-fonts"
    }
  ],
  "scale": {
    "h1": {
      "fontFamily": "var(--font-display)",
      "fontSize": "9.072rem",
      "lineHeight": 0.9,
      "fontWeight": 700,
      "letterSpacing": "0em",
      "textTransform": "none"
    },
    "h2": {
      "fontFamily": "var(--font-display)",
      "fontSize": "5.184rem",
      "lineHeight": 1.05,
      "fontWeight": 700,
      "letterSpacing": "0em",
      "textTransform": "none"
    },
    "h3": {
      "fontFamily": "var(--font-display)",
      "fontSize": "3.052rem",
      "lineHeight": 1.1,
      "fontWeight": 600,
      "letterSpacing": "0.02em",
      "textTransform": "none"
    },
    "h4": {
      "fontFamily": "var(--font-display)",
      "fontSize": "1.953rem",
      "lineHeight": 1.2,
      "fontWeight": 600,
      "letterSpacing": "0.02em",
      "textTransform": "none"
    },
    "body": {
      "fontFamily": "var(--font-body)",
      "fontSize": "1rem",
      "lineHeight": 1.5,
      "fontWeight": 400,
      "letterSpacing": "0em"
    },
    "bodySmall": {
      "fontFamily": "var(--font-body)",
      "fontSize": "0.875rem",
      "lineHeight": 1.5,
      "fontWeight": 400,
      "letterSpacing": "0em"
    },
    "label": {
      "fontFamily": "var(--font-mono)",
      "fontSize": "0.6875rem",
      "lineHeight": 1.4,
      "fontWeight": 500,
      "letterSpacing": "0.1em",
      "textTransform": "uppercase"
    },
    "button": {
      "fontFamily": "var(--font-display)",
      "fontSize": "0.875rem",
      "lineHeight": 1,
      "fontWeight": 600,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "nav": {
      "fontFamily": "var(--font-display)",
      "fontSize": "1rem",
      "lineHeight": 1,
      "fontWeight": 600,
      "letterSpacing": "0.06em",
      "textTransform": "uppercase"
    },
    "code": {
      "fontFamily": "var(--font-mono)",
      "fontSize": "0.875rem",
      "lineHeight": 1.6,
      "fontWeight": 400,
      "letterSpacing": "0em"
    }
  }
}
