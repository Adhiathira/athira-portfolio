        "borderWidth": "1px",
        "outlineColor": "rgb(34, 33, 31)",
        "outlineWidth": "0px",
        "opacity": "0.75",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "0.3s",
        "borderStyle": "solid"
      }
    }
