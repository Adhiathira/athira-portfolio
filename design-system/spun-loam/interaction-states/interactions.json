  "cards": {
    "card-default": {
      "default": {
        "opacity": "1",
        "transition": "0.3s"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "0.3s ease-in-out"
      }
    }
  },
  "navigation": {
    "nav-link": {
      "default": {
        "opacity": "1",
        "transition": "0.3s"
      },
      "hover": {
        "opacity": "0.75",
        "transition": "0.3s ease-in-out"
      }
    }
  },
  "_twist": {
    "type": "hover-opacity",
    "intensity": 3,
    "opacityValue": 0.75,
