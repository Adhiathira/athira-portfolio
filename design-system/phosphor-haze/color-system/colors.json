  "visual": [
    { "hex": "#ffffff", "role": "page-background", "description": "Pure white — the CRT-lit void before the neon arrives." },
    { "hex": "#1b1b37", "role": "body-text", "description": "Deep indigo-black for all text on light backgrounds." },
    { "hex": "#63cabe", "role": "accent-cyan", "description": "Soft teal-cyan — the primary vaporwave neon accent." },
    { "hex": "#b79cff", "role": "accent-purple", "description": "Soft periwinkle-purple — secondary vaporwave glow accent." },
    { "hex": "#477cbe", "role": "link-action", "description": "Mid-blue for interactive links and CTAs." },
    { "hex": "#cccce1", "role": "border", "description": "Light lavender border for subtle separation." },
    { "hex": "#f0f0f4", "role": "surface", "description": "Near-white purple-tinted surface for card backgrounds." }
  ],
  "ctaButtons": [
    { "bg": "#63cabe", "textColor": "#ffffff", "border": "transparent", "role": "primary-cta" },
    { "bg": "transparent", "textColor": "#1b1b37", "border": "#1b1b37", "role": "ghost" },
    { "bg": "#b79cff", "textColor": "#ffffff", "border": "transparent", "role": "accent-purple-cta" },
    { "bg": "transparent", "textColor": "#477cbe", "border": "#477cbe", "role": "secondary" }
  ]
