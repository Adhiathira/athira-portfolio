{
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#63cabe",
        "color": "#ffffff",
        "borderColor": "#63cabe",
        "borderWidth": "2px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)",
        "boxShadow": "0 0 0px rgba(99, 202, 190, 0)"
      },
      "hover": {
        "backgroundColor": "#63cabe",
        "color": "#ffffff",
        "borderColor": "#63cabe",
        "boxShadow": "0 0 16px rgba(99, 202, 190, 0.7), inset 0 0 8px rgba(99, 202, 190, 0.2)",
        "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "active": {
        "backgroundColor": "#477cbe",
        "color": "#ffffff",
        "borderColor": "#477cbe",
        "boxShadow": "0 0 12px rgba(71, 124, 190, 0.6)",
        "transition": "all 0.15s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "focus": {
        "outlineWidth": "4px",
        "outlineOffset": "2px",
        "outlineColor": "#63cabe",
        "outlineStyle": "solid",
        "boxShadow": "0 0 16px rgba(99, 202, 190, 0.8)"
      }
    },
    "ghost": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#1b1b37",
        "borderColor": "#1b1b37",
        "borderWidth": "2px",
        "borderStyle": "solid",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "hover": {
        "backgroundColor": "transparent",
        "color": "#b79cff",
        "borderColor": "#b79cff",
        "boxShadow": "0 0 12px rgba(183, 156, 255, 0.6), inset 0 0 6px rgba(183, 156, 255, 0.1)",
        "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "active": {
        "backgroundColor": "#b79cff",
        "color": "#ffffff",
        "borderColor": "#b79cff",
        "boxShadow": "0 0 16px rgba(183, 156, 255, 0.8)",
        "transition": "all 0.15s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "focus": {
        "outlineWidth": "4px",
        "outlineOffset": "2px",
        "outlineColor": "#b79cff",
        "outlineStyle": "solid",
        "boxShadow": "0 0 16px rgba(183, 156, 255, 0.8)"
      }
    }
  },
  "inputs": {
    "default": {
      "borderColor": "#cccce1",
      "borderWidth": "2px",
      "backgroundColor": "#ffffff",
      "color": "#1b1b37"
    },
    "focus": {
      "outlineWidth": "4px",
      "outlineOffset": "2px",
      "outlineColor": "#63cabe",
      "outlineStyle": "solid",
      "boxShadow": "0 0 12px rgba(99, 202, 190, 0.5)"
    }
  },
  "links": {
    "default": {
      "color": "#1b1b37",
      "textDecoration": "none",
      "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "hover": {
      "color": "#63cabe",
      "boxShadow": "0 0 8px rgba(99, 202, 190, 0.5)",
      "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid #cccce1",
      "boxShadow": "0 0 0px transparent"
    },
    "hover": {
      "border": "1px solid #b79cff",
      "boxShadow": "0 0 16px rgba(183, 156, 255, 0.3)",
      "transition": "all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    }
  },
  "navigation": {
    "link": {
      "default": { "color": "#1b1b37", "opacity": "1" },
      "hover": {
        "color": "#63cabe",
        "boxShadow": "0 0 8px rgba(99, 202, 190, 0.5)",
        "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "active": { "color": "#b79cff", "fontWeight": "400" }
    }
  },
  "_twist": {
    "sourceSystem": "cipher-press",
    "type": "neon-glow-hover",
    "intensity": 4,
    "description": "Neon glow hover: 0.4s ease-in-out on all state changes. Hover adds box-shadow 0 0 12-16px neon glow in accent colors (cyan #63cabe, purple #b79cff). Focus rings: 4px solid with glow shadow. Phosphor afterimage effect: dual-layer shadow (outer glow + inset). Cards glow purple on hover. Slow, dreamy transitions coherent with motion base 0.8s."
  }
}
