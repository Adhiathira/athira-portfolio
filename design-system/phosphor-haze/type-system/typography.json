{
  "cssVars": {
    "ds-type-display-font-family": "'Exo 2', sans-serif",
    "ds-type-accent-font-family": "'Russo One', sans-serif",
    "ds-type-body-font-family": "'Space Mono', monospace",
    "ds-type-nav-font-family": "'Russo One', sans-serif",
    "ds-type-h1-font-size": "85px",
    "ds-type-h1-font-weight": "700",
    "ds-type-h1-line-height": "95px",
    "ds-type-h1-letter-spacing": "0.1em",
    "ds-type-h1-text-transform": "uppercase",
    "ds-type-h2-font-size": "56px",
    "ds-type-h2-font-weight": "700",
    "ds-type-h2-line-height": "64px",
    "ds-type-h2-letter-spacing": "0.1em",
    "ds-type-h2-text-transform": "uppercase",
    "ds-type-h3-font-size": "18px",
    "ds-type-h3-font-weight": "400",
    "ds-type-h3-line-height": "24px",
    "ds-type-h3-letter-spacing": "0.08em",
    "ds-type-h3-text-transform": "uppercase",
    "ds-type-body-font-size": "13px",
    "ds-type-body-font-weight": "400",
    "ds-type-body-line-height": "21px",
    "ds-type-button-font-family": "'Russo One', sans-serif",
    "ds-type-button-font-size": "12px",
    "ds-type-button-letter-spacing": "0.12em",
    "ds-type-button-text-transform": "uppercase",
    "ds-type-mono-font-family": "'Space Mono', monospace",
    "ds-type-mono-font-size": "13px"
  },
  "fontFaces": [
    {
      "resolvedName": "Exo 2",
      "category": "display",
      "weights": ["300", "400", "500", "600", "700", "800"],
      "source": "google-fonts",
      "cssImport": "@import url('https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;500;600;700;800&display=swap');"
    },
    {
      "resolvedName": "Russo One",
      "category": "accent",
      "weights": ["400"],
      "source": "google-fonts",
      "cssImport": "@import url('https://fonts.googleapis.com/css2?family=Russo+One&display=swap');"
    },
    {
      "resolvedName": "Space Mono",
      "category": "mono",
      "weights": ["400", "700"],
      "source": "google-fonts",
      "cssImport": "@import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');"
    }
  ],
  "_twist": {
    "sourceSystem": "copper-still",
    "intensity": 4,
    "description": "Vaporwave/Synthwave transformation: replaced serif fonts with retro-futuristic Exo 2 (display, 85px h1) + Russo One (accents, nav, buttons) + Space Mono (body, 13px). Uppercase everywhere. Increased letter-spacing to 0.1em for dramatic stretch. Three Google Fonts CDN imports. No woff2 references."
  }
}
