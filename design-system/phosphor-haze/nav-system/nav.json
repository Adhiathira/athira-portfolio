{
  "geometry": {
    "height": 64,
    "heightScrolled": 64,
    "paddingInline": 28,
    "paddingBlock": 0,
    "position": "fixed",
    "itemSpacing": 40,
    "logoPosition": "left",
    "alignment": "right"
  },
  "background": {
    "color": "rgba(255, 255, 255, 0.12)",
    "backdropFilter": "blur(12px)",
    "backdropFilterScrolled": "blur(16px)",
    "borderBottom": "1px solid rgba(99, 202, 190, 0.4)",
    "borderBottomScrolled": "1px solid rgba(99, 202, 190, 0.8)",
    "boxShadow": null,
    "boxShadowScrolled": "0 2px 20px rgba(183, 156, 255, 0.15)",
    "transition": "backdrop-filter 0.6s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "typography": {
    "fontFamily": "'Russo One', sans-serif",
    "fontSize": "0.75rem",
    "fontWeight": "400",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase",
    "lineHeight": "1.0"
  },
  "linkHover": {
    "opacity": 1,
    "backgroundPill": false,
    "transition": "color 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1)",
    "color": "#63cabe",
    "boxShadow": "0 0 8px rgba(99, 202, 190, 0.5)",
    "underline": { "type": "none" }
  },
  "linkActive": {
    "selector": ".nav-link.active",
    "fontWeight": "400",
    "indicator": "none",
    "color": "#b79cff"
  },
  "scrollTransition": {
    "mechanism": "class",
    "triggerClass": "scrolled",
    "propertiesChanged": ["backdropFilter", "borderBottomColor", "boxShadow"],
    "duration": "0.6s",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "colorInversion": false
  },
  "dropdown": {
    "present": false,
    "trigger": null,
    "borderRadius": null,
    "boxShadow": null,
    "padding": null,
    "itemPadding": null,
    "animation": null
  },
  "characterDescription": "Glass Vaporwave Nav: 64px height, glassmorphism (blur(12px) backdrop-filter, rgba white 12% fill, thin cyan border-bottom). Russo One all-caps at 0.75rem — retro-futuristic HUD typography. Fixed position, floats above page like a spaceship HUD. Scrolled state intensifies blur to 16px and adds purple glow shadow. Hover links glow cyan. Active links pulse purple. Transition: slow and dreamy, matching the vaporwave motion system.",
  "_twist": {
    "sourceSystem": "pale-current",
    "type": "vaporwave-glass-hud",
    "intensity": 4,
    "description": "Glass morphism nav: backdropFilter blur(12px), rgba(255,255,255,0.12) fill, 1px rgba-cyan border-bottom. Russo One font (Check C PASS — assembled type system has Russo One). 64px height. Slow 0.6s transitions. Scrolled state enhances blur and adds purple glow. Full vaporwave HUD aesthetic."
  }
}
