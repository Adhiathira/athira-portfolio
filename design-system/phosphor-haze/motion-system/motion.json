{
  "cssVars": {
    "ds-motion-duration-fast": "0.4s",
    "ds-motion-duration-base": "0.8s",
    "ds-motion-duration-slow": "1.2s",
    "ds-motion-duration-enter": "1.5s",
    "ds-motion-easing-default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ds-motion-easing-smooth": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "ds-motion-easing-in": "ease-in",
    "ds-motion-easing-out": "ease-out",
    "ds-motion-stagger-delay": "0.15s"
  },
  "transitions": {
    "link": { "duration": "0.4s", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "properties": ["color", "box-shadow"] },
    "button": { "duration": "0.4s", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "properties": ["background-color", "box-shadow", "transform"] },
    "card": { "duration": "0.5s", "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)", "properties": ["box-shadow", "transform"] },
    "nav": { "duration": "0.6s", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "properties": ["background-color", "backdrop-filter"] }
  },
  "keyframes": {
    "vaporwaveFadeIn": "opacity: 0 → 1, duration 0.8s ease-in-out",
    "vaporwaveSlideUp": "opacity: 0→1 + translateY(30px→0), duration 1.0s ease-out",
    "vaporwaveEtherealEntrance": "opacity: 0→1 + scale(0.9→1) + translateY(20px→0), duration 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "vaporwaveNeonGlow": "opacity: 0.6→1→0.6 + text-shadow pulse, duration 2s ease-in-out infinite",
    "vaporwaveScanlineSweep": "background-position sweep top→bottom, duration 1.5s linear infinite",
    "vaporwaveScaleDissolve": "opacity: 0→1 + scale: 0.5→1, duration 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  },
  "_twist": {
    "sourceSystem": "flux-finance",
    "intensity": 4,
    "description": "Vaporwave slow-dreamy timing: base 0.8s, enter 1.5s. Cubic-bezier easing for smooth dissolves. Keyframes: neon-glow pulse (infinite), scanline sweep, ethereal entrance (scale+fade+rise). No linear/instant easing. Everything flows like worn VHS tape."
  }
}
