{
  "cssVars": {
    "ds-font-family-primary": "'Share Tech Mono', monospace",
    "ds-font-family-secondary": "'Space Mono', monospace",
    "ds-font-family-body": "'Space Mono', monospace",
    "ds-font-family-mono": "'Share Tech Mono', monospace",
    "ds-font-size-3xl": "clamp(2.5rem, 5vw, 4rem)",
    "ds-font-size-2xl": "clamp(1.75rem, 3vw, 2.5rem)",
    "ds-font-size-xl": "clamp(1.25rem, 2vw, 1.75rem)",
    "ds-font-size-lg": "1.25rem",
    "ds-font-size-md": "1rem",
    "ds-font-size-base": "0.8125rem",
    "ds-font-size-sm": "0.75rem",
    "ds-font-size-xs": "0.6875rem",
    "ds-font-weight-regular": "400",
    "ds-line-height-tight": "1.1",
    "ds-line-height-snug": "1.3",
    "ds-line-height-normal": "1.6",
    "ds-line-height-relaxed": "1.8",
    "ds-letter-spacing-tight": "0em",
    "ds-letter-spacing-normal": "0.05em",
    "ds-letter-spacing-wide": "0.1em",
    "ds-letter-spacing-wider": "0.15em",
    "ds-letter-spacing-widest": "0.2em"
  },
  "fontFaces": [
    {
      "role": "primary",
      "resolvedName": "Share Tech Mono",
      "weights": ["400"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
    },
    {
      "role": "secondary",
      "resolvedName": "Space Mono",
      "weights": ["400", "700"],
      "source": "google-fonts",
      "cdnUrl": "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
    }
  ],
  "scale": {
    "h1": {
      "fontFamily": "var(--ds-font-family-primary)",
      "fontSize": "clamp(2.5rem, 5vw, 4rem)",
      "fontWeight": "400",
      "lineHeight": "1.1",
      "letterSpacing": "0.05em",
      "color": "#00ff41",
      "textTransform": "uppercase"
    },
    "h2": {
      "fontFamily": "var(--ds-font-family-primary)",
      "fontSize": "clamp(1.75rem, 3vw, 2.5rem)",
      "fontWeight": "400",
      "lineHeight": "1.2",
      "letterSpacing": "0.1em",
      "color": "#00ff41",
      "textTransform": "uppercase"
    },
    "h3": {
      "fontFamily": "var(--ds-font-family-primary)",
      "fontSize": "1.25rem",
      "fontWeight": "400",
      "lineHeight": "1.3",
      "letterSpacing": "0.1em",
      "color": "#00ff41",
      "textTransform": "uppercase"
    },
    "h4": {
      "fontFamily": "var(--ds-font-family-secondary)",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.3",
      "letterSpacing": "0.1em",
      "color": "#00ff41",
      "textTransform": "uppercase"
    },
    "body": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "0.8125rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0em",
      "color": "#008f11"
    },
    "small": {
      "fontFamily": "var(--ds-font-family-body)",
      "fontSize": "0.75rem",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0em",
      "color": "#008f11"
    },
    "label": {
      "fontFamily": "var(--ds-font-family-primary)",
      "fontSize": "0.6875rem",
      "fontWeight": "400",
      "lineHeight": "1.2",
      "letterSpacing": "0.15em",
      "textTransform": "uppercase",
      "color": "#008f11"
    },
    "mono": {
      "fontFamily": "var(--ds-font-family-mono)",
      "fontSize": "0.8125rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0.05em",
      "color": "#00ff41"
    }
  },
  "_twist": {
    "sourceSystem": "null-signal",
    "intensity": 5,
    "twistDescription": "Full matrix terminal typography — all monospace, no proportional type. Share Tech Mono 400 as primary: retro terminal phosphor feel, used for h1/h2/h3 and labels. Space Mono 400 for body and h4: hacker readability at small sizes. h1 clamp(2.5rem, 5vw, 4rem) at weight 400 (monospace has no bold variant in terminal aesthetic). All headings #00ff41 matrix green. Body #008f11 dark green — secondary phosphor. Labels: 0.15em tracking uppercase Share Tech Mono. Zero weight variation except 400 — monospace terminals run one weight."
  }
}
