{
  "buttons": {
    "primary": {
      "selector": ".btn-primary",
      "default": {
        "backgroundColor": "#00ff41",
        "color": "#000000",
        "borderColor": "#00ff41",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "0",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontFamily": "'Share Tech Mono', monospace",
        "fontWeight": "400",
        "fontSize": "0.6875rem",
        "letterSpacing": "0.15em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.05s step-start"
      },
      "hover": {
        "backgroundColor": "#000000",
        "color": "#00ff41",
        "borderColor": "#00ff41",
        "textShadow": "0 0 8px rgba(0, 255, 65, 0.5)",
        "transition": "all 0.05s step-start"
      },
      "active": {
        "backgroundColor": "#00ff41",
        "color": "#000000",
        "transition": "all 0.05s step-start"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "2px",
        "outlineColor": "#00ff41",
        "outlineStyle": "dashed",
        "transition": "all 0.05s step-start"
      }
    },
    "ghost": {
      "selector": ".btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#00ff41",
        "borderColor": "#00ff41",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "borderRadius": "0",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontFamily": "'Share Tech Mono', monospace",
        "fontWeight": "400",
        "fontSize": "0.6875rem",
        "letterSpacing": "0.15em",
        "textTransform": "uppercase",
        "cursor": "pointer",
        "transition": "all 0.05s step-start"
      },
      "hover": {
        "backgroundColor": "rgba(0, 255, 65, 0.08)",
        "color": "#00ff41",
        "borderColor": "#00ff41",
        "textShadow": "0 0 8px rgba(0, 255, 65, 0.5)",
        "transition": "all 0.05s step-start"
      },
      "active": {
        "backgroundColor": "#00ff41",
        "color": "#000000",
        "transition": "all 0.05s step-start"
      },
      "focus": {
        "outlineWidth": "1px",
        "outlineOffset": "2px",
        "outlineColor": "#00ff41",
        "outlineStyle": "dashed",
        "transition": "all 0.05s step-start"
      }
    }
  },
  "inputs": {
    "default": {
      "backgroundColor": "#0d1a0d",
      "color": "#00ff41",
      "borderColor": "rgba(0, 255, 65, 0.4)",
      "borderWidth": "1px",
      "borderRadius": "0",
      "fontFamily": "'Space Mono', monospace",
      "fontSize": "0.8125rem",
      "transition": "all 0.05s step-start"
    },
    "focus": {
      "outlineWidth": "1px",
      "outlineOffset": "2px",
      "outlineColor": "#00ff41",
      "outlineStyle": "dashed",
      "borderColor": "#00ff41",
      "textShadow": "0 0 4px rgba(0, 255, 65, 0.3)",
      "transition": "all 0.05s step-start"
    }
  },
  "links": {
    "default": {
      "color": "#008f11",
      "textDecoration": "none",
      "transition": "all 0.05s step-start"
    },
    "hover": {
      "color": "#00ff41",
      "textShadow": "0 0 8px rgba(0, 255, 65, 0.5)",
      "transition": "all 0.05s step-start"
    }
  },
  "cards": {
    "default": {
      "border": "1px solid rgba(0, 255, 65, 0.4)",
      "boxShadow": "none",
      "borderRadius": "0",
      "transition": "all 0.05s step-start"
    },
    "hover": {
      "border": "1px solid #00ff41",
      "boxShadow": "none",
      "transition": "all 0.05s step-start"
    }
  },
  "navigation": {
    "link": {
      "default": {
        "color": "#008f11",
        "opacity": "1",
        "transition": "all 0.05s step-start"
      },
      "hover": {
        "color": "#00ff41",
        "textShadow": "0 0 8px rgba(0, 255, 65, 0.5)",
        "transition": "all 0.05s step-start"
      },
      "active": {
        "color": "#00ff41",
        "textShadow": "0 0 8px rgba(0, 255, 65, 0.5)"
      }
    }
  },
  "_twist": {
    "sourceSystem": "null-signal",
    "intensity": 5,
    "twistDescription": "Matrix green interaction system. All transitions 0.05s step-start — binary switching, no smooth animation. Primary buttons: matrix green bg / black text. Hover: reverse video — black bg / green text + glow. Active: snap back to green. Ghost: transparent with green border, hover adds trace bg. Focus: 1px dashed green outline (terminal keyboard nav indicator). Cards: 1px solid border at 0.4 opacity, hover to full 1.0 — NO box-shadow (terminals don't shadow). Inputs: dark surface, green border, dashed focus outline. Links: dark green default → full bright on hover with glow. All border-radius 0."
  }
}
