{
  "_source": "halcyon-gauge",
  "_agent": "interaction-states",
  "_twist": "Twist A — hover transition speed (more languid), intensity 3. All hover/state transition durations increased by +0.15s (0.2s -> 0.35s, 0.3s -> 0.45s), clamped within 0.05s-0.8s. No color, border, or structural changes. The slower settle reinforces the analog-gauge feel: the needle eases into its reading rather than snapping.",
  "buttons": {
    "primary-button": {
      "selector": "button.btn-primary, a.btn-primary",
      "default": {
        "backgroundColor": "#2563eb",
        "color": "#f6f7f8",
        "borderColor": "#2563eb",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineColor": "#2563eb",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease"
      },
      "hover": {
        "backgroundColor": "#f6f7f8",
        "color": "#2563eb",
        "borderColor": "#2563eb",
        "borderWidth": "1px",
        "opacity": "1",
        "fontWeight": "600",
        "_note": "Inversion-swap inherited from source — cream bg + amber text on hover"
      },
      "focus": {
        "outlineColor": "#2563eb",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      },
      "active": {
        "backgroundColor": "#1d4ed8",
        "color": "#f6f7f8"
      }
    },
    "ghost-button": {
      "selector": "button.btn-ghost, a.btn-ghost",
      "default": {
        "backgroundColor": "transparent",
        "color": "#1a1c20",
        "borderColor": "#1a1c20",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "background-color 0.35s ease, color 0.35s ease"
      },
      "hover": {
        "backgroundColor": "#1a1c20",
        "color": "#f6f7f8",
        "borderColor": "#1a1c20"
      },
      "focus": {
        "outlineColor": "#1a1c20",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "2px"
      }
    },
    "utility-button": {
      "selector": "button.btn-utility",
      "default": {
        "backgroundColor": "#ffffff",
        "color": "#1a1c20",
        "borderColor": "#d3d9e0",
        "borderWidth": "1px",
        "opacity": "1",
        "fontWeight": "500",
        "cursor": "pointer",
        "transition": "background-color 0.35s ease"
      },
      "hover": {
        "backgroundColor": "#e2e6eb",
        "color": "#1a1c20"
      }
    }
  },
  "inputs": {
    "text-input": {
      "selector": "input[type='text'], input[type='email']",
      "default": {
        "color": "#1a1c20",
        "backgroundColor": "#f6f7f8",
        "borderColor": "#d3d9e0",
        "borderWidth": "1px",
        "borderStyle": "solid",
        "outlineColor": "transparent",
        "outlineWidth": "0px",
        "opacity": "1",
        "fontWeight": "400",
        "cursor": "text",
        "transition": "border-color 0.35s ease, box-shadow 0.35s ease"
      },
      "focus": {
        "color": "#1a1c20",
        "borderColor": "#2563eb",
        "outlineColor": "#2563eb",
        "outlineWidth": "2px",
        "outlineStyle": "solid",
        "outlineOffset": "0px",
        "boxShadow": "0 0 0 3px rgba(184, 92, 42, 0.15)"
      }
    }
  },
  "links": {
    "inline-link": {
      "selector": "a.inline-link",
      "default": {
        "color": "#2563eb",
        "borderColor": "transparent",
        "textDecoration": "underline",
        "textDecorationColor": "rgba(184, 92, 42, 0.4)",
        "opacity": "1",
        "fontWeight": "600",
        "cursor": "pointer",
        "transition": "color 0.35s ease, text-decoration-color 0.35s ease"
      },
      "hover": {
        "color": "#1d4ed8",
        "textDecorationColor": "#1d4ed8"
      }
    },
    "nav-link": {
      "selector": ".nav-link",
      "default": {
        "color": "#1a1c20",
        "opacity": "0.8",
        "fontWeight": "400",
        "cursor": "pointer",
        "transition": "opacity 0.35s ease"
      },
      "hover": {
        "opacity": "1",
        "color": "#1a1c20"
      }
    }
  },
  "cards": {
    "instrument-card": {
      "selector": ".instrument-card",
      "default": {
        "backgroundColor": "#ffffff",
        "borderColor": "#d3d9e0",
        "borderWidth": "1px",
        "transition": "transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "transform": "translateY(-3px)",
        "boxShadow": "0 8px 32px rgba(26, 24, 20, 0.1)"
      }
    }
  },
  "navigation": {}
}
