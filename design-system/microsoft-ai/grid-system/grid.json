{
  "cssVars": {
    "root-icon-xs-max-width": "12px",
    "root-icon-s-max-width": "16px",
    "root-icon-m-max-width": "20px",
    "root-icon-l-max-width": "24px",
    "root-icon-xl-max-width": "32px",
    "root-icon-2xl-max-width": "40px",
    "root-icon-3xl-max-width": "48px",
    "root-icon-4xl-max-width": "64px"
  },
  "container": {
    "maxWidth": "1280px",
    "paddingLeft": "56px",
    "paddingRight": "56px"
  },
  "grids": {
    "ai-resources-for-business-lead": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "32px normal",
      "flexWrap": "wrap",
      "childCount": "2"
    },
    "transform-with-microsoft-aiwh": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "flexWrap": "wrap",
      "childCount": "2"
    },
    "ask-microsoft": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "flexWrap": "wrap",
      "childCount": "2"
    },
    "boost-productivity-to-achieve": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "8px 16px",
      "flexWrap": "wrap",
      "childCount": "4"
    },
    "secure-and-govern-ai": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "16px",
      "childCount": "3"
    },
    "list-item__inner": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "normal 8px",
      "alignItems": "center",
      "childCount": "2",
      "parentSection": "In Page quick links"
    }
  },
  "responsive": {
    "bp-539px": {
      "query": "screen and (max-device-width: 539px)",
      "display": "none"
    },
    "bp-540px": {
      "query": "(min-width: 540px)",
      "maxWidth": "100%",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "display": "flex",
      "columnGap": "1.25rem",
      "gridTemplateColumns": "0px repeat(4, 1fr)",
      "gridTemplateRows": "repeat(13, min-content)",
      "rowGap": "0px"
    },
    "bp-640px": {
      "query": "(max-width: 640px)",
      "maxWidth": "none"
    },
    "bp-767px": {
      "query": "only screen and (max-width: 767px)",
      "display": "flex"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "rowGap": "5px",
      "columnGap": "5px",
      "flexDirection": "column",
      "maxWidth": "350px",
      "display": "block"
    },
    "bp-859px": {
      "query": "screen and (max-width: 859px)",
      "display": "flex",
      "maxWidth": "none"
    },
    "bp-860px": {
      "query": "(min-width: 860px)",
      "maxWidth": "100%",
      "display": "none",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "gridTemplateColumns": "repeat(2,calc((100% * var(--plan-detail-card-width)/ 24) - 8px))",
      "gridTemplateRows": "repeat(13, min-content)",
      "columnGap": "1rem",
      "rowGap": "0px"
    },
    "bp-1083px": {
      "query": "screen and (max-width: 1083px)",
      "display": "flex",
      "flexWrap": "wrap",
      "flexDirection": "column"
    }
  },
  "visual": [
    {
      "section": "hero",
      "layout": "2-column-asymmetric",
      "description": "Left column contains heading, body text, and two CTA buttons; right column has video thumbnail with play button overlay"
    },
    {
      "section": "products-intro",
      "layout": "centered-header-2col-grid",
      "description": "Centered section header above 2-column grid of equal-width product feature cards with images"
    },
    {
      "section": "products-detailed",
      "layout": "2x2-grid",
      "description": "Four equal-width product cards in 2x2 grid layout, each with image, label, heading, and CTA"
    },
    {
      "section": "insights",
      "layout": "2-column-split",
      "description": "Left column has numbered list content, right column displays collection of document/guide thumbnails"
    },
    {
      "section": "trust",
      "layout": "centered-fullwidth",
      "description": "Centered heading and subheading, followed by full-width hero image, then 3-column card grid below"
    },
    {
      "section": "industries",
      "layout": "centered-carousel",
      "description": "Centered heading and body text above horizontal scrollable carousel with equal-width industry cards"
    },
    {
      "section": "news",
      "layout": "centered-carousel",
      "description": "Centered section header above horizontal scrollable carousel of equal-width blog post cards"
    },
    {
      "section": "customers",
      "layout": "asymmetric-2column",
      "description": "Narrow left column with heading and customer story card, wide right column with large presentation photo"
    },
    {
      "section": "faq",
      "layout": "fullwidth-accordion",
      "description": "Heading left-aligned, expand/collapse controls right-aligned, followed by full-width accordion list items"
    }
  ]
}