{
  "geometry": {
    "height": 54,
    "paddingInline": 24,
    "position": "static",
    "itemSpacing": 32,
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": "1px solid",
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "0.3s ease-in"
  },
  "typography": {
    "fontFamily": "MWF-FLUENT-ICONS, MWF-MDL2",
    "fontSize": "13px",
    "fontWeight": "600",
    "letterSpacing": "normal",
    "textTransform": "none",
    "lineHeight": "1.5"
  },
  "linkHover": {
    "backgroundPill": false,
    "transition": null,
    "underline": {
      "type": "pseudo-element",
      "thickness": "0.125rem",
      "offset": "0.25rem",
      "animation": {
        "property": "opacity",
        "from": "none",
        "to": "block",
        "origin": "left",
        "duration": null,
        "easing": null
      }
    }
  },
  "linkActive": {
    "selector": ".nav-link.active, .nav-item.active",
    "fontWeight": "600",
    "indicator": "none"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "stuck",
    "propertiesChanged": [
      "margin-top",
      "margin-bottom",
      "display"
    ],
    "duration": "0.3s",
    "easing": "ease-in",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "click",
    "borderRadius": "1rem",
    "boxShadow": "0 0 0.125rem rgba(0,0,0,0.12), 0 0.063rem 0.125rem rgba(0,0,0,0.14)",
    "padding": "0.5rem",
    "itemPadding": "0.75rem 0.5rem",
    "animation": "display toggle via CSS variable --secondary-nav-dropdown-menu-list-display"
  },
  "characterDescription": "A dense, utility-first enterprise navigation system — Microsoft UHF-style — built for information density and cross-product wayfinding at scale. Its restrained hover affordances (pseudo-element underline reveals) and multi-tier dropdown architecture signal authority and comprehensive scope rather than expressive brand identity."
}