{
  "cssVars": {
    "ds-motion-duration-instant": "100ms",
    "ds-motion-duration-fast": "150ms",
    "ds-motion-duration-base": "200ms",
    "ds-motion-duration-slow": "200ms",
    "ds-motion-duration-enter": "200ms",
    "ds-motion-easing-default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ds-motion-easing-in": "cubic-bezier(0.4, 0, 1, 1)",
    "ds-motion-easing-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ds-motion-easing-inout": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ds-motion-stagger-delay": "40ms"
  },
  "transitions": {
    "link": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["color", "background-color", "opacity"]
    },
    "button": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["background-color", "color", "border-color", "box-shadow"]
    },
    "card": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["border-color", "box-shadow", "transform"]
    },
    "nav": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["background-color", "border-color", "opacity"]
    },
    "input": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["border-color", "box-shadow"]
    }
  },
  "scrollReveal": {
    "type": "opacity-y-translate",
    "y": "8px",
    "opacity": "0 to 1",
    "duration": "200ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "stagger": "40ms",
    "once": true,
    "_note": "Simple opacity + y:8px — NOT dramatic slides. Dashboard content renders immediately."
  },
  "dataCounters": {
    "trigger": "viewport-enter",
    "duration": "1200ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "startValue": 0,
    "_note": "Count-up animation for stat metrics when scrolled into view"
  },
  "chartDraw": {
    "trigger": "viewport-enter",
    "duration": "800ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "once": true
  },
  "pageLoad": {
    "entrance": "none",
    "_note": "No entrance animation on page load — dashboard content renders immediately"
  },
  "keyframes": {},
  "_twist": {
    "sourceSystem": "dense-column",
    "agentIndex": 3,
    "intensity": 4,
    "twistDescription": "Minimal functional motion. All durations 100-200ms max. Easing: cubic-bezier(0.4, 0, 0.2, 1) — Material Design standard, crisp not bouncy. No spring physics. Scroll reveals: opacity + y:8px. Data counters: count-up on viewport entry. Page load: no entrance animation."
  }
}
