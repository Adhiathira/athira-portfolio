{
  "cssVars": {},
  "container": {
    "maxWidth": "1440px",
    "paddingLeft": "24px",
    "paddingRight": "24px"
  },
  "grids": {
    "main-12col": {
      "display": "grid",
      "templateColumns": "repeat(12, 1fr)",
      "columnCount": "12",
      "gap": "16px",
      "description": "Standard 12-column grid for main layout sections"
    },
    "dashboard-card-grid": {
      "display": "grid",
      "templateColumns": "repeat(auto-fill, minmax(200px, 1fr))",
      "gap": "24px",
      "description": "Auto-fill stats row — fills available width with min 200px cards"
    },
    "sidebar-layout": {
      "display": "grid",
      "templateColumns": "240px 1fr",
      "gap": "24px",
      "description": "Fixed 240px sidebar + flexible content area"
    },
    "feature-grid-3col": {
      "display": "grid",
      "templateColumns": "repeat(3, 1fr)",
      "gap": "24px",
      "description": "3-column feature card grid"
    },
    "feature-split": {
      "display": "grid",
      "templateColumns": "3fr 2fr",
      "gap": "48px",
      "description": "Feature split — 3fr content, 2fr graphic/mockup"
    },
    "stats-row": {
      "display": "grid",
      "templateColumns": "repeat(auto-fill, minmax(200px, 1fr))",
      "gap": "24px",
      "description": "Dashboard stats row — 4 metrics minimum"
    },
    "two-col-equal": {
      "display": "grid",
      "templateColumns": "1fr 1fr",
      "gap": "24px",
      "description": "Two equal columns"
    },
    "two-col-asymmetric": {
      "display": "grid",
      "templateColumns": "3fr 2fr",
      "gap": "48px",
      "description": "Asymmetric split"
    }
  },
  "responsive": {
    "breakpoints": {
      "mobile": "375px",
      "tablet": "768px",
      "desktop-sm": "1024px",
      "desktop": "1440px"
    },
    "rules": [
      "At 768px: sidebar-layout collapses to single column",
      "At 768px: feature-grid-3col becomes 2-col",
      "At 375px: all grids become single column",
      "Stats row: auto-fill collapses naturally to 2-col then 1-col"
    ]
  },
  "visual": [
    {
      "section": "hero",
      "layout": "split-left-text-right-mockup",
      "description": "Left ~55% headline + CTAs, right ~45% CSS-only dashboard mockup panel"
    },
    {
      "section": "stats-bar",
      "layout": "4-column-equal-auto-fill",
      "description": "4 equal stat cards, auto-fill grid"
    },
    {
      "section": "features",
      "layout": "3-column-equal",
      "description": "3 equal feature cards with icon + title + body"
    },
    {
      "section": "how-it-works",
      "layout": "numbered-steps-3col",
      "description": "3 numbered step cards"
    },
    {
      "section": "testimonials",
      "layout": "3-column-equal",
      "description": "3 testimonial cards"
    }
  ],
  "_twist": {
    "sourceSystem": "stripe",
    "agentIndex": 4,
    "intensity": 3,
    "twistDescription": "Dense data grid with card containers. Container 1440px, 24px padding. Main grid 12-col 16px gutters. Dashboard card grid 24px gap. Sidebar 240px fixed + 1fr. Stats row auto-fill minmax(200px, 1fr). Feature split 3fr 2fr."
  }
}
