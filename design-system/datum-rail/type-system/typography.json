{
  "cssVars": {},
  "googleFonts": [
    "Inter:wght@400;500;600;700",
    "JetBrains+Mono:wght@400;500;700"
  ],
  "fontFaces": [],
  "typeScale": {
    "h1": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "clamp(2.5rem, 4vw, 3.25rem)",
      "fontWeight": "700",
      "lineHeight": "1.15",
      "letterSpacing": "-0.03em",
      "primaryFont": "Inter",
      "webAccessible": true,
      "_note": "Dashboard-scale heading — functional, not display-editorial"
    },
    "h2": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "clamp(1.5rem, 2.5vw, 2rem)",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "-0.02em",
      "primaryFont": "Inter",
      "webAccessible": true
    },
    "h3": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "clamp(1.125rem, 1.5vw, 1.375rem)",
      "fontWeight": "600",
      "lineHeight": "1.3",
      "letterSpacing": "-0.01em",
      "primaryFont": "Inter",
      "webAccessible": true
    },
    "h4": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "1rem",
      "fontWeight": "600",
      "lineHeight": "1.4",
      "letterSpacing": "0",
      "primaryFont": "Inter",
      "webAccessible": true
    },
    "body": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "0.9375rem",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0",
      "primaryFont": "Inter",
      "webAccessible": true,
      "_note": "Compact body for data density"
    },
    "body-sm": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0",
      "primaryFont": "Inter",
      "webAccessible": true
    },
    "data-label": {
      "fontFamily": "'JetBrains Mono', 'IBM Plex Mono', 'Courier New', monospace",
      "fontSize": "0.75rem",
      "fontWeight": "500",
      "lineHeight": "1.4",
      "letterSpacing": "0.06em",
      "textTransform": "uppercase",
      "primaryFont": "JetBrains Mono",
      "webAccessible": true,
      "_note": "Monospace data labels and category tags"
    },
    "stat-metric": {
      "fontFamily": "'JetBrains Mono', 'IBM Plex Mono', 'Courier New', monospace",
      "fontSize": "clamp(2.5rem, 4vw, 3.5rem)",
      "fontWeight": "700",
      "lineHeight": "1",
      "letterSpacing": "-0.02em",
      "primaryFont": "JetBrains Mono",
      "webAccessible": true,
      "_note": "Large numeric metric display in dashboard stat blocks"
    },
    "code": {
      "fontFamily": "'JetBrains Mono', 'IBM Plex Mono', monospace",
      "fontSize": "0.8125rem",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0",
      "primaryFont": "JetBrains Mono",
      "webAccessible": true
    },
    "nav": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "500",
      "lineHeight": "1",
      "letterSpacing": "0",
      "primaryFont": "Inter",
      "webAccessible": true,
      "_note": "Functional nav — no uppercase, compact"
    },
    "caption": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "0.75rem",
      "fontWeight": "400",
      "lineHeight": "1.4",
      "letterSpacing": "0",
      "primaryFont": "Inter",
      "webAccessible": true
    }
  },
  "_twist": {
    "sourceSystem": "linear",
    "agentIndex": 2,
    "intensity": 3,
    "twistDescription": "Dashboard data font pairing. Inter as primary neutral grotesque (Google Fonts). JetBrains Mono for data labels, stats, numbers. h1 functional scale (2.5–3.25rem, w700). Body compact (0.9375rem, lh1.5). Data labels mono uppercase 0.75rem 0.06em tracking. Stat metric mono 2.5–3.5rem w700."
  }
}
