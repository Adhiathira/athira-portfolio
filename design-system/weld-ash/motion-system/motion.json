{
  "cssAnimations": {
    "keyframes": [
      {
        "name": "mobile-parallax-hero",
        "steps": [
          { "offset": "0%", "properties": { "background-position-y": "0px" } },
          { "offset": "100%", "properties": { "background-position-y": "-150px" } }
        ]
      },
      {
        "name": "mobile-parallax-faq",
        "steps": [
          { "offset": "0%", "properties": { "background-position-y": "0px" } },
          { "offset": "100%", "properties": { "background-position-y": "-150px" } }
        ]
      },
      {
        "name": "chatMessageFadeIn",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(12px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "fadeIn",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(-8px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "fade-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "translateY(10px)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "translateY(0px)" } }
        ]
      },
      {
        "name": "scale-in",
        "steps": [
          { "offset": "0%", "properties": { "transform": "scale(0.95)", "opacity": "0" } },
          { "offset": "100%", "properties": { "transform": "scale(1)", "opacity": "1" } }
        ]
      },
      {
        "name": "shake",
        "steps": [
          { "offset": "0%, 100%", "properties": { "transform": "translate(0px)" } },
          { "offset": "25%", "properties": { "transform": "translate(-5px)" } },
          { "offset": "75%", "properties": { "transform": "translate(5px)" } }
        ]
      },
      {
        "name": "shimmer",
        "steps": [
          { "offset": "100%", "properties": { "transform": "translate(100%)" } }
        ]
      },
      {
        "name": "pulse",
        "steps": [
          { "offset": "50%", "properties": { "opacity": "0.5" } }
        ]
      },
      {
        "name": "spin",
        "steps": [
          { "offset": "100%", "properties": { "transform": "rotate(360deg)" } }
        ]
      },
      {
        "name": "sonner-fade-in",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "0", "transform": "scale(0.8)" } },
          { "offset": "100%", "properties": { "opacity": "1", "transform": "scale(1)" } }
        ]
      },
      {
        "name": "sonner-fade-out",
        "steps": [
          { "offset": "0%", "properties": { "opacity": "1", "transform": "scale(1)" } },
          { "offset": "100%", "properties": { "opacity": "0", "transform": "scale(0.8)" } }
        ]
      }
    ],
    "transitionElements": [
      {
        "selector": ".weld-ash-banner-close",
        "transition": { "property": "all", "duration": "0.26s", "timingFunction": "ease" }
      },
      {
        "selector": ".weld-ash-button-ghost",
        "transition": { "property": "all", "duration": "0.39s", "timingFunction": "ease" }
      },
      {
        "selector": ".weld-ash-button-primary",
        "transition": { "property": "all", "duration": "0.26s", "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)" }
      },
      {
        "selector": ".weld-ash-button-primary-outline",
        "transition": { "property": "all", "duration": "0.26s", "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)" }
      },
      {
        "selector": ".weld-ash-card",
        "transition": { "property": "all", "duration": "0.39s", "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)" }
      },
      {
        "selector": ".weld-ash-pricing-card",
        "transition": { "property": "transform, box-shadow", "duration": "0.39s, 0.39s", "timingFunction": "ease, ease" }
      },
      {
        "selector": ".weld-ash-pricing-card-button",
        "transition": { "property": "all", "duration": "0.39s", "timingFunction": "ease" }
      },
      {
        "selector": ".weld-ash-faq-item",
        "transition": { "property": "all", "duration": "0.39s", "timingFunction": "ease" }
      },
      {
        "selector": ".weld-ash-faq-question",
        "transition": { "property": "color", "duration": "0.39s", "timingFunction": "ease" }
      }
    ],
    "timingTokens": {
      "durations": ["0.26s", "0.39s", "0.39s, 0.39s"],
      "easings": ["ease", "cubic-bezier(0.4, 0, 0.2, 1)", "ease, ease"]
    }
  },
  "scrollAnimations": {
    "patterns": [
      {
        "type": "scroll-driven-tab-switching",
        "description": "As user scrolls within the product section, active tab switches between content panels. No explicit timing values.",
        "trigger": "scroll position within section",
        "targets": ["tab-bar active state", "numbered list active item", "content panel"]
      }
    ],
    "parallaxPatterns": [
      {
        "type": "mobile-parallax-background",
        "description": "CSS-driven background-position-y parallax on hero and FAQ sections for mobile viewports.",
        "keyframes": ["mobile-parallax-hero", "mobile-parallax-faq"]
      }
    ],
    "videoScrollPatterns": [
      {
        "type": "inline-scroll-video",
        "description": "An autoplay looping muted video panel embedded mid-page. Subjects: industrial texture, surface material studies, machined forms.",
        "attributes": {
          "autoplay": true,
          "loop": true,
          "muted": true,
          "controls": false,
          "playsinline": true
        }
      }
    ],
    "animatedGifs": 0
  },
  "microInteractions": {
    "buttonTransitions": [
      { "selector": "button", "transitionDuration": "0.26s" },
      { "selector": "button", "transitionDuration": "0.39s" },
      { "selector": "button", "transitionDuration": "0.26s", "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)" },
      { "selector": "button", "transitionDuration": "0.39s", "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)" }
    ],
    "customCursor": false,
    "loadingStates": [],
    "iconAnimations": [],
    "inputFocusAnimations": [],
    "hasSkeletonScreens": false
  },
  "performance": {
    "totalAnimatedElements": 20,
    "simultaneousAnimations": 0,
    "videoLoad": "light",
    "complexAnimations": 8,
    "reducedMotionSupport": null,
    "usesHardwareAcceleration": false,
    "recommendations": [
      "Use transform and opacity for hardware-accelerated animations",
      "Parallax background animations should use will-change: background-position sparingly"
    ]
  },
  "_twist": {
    "type": "A",
    "description": "Duration scaling (slower) at intensity 2: all transition durations multiplied by 1.3×. 0.2s → 0.26s, 0.3s → 0.39s. Creates a more deliberate, unhurried rhythm — matching the industrial-craft character of the ash palette.",
    "sourceSystem": "griting-opux",
    "intensity": 2
  }
}
