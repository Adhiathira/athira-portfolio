{
  "geometry": {
    "height": 60,
    "heightScrolled": 48,
    "paddingInline": 24,
    "position": "sticky",
    "logoPosition": "left"
  },
  "typography": {
    "fontFamily": "inherit",
    "fontSize": "13px",
    "fontWeight": "500",
    "letterSpacing": "0.08em",
    "textTransform": "uppercase"
  },
  "linkHover": {
    "backgroundPill": false,
    "underline": true,
    "animation": {
      "duration": "0.3s",
      "origin": "left to right"
    }
  }
}
