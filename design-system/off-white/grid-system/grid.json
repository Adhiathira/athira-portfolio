{
  "cssVars": {},
  "container": {},
  "grids": {},
  "responsive": {
    "bp-440px": {
      "query": "only screen and (max-width: 440px)",
      "display": "none",
      "maxWidth": "100%",
      "flexWrap": "wrap"
    },
    "bp-575px": {
      "query": "(max-width: 575px)",
      "display": "block",
      "flexDirection": "column",
      "rowGap": "1.5rem",
      "columnGap": "1.5rem",
      "gridTemplateColumns": "1fr 1fr 1fr 1fr"
    },
    "bp-576px": {
      "query": "(max-width: 576px)",
      "gridTemplateColumns": "repeat(1, 1fr)",
      "display": "none",
      "flexDirection": "row",
      "maxWidth": "7.8125rem",
      "rowGap": "3.75rem",
      "columnGap": "3.75rem"
    },
    "bp-577px": {
      "query": "(min-width: 577px)",
      "display": "block",
      "rowGap": "0.9375rem",
      "columnGap": "0.125rem",
      "maxWidth": "7.625rem",
      "flexDirection": "column",
      "flexWrap": "wrap",
      "gridTemplateColumns": "repeat(2, 1fr)"
    },
    "bp-767px": {
      "query": "(max-width: 767px)",
      "display": "block",
      "maxWidth": "8.125rem",
      "columnGap": "1rem"
    },
    "bp-768px": {
      "query": "(max-width: 768px)",
      "display": "none",
      "maxWidth": "27.875rem",
      "flexDirection": "row",
      "rowGap": "3rem",
      "columnGap": "0.25rem",
      "gridTemplateColumns": "repeat(2, minmax(0px, 1fr))",
      "flexWrap": "nowrap"
    },
    "bp-769px": {
      "query": "(min-width: 769px)",
      "display": "block",
      "flexDirection": "row",
      "flexWrap": "wrap",
      "maxWidth": "29.6875rem",
      "gridTemplateColumns": "repeat(4, 1fr)"
    },
    "bp-991px": {
      "query": "(max-width: 991px)",
      "display": "block",
      "flexDirection": "column"
    }
  },
  "visual": [
    {
      "section": "hero-background",
      "layout": "full-width",
      "description": "Full-width blurred background image spanning the entire viewport behind the modal overlay."
    },
    {
      "section": "modal-overlay",
      "layout": "2-column-split",
      "description": "Modal dialog split into left image panel (~40% width) and right form panel (~60% width) with grey background, centered on screen."
    },
    {
      "section": "modal-image-panel",
      "layout": "single-column-full-height",
      "description": "Left panel contains a single editorial photograph filling the full height of the modal with no padding."
    },
    {
      "section": "modal-form-panel",
      "layout": "single-column-padded",
      "description": "Right panel stacks heading, body copy, email input, category checkboxes, consent checkboxes, and CTA button vertically with consistent left alignment."
    },
    {
      "section": "cookie-banner",
      "layout": "full-width-bottom-overlay",
      "description": "Fixed bottom-right overlay with two-row layout: text paragraph above two stacked action buttons (Accept All Cookies and Cookie Settings)."
    }
  ]
}