{
  "geometry": {
    "height": 56,
    "paddingInline": 20,
    "position": "fixed",
    "itemSpacing": 32,
    "logoPosition": "left",
    "alignment": "left"
  },
  "background": {
    "backdropFilter": null,
    "backdropFilterScrolled": null,
    "borderBottom": null,
    "borderBottomScrolled": null,
    "boxShadow": null,
    "boxShadowScrolled": null,
    "transition": "transform 0.5s ease-in-out, background-color 0.5s ease-in-out, height 0.5s ease-in-out"
  },
  "typography": {
    "fontFamily": "IBMPlexMono-Medium",
    "fontSize": "0.875rem",
    "fontWeight": "500",
    "letterSpacing": "0px",
    "textTransform": "uppercase",
    "lineHeight": "1.3125rem"
  },
  "linkHover": {
    "underline": {
      "type": "pseudo-element",
      "thickness": "1px",
      "offset": "0.3125rem",
      "animation": {
        "property": "transform",
        "from": "scaleX(0)",
        "to": "scaleX(1)",
        "origin": "left center",
        "duration": "0.6s",
        "easing": "cubic-bezier(0, 0.7, 0.3, 1)"
      }
    },
    "transition": "color 0.2s ease-in-out"
  },
  "linkActive": {
    "selector": "a.active",
    "fontWeight": "500",
    "indicator": "dot"
  },
  "scrollTransition": {
    "mechanism": "class-toggle",
    "triggerClass": "scrolled",
    "propertiesChanged": [
      "transform"
    ],
    "duration": "0.5s",
    "easing": "ease-in-out",
    "colorInversion": false
  },
  "dropdown": {
    "present": true,
    "trigger": "hover",
    "borderRadius": null,
    "boxShadow": null,
    "padding": null,
    "itemPadding": "0.3125rem 0px",
    "animation": "transform 0.85s cubic-bezier(0.19, 1, 0.22, 1)"
  },
  "characterDescription": "A precise, monospaced editorial navigation system built on IBM Plex Mono — clinical and typographically rigid, suggesting a luxury brand that deliberately subverts conventional fashion typography with a coder's sensibility. The auto-hide-on-scroll with hover-reveal mechanism and expo-eased slide transitions signal restraint and considered interaction choreography over decorative excess."
}